    let loIndex=Math.max(0,hiIndex-1);
    if(Number(EMPIRICAL_CURVE_AGES[hiIndex])<=a+1e-9)loIndex=hiIndex;
    const loAge=Number(EMPIRICAL_CURVE_AGES[loIndex]);
