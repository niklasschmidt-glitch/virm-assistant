    if(!ownClubId){
      try{ownClubId=String((await start11Api.getCache?.())?.clubId||"");}catch(_){}
    }

    // Den højre "Mod"-boks er brugerens eget hold. Brug den eksisterende
    // start-11-cache direkte, præcis som Holdoversigten gør, i stedet for at
    // forsøge at genfinde brugerens egen opstilling som en vilkårlig ekstern klub.
    const ownKinds=new Set();
    for(const card of cards){
