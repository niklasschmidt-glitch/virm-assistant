  async function renderFriendlyInvitationKv() {
    const renderToken = ++friendlyInvitationRenderToken;
    // På invitationssiden er det VMANs store KV-cirkler i højre side af hvert
    // holdkort, der skal skifte beregningsmetode. Der må ikke indsættes små KV-
    // badges efter klubnavnet på denne side.
    const scope=document.querySelector("#content")||document.querySelector("#main")||document;
    scope.querySelectorAll?.(`.${INLINE_KV}`).forEach(node=>node.remove());
    const cards=friendlyInvitationCards();
    const hosts=[];
    for(const card of cards){
      for(const squad of card.querySelectorAll?.(".squads > .squad")||[]){
        const host=friendlyInvitationRatingHost(squad);
        if(host){snapshotFriendlyInvitationRating(host);hosts.push(host);}
      }
    }
    const state=await requestState();
    const modeByKind={
      senior:kvModeApi?.getEnabled?await kvModeApi.getEnabled("senior"):(await storageGet(enabledKey("senior")))!==false,
      youth:kvModeApi?.getEnabled?await kvModeApi.getEnabled("youth"):(await storageGet(enabledKey("youth")))!==false
