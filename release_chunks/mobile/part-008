    if(!row||!qs.length)return .5;
    const v=Number(value);
    if(!Number.isFinite(v))return .5;
    if(v<=Number(row[0]))return Number(qs[0]);
    const last=row.length-1;
    if(v>=Number(row[last]))return Number(qs[Math.min(last,qs.length-1)]);
    for(let i=0;i<last;i+=1){
