      const clubCount = node.querySelectorAll?.('a[href*="/squads/"],a[href*="/clubs/"]')?.length || 0;
      const hasMatchLink = Boolean(node.querySelector?.('a[href*="/new_matches/"]'));
      const text = normalizeText(node.textContent);
      const hasScore = /\b\d{1,2}\s*[-:]\s*\d{1,2}\b/.test(text);
      if (clubCount >= 1 && clubCount <= 4 && (hasMatchLink || hasScore)) return node;
    }
    return link.parentElement;
  }

  function resultClubLinks() {
    const root = document.querySelector("#content") || document.body;
    if (!root) return [];
    const seen = new Set();
    const output = [];
    for (const link of root.querySelectorAll('a[href*="/squads/"],a[href*="/clubs/"]')) {
      if (link.closest("#header,.side,.navigation,.quick_links,.account")) continue;
      if (link.closest(`[id="${CONTROL_ID}"]`)) continue;
      const { squadId, clubId } = clubIdFromHref(link.getAttribute("href"));
      if (!squadId && !clubId) continue;
      const nameNode = link.querySelector(".club_name") || link;
      const name = normalizeText(nameNode.textContent);
      if (!name || name.length > 80) continue;
      const container = matchContainer(link);
      if (!container) continue;
      const containerText = normalizeText(container.textContent);
      const hasMatchEvidence = Boolean(container.querySelector?.('a[href*="/new_matches/"]')) || /\b\d{1,2}\s*[-:]\s*\d{1,2}\b/.test(containerText) || /result|resultat|score|kamp|match/i.test(String(container.className || ""));
      if (!hasMatchEvidence) continue;
      const key = `${squadId || `club:${clubId}`}|${matchIdFromContainer(container)}|${normalizeKey(name)}`;
      if (seen.has(key)) continue;
      seen.add(key);
      output.push({ link, nameNode, name, container, matchId: matchIdFromContainer(container), squadId, clubId });
    }
    return output;
  }

  function nativeKvForEntry(entry) {
    const container = entry?.container;
    if (!container) return NaN;
    const nodes = Array.from(container.querySelectorAll("td.club_rating > div, .club_rating > div"));
    if (!nodes.length) return NaN;
    if (nodes.length === 1) return finiteKv(normalizeText(nodes[0].textContent));
    const links = resultClubLinks().filter(item => item.container === container);
    const index = links.findIndex(item => item === entry || (item.squadId === entry.squadId && item.clubId === entry.clubId && normalizeKey(item.name) === normalizeKey(entry.name)));
    const node = nodes[Math.max(0, Math.min(nodes.length - 1, index))];
    return finiteKv(normalizeText(node?.textContent));
  }

  function cachedStart11ForEntry(entry, cache) {
    if (!start11Enabled || !cache || !entry) return null;
    const team = cache.teams?.[teamKind];
    const match = entry.matchId ? team?.matches?.[entry.matchId] : null;
    if (!match) return null;
    const entryKey = normalizeKey(entry.name);
    const opponentKey = normalizeKey(match.opponent);
    const id = entry.squadId || entry.clubId;
    const opponentId = String(match.opponentClubId || "");
    if ((id && opponentId && id === opponentId) || (entryKey && opponentKey && entryKey === opponentKey)) {
      const average = finiteKv(match.opponentKv?.average);
      if (kvModeApi?.isValidStart11?.(match.opponentKv)) return { average, source: "start11" };
    }
    const ownKey = normalizeKey(currentSquadName());
    if (ownKey && entryKey === ownKey) {
      const average = finiteKv(match.ownKv?.average);
      if (kvModeApi?.isValidStart11?.(match.ownKv)) return { average, source: "start11" };
    }
    return null;
  }

  function jsonValueAfterAssignment(source, startIndex) {
    const text = String(source || "");
    let start = Number(startIndex) || 0;
    while (start < text.length && /\s/.test(text[start])) start += 1;
    const opening = text[start];
    const closing = opening === "{" ? "}" : opening === "[" ? "]" : "";
    if (!closing) return null;
    let depth = 0, quote = "", escaped = false;
    for (let index = start; index < text.length; index += 1) {
      const ch = text[index];
      if (quote) {
        if (escaped) escaped = false;
        else if (ch === "\\") escaped = true;
        else if (ch === quote) quote = "";
        continue;
      }
      if (ch === '"' || ch === "'") { quote = ch; continue; }
      if (ch === opening) depth += 1;
      else if (ch === closing && --depth === 0) {
        try { return JSON.parse(text.slice(start, index + 1)); } catch (_) { return null; }
      }
    }
    return null;
  }

  function playersDataFromHtml(html) {
    const raw = String(html || "").replace(/\\\//g, "/");
    for (const match of raw.matchAll(/(?:window\.)?playersData\s*=\s*/gi)) {
      const data = jsonValueAfterAssignment(raw, match.index + match[0].length);
      if (data && typeof data === "object" && Array.isArray(data.players)) return data;
    }
    return null;
  }

  function clubIdFromPlayersData(data, squadId = "") {
    const target = String(squadId || "");
    for (const squad of Array.isArray(data?.squads) ? data.squads : []) {
      if (target && String(squad?.id ?? "") !== target) continue;
      const id = String(squad?.club_id ?? squad?.club?.id ?? "");
      if (/^\d+$/.test(id)) return id;
    }
    for (const player of Array.isArray(data?.players) ? data.players : []) {
      const sid = String(player?.squad_id ?? player?.squad?.id ?? "");
      if (target && sid !== target) continue;
      const id = String(player?.squad?.club_id ?? player?.squad?.club?.id ?? "");
      if (/^\d+$/.test(id)) return id;
    }
    return "";
  }

  function ratingFromPlayersData(data, squadId = "") {
    if (!data || !Array.isArray(data.players)) return null;
    const target = String(squadId || "");
    const fallbackIds = new Set((Array.isArray(data.squads) ? data.squads : [])
      .filter(squad => Number(squad?.priority) === squadPriority && squad?.id != null)
      .map(squad => String(squad.id)));
    let players = data.players.filter(player => {
      const sid = String(player?.squad_id ?? player?.squad?.id ?? "");
      if (target) return sid === target;
      return Number(player?.squad?.priority) === squadPriority || fallbackIds.has(sid);
    });
    if (!players.length && target) {
      players = data.players.filter(player => {
        const sid = String(player?.squad_id ?? player?.squad?.id ?? "");
        return Number(player?.squad?.priority) === squadPriority || fallbackIds.has(sid);
      });
    }
    const ratings = players.map(player => Number(player?.rating)).filter(value => Number.isFinite(value) && value >= 0 && value <= 100).sort((a, b) => b - a);
    if (!ratings.length) return null;
    const selected = ratings.slice(0, Math.min(11, ratings.length));
    const average = selected.reduce((sum, value) => sum + value, 0) / selected.length;
    return average > 0 ? { average, playerCount: selected.length, source: "current" } : null;
  }

  function clubIdFromSquadHtml(html, squadId) {
    const data = playersDataFromHtml(html);
    const fromData = clubIdFromPlayersData(data, squadId);
    if (fromData) return fromData;
    const doc = new DOMParser().parseFromString(String(html || ""), "text/html");
    const link = doc.querySelector('#content a[href*="/clubs/"], main a[href*="/clubs/"]') || doc.querySelector('a[href*="/clubs/"]');
    return String(link?.getAttribute("href") || "").match(/\/clubs\/(\d+)/i)?.[1] || "";
  }

  async function loadDailyCache() {
    const stored = await storageGet(CACHE_KEY);
    if (stored?.date === todayKey() && stored?.clubs && typeof stored.clubs === "object") return stored;
    return { date: todayKey(), clubs: {} };
  }

  async function standardKv(entry, dailyCache) {
    const cacheId = entry.squadId ? `squad:${entry.squadId}` : entry.clubId ? `club:${entry.clubId}` : "";
    if (!cacheId) return null;
    const cached = dailyCache.clubs?.[cacheId];
    if (cached && Number.isFinite(Number(cached.average)) && Number(cached.average) > 0) return cached;
    if (inflight.has(cacheId)) return inflight.get(cacheId);

    const promise = (async () => {
      try {
        let result = null;
        let clubId = String(entry.clubId || "");
        const squadId = String(entry.squadId || "");
        if (squadId) {
          const response = await virmFetch(new URL(`/squads/${squadId}`, window.location.origin).href, { credentials: "include", cache: "no-store", headers: { Accept: "text/html,application/xhtml+xml" } });
          if (!response.ok) throw new Error(`Squad ${squadId}: HTTP ${response.status}`);
          const html = await response.text();
          const data = playersDataFromHtml(html);
          result = ratingFromPlayersData(data, squadId);
          clubId = clubId || clubIdFromPlayersData(data, squadId) || clubIdFromSquadHtml(html, squadId);
        }
        if (!result && clubId) {
          const response = await virmFetch(new URL(`/clubs/${clubId}/players`, window.location.origin).href, { credentials: "include", cache: "no-store", headers: { Accept: "text/html,application/xhtml+xml" } });
          if (!response.ok) throw new Error(`Club ${clubId}: HTTP ${response.status}`);
          result = ratingFromPlayersData(playersDataFromHtml(await response.text()), squadId);
        }
        if (result) {
          const saved = { ...result, clubId, squadId, updatedAt: Date.now() };
          dailyCache.clubs[cacheId] = saved;
          await storageSet(CACHE_KEY, dailyCache);
          return saved;
        }
        return null;
      } catch (error) {
        if (!error?.virmDataRequestsDisabled) console.warn("[VIRM Assistant] Resultat-KV kunne ikke indlæses", entry.name, error);
        return null;
      } finally {
        inflight.delete(cacheId);
      }
    })();
    inflight.set(cacheId, promise);
    return promise;
  }

  function appendBadge(entry, badge) {
    if (!entry?.nameNode?.isConnected || !badge) return false;
    const existing = entry.nameNode.parentElement?.querySelector?.(`.${BADGE_CLASS}[data-virm-results-club="${entry.squadId || entry.clubId}"]`);
    if (existing) existing.remove();
    badge.dataset.virmResultsClub = entry.squadId || entry.clubId;
    const anchor = entry.link;
    anchor.insertAdjacentElement("afterend", badge);
    return true;
  }

  async function mapWithConcurrency(items, limit, worker) {
    const list = Array.from(items || []);
    let next = 0;
    const runners = Array.from({ length: Math.max(1, Math.min(limit, list.length || 1)) }, async () => {
      while (true) {
        const index = next++;
        if (index >= list.length) return;
        await worker(list[index], index);
      }
    });
    await Promise.all(runners);
  }

  async function render() {
    const token = ++renderToken;
    removeBadges();
    const state = await dataRequestState();
    if (state.disabled || token !== renderToken) return;

    start11Enabled = kvModeApi?.getEnabled ? await kvModeApi.getEnabled(teamKind) : (await storageGet(ENABLED_KEY)) !== false;
    const entries = resultClubLinks();
    if (!entries.length || token !== renderToken) return;
    let startCache = null;
    if (start11Enabled && start11Api?.getCache) {
      try { startCache = await start11Api.getCache(); } catch (_) {}
    }
    const dailyCache = await loadDailyCache();

    await mapWithConcurrency(entries, CONCURRENCY, async entry => {
      if (token !== renderToken) return;
      let result = cachedStart11ForEntry(entry, startCache);
      if (!result) {
        const native = nativeKvForEntry(entry);
        if (Number.isFinite(native)) result = { average: native, source: "vman" };
      }
      if (!result) result = await standardKv(entry, dailyCache);
      if (token !== renderToken || !result || !Number.isFinite(Number(result.average))) return;
      appendBadge(entry, createBadge(result.average, result.source || "current"));
    });
  }

  function scheduleRender() {
    if (renderScheduled) return;
    renderScheduled = true;
    setTimeout(() => {
      renderScheduled = false;
      render().catch(error => console.warn("[VIRM Assistant] Resultat-KV rendering fejlede", error));
    }, 80);
  }

  function boot() {
    createMenu().then(created => {
      if (!created) {
        const menuObserver = new MutationObserver(() => createMenu().then(done => { if (done) menuObserver.disconnect(); }));
        menuObserver.observe(document.documentElement, { childList: true, subtree: true });
        setTimeout(() => menuObserver.disconnect(), 20000);
      }
    });
    scheduleRender();
    const root = document.querySelector("#content") || document.documentElement;
    if (root) {
      observer = new MutationObserver(mutations => {
        if (mutations.some(mutation => Array.from(mutation.addedNodes || []).some(node => node.nodeType === Node.ELEMENT_NODE && !node.classList?.contains(BADGE_CLASS)))) scheduleRender();
      });
      observer.observe(root, { childList: true, subtree: true });
      setTimeout(() => { observer?.disconnect(); observer = null; }, 20000);
    }
    document.addEventListener("virm:data-requests-changed", () => {
      syncRequestMenu().catch(() => {});
      scheduleRender();
    });
    document.addEventListener("virm:kv-mode-changed", event => {
      const detail = event?.detail || {};
      if ((detail.kind || detail.teamKind) !== teamKind) return;
      start11Enabled = Boolean(detail.enabled);
      const checkbox = control()?.querySelector?.(".virm-assistant-overview-checkbox-item input[type=checkbox]");
      if (checkbox) checkbox.checked = start11Enabled;
      scheduleRender();
    });
    start11Api?.subscribe?.(() => scheduleRender());
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, { once: true });
  else boot();
})();

// 0.1.325: Hamburgere på spillerprofil/holdsider/klub-spillerliste 7 px op.
