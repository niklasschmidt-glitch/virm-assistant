    const loRow=rows[loIndex],hiRow=rows[hiIndex];
    if(!Array.isArray(loRow)||!Array.isArray(hiRow))return null;
    if(loIndex===hiIndex||Math.abs(hiAge-loAge)<1e-9)return loRow.map(Number);
