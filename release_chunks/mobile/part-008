  function findHeading() {
    if (/^\/clubs\/\d+$/i.test(path)) {
      const licenseHost = clubLicenseHost();
      if (licenseHost) return licenseHost;
    }
    const roots = [document.querySelector("#content"), document.querySelector("#main"), document.body].filter(Boolean);
    for (const root of roots) {
      const candidates = Array.from(root.querySelectorAll("h1,h2"));
      if (path === "/friendly_invitations") {
        const invitationHeading = candidates.find(node => /^(?:invitationer til venskabskampe|friendly match invitations|friendly invitations)$/i.test(normalizeText(node.textContent)));
        if (invitationHeading) return invitationHeading;
      }
      if (/^\/clubs\/\d+\/transfers$/i.test(path)) {
        const transferHeading = candidates.find(node => /^(?:transfers|transferhistorik|transfer history)$/i.test(normalizeText(node.textContent)));
        if (transferHeading) return transferHeading;
      }
      if (marketSearchMenuPage()) {
        const marketHeading = marketSearchHeading();
        if (marketHeading) return marketHeading;
      }
      /* Klub- og ligaprofiler har et stort banner med sin egen H1. Det er ikke
         sidens handlingsoverskrift og må derfor aldrig være hamburger-host. */
      const clean = candidates.filter(node =>
        !node.closest(".side,.navigation,#header,.big_name") && normalizeText(node.textContent)
      );
      if (/^\/(?:youth_)?cups?\/\d+\/fixtures$/i.test(path)) {
        const cupFixtures = Array.from(root.querySelectorAll("h1,h2,h3"))
          .filter(node => !node.closest(".side,.navigation,#header,.big_name"))
          .find(node => /^(?:kampprogram|fixtures|matches)$/i.test(normalizeText(node.textContent)));
        if (cupFixtures) return cupFixtures;
      }
      if (/^\/clubs\/\d+\/fixtures$/i.test(path)) {
        const fixtures = clean.find(node => /^(?:kampprogram|fixtures)$/i.test(normalizeText(node.textContent)));
        if (fixtures) return fixtures;
      }
      if (/^\/(?:leagues|youth_leagues)\/\d+\/\d+\/\d+\/matches$/i.test(path)) {
        const matches = clean.find(node => /^(?:kampprogram|kampe|matches|fixtures)$/i.test(normalizeText(node.textContent)));
        if (matches) return matches;
      }
      const best = clean[0] || null;
      if (best) return best;
    }
    return null;
  }

