  const path = rawPath.replace(/^\/[a-z]{2}(?=\/)/i, "");
  const guard = window.__VIRM_DATA_REQUESTS_V1__ || null;
  const start11Api = window.__VIRM_KV_START11_CACHE_V1__ || null;
  const kvModeApi = globalThis.__VIRM_KV_MODE_V1__ || null;
  const DATA_CLASS = "virm-0318-data-ui";
  const INLINE_KV = "virm-0318-inline-kv";
  const VT_CLASS = "virm-0318-player-vt";
  const SHARED_CACHE_PREFIX = "virmAssistantSharedClubKvDailyV1_";
  const TRANSFER_VT_CACHE_KEY = "virmAssistantTransferHistoryPlayerVtDailyV1";
  const PALETTE = [
    ["#4fac39", "#38651d"], ["#b4c30c", "#677a00"], ["#edc50d", "#a16920"],
    ["#f59000", "#a25314"], ["#cf4120", "#743316"], ["#dc49a7", "#742871"],
    ["#aa51c4", "#6b2779"], ["#356bc5", "#2e3689"], ["#13a4d3", "#00597a"],
    ["#5b5b5b", "#282828"],
  ];
  const inflight = new Map();
  let rerenderTimer = 0;

  function normalizeText(value) { return String(value == null ? "" : value).replace(/\s+/g, " ").trim(); }
  function normalizeKey(value) { return normalizeText(value).normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("da"); }
  function finite(value) { const n = Number(String(value ?? "").replace(",", ".")); return Number.isFinite(n) ? n : NaN; }
  function todayKey() { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`; }
  async function storageGet(key) { try { const r = await globalThis.chrome?.storage?.local?.get?.(key); return r?.[key]; } catch (_) { return undefined; } }
  async function storageSet(key, value) { try { await globalThis.chrome?.storage?.local?.set?.({ [key]: value }); } catch (_) {} }
  function teamKindForPath() { return /^\/(?:youth_squad|youth_leagues|youth_cups?)(?:\/|$)/i.test(path) ? "youth" : "senior"; }
