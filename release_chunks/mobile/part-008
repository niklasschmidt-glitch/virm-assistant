  function clubLicenseHost() {
    if (!/^\/clubs\/\d+$/i.test(path)) return null;
    const root = document.querySelector("#content") || document.querySelector("#main") || document.body;
    if (!root) return null;
    const phrases = ["denne klub har licens", "this club has a license", "this club has licence"];
    const candidates = Array.from(root.querySelectorAll("span,p,div,li,strong,em"))
      .filter(node => !node.closest?.(".side,.navigation,#header"))
      .map(node => ({ node, text: normalizeKey(node.textContent || "") }))
      .filter(entry => phrases.some(phrase => entry.text.includes(phrase)));
    candidates.sort((a, b) => {
      const aChildren = a.node.querySelectorAll?.("*")?.length || 0;
      const bChildren = b.node.querySelectorAll?.("*")?.length || 0;
      const aScore = a.text.length + aChildren * 30;
      const bScore = b.text.length + bChildren * 30;
      return aScore - bScore;
    });
    return candidates[0]?.node || null;
  }

  function clubLicenseBadgeAnchor(licenseHost) {
    if (!licenseHost) return null;
    const isCandidate = node => {
      if (!(node instanceof Element)) return false;
      const ownImg = node.matches?.("img") ? node : node.querySelector?.("img");
      if (!ownImg) return false;
      const hint = normalizeKey([
        node.getAttribute?.("title"), node.getAttribute?.("aria-label"),
        ownImg.getAttribute?.("title"), ownImg.getAttribute?.("alt"), ownImg.getAttribute?.("src")
      ].filter(Boolean).join(" "));
      if (/licen|medal|badge|premium/.test(hint)) return true;
      const text = normalizeText(node.textContent || "");
      return text.length <= 3;
    };

    // Badge may already be a child of the same text host.
    const children = Array.from(licenseHost.children || []);
    const childBadge = children.find(isCandidate);
    if (childBadge) return childBadge;

    // On current VMAN club pages the medal is normally the next small sibling.
    let sibling = licenseHost.nextElementSibling;
    for (let i = 0; sibling && i < 4; i++, sibling = sibling.nextElementSibling) {
      if (isCandidate(sibling)) return sibling;
    }

    // Final fallback: search the immediate row/container, but never wander into
    // the rest of the club page.
    const parent = licenseHost.parentElement;
    if (parent) {
      const nearby = Array.from(parent.children || []);
      const hostIndex = nearby.indexOf(licenseHost);
      for (let i = Math.max(0, hostIndex + 1); i < Math.min(nearby.length, hostIndex + 5); i++) {
        if (isCandidate(nearby[i])) return nearby[i];
      }
    }
    return null;
  }

  function marketSearchHeading() {
    const roots = [document.querySelector("#content"), document.querySelector("#main"), document.body].filter(Boolean);
    for (const root of roots) {
      const candidates = Array.from(root.querySelectorAll("h1,h2"))
        .filter(node => !node.closest(".side,.navigation,#header,.big_name"));
      const exact = candidates.find(node => {
        const key = normalizeKey(node.textContent);
        if (!key || key.length > 90) return false;
        return key.includes("transferliste")
          || key.includes("transfer list")
          || key.includes("transfersøgning")
          || key.includes("transfersogning")
          || key.includes("transfer search")
          || key.includes("auktion")
          || key.includes("auction")
          || key.includes("fri transfer")
          || key.includes("free transfer")
          || key.includes("free agent");
      });
      if (exact) return exact;
    }
    return null;
  }

  function marketSearchMenuPage() {
    if (path === "/transfer_listings") return true;
    const route = normalizeKey(path);
    if (route.includes("auction") || route.includes("auktion")
      || route.includes("free_transfer") || route.includes("free-transfer")
      || route.includes("free transfer") || route.includes("free_agent")
      || route.includes("free-agent") || route.includes("free agent")
      || route.includes("fri_transfer") || route.includes("fri-transfer")
      || route.includes("fri transfer")) return true;
