  function priorityFor(kind) { return kind === "youth" ? 2 : 1; }
  function colorFor(value) { const n = Math.max(0, Math.min(99, Math.round(Number(value) || 0))); return PALETTE[Math.min(9, Math.floor(n / 10))]; }
