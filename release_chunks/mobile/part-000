  }
}

function virmMobileFallbackSet(key, value) {
  localStorage.setItem(VIRM_MOBILE_FALLBACK_PREFIX + String(key), JSON.stringify(value));
}

function virmMobileFallbackRemove(key) {
  try {
    localStorage.removeItem(VIRM_MOBILE_FALLBACK_PREFIX + String(key));
