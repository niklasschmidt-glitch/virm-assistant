const VIRM_MOBILE_DB_NAME = "VIRMExtensionUserscript";
const VIRM_MOBILE_DB_VERSION = 1;
const VIRM_MOBILE_STORE_NAME = "keyvalue";
const VIRM_MOBILE_FALLBACK_PREFIX = "virm-extension-userscript:";

function virmMobileOpenDatabase() {
  return new Promise((resolve, reject) => {
    if (!("indexedDB" in globalThis)) {
      reject(new Error("IndexedDB understøttes ikke."));
      return;
    }
    const request = indexedDB.open(VIRM_MOBILE_DB_NAME, VIRM_MOBILE_DB_VERSION);
    request.onupgradeneeded = () => {
      const db = request.result;
      if (!db.objectStoreNames.contains(VIRM_MOBILE_STORE_NAME)) db.createObjectStore(VIRM_MOBILE_STORE_NAME);
    };
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error || new Error("Kunne ikke åbne lokal lagring."));
    request.onblocked = () => reject(new Error("Den lokale lagring er blokeret."));
  });
}

async function virmMobileIndexedGet(key) {
  const db = await virmMobileOpenDatabase();
  try {
    return await new Promise((resolve, reject) => {
      const transaction = db.transaction(VIRM_MOBILE_STORE_NAME, "readonly");
      const request = transaction.objectStore(VIRM_MOBILE_STORE_NAME).get(String(key));
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error || new Error("Kunne ikke læse lokal lagring."));
    });
  } finally {
    db.close();
  }
}

