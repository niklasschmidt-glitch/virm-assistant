  function assistantDisplayResults(assistant) {
    const canonicalRank = new Map(assistant.results.map((result, index) => [result.id, index + 1]));
    const key = assistant.resultSortKey;
    const direction = assistant.resultSortDirection === "asc" ? 1 : -1;
    const sortValue = (result) => key === "rank" ? canonicalRank.get(result.id) : result[key];
    const results = [...assistant.results];
    results.sort((left, right) => {
      const leftValue = sortValue(left);
      const rightValue = sortValue(right);
      let comparison;
      if (typeof leftValue === "number" && typeof rightValue === "number") {
        const precision = ["rating", "weightedRating", "average"].includes(key) ? 100 : 1;
        comparison = Math.round(leftValue * precision) - Math.round(rightValue * precision);
      }
      else comparison = String(leftValue || "").localeCompare(String(rightValue || ""), "da", { numeric: true, sensitivity: "base" });
      return comparison * direction || (canonicalRank.get(left.id) - canonicalRank.get(right.id));
    });
    return { results, canonicalRank };
  }

  function setAssistantResultSort(key) {
    const assistant = assistantStateForProgram();
    if (!ASSISTANT_RESULT_SORT_KEYS.includes(key)) return;
    if (assistant.resultSortKey === key) {
      assistant.resultSortDirection = assistant.resultSortDirection === "asc" ? "desc" : "asc";
    } else {
      assistant.resultSortKey = key;
      assistant.resultSortDirection = ["method", "notes", "rank"].includes(key) ? "asc" : "desc";
    }
    persistAssistantChange();
    renderAssistantResultsTable();
  }

