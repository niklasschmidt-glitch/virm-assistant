      const optaktHref = row.querySelector('td.more a[href*="/new_matches/"]')?.getAttribute('href') || '';
      const tacticsHref = row.querySelector('a[href*="/new_matches/"][href*="/tactics"]')?.getAttribute('href') || '';
      const matchId = (tacticsHref || optaktHref).match(/\/new_matches\/(\d+)/)?.[1] || selectionId;
      const opponentLink = row.querySelector('td.opponent a[href*="/clubs/"], td.opponent a[href*="/squads/"], .opponent a[href*="/clubs/"], .opponent a[href*="/squads/"]');
      const opponentHref = String(opponentLink?.getAttribute('href') || '');
      const opponentClubId = opponentHref.match(/\/clubs\/(\d+)/i)?.[1] || '';
      const opponentSquadId = opponentHref.match(/\/squads\/(\d+)/i)?.[1] || '';
      const vmanKvNode = row.querySelector('td.club_rating > div, td.club_rating, .club_rating > div, .club_rating');
      const vmanKv = parseRotationKv(vmanKvNode?.textContent);
