    if (/^\/new_matches\/\d+\/tactics$/i.test(path)) {
      if (document.querySelector('a[href^="/youth_squad/tactics/"][href*="match_id"], a[href^="/youth_squad/tactics/"][href$="/edit"]')) return "youth";
      if (document.querySelector('a[href^="/new_tactics/"][href*="match_id"], a[href^="/new_tactics/"][href$="/edit"]')) return "senior";
    }
    return null;
  }

  function queue(reason, options = {}) {
    const teamKind = currentTeamKind();
    if (!teamKind) return;
    api.requestTeamRefresh(teamKind, reason, options);
  }

  document.addEventListener("change", event => {
    const select = event.target?.closest?.('td.tactic select[data-selection_id], .tactic select[data-selection_id]');
    if (!select) return;
    queue("match-tactic-change", { delayMs: 1500 });
