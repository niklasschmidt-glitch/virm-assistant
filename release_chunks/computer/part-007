      vmanGroupId: Number.isInteger(Number(exercise && exercise.id)) ? Number(exercise.id) : null,
      name: normalizeText(exercise && exercise.name) || `Træningsgruppe ${index + 1}`,
      groupId: plannerGroupIdForVmanExercise(exercise),
    }));
  }

