  function boot() {
    createMenu().then(done => {
      if (!done) {
        const menuObserver = new MutationObserver(() => {
          createMenu().then(created => { if (created) menuObserver.disconnect(); });
        });
        menuObserver.observe(document.documentElement, { childList: true, subtree: true });
        setTimeout(() => menuObserver.disconnect(), 20000);
      }
    });

    // .pitches kan blive indsat efter den første DOMContentLoaded-rendering.
    // Observer kun indtil begge faktiske klubnavne er til stede; badges i sig selv
    // må ikke starte en permanent mutationsløkke.
    const root = document.querySelector("#content .match_tactics") || document.querySelector("#content");
    if (root) {
      let scheduled = false;
      const pitchObserver = new MutationObserver(() => {
        if (scheduled) return;
        scheduled = true;
        queueMicrotask(() => {
          scheduled = false;
          const clubs = document.querySelectorAll("#content .match_tactics > .pitches > li > .club");
          if (clubs.length >= 2) {
            pitchObserver.disconnect();
            render().catch(() => {});
          }
        });
      });
      const clubs = document.querySelectorAll("#content .match_tactics > .pitches > li > .club");
