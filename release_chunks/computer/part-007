  function renderAssistantResultsTable() {
    const body = refs.assistantResultsBody;
    if (!body || !body.isConnected) return;
    const program = activeProgram();
    const assistant = assistantStateForProgram(program);
    const customWeights = assistantHasCustomWeights(assistant, program.scenario ? program.scenario.position : program.position);
    const columns = assistantResultColumns(customWeights);
    const hasSelection = assistant.results.some((result) => result.id === assistant.selectedResultId);
    if (refs.assistantImportButton) refs.assistantImportButton.disabled = !hasSelection;
    if (refs.assistantClearButton) refs.assistantClearButton.disabled = !assistant.results.length;
    if (refs.assistantExportSelect) refs.assistantExportSelect.disabled = !hasSelection;
    const table = body.closest("table");
    for (const heading of table.querySelectorAll("th[data-sort-key]")) {
      const active = heading.dataset.sortKey === assistant.resultSortKey;
      heading.setAttribute("aria-sort", active ? (assistant.resultSortDirection === "asc" ? "ascending" : "descending") : "none");
      const indicator = heading.querySelector(".virm-sort-indicator");
      if (indicator) indicator.textContent = active ? (assistant.resultSortDirection === "asc" ? "↑" : "↓") : "";
    }
    body.replaceChildren();
    const display = assistantDisplayResults(assistant);
    for (const result of display.results.slice(0, 100)) {
      const row = document.createElement("tr");
      row.dataset.resultId = result.id;
      row.classList.toggle("is-selected", result.id === assistant.selectedResultId);
      for (const column of columns) {
        const cell = document.createElement("td");
        cell.className = `virm-result-col-${column.className}`;
        cell.textContent = String(column.value(result, display.canonicalRank.get(result.id)));
        row.appendChild(cell);
      }
      const select = () => {
        assistant.selectedResultId = result.id;
        persistAssistantChange();
        renderAssistantResultsTable();
      };
      row.addEventListener("click", select);
      row.addEventListener("dblclick", () => {
        select();
        importSelectedAssistantResult();
      });
      row.addEventListener("contextmenu", (event) => {
        event.preventDefault();
        select();
        openAssistantResultMenu(event.clientX, event.clientY);
      });
      body.appendChild(row);
    }
    if (!body.childElementCount) {
      const row = document.createElement("tr");
      const cell = document.createElement("td");
      cell.colSpan = customWeights ? 6 : 5;
      cell.className = "virm-assistant-empty-results";
      cell.textContent = "Ingen resultater endnu.";
      row.appendChild(cell);
      body.appendChild(row);
    }
  }

