  }

  function setPlayerPointNode(node, value, kind, age = null) {
    if (!node) return;
    node.textContent = kind === "KP"
      ? formatKpDisplay(value, age, formatTwo)
      : (Number.isFinite(value) ? formatTwo(value) : "—");
    node.title = Number.isFinite(value)
      ? kind === "PP"
        ? "PP beregnet ud fra spillerens seneste tilgængelige træninger."
        : "KP viser spillerens gennemsnitlige træningsniveau gennem karrieren på samme skala som PP."
      : kind === "KP" && isBelowKpMinimumAge(age)
        ? "KP beregnes fra og med alderen 15.5."
        : `${kind} kunne ikke beregnes.`;
  }

  async function ensurePlayerPagePoints() {
    if (!playerPageMatch) return;

    // Behold det oprindelige PP/KP-felt mellem Udmærkelse og Egenskaber.
    // Den tidligere top-rækkeændring hørte til /youth_squad/players og er fjernet herfra.
    const legacyCard = ensureLegacyPlayerPointsCard();
    if (!legacyCard) return;

    const ppNode = legacyCard.querySelector("[data-virm-legacy-player-pp]");
    const kpNode = legacyCard.querySelector("[data-virm-legacy-player-kp]");
    if (ppNode?.dataset.virmLoaded === "1" && kpNode?.dataset.virmLoaded === "1") return;
    if (legacyCard.dataset.virmLoading === "1") return;
    legacyCard.dataset.virmLoading = "1";

    const id = playerPageMatch[1];
    const href = window.location.href;
    const positionBeforeFetch = playerProfilePosition();
    const liveProfileAge = parsePrecisePlayerAge(document);
    const liveProfileSum = parseCurrentAbilitySum(document);

    try {
      const summary = await fetchTrainingSummary({
        id,
        href,
        position: positionBeforeFetch,
        marketAge: liveProfileAge,
        marketSum: liveProfileSum
      });
      const pp = Number(summary?.pp);
      const age = bestAvailableKpAge(summary?.age, liveProfileAge);
      const sum = firstFiniteKpNumber(summary?.sum, liveProfileSum);
      const position = positionBeforeFetch || normalizePlayerPosition(summary?.position || "");
      const kp = calculateKp(position, age, sum);

      setPlayerPointNode(ppNode, pp, "PP");
      setPlayerPointNode(kpNode, kp, "KP", age);
      const kpHasFactorInfo = Number.isFinite(kp) && renderKpFactorInfo(kpNode, summary);
      if (kpHasFactorInfo) kpNode.removeAttribute("title");
      if (ppNode) ppNode.dataset.virmLoaded = "1";
      if (kpNode) kpNode.dataset.virmLoaded = "1";
    } catch (error) {
      if (ppNode) {
        ppNode.textContent = "—";
        ppNode.title = error?.message || "PP kunne ikke indlæses.";
      }
      if (kpNode) {
        kpNode.textContent = "—";
        kpNode.title = error?.message || "KP kunne ikke indlæses.";
      }
    } finally {
      delete legacyCard.dataset.virmLoading;
    }
  }

  function scoutReportTablesForKp() {
    if (!scoutReportPage) return [];

    return Array.from(document.querySelectorAll("#content table")).filter(table => {
      const header = headerRowForTable(table);
      if (!header) return false;

      const keys = Array.from(header.children).map(cell => normalizeKey(cell.textContent));
      const hasPlayer = keys.some(key => key === "spiller" || key === "player");
      const hasAge = keys.some(key => key === "alder" || key === "age") || Boolean(header.querySelector(".age"));
      const hasRows = Boolean(table.querySelector('tbody a[href*="/players/"]'));

      return hasPlayer && hasAge && hasRows;
    });
  }

  function setScoutColumnWidth(element, widthPx) {
    if (!element || !(widthPx > 0)) return;
    const px = `${widthPx}px`;
    element.style.setProperty("box-sizing", "border-box", "important");
    element.style.setProperty("width", px, "important");
    element.style.setProperty("min-width", px, "important");
    element.style.setProperty("max-width", px, "important");
  }

  function parseVmEnhancerPp(cell) {
    if (!cell) return null;

    const source = Array.from(cell.querySelectorAll("*"))
      .find(element => element.tagName.toLowerCase() === "c");
    const raw = normalizeText(source?.textContent || cell.textContent);
    const match = raw.match(/[-+]?\d+(?:[.,]\d+)?/);
    if (!match) return null;

    const value = Number(match[0].replace(",", "."));
    return Number.isFinite(value) ? value : null;
  }

  function scoutLayoutState(table, header, playerHeader) {
    if (table.__virmScoutLayoutState) return table.__virmScoutLayoutState;

    const tableWidth = table.getBoundingClientRect().width || 0;
    const playerWidth = playerHeader.getBoundingClientRect().width || 0;

    table.__virmScoutLayoutState = {
      tableWidth,
      originalPlayerWidth: playerWidth,
      vmePpWidth: 0,
      hasVmePp: false,
    };
    return table.__virmScoutLayoutState;
  }

  function vmEnhancerPpHeader(header) {
    return Array.from(header.children).find(cell => {
      if (cell.classList.contains("virm-scout-pp")) return false;
      if (cell.classList.contains("virm-market-pp")) return false;
      if (cell.classList.contains("virm-roster-pp")) return false;

      return cell.classList.contains("virm-vme-pp-source")
        || normalizeKey(cell.textContent) === "pp";
    }) || null;
  }

  function ensureVirmScoutPpHeader(header, ageHeader, width, enabled) {
    let pp = header.querySelector("th.virm-scout-pp, td.virm-scout-pp");

    if (!enabled) {
      pp?.remove();
      return null;
    }

    if (!pp) {
      pp = document.createElement(ageHeader.tagName === "TH" ? "th" : "td");
      pp.className = "virm-scout-pp";
      pp.textContent = "PP";
      pp.title = "PP-data aflæst fra VMEnhancer";
    }

    setScoutColumnWidth(pp, width);
    return pp;
  }

  function ensureVirmScoutKpHeader(header, ageHeader, width) {
    let kp = header.querySelector("th.virm-scout-kp, td.virm-scout-kp");

    if (!kp) {
      kp = document.createElement(ageHeader.tagName === "TH" ? "th" : "td");
      kp.className = "virm-scout-kp";
      kp.innerHTML = '<span class="virm-scout-kp-content">KP</span>';
      kp.title = "Karriere-point";
    } else if (!kp.querySelector(".virm-scout-kp-content")) {
      kp.textContent = "";
      const span = document.createElement("span");
      span.className = "virm-scout-kp-content";
      span.textContent = "KP";
      kp.appendChild(span);
    }

    setScoutColumnWidth(kp, width);
    return kp;
  }

  function bindVmEnhancerPpSource(sourceCell, targetCell) {
    if (!sourceCell || !targetCell) return;

    const render = () => {
      const value = parseVmEnhancerPp(sourceCell);
      targetCell.textContent = Number.isFinite(value) ? formatTwo(value) : "—";
      targetCell.title = Number.isFinite(value)
        ? "PP-data aflæst fra VMEnhancer."
        : "VMEnhancer leverede ikke en brugbar PP-værdi.";
    };

    render();

    if (sourceCell.__virmPpTarget === targetCell && sourceCell.__virmPpSourceObserver) return;

    sourceCell.__virmPpSourceObserver?.disconnect?.();
    const observer = new MutationObserver(render);
    observer.observe(sourceCell, {
      characterData: true,
      childList: true,
      subtree: true,
    });

    sourceCell.__virmPpSourceObserver = observer;
    sourceCell.__virmPpTarget = targetCell;
  }

  function ensureScoutVmePpInfo(ppHeader, enabled) {
    if (!ppHeader) return;

    let label = ppHeader.querySelector(".virm-scout-pp-label");
    if (!label) {
      ppHeader.textContent = "";
      label = document.createElement("span");
      label.className = "virm-scout-pp-label";
      label.textContent = "PP";
      ppHeader.appendChild(label);
    }

    let info = ppHeader.querySelector(".virm-scout-vme-pp-info");
    if (!enabled) {
      info?.remove();
      return;
    }

    if (!info) {
      info = document.createElement("span");
      info.className = "virm-scout-vme-pp-info";
      info.tabIndex = 0;
      info.setAttribute("role", "button");
      info.setAttribute("aria-label", "Om PP fra VMEnhancer");
      info.innerHTML = `
        <span class="virm-scout-vme-pp-info-icon" aria-hidden="true">i</span>
        <span class="virm-scout-vme-pp-tooltip" role="tooltip">
          <span>Denne PP-værdi er beregnet af <strong>VMEnhancer 🙏❤️</strong></span>
          <span>Bemærk, at værdien kan afvige fra VIRM Assistants PP, da beregningsmetoderne ikke er helt ens.</span>
        </span>
      `;
      ppHeader.appendChild(info);
    }
  }

  function ensureScoutPointsHeader(table) {
    const header = headerRowForTable(table);
    if (!header) return false;

    const ageHeader = header.querySelector(".age")
      || Array.from(header.children).find(cell => ["alder", "age"].includes(normalizeKey(cell.textContent)));
    const playerHeader = header.querySelector(".player")
      || Array.from(header.children).find(cell => ["spiller", "player"].includes(normalizeKey(cell.textContent)));
    if (!ageHeader || !playerHeader) return false;

    // Ryd gamle VIRM-markedskolonner fra tidligere builds.
    for (const cell of Array.from(header.children)) {
      if (
        cell.classList.contains("virm-market-pp")
        || cell.classList.contains("virm-market-kp")
        || cell.classList.contains("virm-roster-pp")
        || cell.classList.contains("virm-roster-kp")
      ) {
        cell.remove();
      }
    }

    // Debug 0.1.138 viste den egentlige forskel:
    // - med VME bliver .details-kolonnen brugt som VME-PP og skjult af VIRM
    // - uden VME bliver den samme tomme .details-kolonne stående og optager ca. 91 px
    // Derfor skal .details-kolonnen fjernes fra layoutet i BEGGE tilstande, før vi måler.
    const sourceHeader = vmEnhancerPpHeader(header);
    const hasVmePp = Boolean(sourceHeader);
    const detailsHeader = sourceHeader
      || header.querySelector(".details")
      || Array.from(header.children).find(cell => /details/i.test(String(cell.className || "")))
      || null;

    if (detailsHeader) {
      const detailsIndex = Array.from(header.children).indexOf(detailsHeader);
      detailsHeader.classList.add(hasVmePp ? "virm-vme-pp-source" : "virm-scout-unused-details");
      detailsHeader.setAttribute("aria-hidden", "true");

      if (detailsIndex >= 0) {
        for (const row of table.querySelectorAll("tbody tr")) {
          const detailsCell = row.children[detailsIndex] || null;
          if (!detailsCell) continue;
          detailsCell.classList.add(hasVmePp ? "virm-vme-pp-source" : "virm-scout-unused-details");
          detailsCell.setAttribute("aria-hidden", "true");
        }
      }
    }

    // Begge skjulte details-varianter er display:none i CSS. Først derefter måler
    // scoutLayoutState(), så med/uden VME får samme udgangspunkt og samme bredder.
    table.classList.add("virm-scout-owned-points");

    const state = scoutLayoutState(table, header, playerHeader);
    if (!(state.tableWidth > 0 && state.originalPlayerWidth > 0)) return false;
    state.hasVmePp = hasVmePp;

    // Én og samme synlige geometri uanset VMEnhancer.
    // Dette er 0.1.133-layoutet uden VME, som nu er kanonisk for begge tilstande.
    const defaultPlayerWidth = state.originalPlayerWidth * 0.80;
    const defaultDonatedWidth = state.originalPlayerWidth - defaultPlayerWidth;
    const ageWidth = ageHeader.getBoundingClientRect().width || 0;
    const comfortablePointWidth = Math.max(ageWidth, 56);

    let pointWidth = Math.max(defaultDonatedWidth / 2, comfortablePointWidth);
    let playerWidth = state.originalPlayerWidth - pointWidth * 2;

    // Sikkerhedsnet: Spiller må ikke blive urimeligt smal.
    const minPlayerWidth = state.originalPlayerWidth * 0.58;
    if (playerWidth < minPlayerWidth) {
      playerWidth = minPlayerWidth;
      pointWidth = (state.originalPlayerWidth - playerWidth) / 2;
    }

    setScoutColumnWidth(playerHeader, playerWidth);

    // PP vises altid:
    // - VME aktiv: VIRM viser VME's PP-data.
    // - VME ikke aktiv: VIRM beregner og viser sin egen PP.
    const pp = ensureVirmScoutPpHeader(header, ageHeader, pointWidth, true);
    const kp = ensureVirmScoutKpHeader(header, ageHeader, pointWidth);
    if (pp) {
      pp.title = hasVmePp
        ? "PP-data aflæst fra VMEnhancer"
        : "Potentiale point beregnet af VIRM";
    }

    // Samme rækkefølge med og uden VMEnhancer:
    // Spiller · Alder · Vurdering · PP · KP · ...
    const ratingHeader = header.querySelector(".rating")
      || Array.from(header.children).find(cell =>
        ["vurdering", "rating"].includes(normalizeKey(cell.textContent))
      );

    if (ratingHeader) {
      if (kp.previousElementSibling !== pp || pp?.previousElementSibling !== ratingHeader) {
        ratingHeader.insertAdjacentElement("afterend", kp);
        ratingHeader.insertAdjacentElement("afterend", pp);
      }
    } else {
      if (kp.nextElementSibling !== ageHeader) header.insertBefore(kp, ageHeader);
      if (pp && pp.nextElementSibling !== kp) header.insertBefore(pp, kp);
    }

    // Når VMEnhancer leverer PP, vises et diskret info-ikon ved PP.
    // Uden VME vises intet ikon.
    ensureScoutVmePpInfo(pp, hasVmePp);

    table.classList.add("virm-scout-kp-table", "virm-scout-owned-points");
    table.classList.toggle("virm-scout-with-vmenhancer-pp", hasVmePp);
    table.style.setProperty("--virm-scout-table-width", `${state.tableWidth}px`);
    table.style.setProperty("--virm-scout-player-width", `${playerWidth}px`);
    table.style.setProperty("--virm-scout-point-width", `${pointWidth}px`);
    table.style.setProperty("--virm-scout-kp-width", `${pointWidth}px`);

    // Ingen geometriske transforms/feedback længere. VIRM ejer nu cellerne selv.
    table.style.setProperty("--virm-scout-kp-shift", "0px");
    table.style.setProperty("--virm-scout-kp-header-adjust", "0px");
    table.style.setProperty("--virm-scout-kp-row-y-adjust", "0px");

    const cells = Array.from(header.children);
    table.dataset.virmScoutSourcePpIndex = sourceHeader ? String(cells.indexOf(sourceHeader)) : "-1";
    table.dataset.virmScoutAgeIndex = String(cells.indexOf(ageHeader));

    return true;
  }

  function ensureScoutPointsRow(row) {
    if (!(row instanceof HTMLTableRowElement)) return;

    const playerLink = row.querySelector('a[href*="/players/"]');
    if (!playerLink) return;

    const table = row.closest("table");
    const header = headerRowForTable(table);
    if (!table || !header) return;

    const state = table.__virmScoutLayoutState;
    if (!state) return;

    const playerCell = row.querySelector("td.player") || playerLink.closest("td");
    const playerWidth = Number(table.style.getPropertyValue("--virm-scout-player-width").replace("px", "")) || 0;
    const pointWidth = Number(table.style.getPropertyValue("--virm-scout-point-width").replace("px", "")) || 0;
    if (!(playerWidth > 0 && pointWidth > 0)) return;

    setScoutColumnWidth(playerCell, playerWidth);

    // Fjern gamle VIRM-markedsceller fra tidligere builds.
    for (const cell of Array.from(row.children)) {
      if (
        cell.classList.contains("virm-market-pp")
        || cell.classList.contains("virm-market-kp")
        || cell.classList.contains("virm-roster-pp")
        || cell.classList.contains("virm-roster-kp")
      ) {
        cell.remove();
      }
    }

    const sourceIndex = Number(table.dataset.virmScoutSourcePpIndex);
    let sourceCell = state.hasVmePp
      ? row.querySelector("td.virm-vme-pp-source")
      : null;

    if (!sourceCell && state.hasVmePp && Number.isInteger(sourceIndex) && sourceIndex >= 0) {
      const candidate = row.children[sourceIndex] || null;
      if (
        candidate
        && !candidate.classList.contains("virm-scout-pp")
        && !candidate.classList.contains("virm-scout-kp")
      ) {
        sourceCell = candidate;
        sourceCell.classList.add("virm-vme-pp-source");
        sourceCell.setAttribute("aria-hidden", "true");
      }
    }

    const headerCells = Array.from(header.children);
    const ageHeader = header.querySelector(".age")
      || headerCells.find(cell => ["alder", "age"].includes(normalizeKey(cell.textContent)));
    const ageIndex = ageHeader ? headerCells.indexOf(ageHeader) : -1;

    let ageCell = row.querySelector("td.age");
    if (!ageCell && ageIndex >= 0) ageCell = row.children[ageIndex] || null;
    if (!ageCell) return;

    let pp = row.querySelector("td.virm-scout-pp");
    if (!pp) {
      pp = document.createElement("td");
      pp.className = "virm-scout-pp";
      pp.textContent = "…";
    }
    setScoutColumnWidth(pp, pointWidth);

    let kp = row.querySelector("td.virm-scout-kp");
    const kpWasReady = Boolean(kp) && row.dataset.virmScoutKpState === "ready";
    if (!kp) {
      kp = document.createElement("td");
      kp.className = "virm-scout-kp";
      kp.innerHTML = '<span class="virm-scout-kp-content">…</span>';
    } else if (!kp.querySelector(".virm-scout-kp-content")) {
      const currentText = normalizeText(kp.textContent) || "…";
      kp.textContent = "";
      const span = document.createElement("span");
      span.className = "virm-scout-kp-content";
      span.textContent = currentText;
      kp.appendChild(span);
    }
    setScoutColumnWidth(kp, pointWidth);

    // Samme kolonnerækkefølge som headeren – også når VME leverer PP-data.
    const ratingCell = row.querySelector("td.rating")
      || Array.from(row.children).find(cell =>
        /rating/i.test(String(cell.className || ""))
      );

    if (ratingCell) {
      if (kp.previousElementSibling !== pp || pp?.previousElementSibling !== ratingCell) {
        ratingCell.insertAdjacentElement("afterend", kp);
        ratingCell.insertAdjacentElement("afterend", pp);
      }
    } else {
      if (kp.nextElementSibling !== ageCell) row.insertBefore(kp, ageCell);
      if (pp && pp.nextElementSibling !== kp) row.insertBefore(pp, kp);
    }

    if (sourceCell && pp) bindVmEnhancerPpSource(sourceCell, pp);

    const scoutPpSource = sourceCell ? "vme" : "virm";
    row.dataset.virmScoutPpSource = scoutPpSource;

    if (kpWasReady) {
      // Hvis siden skifter fra VME til ingen VME, skal VIRMs PP kunne udfyldes
      // fra cache uden at vente på en ny KP-beregning.
      if (scoutPpSource === "virm") {
        const readyData = marketRowData(row);
        const readyCached = readyData.id ? cachedSummary(readyData.id) : null;
        if (readyCached) {
          readyData.virmKpOnly = true;
          readyData.virmScoutPpSource = "virm";
          renderScoutKpResult(readyData, readyCached);
        }
      }
      return;
    }
    if (row.dataset.virmScoutKpState === "loading") return;

    const data = marketRowData(row);
    if (!data.id) {
      const kpContent = kp.querySelector(".virm-scout-kp-content") || kp;
      kpContent.textContent = "—";
      kp.title = "Spilleren kunne ikke identificeres.";
      row.dataset.virmScoutKpState = "error";
      return;
    }

    data.virmKpOnly = true;
    data.virmScoutPpSource = scoutPpSource;
    row.dataset.virmScoutKpState = "loading";

    const cached = cachedSummary(data.id);
    if (cached) {
      renderScoutKpResult(data, cached);
      row.dataset.virmScoutKpState = "ready";
    } else {
      enqueue(data);
    }
  }

  function ensureScoutReportKp() {
    for (const table of scoutReportTablesForKp()) {
      if (!ensureScoutPointsHeader(table)) continue;
      for (const row of table.querySelectorAll("tbody tr")) ensureScoutPointsRow(row);
    }
  }

  function rosterTablesForPoints() {
    if (!rosterPlayersPage) return [];

    return Array.from(document.querySelectorAll("#content table")).filter(table => {
      const header = table.querySelector("thead tr");
      if (!header) return false;

      const hasCoreHeaders =
        Boolean(header.querySelector("th.name"))
        && Boolean(header.querySelector("th.position"))
        && Boolean(header.querySelector("th.age"))
        && Boolean(header.querySelector("th.rating"));

      const hasPlayers = Boolean(
        table.querySelector('tbody tr.player td.name a[href*="/players/"]')
        || table.querySelector('tbody tr.player a[href*="/players/"]')
      );

      return hasCoreHeaders && hasPlayers;
    });
  }

  function setFixedColumnWidth(element, widthPx) {
    if (!element || !(widthPx > 0)) return;
    const value = `${widthPx}px`;
    element.style.setProperty("box-sizing", "border-box", "important");
    element.style.setProperty("width", value, "important");
    element.style.setProperty("min-width", value, "important");
    element.style.setProperty("max-width", value, "important");
  }

  function rosterMoveHeader(header) {
    return header.querySelector('th[class*="move_"]')
      || Array.from(header.children).find(cell => ["flyt", "move"].includes(normalizeKey(cell.textContent)))
      || null;
  }

  function rosterMoveCell(row, moveHeader) {
    if (!moveHeader) return null;

    const classNames = Array.from(moveHeader.classList || []);
    for (const className of classNames) {
      const cell = row.querySelector(`td.${CSS.escape(className)}`);
      if (cell) return cell;
    }

    return Array.from(row.children).find(cell =>
      /move_/i.test(String(cell.className || ""))
    ) || null;
  }

  let clubRosterStableBaseline = null;

  function nativeRosterHeaderCells(header) {
    return Array.from(header?.children || []).filter(cell =>
      !cell.classList.contains("virm-roster-pp")
      && !cell.classList.contains("virm-roster-kp")
      && !cell.classList.contains("virm-market-pp")
      && !cell.classList.contains("virm-market-kp")
    );
  }

  function rosterHeaderIdentity(cell) {
    const classes = Array.from(cell?.classList || [])
      .filter(className => !/^virm-/i.test(className))
      .sort();
    if (classes.length) return classes.join(".");
    return normalizeKey(cell?.textContent || "");
  }

  function rosterHeaderStructure(cells) {
    return cells.map(rosterHeaderIdentity).join("|");
  }

  function originalRosterHeaderWidths(table, header) {
    const cached = table.__virmRosterOriginalWidths;
    const cachedStillMatches = cached
      && cached.widths?.length
      && cached.widths.every(item =>
        item.cell?.isConnected
        && item.cell.closest("table") === table
      );

    if (cachedStillMatches) return cached;

    const cells = nativeRosterHeaderCells(header);
    const structure = rosterHeaderStructure(cells);

    // På klubspillersiden kan VMAN erstatte hele headeren/tabellen ved
    // "Filtrér efter hold". Genbrug da den første stabile native måling,
    // i stedet for at måle under den midlertidige rerender.
    if (
      clubPlayersPage
      && clubRosterStableBaseline
      && clubRosterStableBaseline.structure === structure
      && clubRosterStableBaseline.widths.length === cells.length
    ) {
      const restored = {
        tableWidth: clubRosterStableBaseline.tableWidth,
        widths: cells.map((cell, index) => ({
          cell,
          width: clubRosterStableBaseline.widths[index],
          classNames: Array.from(cell.classList || []),
        })),
      };
      table.__virmRosterOriginalWidths = restored;
      return restored;
    }

    const widths = cells.map(cell => ({
      cell,
      width: cell.getBoundingClientRect().width || 0,
      classNames: Array.from(cell.classList || []),
    }));

    const measured = {
      tableWidth: table.getBoundingClientRect().width || 0,
      widths,
    };

    // Gem kun en reel, stabil førstegangs-måling.
    if (
      clubPlayersPage
      && measured.tableWidth > 0
      && widths.length
      && widths.every(item => item.width > 0)
    ) {
      clubRosterStableBaseline = {
        structure,
        tableWidth: measured.tableWidth,
        widths: widths.map(item => item.width),
      };
    }

    table.__virmRosterOriginalWidths = measured;
    return measured;
  }

  function ensureRosterHeader(table) {
    const header = table?.querySelector("thead tr");
    if (!header) return false;

    const name = header.querySelector("th.name");
    const rating = header.querySelector("th.rating");
    if (!name || !rating) return false;

    const transfer = header.querySelector("th.transfer_status");
    const move = rosterMoveHeader(header);
    const original = originalRosterHeaderWidths(table, header);
    const tableWidth = original.tableWidth || table.getBoundingClientRect().width;
    if (!(tableWidth > 0)) return false;

    const widthFor = cell => original.widths.find(item => item.cell === cell)?.width || cell?.getBoundingClientRect().width || 0;
    const originalNameWidth = widthFor(name);
    const nameWidth = originalNameWidth * (5 / 6);
    const transferWidth = transfer ? widthFor(transfer) * 0.80 : 0;

    // De eksisterende "små" kolonner, der skal have samme bredde som PP/KP.
    const commonHeaders = [
      header.querySelector("th.position"),
      header.querySelector("th.age"),
      header.querySelector("th.nationality"),
      header.querySelector("th.jersey_number"),
      rating,
      move,
    ].filter(Boolean);

    const commonSet = new Set(commonHeaders);
    const reservedHeaders = original.widths.filter(item =>
      item.cell !== name
      && item.cell !== transfer
      && !commonSet.has(item.cell)
    );

    const reservedWidth = nameWidth
      + transferWidth
      + reservedHeaders.reduce((sum, item) => sum + item.width, 0);

    // PP og KP er to nye kolonner. Den samlede tabelbredde skal være præcis som før.
    const commonColumnCount = commonHeaders.length + 2;
    const commonWidth = Math.max(1, (tableWidth - reservedWidth) / commonColumnCount);

    setFixedColumnWidth(name, nameWidth);
    if (transfer) setFixedColumnWidth(transfer, transferWidth);
    for (const item of reservedHeaders) setFixedColumnWidth(item.cell, item.width);
    for (const cell of commonHeaders) setFixedColumnWidth(cell, commonWidth);

    rating.textContent = "VT";
    rating.title = "Vurderingstal";

    let pp = header.querySelector("th.virm-roster-pp");
    let kp = header.querySelector("th.virm-roster-kp");

    if (!pp) {
      pp = document.createElement("th");
      pp.className = "virm-roster-pp";
      pp.textContent = "PP";
      pp.title = "Potentiale point";
      rating.insertAdjacentElement("afterend", pp);
    }

    if (!kp) {
      kp = document.createElement("th");
      kp.className = "virm-roster-kp";
      kp.textContent = "KP";
      kp.title = "Karriere-point";
      pp.insertAdjacentElement("afterend", kp);
    }

    setFixedColumnWidth(pp, commonWidth);
    setFixedColumnWidth(kp, commonWidth);

    table.classList.add("virm-roster-points-table");
    table.style.setProperty("--virm-roster-table-width", `${tableWidth}px`);
    table.style.setProperty("--virm-roster-name-width", `${nameWidth}px`);
    table.style.setProperty("--virm-roster-transfer-width", `${transferWidth}px`);
    table.style.setProperty("--virm-roster-common-width", `${commonWidth}px`);

    // Gem klasselisten for de oprindelige fælles kolonner, så rækkerne følger headeren.
    table.__virmRosterCommonClasses = commonHeaders.map(cell =>
      Array.from(cell.classList || []).find(className =>
        ["position", "age", "nationality", "jersey_number", "rating"].includes(className)
        || /^move_/i.test(className)
      )
    ).filter(Boolean);

    return true;
  }

  function ensureRosterRow(row) {
    if (!(row instanceof HTMLTableRowElement) || !row.classList.contains("player")) return;

    const table = row.closest("table");
    const rating = row.querySelector("td.rating");
    if (!table || !rating) return;

    const name = row.querySelector("td.name");
    const transfer = row.querySelector("td.transfer_status");
    const moveHeader = table.querySelector('thead th[class*="move_"]')
      || Array.from(table.querySelectorAll("thead th")).find(cell => ["flyt", "move"].includes(normalizeKey(cell.textContent)));
    const move = rosterMoveCell(row, moveHeader);

    const nameWidth = Number(table.style.getPropertyValue("--virm-roster-name-width").replace("px", "")) || 0;
    const transferWidth = Number(table.style.getPropertyValue("--virm-roster-transfer-width").replace("px", "")) || 0;
    const commonWidth = Number(table.style.getPropertyValue("--virm-roster-common-width").replace("px", "")) || 0;

    setFixedColumnWidth(name, nameWidth);
    if (transfer && transferWidth > 0) setFixedColumnWidth(transfer, transferWidth);

    for (const className of table.__virmRosterCommonClasses || []) {
      const cell = row.querySelector(`td.${CSS.escape(className)}`);
      if (cell) setFixedColumnWidth(cell, commonWidth);
    }
    if (move) setFixedColumnWidth(move, commonWidth);
    setFixedColumnWidth(rating, commonWidth);

    let pp = row.querySelector("td.virm-market-pp");
    let kp = row.querySelector("td.virm-market-kp");

    if (!pp) {
      pp = document.createElement("td");
      pp.className = "virm-market-pp virm-roster-pp";
      pp.textContent = "…";
      rating.insertAdjacentElement("afterend", pp);
    }

    if (!kp) {
      kp = document.createElement("td");
      kp.className = "virm-market-kp virm-roster-kp";
      kp.textContent = "…";
      pp.insertAdjacentElement("afterend", kp);
    }

    setFixedColumnWidth(pp, commonWidth);
    setFixedColumnWidth(kp, commonWidth);

    const data = marketRowData(row);
    if (!data.id) {
      renderError(data, new Error("Spilleren kunne ikke identificeres."));
      return;
    }

    if (!row.dataset.virmMarketRatingState) row.dataset.virmMarketRatingState = "loading";
    const cached = cachedSummary(data.id);
    if (cached) renderResult(data, cached);
    else enqueue(data);
  }

  function ensureRosterPoints() {
    for (const table of rosterTablesForPoints()) {
      if (!ensureRosterHeader(table)) continue;
      for (const row of table.querySelectorAll("tbody tr.player")) ensureRosterRow(row);
    }
  }

  function scan() {
    const playerCells = Array.from(document.querySelectorAll('#content td.player, td.player'))
      .filter(cell => cell.querySelector('a[href*="/players/"]'));
    const candidateTables = new Set(playerCells.map(cell => cell.closest("table")).filter(Boolean));
    const tables = new Set(Array.from(candidateTables).filter(tableLooksLikePlayerMarket));
    for (const table of tables) markTable(table);

    if (tables.size) ensurePpSortOption();
    if (ppSortActive) for (const table of tables) sortTableByPp(table);

    ensurePlayerPagePoints();
    ensureRosterPoints();
    ensureScoutReportKp();
  }

  let scanTimer = 0;
  function scheduleScan() {
    clearTimeout(scanTimer);
    scanTimer = window.setTimeout(scan, 80);
  }

  async function globalDataRequestsDisabled() {
    try {
      const current = await dataRequestApi?.getState?.();
      return Boolean(current?.globalDisabled);
    } catch (_) {
      return Boolean(dataRequestApi?.isGlobalDisabledSync?.());
    }
  }

  async function boot() {
    if (await globalDataRequestsDisabled()) {
      // Udviklingsprognosen er undtaget fra global deaktivering og bruger
      // #virm-player-career-points som host. På spillersider under 28 år
      // må den skjulte PP-beregning fortsat levere XP-grundlaget til selve
      // prognosen, men PP/KP-elementerne er skjult og der oprettes ingen
      // kolonner eller øvrige pointspor.
      if (playerPageMatch) {
        ensureLegacyPlayerPointsCard();
        const age = parsePrecisePlayerAge(document);
        if (!Number.isFinite(age) || age < 28) await ensurePlayerPagePoints();
      }
      return;
    }
    scan();
    const observer = new MutationObserver(scheduleScan);
    observer.observe(document.documentElement, { childList: true, subtree: true });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", () => { boot().catch(() => {}); }, { once: true });
  else boot().catch(() => {});
})();

})();


// 0.1.174: fjern kun etiketten “Detaljer” i talentspejderrapporter.
(() => {
  "use strict";

  const path = String(window.location.pathname || "").replace(/\/+$/, "") || "/";
  if (!/^\/(?:[a-z]{2}\/)?new_scout_reports\/\d+$/i.test(path)) return;
  if (window.__VIRM_SCOUT_REPORT_DETAILS_01113__) return;
  window.__VIRM_SCOUT_REPORT_DETAILS_01113__ = true;

  function normalized(value) {
    return String(value || "").replace(/\s+/g, " ").trim().toLocaleLowerCase("da");
  }

  function removeDetailsLabel() {
    const root = document.querySelector("#content") || document.body;
    if (!root) return;

    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const matches = [];
    while (walker.nextNode()) {
      const node = walker.currentNode;
      const key = normalized(node.nodeValue);
      if (key === "detaljer" || key === "details") matches.push(node);
    }

    for (const node of matches) {
      const parent = node.parentElement;
      if (!parent) continue;

      const parentKey = normalized(parent.textContent);
      const headingLike = parent.matches("h1,h2,h3,h4,h5,h6,legend,.headline,.heading,.title");
      if (headingLike && (parentKey === "detaljer" || parentKey === "details")) {
        parent.remove();
      } else {
        node.nodeValue = "";
      }
    }
  }

  function refreshScoutReport() {
    removeDetailsLabel();
  }

  async function boot() {
    const guard = window.__VIRM_DATA_REQUESTS_V1__;
    const current = await guard?.getState?.();
    if (current?.globalDisabled) return;
    refreshScoutReport();
    const observer = new MutationObserver(refreshScoutReport);
    observer.observe(document.documentElement, { childList: true, subtree: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => { boot().catch(() => {}); }, { once: true });
  } else {
    boot().catch(() => {});
  }
})();



