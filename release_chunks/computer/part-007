      const empty = document.createElement("div");
      empty.className = "virm-scenario-player-empty";
      empty.textContent = "Gruppen indeholder ingen indlæste spillere.";
      refs.editor.appendChild(empty);
      return;
    }

    const scenario = program.scenario || scenarioFromPlayers(data, program.position);
    if (!scenario) return;
    if (!program.scenario) program.scenario = scenario;

    const players = [...data.players].sort((left, right) => normalizeText(left.name).localeCompare(normalizeText(right.name), "da"));
    let selectedIds = new Set(scenarioIncludedPlayers(data, scenario).map(scenarioPlayerIdentity).filter(Boolean));
    if (!selectedIds.size) selectedIds = new Set(players.map(scenarioPlayerIdentity).filter(Boolean));

    const intro = document.createElement("div");
    intro.className = "virm-scenario-player-intro";
    intro.textContent = "Vælg de spillere, der skal bidrage til scenariets gennemsnitsværdier.";

    const toolbar = document.createElement("div");
    toolbar.className = "virm-scenario-player-toolbar";
    const count = document.createElement("strong");
    const selectAll = document.createElement("button");
    selectAll.type = "button";
    selectAll.className = "virm-small-button";
    selectAll.textContent = "Vælg alle";
    toolbar.append(count, selectAll);

    const list = document.createElement("div");
    list.className = "virm-scenario-player-list";

    function playerMeta(player) {
      const age = agePartsFromDecimal(Number(player.age));
      const ageText = Number.isFinite(Number(player.age)) ? `${age.years} år ${age.days} dage` : "Alder ukendt";
      const ratingText = Number.isFinite(Number(player.rating)) ? `VT ${formatDanishNumber(Number(player.rating))}` : "VT -";
      return `${normalizeText(player.specificPosition) || normalizeText(player.position) || program.position} · ${ageText} · ${ratingText}`;
    }

    function updateCount() {
      count.textContent = `${selectedIds.size} af ${players.length} valgt`;
      selectAll.disabled = selectedIds.size === players.length;
    }

    function applySelection() {
      const ids = players.map(scenarioPlayerIdentity).filter((id) => selectedIds.has(id));
      const nextScenario = scenarioFromPlayers(data, program.scenario && program.scenario.position || program.position, ids, program.scenario);
      if (!nextScenario) return;
      program.scenario = nextScenario;
      scheduleSave();
      renderPlayerResultLine();
      updateCount();
    }

    for (const player of players) {
      const id = scenarioPlayerIdentity(player);
      if (!id) continue;
      const row = document.createElement("label");
      row.className = "virm-scenario-player-row";
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = selectedIds.has(id);
      checkbox.setAttribute("aria-label", `Medtag ${normalizeText(player.name) || "spiller"}`);
      const textBox = document.createElement("span");
      textBox.className = "virm-scenario-player-text";
      const name = document.createElement("strong");
      name.textContent = normalizeText(player.name) || "Ukendt spiller";
      const meta = document.createElement("small");
      meta.textContent = playerMeta(player);
      textBox.append(name, meta);
      row.append(checkbox, textBox);
      checkbox.addEventListener("change", () => {
        if (checkbox.checked) {
          selectedIds.add(id);
        } else if (selectedIds.size <= 1) {
          checkbox.checked = true;
          showToast("Mindst én spiller skal indgå i scenariet.");
          return;
        } else {
          selectedIds.delete(id);
        }
        applySelection();
      });
      list.appendChild(row);
    }

    selectAll.addEventListener("click", () => {
      selectedIds = new Set(players.map(scenarioPlayerIdentity).filter(Boolean));
      list.querySelectorAll('input[type="checkbox"]').forEach((checkbox) => { checkbox.checked = true; });
      applySelection();
    });

    updateCount();
    refs.editor.append(intro, toolbar, list);
  }

  function renderScenarioEditor(readOnly = false) {
    const program = activeProgram();
    refs.editor.appendChild(createEditorTitle(readOnly ? "Resultat" : "Scenario", closeScenarioEditor));
    const data = groupPlayerData.get(state.activeGroupId);
    if (!program.scenario) {
      const fromPlayers = scenarioFromPlayers(data, program.position);
      if (fromPlayers) {
        program.scenario = fromPlayers;
        scheduleSave();
        renderPlayerResultLine();
      }
    }
    if (!program.scenario) {
      const empty = document.createElement("div");
      empty.className = "virm-scenario-empty";
      const message = document.createElement("p");
      message.textContent = !data || data.status === "loading"
        ? "Henter spillerdata fra gruppen…"
        : "Gruppen indeholder ingen indlæste spillere.";
      const manual = document.createElement("button");
      manual.type = "button";
      manual.className = "virm-button primary";
      manual.textContent = readOnly ? "Åbn Scenario" : "Manuel indtastning";
      manual.addEventListener("click", () => {
        if (readOnly) {
          openScenarioEditor();
          return;
        }
        program.scenario = manualScenario(program.position);
        scheduleSave();
        renderPlayerResultLine();
        renderEditor();
      });
      empty.append(message, manual);
      refs.editor.appendChild(empty);
      return;
    }

    const scenario = readOnly ? scenarioResultForProgram(program) : program.scenario;
    if (!scenario) {
      const empty = document.createElement("div");
      empty.className = "virm-scenario-empty";
      const message = document.createElement("p");
      message.textContent = "Resultatet kunne ikke beregnes ud fra det aktuelle scenario og træningsprogram.";
      const open = document.createElement("button");
      open.type = "button";
      open.className = "virm-button primary";
      open.textContent = "Åbn Scenario";
      open.addEventListener("click", openScenarioEditor);
      empty.append(message, open);
      refs.editor.appendChild(empty);
      return;
    }
    const source = document.createElement("div");
    source.className = "virm-scenario-source";
    if (readOnly) {
      const start = program.scenario;
      source.textContent = `${formatDanishDayCount(programTotalDays(program))} · Alder ${start.ageYears} år ${start.ageDays} dage → ${scenario.ageYears} år ${scenario.ageDays} dage · felterne er låst`;
    } else if (scenario.source === "manual") {
      source.textContent = "Manuelt scenario";
    } else {
      const contributors = scenarioIncludedPlayers(data, scenario);
      const totalPlayers = data && Array.isArray(data.players) ? data.players.length : contributors.length;
      source.textContent = contributors.length && contributors.length < totalPlayers
        ? `Gennemsnit af ${contributors.length}/${totalPlayers} spillere – felterne kan redigeres`
        : "Gruppens gennemsnit – felterne kan redigeres";
    }
    refs.editor.appendChild(source);

    const controls = document.createElement("div");
    controls.className = "virm-scenario-controls";
    const positionSelect = document.createElement("select");
    for (const position of Object.keys(POSITION_STATS)) {
      const option = document.createElement("option");
      option.value = position;
      option.textContent = position;
      option.selected = position === scenario.position;
      positionSelect.appendChild(option);
    }
    const ageYears = document.createElement("input");
    ageYears.type = "number";
    ageYears.min = "15";
    ageYears.max = "40";
    ageYears.step = "1";
    ageYears.value = String(scenario.ageYears);
    const ageDays = document.createElement("input");
    ageDays.type = "number";
    ageDays.min = "0";
    ageDays.max = "29";
    ageDays.step = "1";
    ageDays.value = String(scenario.ageDays);
    const xp = document.createElement("input");
    xp.type = "number";
    xp.min = "0";
    xp.max = "999";
    xp.step = "1";
    xp.value = String(scenario.xp);
    const referenceIntensity = document.createElement("select");
    for (const intensity of Object.keys(INTENSITIES)) {
      const option = document.createElement("option");
      option.value = intensity;
      option.textContent = intensity;
      option.selected = intensity === scenario.referenceIntensity;
      referenceIntensity.appendChild(option);
    }
    controls.append(
      editorField("Position", positionSelect),
      editorField("År", ageYears),
      editorField("Dage", ageDays),
    );
    const xpRow = document.createElement("div");
    xpRow.className = "virm-scenario-xp-row";
    const xpText = document.createElement("span");
    xpText.textContent = "XP";
    const atText = document.createElement("span");
    atText.textContent = "ved";
    const intensityText = document.createElement("span");
    intensityText.textContent = "intensitet";
    xp.setAttribute("aria-label", "XP");
    referenceIntensity.setAttribute("aria-label", "XP ved intensitet");
    positionSelect.disabled = readOnly;
    ageYears.disabled = readOnly;
    ageDays.disabled = readOnly;
    xp.disabled = readOnly;
    referenceIntensity.disabled = readOnly;
    xpRow.append(xpText, xp, atText, referenceIntensity, intensityText);
    refs.editor.append(controls, xpRow);

    function updateScenarioValue(key, value) {
      scenario[key] = value;
      scheduleSave();
      renderPlayerResultLine();
    }
    if (!readOnly) {
      positionSelect.addEventListener("change", () => {
        const nextPosition = positionSelect.value;
        const previousStats = scenario.stats;
        scenario.position = nextPosition;
        scenario.stats = Object.fromEntries(POSITION_STATS[nextPosition].map((stat) => [stat, Number.isFinite(previousStats[stat]) ? previousStats[stat] : 2]));
        scheduleSave();
        renderPlayerResultLine();
        renderEditor();
      });
      const numberBindings = [
        [ageYears, "ageYears", 15, 40],
        [ageDays, "ageDays", 0, 29],
        [xp, "xp", 0, 999],
      ];
      for (const [input, key, minimum, maximum] of numberBindings) {
        bindNumberWheel(input, { minimum, maximum, step: 1 });
        input.addEventListener("input", () => updateScenarioValue(key, clamp(Math.round(Number(input.value) || minimum), minimum, maximum)));
        input.addEventListener("change", () => {
          input.value = String(clamp(Math.round(Number(input.value) || minimum), minimum, maximum));
          updateScenarioValue(key, Number(input.value));
        });
      }
      referenceIntensity.addEventListener("change", () => updateScenarioValue("referenceIntensity", referenceIntensity.value));
    }

    const statBox = document.createElement("div");
    statBox.className = "virm-scenario-stats";
    const statHeading = document.createElement("div");
    statHeading.className = "virm-scenario-stats-title";
    statHeading.textContent = "Egenskaber";
    statBox.appendChild(statHeading);
    const summary = document.createElement("div");
    summary.className = "virm-scenario-summary";
    const ratingSummary = document.createElement("span");
    const totalSummary = document.createElement("span");
    const playerSelectionButton = document.createElement("button");
    playerSelectionButton.type = "button";
    playerSelectionButton.className = "virm-scenario-player-button";
    const playerSelectionIcon = document.createElement("span");
    playerSelectionIcon.className = "virm-scenario-player-button-icon";
    playerSelectionIcon.setAttribute("aria-hidden", "true");
    playerSelectionIcon.innerHTML = '<svg viewBox="0 0 16 16" focusable="false"><path fill="currentColor" d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/></svg>';
    playerSelectionButton.appendChild(playerSelectionIcon);
    playerSelectionButton.title = "Vælg spillere til gennemsnittet";
    playerSelectionButton.setAttribute("aria-label", "Vælg spillere til gennemsnittet");
    playerSelectionButton.disabled = readOnly || !data || data.status !== "ready" || !Array.isArray(data.players) || !data.players.length;
    if (!readOnly) {
      playerSelectionButton.addEventListener("click", () => {
        editorState = { type: "scenario-players" };
        renderEditor();
      });
    }
    summary.append(ratingSummary, totalSummary, playerSelectionButton);

    function updateScenarioSummary() {
      const rating = calculateRating(scenario.stats, scenario.position);
      const total = Object.values(scenario.stats).reduce((sum, value) => sum + Number(value || 0), 0);
      ratingSummary.textContent = `Vurderingstal: ${formatDanishNumber(rating)}`;
      totalSummary.textContent = `Egenskabssum: ${readOnly ? Math.round(total) : total}`;
    }
    for (const stat of POSITION_STATS[scenario.position]) {
      const input = document.createElement("input");
      input.type = "number";
      input.min = "0";
      input.max = "100";
      input.step = "1";
      input.value = readOnly ? String(Math.round(Number(scenario.stats[stat]))) : String(scenario.stats[stat]);
      input.disabled = readOnly;
      if (!readOnly) {
        bindNumberWheel(input, { minimum: 0, maximum: 100, step: 1 });
        input.addEventListener("input", () => {
          scenario.stats[stat] = clamp(Math.round(Number(input.value) || 0), 0, 100);
          scheduleSave();
          renderPlayerResultLine();
          updateScenarioSummary();
        });
        input.addEventListener("change", () => {
          input.value = String(clamp(Math.round(Number(input.value) || 0), 0, 100));
          scenario.stats[stat] = Number(input.value);
          scheduleSave();
          renderPlayerResultLine();
          updateScenarioSummary();
        });
      }
      statBox.appendChild(editorField(stat, input));
    }
    statBox.appendChild(summary);
    updateScenarioSummary();
    refs.editor.appendChild(statBox);
  }

  function phaseForEditor() {
    const program = activeProgram();
    if (editorState.type === "phase") {
      return program.sessions.find((item) => item.id === editorState.itemId) || null;
    }
    if (editorState.type === "phase-block") {
      const block = program.sessions.find((item) => item.id === editorState.parentBlockId && item.type === "block");
      return block ? block.phases.find((phase) => phase.id === editorState.phaseId) || null : null;
    }
    return null;
  }

  function editorField(labelText, control) {
    const label = document.createElement("label");
    label.className = "virm-field";
    const text = document.createElement("span");
    text.textContent = labelText;
    label.append(text, control);
    return label;
  }

  function renderPhaseEditor() {
    const existing = phaseForEditor();
    const position = activeProgram().position;
    const isNew = !existing;
    const draftKey = currentEditorDraftKey();
    const matchingDraft = editorDraft && editorDraft.key === draftKey ? editorDraft : null;
    const phase = matchingDraft || existing || {
      days: 2,
      exercise: "Intervaltræning",
      exerciseTypeCode: 1,
      trainingPoints: 23,
      distribution: null,
    };
    if (matchingDraft) {
      currentDistribution = deepClone(matchingDraft.distribution || {});
      distributionEditOrder = Array.from(matchingDraft.editOrder || matchingDraft.lockedStats || []);
      distributionRequestedValues = deepClone(matchingDraft.requestedValues || {});
    }

    let title = "Ny session";
    if (editorState.type === "phase") title = "Redigér session";
    if (editorState.type === "phase-block") title = "Redigér session i blok";
    if (editorState.type === "phase-new-block") title = "Ny session i blok";
    const nestedBlockId = ["phase-block", "phase-new-block"].includes(editorState.type)
      ? editorState.parentBlockId
      : null;
    const returnToBlock = nestedBlockId
      ? () => openBlockEditor(nestedBlockId)
      : null;
    refs.editor.appendChild(createEditorTitle(title, returnToBlock));

    const fields = document.createElement("div");
    fields.className = "virm-editor-fields";

    const daysInput = document.createElement("input");
    daysInput.type = "number";
    daysInput.min = "1";
    daysInput.max = "9999";
    daysInput.step = "1";
    daysInput.value = String(phase.days || 1);
    bindNumberWheel(daysInput, {
      minimum: 1,
      maximum: 9999,
      step: 1,
    });

    const exerciseSelect = document.createElement("select");
    const selectedDefinition = exerciseDefinitionForPhase(phase, position);
    for (const group of EDITOR_EXERCISE_GROUPS) {
      const optgroup = document.createElement("optgroup");
      optgroup.label = group.label;
      for (const definition of EDITOR_EXERCISES.filter((exercise) => exercise.audience === group.audience)) {
        const option = document.createElement("option");
        option.value = String(definition.code);
        option.textContent = definition.label;
        option.selected = definition.code === selectedDefinition.code;
        optgroup.appendChild(option);
      }
      exerciseSelect.appendChild(optgroup);
    }

    const intensitySelect = document.createElement("select");
    for (const [intensityName, trainingPoints] of Object.entries(INTENSITIES)) {
      const option = document.createElement("option");
      option.value = String(trainingPoints);
      option.textContent = intensityName;
      option.selected = trainingPoints === Number(phase.trainingPoints || 23);
      intensitySelect.appendChild(option);
    }

    fields.append(
      editorField("Dage", daysInput),
      editorField("Øvelse", exerciseSelect),
      editorField("Intensitet", intensitySelect),
    );
    refs.editor.appendChild(fields);

    const distributionContainer = document.createElement("div");
    refs.editor.appendChild(distributionContainer);

    function ensureCurrentDistribution() {
      const definition = EDITOR_EXERCISE_BY_CODE.get(Number(exerciseSelect.value));
      const target = Number(intensitySelect.value);
      if (definition.code === 0) {
        currentDistribution = {};
        resetDistributionPriorities();
        return;
      }
      const expectedStats = definition.stats;
      const matchingStats = Object.keys(currentDistribution).length === expectedStats.length
        && expectedStats.every((stat) => Object.hasOwn(currentDistribution, stat));
      if (!matchingStats) {
        currentDistribution = balancedDistribution(expectedStats, target, phase.distribution);
        resetDistributionPriorities();
      } else if (Object.values(currentDistribution).reduce((sum, value) => sum + value, 0) !== target) {
        smartAutofillDistribution(target);
      }
    }

    function rememberDraft() {
      const definition = EDITOR_EXERCISE_BY_CODE.get(Number(exerciseSelect.value));
      editorDraft = {
        key: draftKey,
        days: Math.max(1, Math.round(Number(daysInput.value) || 1)),
        exercise: definition.name,
        exerciseTypeCode: definition.code,
        trainingPoints: Number(intensitySelect.value),
        distribution: definition.code === 0 ? null : deepClone(currentDistribution),
        editOrder: [...distributionEditOrder],
        requestedValues: deepClone(distributionRequestedValues),
      };
    }

    function refreshDistribution() {
      distributionContainer.replaceChildren();
      const definition = EDITOR_EXERCISE_BY_CODE.get(Number(exerciseSelect.value));
      const target = Number(intensitySelect.value);
      if (definition.code === 0) {
        const note = document.createElement("div");
        note.className = "virm-training-match-note";
        note.textContent = "Træningskamp fordeler automatisk træningen på alle egenskaber.";
        distributionContainer.appendChild(note);
        return;
      }

      ensureCurrentDistribution();
      const box = document.createElement("div");
      box.className = "virm-distribution";
      const head = document.createElement("div");
      head.className = "virm-distribution-head";
      const heading = document.createElement("span");
      heading.textContent = "Indsats";
      const reset = document.createElement("button");
      reset.type = "button";
      reset.className = "virm-distribution-reset";
      reset.textContent = "Nulstil";
      reset.addEventListener("click", () => {
        resetDistributionPriorities();
        currentDistribution = balancedDistribution(definition.stats, target, null);
        rememberDraft();
        refreshDistribution();
      });
      head.append(heading, reset);
      box.appendChild(head);

      const barViews = new Map();

      function drawDistributionBars() {
        for (const [stat, view] of barViews) {
          const value = currentDistribution[stat];
          view.bar.setAttribute("aria-valuenow", String(value));
          view.segments.forEach((segment, index) => {
            segment.classList.toggle("is-filled", index < value);
          });
        }
      }

      for (const stat of definition.stats) {
        const row = document.createElement("div");
        row.className = "virm-distribution-row";
        const name = document.createElement("div");
        name.className = "virm-stat-name";
        name.textContent = stat;
        name.title = stat;
        const bar = document.createElement("div");
        bar.className = "virm-point-bar";
        bar.setAttribute("role", "slider");
        bar.setAttribute("aria-label", stat);
        bar.setAttribute("aria-valuemin", "2");
        bar.setAttribute("aria-valuemax", "10");
        bar.setAttribute("aria-valuenow", String(currentDistribution[stat]));
        let activePointer = null;
        const segments = [];

        function applyPointerValue(event) {
          const point = distributionValueFromPointer(bar, event);
          if (point === null) return;
          if (setManualDistributionValue(stat, point, target)) {
            rememberDraft();
            drawDistributionBars();
          }
        }

        bar.addEventListener("pointerdown", (event) => {
          if (event.button !== undefined && event.button !== 0) return;
          event.preventDefault();
          activePointer = event.pointerId ?? "mouse";
          if (typeof bar.setPointerCapture === "function" && event.pointerId !== undefined) {
            try {
              bar.setPointerCapture(event.pointerId);
            } catch (_error) {
              // Pointer capture er en forbedring, men ikke nødvendig for klik.
            }
          }
          applyPointerValue(event);
        });
        bar.addEventListener("pointermove", (event) => {
          if (activePointer === null || activePointer !== (event.pointerId ?? "mouse")) return;
          applyPointerValue(event);
        });
        for (const eventName of ["pointerup", "pointercancel", "lostpointercapture"]) {
          bar.addEventListener(eventName, (event) => {
            if (activePointer === (event.pointerId ?? "mouse") || eventName === "lostpointercapture") {
              activePointer = null;
            }
          });
        }

        for (let point = 1; point <= 10; point += 1) {
          const segment = document.createElement("button");
          segment.type = "button";
          segment.className = "virm-point-segment";
          segment.classList.toggle("is-filled", point <= currentDistribution[stat]);
          segment.title = `${stat}: ${Math.max(2, point)}`;
          segment.setAttribute("aria-label", `Sæt ${stat} til ${Math.max(2, point)} point`);
          segment.addEventListener("click", () => {
            if (setManualDistributionValue(stat, point, target)) {
              rememberDraft();
              drawDistributionBars();
            }
          });
          segments.push(segment);
          bar.appendChild(segment);
        }
        barViews.set(stat, { bar, segments });
        row.append(name, bar);
        box.appendChild(row);
      }
      drawDistributionBars();
      distributionContainer.appendChild(box);
    }

    daysInput.addEventListener("input", rememberDraft);
    exerciseSelect.addEventListener("change", () => {
      currentDistribution = {};
      resetDistributionPriorities();
      ensureCurrentDistribution();
      rememberDraft();
      refreshDistribution();
    });
    intensitySelect.addEventListener("change", () => {
      smartAutofillDistribution(Number(intensitySelect.value));
      rememberDraft();
      refreshDistribution();
    });
    ensureCurrentDistribution();
    refreshDistribution();

    function phaseValueFromFields(id = uid("phase")) {
      const days = Math.max(1, Math.round(Number(daysInput.value) || 1));
      const definition = EDITOR_EXERCISE_BY_CODE.get(Number(exerciseSelect.value));
      const trainingPoints = Number(intensitySelect.value);
      return {
        id,
        type: "phase",
        days,
        exercise: definition.name,
        exerciseTypeCode: definition.code,
        trainingPoints,
        distribution: definition.code === 0 ? null : deepClone(currentDistribution),
      };
    }

    function phaseValueIsValid(phaseValue) {
      const total = phaseValue.distribution
        ? Object.values(phaseValue.distribution).reduce((sum, value) => sum + value, 0)
        : phaseValue.trainingPoints;
      if (total !== phaseValue.trainingPoints) {
        showToast(`Indsatsen skal give ${phaseValue.trainingPoints}.`);
        return false;
      }
      return true;
    }

    const actions = document.createElement("div");
    actions.className = "virm-editor-actions";

    const add = document.createElement("button");
    add.type = "button";
    add.className = "virm-button primary";
    add.textContent = nestedBlockId ? "Tilføj til blok" : "Tilføj til træningsprogram";
    add.addEventListener("click", () => {
      const phaseValue = phaseValueFromFields();
      if (!phaseValueIsValid(phaseValue)) return;
      commitChange(nestedBlockId ? "Tilføj session til blok" : "Tilføj session", () => {
        if (nestedBlockId) {
          const block = activeProgram().sessions.find((item) => item.id === nestedBlockId && item.type === "block");
          if (block) {
            block.phases.push(phaseValue);
            selectedIds = new Set([block.id]);
            editorState = { type: "block", itemId: block.id };
          }
        } else {
          activeProgram().sessions.push(phaseValue);
          selectedIds = new Set([phaseValue.id]);
          editorState = { type: "phase", itemId: phaseValue.id };
        }
      }, { keepEditor: true });
      showToast(nestedBlockId ? "Sessionen blev tilføjet til blokken." : "Sessionen blev tilføjet.");
    });

    const update = document.createElement("button");
    update.type = "button";
    update.className = "virm-button";
    update.textContent = "Opdatér";
    update.disabled = !existing;
    update.addEventListener("click", () => {
      if (update.disabled) return;
      const phaseValue = phaseValueFromFields(existing ? existing.id : uid("phase"));
      if (!phaseValueIsValid(phaseValue)) return;
      commitChange(existing ? "Opdatér session" : "Tilføj session til blok", () => {
        if (editorState.type === "phase") {
          const index = activeProgram().sessions.findIndex((item) => item.id === editorState.itemId);
          if (index >= 0) {
            activeProgram().sessions[index] = phaseValue;
            editorState = { type: "phase", itemId: phaseValue.id };
          }
        } else if (editorState.type === "phase-block") {
          const block = activeProgram().sessions.find((item) => item.id === editorState.parentBlockId && item.type === "block");
          const index = block ? block.phases.findIndex((item) => item.id === editorState.phaseId) : -1;
          if (block && index >= 0) {
            block.phases[index] = phaseValue;
            editorState = { type: "block", itemId: block.id };
          }
        }
      }, { keepEditor: true });
      showToast("Sessionen blev opdateret.");
    });
    actions.append(add, update);
    refs.editor.appendChild(actions);
  }

  function renderBlockEditor() {
    const block = activeProgram().sessions.find((item) => item.id === editorState.itemId && item.type === "block");
    if (!block) {
      closeEditor();
      return;
    }
    refs.editor.appendChild(createEditorTitle("Blok"));

    const controls = document.createElement("div");
    controls.className = "virm-block-controls";
    const nameInput = document.createElement("input");
    nameInput.type = "text";
    nameInput.maxLength = 60;
    nameInput.value = block.name;
    const repetitionsInput = document.createElement("input");
    repetitionsInput.type = "number";
    repetitionsInput.min = "1";
    repetitionsInput.max = "999";
    repetitionsInput.value = String(block.repetitions);
    controls.append(
      editorField("Navn", nameInput),
      editorField("Antal gentagelser", repetitionsInput),
    );
    refs.editor.appendChild(controls);

    const phaseList = document.createElement("div");
    phaseList.className = "virm-block-list";
    block.phases.forEach((phase, phaseIndex) => {
      const row = document.createElement("div");
      row.className = "virm-block-phase";
      row.title = distributionSummary(phase);
