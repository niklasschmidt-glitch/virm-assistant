      "Midfielder": "Midtbane",
      "Midfield": "Midtbane",
      "Forward": "Angreb",
      "Attack": "Angreb",
    };
    return POSITION_STATS[value] ? value : (aliases[value] || activeProgram().position);
  }

  function importedTeamPosition(value) {
    const normalized = normalizeText(value);
    if (!normalized) return null;
    if (POSITION_STATS[normalized]) return normalized;
    const lowered = normalized.toLocaleLowerCase("da");
    const aliases = {
      "mål": "Keepere",
      "målmand": "Keepere",
      "målmænd": "Keepere",
      "keeper": "Keepere",
      "keepere": "Keepere",
      "goalkeeper": "Keepere",
      "goalkeepers": "Keepere",
      "forsvar": "Forsvar",
