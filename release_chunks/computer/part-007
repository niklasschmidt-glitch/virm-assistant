  }

  function insertControl(descriptor) {
    if (descriptor.section.querySelector(`.${CONTROL_CLASS}`)) return true;
    const trainArea = descriptor.section.querySelector(".train_now") || descriptor.section;
    const form = trainArea.querySelector("form");
    const nativeButton = trainArea.querySelector('.training_button, input[type="submit"], button[type="submit"]');
    watchNativeTrainingAction(descriptor, form, nativeButton);
    const control = createControl(descriptor);
    if (form) {
      if (nativeButton?.parentNode === form) form.insertBefore(control, nativeButton);
      else form.prepend(control);
    } else if (nativeButton?.parentNode) {
      nativeButton.parentNode.insertBefore(control, nativeButton);
    } else {
      trainArea.append(control);
    }
    refreshControl(control, descriptor);
    return true;
  }

  function initialize() {
    const root = findTrainingRoot();
    if (!root) return false;
    const sections = directSquadSections(root);
    if (!sections.length) return false;
    const descriptors = resolveSquadIds(sections.map(describeSection));
    descriptors.forEach(insertControl);
    return true;
  }

  async function boot() {
    if (await globalDataRequestsDisabled()) {
      for (const node of document.querySelectorAll(`.${CONTROL_CLASS}`)) node.remove();
      return;
    }
    if (initialize()) return;
    const observer = new MutationObserver(() => {
      if (initialize()) observer.disconnect();
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });
    window.setTimeout(() => observer.disconnect(), 20000);
  }

