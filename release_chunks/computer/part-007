    layer.style.setProperty("pointer-events", "none", "important");
    layer.style.setProperty("overflow", "visible", "important");
    layer.style.setProperty("z-index", "2147483000", "important");
    (document.body || document.documentElement).appendChild(layer);

    if (!globalThis.__VIRM_MATCH_TACTICS_KV_OVERLAY_LISTENERS__) {
      globalThis.__VIRM_MATCH_TACTICS_KV_OVERLAY_LISTENERS__ = true;
      const schedule = () => scheduleKvOverlayPosition();
      window.addEventListener("resize", schedule, { passive: true });
      window.addEventListener("scroll", schedule, { passive: true });
      window.visualViewport?.addEventListener?.("resize", schedule, { passive: true });
      window.visualViewport?.addEventListener?.("scroll", schedule, { passive: true });
    }
    return layer;
  }

  function positionKvBadge(badge) {
    const anchor = badge?.__virmKvAnchor;
    if (!badge || !anchor?.isConnected) {
      if (badge) badge.style.setProperty("display", "none", "important");
      return;
    }
    const rect = anchor.getBoundingClientRect();
    if (!rect.width || !rect.height) {
      badge.style.setProperty("display", "none", "important");
      return;
    }
    const layer = badge.parentElement;
    const layerRect = layer?.getBoundingClientRect?.();
    if (!layerRect) {
      badge.style.setProperty("display", "none", "important");
      return;
    }
    const size = 29;
    const left = (rect.right - layerRect.left) + 5;
    const top = (rect.top - layerRect.top) + ((rect.height - size) / 2);
    badge.style.setProperty("left", `${left}px`, "important");
    badge.style.setProperty("top", `${top}px`, "important");
    badge.style.setProperty("display", "flex", "important");
  }

  function scheduleKvOverlayPosition() {
    if (overlayPositionFrame) return;
    overlayPositionFrame = requestAnimationFrame(() => {
      overlayPositionFrame = 0;
      document.querySelectorAll(`.${BADGE_CLASS}`).forEach(positionKvBadge);
    });
  }

  function removeBadges() {
    document.querySelectorAll(`.${BADGE_CLASS}`).forEach(node => node.remove());
    document.querySelectorAll(`.${ROW_CLASS}`).forEach(node => node.remove());
    const layer = document.getElementById(OVERLAY_ID);
    if (layer && !layer.children.length) layer.remove();
  }

  function createBadge(value, side, source) {
    const numeric = finiteKv(value);
    if (!Number.isFinite(numeric) || numeric <= 0) return null;
    const displayed = Math.round(numeric);
    const style = virmOfficialRatingStyleForDisplayedValue(displayed);
    if (!style) return null;
    const badge = document.createElement("span");
    badge.className = `${BADGE_CLASS} ${BADGE_CLASS}-${side}`;
    badge.textContent = String(displayed);
    const precise = numeric.toLocaleString("da-DK", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    badge.title = source === "vman" ? `VMAN KV: ${precise}` : `KV baseret på startopstilling: ${precise}`;
    badge.dataset.virmKvSource = source;
    const styles = {
      boxSizing: "border-box", position: "absolute", display: "flex", alignItems: "center", justifyContent: "center",
      width: "29px", height: "29px", minWidth: "29px", minHeight: "29px", maxWidth: "29px", maxHeight: "29px",
      margin: "0", padding: "0", border: `2px solid ${style.borderColor}`, borderRadius: "50%",
      background: style.background, backgroundColor: style.background, color: "#fff",
      font: "400 13px/1 Arial,Helvetica,sans-serif", textAlign: "center",
      textShadow: `0 -1px 0 ${style.borderColor}`, whiteSpace: "nowrap", pointerEvents: "none",
    };
    for (const [name, val] of Object.entries(styles)) badge.style.setProperty(name.replace(/[A-Z]/g, m => `-${m.toLowerCase()}`), val, "important");
    return badge;
  }

  function exactClubNode(name) {
    const wanted = normalizeKey(name);
    if (!wanted) return null;
    const root = document.querySelector("#content .match_tactics") || document.querySelector("#content") || document.body;
    const candidates = [];
    for (const node of root.querySelectorAll("a,strong,b,span,div,p,h2,h3")) {
      if (normalizeKey(node.textContent) !== wanted) continue;
      if (node.closest('a[href*="/players/"]')) continue;
      if (node.children.length > 3) continue;
      const marker = normalizeKey(`${node.id || ""} ${node.className || ""} ${node.getAttribute?.("href") || ""}`);
      let score = 0;
      if (/club|team|squad|home|away|name/.test(marker)) score += 30;
      if (/\/squads\//.test(marker)) score += 40;
      if (node.children.length === 0) score += 10;
      const rect = node.getBoundingClientRect();
      if (!rect.height || rect.height <= 45) score += 5;
      candidates.push({ node, score });
    }
    candidates.sort((a, b) => b.score - a.score);
    return candidates[0]?.node || null;
  }

  function appendAfterClubMarker(slot, badge) {
    if (!slot?.clubHost || !slot?.nameNode || !badge) return false;
    const layer = ensureKvOverlay();
    badge.__virmKvAnchor = slot.nameNode;
    layer.appendChild(badge);
    positionKvBadge(badge);
    scheduleKvOverlayPosition();
    setTimeout(scheduleKvOverlayPosition, 100);
    setTimeout(scheduleKvOverlayPosition, 500);
    return true;
  }

  function matchPitchClubNodes(ownName, opponentName) {
    const root = document.querySelector("#content .match_tactics");
    if (!root) return { ownNode: null, opponentNode: null, ownSlot: null, opponentSlot: null };

    const slots = Array.from(root.querySelectorAll(".pitches > li")).slice(0, 2).map((item, index) => {
      const clubHost = Array.from(item.children || []).find(child => child.classList?.contains("club")) || item.querySelector(".club");
      const nameNode = clubHost?.querySelector("a") || clubHost || null;
      return { index, item, clubHost, nameNode, key: normalizeKey(nameNode?.textContent || "") };
    }).filter(slot => slot.nameNode && slot.clubHost);

    if (slots.length < 2) return { ownNode: null, opponentNode: null, ownSlot: null, opponentSlot: null };

    const ownKey = normalizeKey(ownName);
    const opponentKey = normalizeKey(opponentName);
    let ownSlot = ownKey ? slots.find(slot => slot.key === ownKey) || null : null;
    let opponentSlot = opponentKey ? slots.find(slot => slot.key === opponentKey && slot !== ownSlot) || null : null;

    if (!ownSlot && opponentSlot) ownSlot = slots.find(slot => slot !== opponentSlot) || null;
    if (!opponentSlot && ownSlot) opponentSlot = slots.find(slot => slot !== ownSlot) || null;
    if (!ownSlot && !opponentSlot) {
      ownSlot = slots[0] || null;
      opponentSlot = slots[1] || null;
    }

    return {
      ownNode: ownSlot?.nameNode || null,
      opponentNode: opponentSlot?.nameNode || null,
      ownSlot,
      opponentSlot,
    };
  }

  function lineupKvFromPitchSlot(slot) {
    if (!slot?.item) return NaN;
    // På den store optaktsbane er .rating-spillerikonerne de valgte spilleres VT.
    // Brug dem direkte: det er både mere præcist og kræver ingen ekstra request.
    const values = Array.from(slot.item.querySelectorAll("ol > li > .rating, .pitch > li > .rating"))
      .map(node => finiteKv(normalizeText(node.textContent)))
      .filter(value => Number.isFinite(value) && value >= 0 && value <= 100)
      .slice(0, 11);
    // Fælles KV-regel: en identificeret startopstilling på 1-11 spillere
    // beregnes altid som summen af de fundne spilleres VT divideret med 11.
    if (values.length < 1 || values.length > 11) return NaN;
    return values.reduce((sum, value) => sum + value, 0) / 11;
  }

  function todayKey() {
    const now = new Date();
    return [now.getFullYear(), String(now.getMonth() + 1).padStart(2, "0"), String(now.getDate()).padStart(2, "0")].join("-");
  }

  function parseRatingFromOverviewHtml(html) {
    const doc = new DOMParser().parseFromString(String(html || ""), "text/html");
    const root = doc.querySelector(".team_overview") || doc.querySelector("#content") || doc.body;
    const headingNode = Array.from(root.querySelectorAll("h1,h2,h3,h4,h5,strong,b,span,div,p"))
      .find(node => ["vurdering", "rating"].includes(normalizeKey(node.textContent)));
    if (!headingNode) return NaN;
    let host = headingNode.parentElement;
    for (let depth = 0; host && depth < 8; depth += 1, host = host.parentElement) {
      const nums = Array.from(host.querySelectorAll("*"))
        .filter(node => /^\d{1,3}$/.test(normalizeText(node.textContent)) && !Array.from(node.children).some(child => normalizeText(child.textContent) === normalizeText(node.textContent)))
        .map(node => Number(normalizeText(node.textContent)))
        .filter(value => Number.isFinite(value) && value >= 0 && value <= 100);
      if (nums.length) return nums[0];
    }
    return NaN;
  }

  async function ownVmanKv(kind) {
    if (!ownStandardPromise) {
      ownStandardPromise = (async () => {
        const date = todayKey();
        const cache = await storageGet(OWN_STANDARD_CACHE_KEY).catch(() => null);
        const cached = cache?.[kind];
        if (cache?.date === date && Number.isFinite(Number(cached))) return Number(cached);
        const target = kind === "youth" ? "/youth_squad" : "/team_overview";
        try {
          const response = await fetch(new URL(target, window.location.origin).href, {
            credentials: "include", cache: "no-store", headers: { Accept: "text/html,application/xhtml+xml" },
          });
          if (!response.ok) return NaN;
          const value = parseRatingFromOverviewHtml(await response.text());
          if (Number.isFinite(value)) {
            const next = cache?.date === date && typeof cache === "object" ? { ...cache } : { date };
            next.date = date;
            next[kind] = value;
            await storageSet(OWN_STANDARD_CACHE_KEY, next).catch(() => {});
          }
          return value;
        } catch (_) { return NaN; }
      })();
    }
    return ownStandardPromise;
  }

  const opponentVmanKvInflight = new Map();
  const opponentVmanKvMemory = new Map();

  async function opponentVmanKv(kind, cachedMatch = null) {
    const embedded = finiteKv(cachedMatch?.vmanKv);
    if (Number.isFinite(embedded)) return embedded;
    if (opponentVmanKvMemory.has(matchId)) return opponentVmanKvMemory.get(matchId);
    if (opponentVmanKvInflight.has(matchId)) return opponentVmanKvInflight.get(matchId);

    const promise = (async () => {
      const target = kind === "youth" ? "/youth_squad/matches" : "/new_matches/coming";
      try {
        const response = await fetch(new URL(target, window.location.origin).href, {
          credentials: "include", cache: "no-store", headers: { Accept: "text/html,application/xhtml+xml" },
        });
        if (!response.ok) return NaN;
        const doc = new DOMParser().parseFromString(await response.text(), "text/html");
        const row = Array.from(doc.querySelectorAll(".coming_matches tbody tr, table tbody tr")).find(candidate => {
          const link = candidate.querySelector('a[href*="/new_matches/"][href*="/tactics"]');
          return String(link?.getAttribute("href") || "").match(/\/new_matches\/(\d+)/i)?.[1] === matchId;
        });
        const value = finiteKv(normalizeText(row?.querySelector("td.club_rating > div, .club_rating > div")?.textContent));
        if (Number.isFinite(value)) opponentVmanKvMemory.set(matchId, value);
        return value;
      } catch (_) {
        return NaN;
      } finally {
        opponentVmanKvInflight.delete(matchId);
      }
    })();
    opponentVmanKvInflight.set(matchId, promise);
    return promise;
  }

