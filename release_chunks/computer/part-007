  function debugHtmlSnippets(html, pattern = /tactic|formation|lineup|new_tactic|selection|squad|players?/ig, limit = 160) {
    const snippets = [];
    const source = String(html || '');
    const expression = new RegExp(pattern.source, pattern.flags.includes('g') ? pattern.flags : `${pattern.flags}g`);
    let match;
    while ((match = expression.exec(source)) && snippets.length < limit) {
      const start = Math.max(0, match.index - 260);
      const end = Math.min(source.length, match.index + String(match[0]).length + 520);
      const snippet = normalizeText(source.slice(start, end));
      if (snippet && !snippets.includes(snippet)) snippets.push(snippet);
      if (expression.lastIndex === match.index) expression.lastIndex += 1;
    }
    return snippets;
  }

  function debugTacticsData(doc) {
    for (const script of Array.from(doc?.querySelectorAll?.('script') || [])) {
      const source = String(script.textContent || '');
      const marker = source.match(/window\.tacticsData\s*=\s*/i);
      if (!marker) continue;
      const start = marker.index + marker[0].length;
      const end = source.indexOf(';', start);
      if (end < 0) continue;
      try {
        const tactics = JSON.parse(source.slice(start, end));
        if (!Array.isArray(tactics)) continue;
        return tactics.map(tactic => ({
          id: String(tactic?.id || ''),
          name: String(tactic?.name || ''),
          standard: Boolean(tactic?.standard),
          newMatchId: tactic?.new_match_id == null ? null : String(tactic.new_match_id),
          squadId: tactic?.squad_id == null ? null : String(tactic.squad_id),
          playerIds: Array.from(new Set((tactic?.lineup_selections || [])
            .slice()
            .sort((left, right) => Number(left?.x || 0) - Number(right?.x || 0) || Number(left?.y || 0) - Number(right?.y || 0))
            .map(item => String(item?.player_id || ''))
            .filter(Boolean)))
        }));
      } catch (_) {}
    }
    return [];
  }

  function squadIdFromHref(href) {
    return String(href || '').match(/\/squads\/(\d+)/i)?.[1] || '';
  }

  function historicalLineupPlayerIds(doc, squadId) {
    if (!doc || !squadId) return [];
    const teams = doc.querySelector('.match_summary .teams, .teams');
    let side = '';
    for (const candidate of ['home', 'away']) {
      const link = teams?.querySelector(`.${candidate} a[href*="/squads/"]`);
      if (squadIdFromHref(link?.getAttribute('href')) === String(squadId)) {
        side = candidate;
        break;
      }
    }
    if (!side) return [];

    const field = doc.querySelector(`.lineups .lineup.${side} .field`)
      || doc.querySelector(`.lineup.${side} .field`);
    if (!field) return [];
    const players = [];
    for (const node of Array.from(field.querySelectorAll('.player'))) {
      const link = node.querySelector('a[href*="/players/"]');
      const playerId = String(link?.getAttribute('href') || '').match(/\/players\/(\d+)/i)?.[1] || '';
      if (!playerId || players.some(player => player.playerId === playerId)) continue;
      const style = String(node.getAttribute('style') || '');
      const top = Number(style.match(/(?:^|;)\s*top\s*:\s*(-?\d+(?:\.\d+)?)px/i)?.[1]);
      const left = Number(style.match(/(?:^|;)\s*left\s*:\s*(-?\d+(?:\.\d+)?)px/i)?.[1]);
      players.push({
        playerId,
        top: Number.isFinite(top) ? top : null,
        left: Number.isFinite(left) ? left : null,
        order: players.length
      });
    }
    if (players.length !== 11) return [];
    if (players.every(player => Number.isFinite(player.left) && Number.isFinite(player.top))) {
      players.sort((left, right) => left.left - right.left || right.top - left.top || left.order - right.order);
    }
    return players.map(player => player.playerId);
  }

  function historicalTacticMatch(tacticsData, playerIds) {
    if (!Array.isArray(playerIds) || playerIds.length !== 11) return null;
    const scored = tacticsData
      .filter(tactic => session.tactics.some(current => current.id === tactic.id) && tactic.playerIds.length === 11)
      .map(tactic => ({
        tactic,
        score: playerIds.reduce((total, playerId, index) => total + (playerId === tactic.playerIds[index] ? 1 : 0), 0)
      }))
      .sort((left, right) => right.score - left.score);
    const best = scored[0];
    const second = scored[1];
    if (!best || best.score < 9) return null;
    if (second && best.score - second.score < 2 && best.score < 11) return null;
    return best;
  }

  function hasProcessedMatchId(matchId) {
    const target = String(matchId || '');
    return Object.values(session.state?.processed || {}).some(item => String(item?.matchId || '') === target);
  }

  async function syncHistoricalAssignments() {
    if (!session.state || !session.tactics.length) return { added: 0, inspected: 0 };
    const resultPath = teamKind === 'youth' ? '/youth_squad/results' : '/new_matches/results';
    const tacticIndexPath = teamKind === 'youth' ? '/youth_squad/tactics' : '/new_tactics';
    try {
      const [resultPage, tacticPage] = await Promise.all([
        fetchRotationDebugDocument(resultPath),
        fetchRotationDebugDocument(tacticIndexPath)
      ]);
      if (!resultPage.ok || !tacticPage.ok) return { added: 0, inspected: 0 };
      const tacticsData = debugTacticsData(tacticPage.doc);
      const squadId = String(tacticsData.find(tactic => tactic.squadId)?.squadId || '');
      if (!squadId || !tacticsData.length) return { added: 0, inspected: 0 };

      const matchLinks = [];
      const seenMatchIds = new Set();
      for (const link of Array.from(resultPage.doc.querySelectorAll('a[href*="/new_matches/"]'))) {
        const href = String(link.getAttribute('href') || '');
        const matchId = href.match(/\/new_matches\/(\d+)/i)?.[1] || '';
        if (!matchId || seenMatchIds.has(matchId) || hasProcessedMatchId(matchId)) continue;
        seenMatchIds.add(matchId);
        matchLinks.push({ matchId, href });
        if (matchLinks.length >= 50) break;
      }

      let added = 0;
      let inspected = 0;
      for (const match of matchLinks) {
        try {
          const summaryPage = await fetchRotationDebugDocument(match.href || `/new_matches/${match.matchId}/summary`);
          if (!summaryPage.ok) continue;
          inspected += 1;
          const playerIds = historicalLineupPlayerIds(summaryPage.doc, squadId);
          const matched = historicalTacticMatch(tacticsData, playerIds);
          if (!matched) continue;
          const currentTactic = session.tactics.find(tactic => tactic.id === matched.tactic.id);
          if (!currentTactic) continue;
          session.state.processed[`history:${match.matchId}`] = {
            tacticId: currentTactic.id,
            tacticLabel: currentTactic.label,
            matchId: match.matchId,
            band: '',
            opponentKv: null,
            appliedAt: Date.now() - Math.max(0, matchLinks.length - added),
            source: 'result-summary-lineup',
            confidence: matched.score
          };
          added += 1;
        } catch (_) {}
      }
      if (added > 0) await saveState();
      return { added, inspected };
    } catch (error) {
      console.warn('[VIRM Assistant] Afsluttede kampes taktikforbrug kunne ikke synkroniseres.', error);
      return { added: 0, inspected: 0 };
    }
  }

  async function fetchRotationDebugDocument(path) {
    const url = new URL(path, window.location.origin).href;
    const response = await fetch(url, {
      credentials: 'include',
      cache: 'no-store',
      headers: { Accept: 'text/html,application/xhtml+xml' }
    });
    const html = await response.text();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    return { url, status: response.status, ok: response.ok, htmlLength: html.length, html, doc };
  }

  async function rotationRemoteDebug() {
    const resultPath = teamKind === 'youth' ? '/youth_squad/results' : '/new_matches/results';
    const tacticIndexPath = teamKind === 'youth' ? '/youth_squad/tactics' : '/new_tactics';
    const remote = { resultPath, tacticIndexPath, resultPage: null, tacticIndexPage: null, matchSummaryPages: [] };

    try {
      const page = await fetchRotationDebugDocument(resultPath);
      const matchLinks = debugDocumentLinks(page.doc, /\/new_matches\/\d+/i, 200);
      const matchIds = Array.from(new Set(matchLinks.map(link => link.href.match(/\/new_matches\/(\d+)/i)?.[1]).filter(Boolean))).slice(0, 16);
      remote.resultPage = {
        url: page.url,
        status: page.status,
        ok: page.ok,
        htmlLength: page.htmlLength,
        title: normalizeText(page.doc.title),
        matchLinks,
        rows: debugDocumentRows(page.doc)
      };
      for (const matchId of matchIds) {
        try {
          const resultHref = matchLinks.find(link => link.href.match(/\/new_matches\/(\d+)/i)?.[1] === matchId)?.href;
          const summaryPage = await fetchRotationDebugDocument(resultHref || `/new_matches/${matchId}/summary`);
          remote.matchSummaryPages.push({
            matchId,
            requestedHref: resultHref || '',
            url: summaryPage.url,
            status: summaryPage.status,
            ok: summaryPage.ok,
            htmlLength: summaryPage.htmlLength,
            title: normalizeText(summaryPage.doc.title),
            tacticLinks: debugDocumentLinks(summaryPage.doc, /\/(?:youth_squad\/tactics|new_tactics)(?:\/|\?|$)/i, 100),
            matchLinks: debugDocumentLinks(summaryPage.doc, /\/new_matches\/\d+/i, 100),
            playerLinks: debugDocumentPlayers(summaryPage.doc),
            controls: debugDocumentControls(summaryPage.doc),
            rows: debugDocumentRows(summaryPage.doc, 100),
            scripts: debugDocumentScripts(summaryPage.doc),
            htmlSnippets: debugHtmlSnippets(summaryPage.html),
            bodyText: normalizeText(summaryPage.doc.body?.textContent).slice(0, 12000)
          });
        } catch (error) {
          remote.matchSummaryPages.push({ matchId, error: String(error?.stack || error) });
        }
      }
    } catch (error) {
      remote.resultPage = { error: String(error?.stack || error) };
    }

    try {
      const page = await fetchRotationDebugDocument(tacticIndexPath);
      remote.tacticIndexPage = {
        url: page.url,
        status: page.status,
        ok: page.ok,
        htmlLength: page.htmlLength,
        title: normalizeText(page.doc.title),
        tacticLinks: debugDocumentLinks(page.doc, /\/(?:youth_squad\/tactics|new_tactics)(?:\/|\?|$)/i, 200),
        rows: debugDocumentRows(page.doc),
        tacticsData: debugTacticsData(page.doc),
        scripts: debugDocumentScripts(page.doc),
        htmlSnippets: debugHtmlSnippets(page.html, /tacticsData|new_tactic|lineup_selection|player_id|standard/ig),
        bodyText: normalizeText(page.doc.body?.textContent).slice(0, 16000)
      };
    } catch (error) {
      remote.tacticIndexPage = { error: String(error?.stack || error) };
    }

    return remote;
  }

  async function downloadRotationDebug(panel) {
    closeRotationMenu(panel);
    const debug = rotationDebugSnapshot();
    debug.remote = await rotationRemoteDebug();
    const blob = new Blob([JSON.stringify(debug, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = `virm_tactic_rotation_debug_${String(globalThis.__VIRM_ASSISTANT_BUILD_VERSION__ || 'unknown')}.json`;
    anchor.style.display = 'none';
    (document.body || document.documentElement).appendChild(anchor);
    anchor.click();
    window.setTimeout(() => {
      try { anchor.remove(); URL.revokeObjectURL(url); } catch (_) {}
    }, 1500);
