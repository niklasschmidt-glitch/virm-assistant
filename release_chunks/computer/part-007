  async function lineupKvForClub(clubId, teamKind = "senior", preferredSquadId = "") {
    const id = String(clubId || "");
    if (!/^\d+$/.test(id)) return null;
    if (!await dataRequestsAllowed()) return null;
    const kind = teamKind === "youth" ? "youth" : "senior";
    const squadId = String(preferredSquadId || "");
    const key = `${todayKey()}:${id}:${kind}:${squadId || "-"}`;
