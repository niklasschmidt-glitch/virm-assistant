  async function syncRequestMenu() {
    const current = control();
    if (!current) return;
    const state = await dataRequestState();
    const label = current.querySelector(".virm-assistant-overview-checkbox-item");
    const triggerText = current.querySelector(".virm-assistant-data-request-trigger-text");
    const pageToggle = current.querySelector(".virm-assistant-data-request-page-toggle");
