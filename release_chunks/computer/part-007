  const TRAINER_NEGATIVE_RE = /(?:no trainer was used|trainer was not used|a trainer was not used|without (?:a )?trainer|no (?:coach|trainer)|(?:trainer|coach)[-_ ]?(?:none|no|false|missing|absent)|(?:none|no)[-_ ]?(?:trainer|coach)|ingen træner|ingen traener|uden træner|uden traener|ikke brugt en træner|ikke brugt en traener|blev ikke brugt en træner|blev ikke brugt en traener|træner[: ]+(?:ingen|nej)|traener[: ]+(?:ingen|nej))/i;

  const referenceCache = new Map();
  const queued = new Set();
  const queue = [];
  let queueRunning = false;
  let rateLimited = false;
  let cache = loadCache();
  let ppSortActive = false;
  let marketRowOrdinal = 0;
  const PP_SORT_VALUE = "__virm_pp__";

  function normalizeText(value) {
    return String(value == null ? "" : value).replace(/\s+/g, " ").trim();
  }

  function normalizeKey(value) {
    return String(value || "")
      .toLocaleLowerCase("da")
      .replace(/æ/g, "ae").replace(/ø/g, "o").replace(/å/g, "a")
      .normalize("NFKD").replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, " ").trim();
  }

  function loadCache() {
    try {
      const value = JSON.parse(localStorage.getItem(CACHE_KEY) || "{}");
      return value && typeof value === "object" ? value : {};
    } catch (_error) {
      return {};
    }
  }

  function saveCache() {
    try {
      const now = Date.now();
      for (const [id, item] of Object.entries(cache)) {
        if (!item || now - Number(item.time || 0) > 24 * 60 * 60 * 1000) delete cache[id];
      }
      localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
    } catch (_error) {
      // Cachen er kun en optimering.
    }
  }

  function cachedSummary(playerId) {
    const item = cache[playerId];
    if (!item || Date.now() - Number(item.time || 0) > CACHE_TTL_MS) return null;
    return item;
  }

  function formatOne(value, signed = false) {
    if (!Number.isFinite(value)) return "—";
    const prefix = signed && value > 0 ? "+" : "";
    return prefix + Number(value).toFixed(1).replace(".", ",");
  }

  function formatTwo(value, signed = false) {
    if (!Number.isFinite(value)) return "—";
    const prefix = signed && value > 0 ? "+" : "";
    return prefix + Number(value).toFixed(2).replace(".", ",");
  }

  function extractNumber(value) {
    const match = normalizeText(value).match(/[-+]?\d{1,4}(?:[.,]\d{1,3})?/);
    return match ? Number(match[0].replace(",", ".")) : NaN;
  }

  function normalizePlayerPosition(value) {
    const text = normalizeText(value);
    const upper = text.toUpperCase();
    const codeMatch = upper.match(/(?:^|[^A-ZÆØÅ])(K|FV|FC|FH|MV|MC|MH|MO|AV|AC|AH)(?:$|[^A-ZÆØÅ])/);
    if (codeMatch) return codeMatch[1];

    const key = normalizeKey(text);
    if (/\b(goalkeeper|keeper|målmand|maalmand|malmand)\b/.test(key)) return "K";
    if (/\b(defender|defence|defense|forsvar)\b/.test(key)) return "FC";
    if (/\b(midfielder|midfield|midtbane)\b/.test(key)) return "MC";
    if (/\b(attacker|forward|striker|angreb)\b/.test(key)) return "AC";
    return "";
  }

  function parsePlayerPosition(documentNode) {
    if (!documentNode) return "";

    // Først labels/rækker, hvor "Position" er eksplicit angivet.
    for (const row of documentNode.querySelectorAll("tr")) {
      const cells = Array.from(row.querySelectorAll("th,td"));
      if (cells.length < 2) continue;
      const label = normalizeKey(cells[0].textContent);
      if (label === "position" || label === "pos") {
        const parsed = normalizePlayerPosition(cells.slice(1).map(cell => cell.textContent).join(" "));
        if (parsed) return parsed;
      }
    }

    // Derefter kendte/semantiske positionselementer.
    for (const element of documentNode.querySelectorAll(
      "td.position, .player_position, .player-position, [data-position], [class*='position']"
    )) {
      const source = [
        element.textContent || "",
        element.getAttribute("data-position") || "",
        element.getAttribute("title") || "",
        element.getAttribute("aria-label") || ""
      ].join(" ");
      const parsed = normalizePlayerPosition(source);
      if (parsed) return parsed;
    }

    return "";
  }

  function marketRowData(row) {
    const playerLink = row.querySelector('td.player a[href*="/players/"]') || row.querySelector('a[href*="/players/"]');
    const href = playerLink?.getAttribute("href") || "";
    const id = href.match(/\/players\/(\d+)/i)?.[1] || "";
    const position = normalizeText(row.querySelector("td.position")?.textContent).toUpperCase();

    const ageCell = row.querySelector("td.age");
    const ageSource = [ageCell?.textContent || "", ageCell?.getAttribute("title") || "", ageCell?.getAttribute("aria-label") || "",
      ...Array.from(ageCell?.querySelectorAll("[title],[aria-label]") || []).flatMap(el => [el.getAttribute("title") || "", el.getAttribute("aria-label") || ""])
    ].join(" ");
    let age = NaN;
    const ageDays = ageSource.match(/(\d+(?:[.,]\d+)?)\s*(?:år|year|years)\D{0,24}?(\d+)\s*(?:dag|dage|day|days)/i);
    if (ageDays) age = Number(ageDays[1].replace(",", ".")) + Number(ageDays[2]) / DAYS_PER_YEAR;
    if (!Number.isFinite(age)) age = extractNumber(ageSource);

    // På flere VMAN-lister står kun heltalsalderen synligt, mens title/aria-label
    // indeholder "Fødselsdag om X dage". Brug den til at få den aktuelle alder.
    if (Number.isFinite(age) && Math.abs(age - Math.round(age)) < 1e-9) {
      const remaining = ageSource.match(
        /(?:Fødselsdag\s*om|Birthday\s*in)\s*(\d{1,2})\s*(?:dag|dage|day|days)\b/i
      );
      if (remaining) {
        const daysRemaining = Math.max(0, Math.min(DAYS_PER_YEAR, Number(remaining[1])));
        age = Math.floor(age) + ((DAYS_PER_YEAR - daysRemaining) % DAYS_PER_YEAR) / DAYS_PER_YEAR;
      } else if (/(?:Fødselsdag\s*i\s*morgen|Birthday\s*tomorrow)/i.test(ageSource)) {
        age = Math.floor(age) + 29 / DAYS_PER_YEAR;
      }
    }

    const sumCell = row.querySelector("td.abilities_total");
    const abilitySum = extractNumber(sumCell?.textContent || "");

    return {
      row, playerLink, id, href, position,
      marketAge: Number.isFinite(age) ? age : null,
      marketSum: Number.isFinite(abilitySum) ? abilitySum : null
    };
  }

  function optionalFiniteKpNumber(value) {
    if (value === null || value === undefined || value === "") return null;
    const number = Number(value);
    return Number.isFinite(number) ? number : null;
  }

  function firstFiniteKpNumber(...values) {
    for (const value of values) {
      const number = optionalFiniteKpNumber(value);
      if (number !== null) return number;
    }
    return null;
  }

  function bestAvailableKpAge(...values) {
    const ages = values
      .map(optionalFiniteKpNumber)
      .filter(value => value !== null);
    return ages.length ? Math.max(...ages) : null;
  }

  function trainingUrlFromHref(href) {
    try {
      const url = new URL(href, window.location.origin);
      url.search = "";
      url.hash = "";
      url.pathname = url.pathname.replace(/\/+$/, "") + "/training";
      return url.href;
    } catch (_error) {
      return "";
    }
  }

  function facilityFactor(card) {
    const haystack = `${card.textContent || ""} ${card.outerHTML || ""}`;
    const key = normalizeKey(haystack);
    const compact = String(haystack).toLocaleLowerCase("en").replace(/\s+/g, "");
    for (const [factor, aliases, colours] of FACILITY_FACTORS) {
      if (aliases.some(alias => key.includes(alias))) return factor;
      if (colours.some(colour => compact.includes(colour.replace(/\s+/g, "")))) return factor;
    }
    return null;
  }

  function extractExplicitXp(value) {
    const text = normalizeText(value);
    if (!/\bxp\b/i.test(text)) return null;
    for (const pattern of [
      /(?:trænings[-\s]*xp|training[-\s]*xp|træning[-\s]*xp|xp[-\s]*(?:gain|udbytte)|(?:gain|udbytte)[-\s]*xp|\bxp\b)\s*[:=+]?\s*([-+]?\s*\d{1,4}(?:[.,]\d{1,2})?)/i,
      /([-+]?\s*\d{1,4}(?:[.,]\d{1,2})?)\s*(?:trænings[-\s]*xp|training[-\s]*xp|træning[-\s]*xp|xp[-\s]*(?:gain|udbytte)|\bxp\b)/i
    ]) {
      const match = text.match(pattern);
      if (!match) continue;
      const number = Number(match[1].replace(/\s+/g, "").replace(",", "."));
      if (number > 0 && number <= 350) return number;
    }
    return null;
  }

  function cardTotalXp(card) {
    for (const row of card.querySelectorAll("tr")) {
      const cells = Array.from(row.querySelectorAll("th,td"));
      if (cells.length < 2) continue;
      const label = normalizeKey(cells[0].textContent);
      if (!["total", "i alt", "ialt", "samlet"].includes(label)) continue;
      const value = extractExplicitXp(cells[1].textContent);
      if (value != null) return value;
    }
    const text = normalizeText(card.textContent);
    const total = text.match(/\b(?:total|i alt|ialt|samlet)\b[\s\S]{0,120}?\bxp\b[\s\S]{0,30}/i);
    if (total) {
      const value = extractExplicitXp(total[0]);
      if (value != null) return value;
    }
    return null;
  }


  const TRAINING_MONTHS = {
    januar:1, jan:1, january:1,
    februar:2, feb:2, february:2,
    marts:3, mar:3, march:3,
    april:4, apr:4,
    maj:5, may:5,
    juni:6, jun:6, june:6,
    juli:7, jul:7, july:7,
    august:8, aug:8,
    september:9, sep:9, sept:9,
    oktober:10, okt:10, oct:10, october:10,
    november:11, nov:11,
    december:12, dec:12
  };

  function dateUtc(year, month, day) {
    const y = Number(year);
    const m = Number(month);
    const d = Number(day);
    if (!(y >= 2000 && y <= 2100 && m >= 1 && m <= 12 && d >= 1 && d <= 31)) return null;
    const value = Date.UTC(y, m - 1, d);
    const date = new Date(value);
    if (date.getUTCFullYear() !== y || date.getUTCMonth() !== m - 1 || date.getUTCDate() !== d) return null;
    return value;
  }

  function inferredTrainingYear(month, day) {
    const now = new Date();
    let year = now.getFullYear();
    let candidate = dateUtc(year, month, day);
    if (!Number.isFinite(candidate)) return null;

    // Træningshistorikken vi analyserer er kun ca. 60 dage lang. En dato uden
    // årstal, der ellers ville ligge tydeligt i fremtiden, må derfor høre til
    // det foregående kalenderår (relevant omkring nytår).
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
    if (candidate > today + 2 * 86400000) {
      year -= 1;
      candidate = dateUtc(year, month, day);
    }
    return candidate;
  }

  function parseTrainingDateValue(value) {
    const text = normalizeText(value);
    if (!text) return null;

    const key = normalizeKey(text);
    const now = new Date();
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
    if (/\b(?:i dag|idag|today)\b/.test(key)) return today;
    if (/\b(?:i gar|igar|yesterday)\b/.test(key)) return today - 86400000;

    let match = text.match(/\b(20\d{2})[-/.](\d{1,2})[-/.](\d{1,2})\b/);
    if (match) return dateUtc(match[1], match[2], match[3]);

    match = text.match(/\b(\d{1,2})[-/.](\d{1,2})[-/.](20\d{2})\b/);
    if (match) return dateUtc(match[3], match[2], match[1]);

    match = text.match(/\b(\d{1,2})[-/.](\d{1,2})[-/.](\d{2})\b/);
    if (match) return dateUtc(2000 + Number(match[3]), match[2], match[1]);

    // VMAN viser nogle steder dag/måned uden årstal.
    match = text.match(/\b(\d{1,2})[-/.](\d{1,2})(?![-/.]\d)\b/);
    if (match) {
      const value = inferredTrainingYear(match[2], match[1]);
      if (Number.isFinite(value)) return value;
    }

    match = key.match(/\b(\d{1,2})\s+([a-z]+)\s+(20\d{2})\b/);
    if (match && TRAINING_MONTHS[match[2]]) {
      return dateUtc(match[3], TRAINING_MONTHS[match[2]], match[1]);
    }

    match = key.match(/\b(\d{1,2})\s+([a-z]+)\b/);
    if (match && TRAINING_MONTHS[match[2]]) {
      const value = inferredTrainingYear(TRAINING_MONTHS[match[2]], match[1]);
      if (Number.isFinite(value)) return value;
    }

    return null;
  }

  function pushTrainingDateSources(sources, element, includeText = true) {
    if (!element) return;
    for (const attribute of [
      "datetime", "data-date", "data-datetime", "data-day", "data-time",
      "data-timestamp", "title", "aria-label"
    ]) {
      const value = element.getAttribute?.(attribute);
      if (value) sources.push(value);
    }
    if (includeText && element.textContent) sources.push(element.textContent);
  }

  function parsedDateFromElement(element) {
    if (!element) return null;
    const sources = [];
    pushTrainingDateSources(sources, element, true);
    for (const child of element.querySelectorAll?.(
      "time[datetime], [datetime], [data-date], [data-datetime], [data-day], [data-time], [data-timestamp], .date, .training_date, .training-date, [class*='date'], abbr[title]"
    ) || []) {
      pushTrainingDateSources(sources, child, true);
    }
    for (const source of sources) {
      const parsed = parseTrainingDateValue(source);
      if (Number.isFinite(parsed)) return parsed;
    }
    return null;
  }

  function collectTrainingDateCandidates(documentNode) {
    const selector = [
      "time", "[datetime]", "[data-date]", "[data-datetime]", "[data-day]", "[data-time]", "[data-timestamp]",
      ".date", ".training_date", ".training-date", "[class*='date']", "[id*='date']",
      "h1", "h2", "h3", "h4", "h5", "h6", "legend", "dt", "th", "span"
    ].join(",");

    const result = [];
    const seen = new Set();
    for (const element of documentNode.querySelectorAll(selector)) {
      if (element.closest?.("li.bar")) continue;
      const text = normalizeText(element.textContent || "");
      if (text.length > 90 && !element.matches("time,[datetime],[data-date],[data-datetime],[data-day],[data-time],[data-timestamp]")) continue;
      const date = parsedDateFromElement(element);
      if (!Number.isFinite(date)) continue;
      const key = `${date}:${text}`;
      if (seen.has(key)) continue;
      seen.add(key);
      result.push({ element, date });
    }
    return result;
  }

  function trainingCardDate(card, globalCandidates = []) {
    const direct = parsedDateFromElement(card);
    if (Number.isFinite(direct)) return direct;

    // Gå op gennem DOM-strukturen og scan baglæns indtil nærmeste datomarkør.
    // Datoen på VMAN kan ligge som fælles overskrift for en eller flere cards.
    let node = card;
    for (let depth = 0; depth < 8 && node; depth += 1) {
      let sibling = node.previousElementSibling;
      let checked = 0;
      while (sibling && checked < 40) {
        const parsed = parsedDateFromElement(sibling);
        if (Number.isFinite(parsed)) return parsed;
        sibling = sibling.previousElementSibling;
        checked += 1;
      }
      node = node.parentElement;
    }

    // Sidste fallback: brug nærmeste datomarkør tidligere i dokumentet.
    // QuerySelectorAll leverer kandidater i dokumentrækkefølge.
    let nearest = null;
    for (const candidate of globalCandidates) {
      if (!candidate?.element || candidate.element.contains?.(card)) continue;
      const relation = candidate.element.compareDocumentPosition(card);
      if (relation & Node.DOCUMENT_POSITION_FOLLOWING) nearest = candidate.date;
      else if (nearest != null) break;
    }
    return Number.isFinite(nearest) ? nearest : null;
  }

  function analyzeRecentTrainings(documentNode) {
    const cards = Array.from(documentNode.querySelectorAll("li.bar")).slice(0, 60);
    const entries = [];
    const facilityCounts = {};
    let withoutTrainer = 0;
    const cardDates = [];
    const globalDateCandidates = collectTrainingDateCandidates(documentNode);

    for (const card of cards) {
      const xp = cardTotalXp(card);
      const factor = facilityFactor(card);
      const trainerUsed = !TRAINER_NEGATIVE_RE.test(`${card.textContent || ""} ${card.outerHTML || ""}`);
      if (!trainerUsed) withoutTrainer += 1;

      if (Number.isFinite(factor)) {
        const key = String(factor);
        facilityCounts[key] = (facilityCounts[key] || 0) + 1;
      }

      const date = trainingCardDate(card, globalDateCandidates);
      cardDates.push(Number.isFinite(date) ? date : null);

      if (!Number.isFinite(xp) || !Number.isFinite(factor)) continue;
      const correctedXp = trainerUsed ? xp : xp * TRAINER_BONUS_FACTOR;
      const pp = correctedXp * PP_BASE_DIVISOR / factor;
      if (!Number.isFinite(pp) || pp < 0 || pp >= 200) continue;
      entries.push({ pp, xp, factor, trainerUsed, date });
    }

    const ppValues = entries.map(entry => entry.pp);
    const generalPp = ppValues.length
      ? ppValues.reduce((sum, value) => sum + value, 0) / ppValues.length
      : null;

    const injuryThreshold = Number.isFinite(generalPp) ? generalPp * 0.35 : null;
    const trainedWithInjury = Number.isFinite(injuryThreshold)
      ? entries.filter(entry => entry.pp <= injuryThreshold).length
      : 0;

    let forgottenTraining = null;
    let dateSpanDays = null;
    let forgottenTrainingChecked = false;
    let forgottenTrainingMethod = "unavailable";

    if (cards.length >= 2) {
      const newestDate = cardDates[0];
      const oldestDate = cardDates[cardDates.length - 1];

      if (Number.isFinite(newestDate) && Number.isFinite(oldestDate)) {
        const first = Math.min(newestDate, oldestDate);
        const last = Math.max(newestDate, oldestDate);
        dateSpanDays = Math.round((last - first) / 86400000);
        forgottenTraining = Math.max(0, dateSpanDays - (cards.length - 1));
        forgottenTrainingChecked = true;
        forgottenTrainingMethod = "edge-dates";
      } else {
        const finiteDates = cardDates.filter(Number.isFinite);
        // Hvis yderste kort mangler dato, kan min/max kun bruges sikkert, når
        // alle kort er dateret. Ellers risikerer vi at undervurdere perioden.
        if (finiteDates.length === cards.length) {
          const first = Math.min(...finiteDates);
          const last = Math.max(...finiteDates);
          dateSpanDays = Math.round((last - first) / 86400000);
          forgottenTraining = Math.max(0, dateSpanDays - (cards.length - 1));
          forgottenTrainingChecked = true;
          forgottenTrainingMethod = "all-dates";
        }
      }
    }

    const secondaryFacilityCount = Object.entries(facilityCounts)
      .filter(([factor]) => Number(factor) !== WORLD_CLASS_FACILITY_FACTOR)
      .reduce((sum, [, count]) => sum + Number(count || 0), 0);

    const hasNegative = trainedWithInjury > 0
      || withoutTrainer > 0
      || Number(forgottenTraining || 0) > 0
      || secondaryFacilityCount > 0;

    return {
      pp: Number.isFinite(generalPp) ? generalPp : null,
      factors: {
        trainingCount: cards.length,
        trainedWithInjury,
        injuryThresholdPp: Number.isFinite(injuryThreshold) ? injuryThreshold : null,
        withoutTrainer,
        forgottenTraining: Number.isFinite(forgottenTraining) ? forgottenTraining : null,
        forgottenTrainingChecked,
        forgottenTrainingMethod,
        datedTrainingCount: cardDates.filter(Number.isFinite).length,
        missingTrainingDateCount: cardDates.filter(date => !Number.isFinite(date)).length,
        dateSpanDays: Number.isFinite(dateSpanDays) ? dateSpanDays : null,
        secondaryFacilityCount,
        facilityCounts,
        hasNegative
      }
    };
  }

  function parsePp(documentNode) {
    return analyzeRecentTrainings(documentNode).pp;
  }




  function parsePrecisePlayerAge(documentNode) {
    if (!documentNode) return null;

    const bodyText = normalizeText(documentNode.body?.textContent || "");
    const sources = [bodyText];

    for (const element of documentNode.querySelectorAll(
      "[data-age], .age, [class*='age'], [title*='Fødselsdag'], [title*='fødselsdag'], [title*='Birthday'], [aria-label*='Fødselsdag'], [aria-label*='fødselsdag'], [aria-label*='Birthday']"
    )) {
      for (const value of [
        element.getAttribute?.("data-age"),
        element.getAttribute?.("title"),
        element.getAttribute?.("aria-label"),
        element.textContent
      ]) {
        if (value) sources.push(normalizeText(value));
      }
    }

    // Direkte decimal alder, fx "Alder 15,2" / "Age 15.2".
    for (const source of sources) {
      const decimal = source.match(/\b(?:Alder|Age)\s*[:\-]?\s*(\d{1,2}[.,]\d{1,4})\b/i);
      if (decimal) {
        const value = Number(decimal[1].replace(",", "."));
        if (Number.isFinite(value) && value >= 15 && value <= 40) return value;
      }
    }

    // Eksplicit "15 år og 6 dage" / "15 years 6 days".
    for (const source of sources) {
      const parts = source.match(
        /\b(\d{1,2})\s*(?:år|year|years)\D{0,20}?(\d{1,2})\s*(?:dag|dage|day|days)\b/i
      );
      if (parts) {
        const years = Number(parts[1]);
        const days = Number(parts[2]);
        if (years >= 15 && years <= 40 && days >= 0 && days <= 29) {
          return years + days / DAYS_PER_YEAR;
        }
      }
    }

    let years = null;
    const labelledAge = bodyText.match(/\b(?:Alder|Age)\s*[:\-]?\s*(\d{1,2})\b/i);
    if (labelledAge) years = Number(labelledAge[1]);

    if (!Number.isFinite(years)) {
      for (const source of sources) {
        const simple = source.match(/\b(\d{1,2})\s*(?:år|year|years)\b/i);
        if (!simple) continue;
        const value = Number(simple[1]);
        if (value >= 15 && value <= 40) {
          years = value;
          break;
        }
      }
    }

    if (!Number.isFinite(years) || years < 15 || years > 40) return null;

    // VMAN viser normalt antal dage til næste fødselsdag. Med 30 dage pr. år
    // giver "fødselsdag om 24 dage" præcis alder 15.2 (= 6 dage inde i året).
    const birthdaySources = sources.join(" ");
    const remaining = birthdaySources.match(
      /(?:Fødselsdag\s*om|Birthday\s*in)\s*(\d{1,2})\s*(?:dag|dage|day|days)\b/i
    );
    if (remaining) {
      const daysRemaining = Math.max(0, Math.min(DAYS_PER_YEAR, Number(remaining[1])));
      const daysIntoYear = (DAYS_PER_YEAR - daysRemaining) % DAYS_PER_YEAR;
      return years + daysIntoYear / DAYS_PER_YEAR;
    }

    if (/(?:Fødselsdag\s*i\s*morgen|Birthday\s*tomorrow)/i.test(birthdaySources)) {
      return years + 29 / DAYS_PER_YEAR;
    }

    return years;
  }

  function parseCurrentAbilitySum(documentNode) {
    if (!documentNode) return null;

    for (const element of documentNode.querySelectorAll(
      ".abilities_total, [class*='abilities_total'], [data-abilities-total], [data-ability-sum]"
    )) {
      const direct = firstFiniteKpNumber(
        element.getAttribute?.("data-abilities-total"),
        element.getAttribute?.("data-ability-sum"),
        extractNumber(element.textContent || "")
      );
      if (direct !== null && direct >= 20 && direct <= 1000) return direct;
    }

    const text = normalizeText(documentNode.body?.textContent || "");
    for (const pattern of [
      /(?:Egenskaber|Abilities)\s*Total\s*(\d{2,4})\b/i,
      /\bTotal\s*(\d{2,4})\b/i
    ]) {
      const match = text.match(pattern);
      if (!match) continue;
      const value = Number(match[1]);
      if (Number.isFinite(value) && value >= 20 && value <= 1000) return value;
    }

    return null;
  }

  async function fetchPlayerKpProfileMeta(href) {
    if (!href) return { age: null, sum: null, position: null };
    try {
      const url = new URL(href, window.location.origin);
      url.search = "";
      url.hash = "";
      const response = await fetch(url.href, { credentials: "include", cache: "no-store" });
      if (!response.ok) return { age: null, sum: null, position: null };
      const html = await response.text();
      const documentNode = new DOMParser().parseFromString(html, "text/html");
      return {
        age: parsePrecisePlayerAge(documentNode),
        sum: parseCurrentAbilitySum(documentNode),
        position: parsePlayerPosition(documentNode) || null
      };
    } catch (_error) {
      return { age: null, sum: null, position: null };
    }
  }

  async function fetchPrecisePlayerAge(href) {
    return (await fetchPlayerKpProfileMeta(href)).age;
  }

  function resolveCurrentKpAge(documentNode, historyAge, fallbackAge = null) {
    const pageAge = parsePrecisePlayerAge(documentNode);
    return bestAvailableKpAge(historyAge, pageAge, fallbackAge);
  }

  function parseAbilityHistory(rawHtml) {
    const raw = String(rawHtml || "");
    const anchor = raw.search(/id\s*=\s*["']ability_history_chart["']/i);
    if (anchor < 0) return { age: null, sum: null };
    const scope = raw.slice(anchor, anchor + 60000);
    const pattern = /\b(?:var|let|const)\s+data\s*=\s*(\[\s*\[[\s\S]*?\]\s*\])\s*;/gi;
    const candidates = [];
    for (const match of scope.matchAll(pattern)) candidates.push(match[1]);
    for (const candidate of candidates) {
      try {
        const parsed = JSON.parse(candidate);
        const points = Array.isArray(parsed) ? parsed.map(item => {
          if (!Array.isArray(item) || item.length < 2) return null;
          const age = Number(item[0]);
          const sum = Number(item[1]);
          return Number.isFinite(age) && Number.isFinite(sum) && age >= 0 && age <= 100 && sum >= 0 && sum <= 1000 ? [age, sum] : null;
        }).filter(Boolean).sort((a,b) => a[0] - b[0]) : [];
        if (points.length) return { age: points[points.length - 1][0], sum: points[points.length - 1][1] };
      } catch (_error) {
        // Prøv næste data-array i chart-området.
      }
    }
    return { age: null, sum: null };
  }

  function cycleFor(template) {
    const expanded = [];
    for (const [days, exercise, distribution] of TEMPLATE_CYCLES[template] || []) {
      for (let day = 0; day < days; day += 1) expanded.push([exercise, distribution]);
    }
    return expanded;
  }

  const EXPANDED_CYCLES = Object.fromEntries(Object.keys(TEMPLATE_CYCLES).map(key => [key, cycleFor(key)]));

  function statsForTemplate(template) {
    return template === "k" ? KEEPER_STATS : MARK_STATS;
  }

  function makeState(stats) {
    const levels = {};
    const progress = {};
    for (const stat of stats) { levels[stat] = 2; progress[stat] = 0; }
    return { levels, progress };
  }

  function statValue(state, stat) {
    const level = state.levels[stat];
    if (level >= 100) return 100;
    return level + state.progress[stat] / XP_TO_NEXT_ABILITY[level];
  }

  function stateValues(state, stats) {
    const result = {};
    for (const stat of stats) result[stat] = statValue(state, stat);
    return result;
  }

  function addXp(state, stat, xp) {
    if (!(stat in state.levels) || state.levels[stat] >= 100) return;
    state.progress[stat] += Math.max(0, Number(xp) || 0);
    while (state.levels[stat] < 100) {
      const level = state.levels[stat];
      const needed = XP_TO_NEXT_ABILITY[level];
      if (state.progress[stat] + 1e-12 < needed) break;
      state.progress[stat] -= needed;
      state.levels[stat] += 1;
    }
    if (state.levels[stat] >= 100) {
      state.levels[stat] = 100;
      state.progress[stat] = 0;
    }
  }

  function referenceSum(position, pp, age) {
    const template = POSITION_TEMPLATE[String(position || "").toUpperCase()];
    if (!template || !Number.isFinite(pp) || !Number.isFinite(age)) return null;
    const totalDays = Math.max(0, Math.round((Math.max(START_AGE, age) - START_AGE) * DAYS_PER_YEAR));
    const cacheKey = `${template}:${pp.toFixed(4)}:${totalDays}`;
    if (referenceCache.has(cacheKey)) return referenceCache.get(cacheKey);

    const stats = statsForTemplate(template);
    const state = makeState(stats);
    const dailyXp = pp * WORLD_CLASS_FACILITY_FACTOR / PP_BASE_DIVISOR;
    const cycle = EXPANDED_CYCLES[template];

    for (let day = 0; day < totalDays; day += 1) {
      const [exercise, distribution] = day < PREFIX_DAYS ? ["Træningskamp", null] : cycle[(day - PREFIX_DAYS) % cycle.length];
      let raw = {};
      if (exercise === "Træningskamp") {
        for (const stat of stats) raw[stat] = dailyXp / stats.length;
      } else {
        const entries = Object.entries(distribution || {}).filter(([stat, points]) => stat in state.levels && Number(points) > 0);
        const totalPoints = entries.reduce((sum, [, points]) => sum + Number(points), 0);
        if (!totalPoints) continue;
        for (const [stat, points] of entries) raw[stat] = dailyXp * Number(points) / totalPoints;
      }

      const values = stateValues(state, stats);
      const average = stats.reduce((sum, stat) => sum + values[stat], 0) / stats.length;
      for (const [stat, rawXp] of Object.entries(raw)) {
        let factor = 1;
        if (exercise !== "Træningskamp" && average > 0) {
          const percentAbove = (values[stat] / average - 1) * 100;
          if (percentAbove > 15) factor = Math.max(0, 1 - ((percentAbove - 15) / 3) / 100);
        }
        addXp(state, stat, rawXp * factor);
      }
    }

    const result = stats.reduce((sum, stat) => sum + statValue(state, stat), 0);
    referenceCache.set(cacheKey, result);
    return result;
  }


  function kpAgeFactor(position, age) {
    const template = POSITION_TEMPLATE[String(position || "").toUpperCase()];
    if (!template || !Number.isFinite(age)) return null;
    if (age <= 27) return 1;
    if (age > 40) return null;

    const curve = KP_POST27_FACTORS[template];
    if (!curve) return null;

    const low = Math.max(27, Math.floor(age));
    const high = Math.min(40, Math.ceil(age));
    if (low === high) return Number(curve[low]);

    const lowValue = Number(curve[low]);
    const highValue = Number(curve[high]);
    if (!Number.isFinite(lowValue) || !Number.isFinite(highValue)) return null;

    const fraction = age - low;
    return lowValue + (highValue - lowValue) * fraction;
  }

  // KP bruger kun egenskabssummen. Frem til 27 år antages udviklingen lineært
  // fordelt over de 10 egenskaber. XP-prisen følger VMANs progressive XP-tabel.
  function totalXpFromAbilitySum(abilitySum) {
    if (!Number.isFinite(abilitySum)) return null;
    const averageAbility = Math.max(2, Math.min(100, abilitySum / 10));
    const wholeLevel = Math.floor(averageAbility);
    let xpPerAbility = 0;

    for (let level = 2; level < wholeLevel && level < 100; level += 1) {
      xpPerAbility += Number(XP_TO_NEXT_ABILITY[level]) || 0;
    }

    if (wholeLevel < 100) {
      const fraction = averageAbility - wholeLevel;
      xpPerAbility += fraction * (Number(XP_TO_NEXT_ABILITY[wholeLevel]) || 0);
    }

    return xpPerAbility * 10;
  }

  function isBelowKpMinimumAge(age) {
    return Number.isFinite(age) && age + 1e-9 < KP_MIN_AGE;
  }

  function formatKpDisplay(value, age, formatter) {
    if (Number.isFinite(value)) return formatter(value);
    return isBelowKpMinimumAge(age) ? "👨‍🎓" : "—";
  }

  function calculateKp(position, age, abilitySum) {
    if (!Number.isFinite(age) || !Number.isFinite(abilitySum)) return null;
    // KP kan trækkes fra og med 15.2 år. 15.2 er altså gyldig, mens yngre spillere
    // fortsat vises uden KP.
    if (age + 1e-9 < KP_MIN_AGE || age > 40) return null;

    let equivalentSum = abilitySum;
    let careerDays = (age - START_AGE) * DAYS_PER_YEAR;

    if (age > 27) {
      const factor = kpAgeFactor(position, age);
      if (!Number.isFinite(factor) || factor <= 0) return null;
      equivalentSum = abilitySum / factor;
      careerDays = (27 - START_AGE) * DAYS_PER_YEAR;
    }

    equivalentSum = Math.max(20, Math.min(1000, equivalentSum));
    const totalXp = totalXpFromAbilitySum(equivalentSum);
    if (!Number.isFinite(totalXp) || !Number.isFinite(careerDays) || careerDays <= 0) return null;

    const averageCareerXpPerDay = totalXp / careerDays;
    return averageCareerXpPerDay * PP_BASE_DIVISOR / WORLD_CLASS_FACILITY_FACTOR;
  }

  async function fetchTrainingSummary(data) {
    const cached = cachedSummary(data.id);
    if (cached) return cached;
    const url = trainingUrlFromHref(data.href);
    if (!url) throw new Error("Spillerens træningsside kunne ikke bestemmes.");
    const response = await fetch(url, { credentials: "include", cache: "no-store" });
    if (response.status === 429) {
      rateLimited = true;
      throw new Error("VMAN har midlertidigt begrænset opslagene.");
    }
    if (!response.ok) throw new Error(`Træningsdata kunne ikke hentes (HTTP ${response.status}).`);
    const html = await response.text();
    const documentNode = new DOMParser().parseFromString(html, "text/html");
    const trainingAnalysis = analyzeRecentTrainings(documentNode);
    const pp = trainingAnalysis.pp;
    const history = parseAbilityHistory(html);

    let resolvedAge = resolveCurrentKpAge(documentNode, history.age, data.marketAge);
    let resolvedSum = firstFiniteKpNumber(history.sum, data.marketSum);
    let resolvedPosition = parsePlayerPosition(documentNode) || data.position || null;

    // For 15-årige viser liste/træningsside typisk kun "15", mens profilsiden
    // indeholder "Fødselsdag om X dage". Den skal derfor hentes for at afgøre,
    // om spilleren har passeret 15.2 (= mere end 5 dage gammel).
    //
    // Profilen bruges også som fallback, hvis ability-history endnu ikke findes
    // (det gælder netop de helt unge spillere).
    const needsPreciseYoungAge = Number.isFinite(resolvedAge)
      && resolvedAge >= 15
      && resolvedAge < 16;
    const needsProfileMeta = needsPreciseYoungAge
      || resolvedSum === null
      || !resolvedPosition;

    if (needsProfileMeta) {
      const profileMeta = await fetchPlayerKpProfileMeta(data.href);
      resolvedAge = bestAvailableKpAge(resolvedAge, profileMeta.age);
      resolvedSum = firstFiniteKpNumber(resolvedSum, profileMeta.sum);
      resolvedPosition = resolvedPosition || profileMeta.position || null;
    }

    const summary = {
      time: Date.now(),
      pp: Number.isFinite(pp) ? pp : null,
      kpFactors: trainingAnalysis.factors,
      age: optionalFiniteKpNumber(resolvedAge),
      sum: optionalFiniteKpNumber(resolvedSum),
      position: resolvedPosition || null
    };
    cache[data.id] = summary;
    saveCache();
    return summary;
  }

  function valueCells(row) {
    return {
      pp: row.querySelector("td.virm-market-pp"),
      kp: row.querySelector("td.virm-market-kp")
    };
  }


  function kpFactorFacilityRows(factors) {
    const rows = [];
    for (const [factorKey, countRaw] of Object.entries(factors?.facilityCounts || {})) {
      const count = Number(countRaw) || 0;
      const factor = Number(factorKey);
      if (count <= 0 || factor === WORLD_CLASS_FACILITY_FACTOR) continue;

      const definition = FACILITY_FACTORS.find(([candidate]) => Number(candidate) === factor);
      const color = definition?.[2]?.[0] || "#8f8b7b";
      const name = FACILITY_NAMES[factor] || `${factor} XP-anlæg`;
      rows.push({ factor, name, count, color });
    }
    return rows.sort((a, b) => b.factor - a.factor);
  }

  function danishDayUnit(value) {
    const count = Number(value);
    return Number.isFinite(count) && Math.abs(count - 1) < 1e-9 ? "dag" : "dage";
  }

  function formatDanishDayCount(value, decimals = 0) {
    const count = Number(value);
    const safeCount = Number.isFinite(count) ? Math.max(0, count) : 0;
    const digits = Math.max(0, Math.min(4, Math.round(Number(decimals) || 0)));
    const display = digits > 0
      ? safeCount.toFixed(digits).replace(".", ",")
      : String(Math.round(safeCount));
    return `${display} ${danishDayUnit(safeCount)}`;
  }

  function dynamicDanishDayUnit(input) {
    const node = document.createTextNode(danishDayUnit(input?.value));
    const sync = () => {
      node.nodeValue = danishDayUnit(input?.value);
    };
    input?.addEventListener("input", sync);
    input?.addEventListener("change", sync);
    return node;
  }

  function formatDanishOccurrenceCount(value) {
    const count = Math.max(0, Math.round(Number(value) || 0));
    return `${count} ${count === 1 ? "gang" : "gange"}`;
  }

  function kpFactorSeverity(factors) {
    const facilityCounts = factors?.facilityCounts || {};
    const facilityCountAtOrBelow = threshold => Object.entries(facilityCounts)
      .filter(([factor]) => Number(factor) <= threshold)
      .reduce((sum, [, count]) => sum + (Number(count) || 0), 0);

    const extendedOrWorse = facilityCountAtOrBelow(170);
    const standardOrWorse = facilityCountAtOrBelow(150);
    const injury = Number(factors?.trainedWithInjury) || 0;
    const forgotten = Number(factors?.forgottenTraining) || 0;
    const withoutTrainer = Number(factors?.withoutTrainer) || 0;

    // Professionelt træningsanlæg (180) er bevidst ikke en del af den grønne
    // afvigelsessum. Det er en mild negativ faktor, som alene stadig giver grøn.
    const greenDeviationTotal = extendedOrWorse + injury + forgotten + withoutTrainer;

    const red = standardOrWorse > 5
      || injury > 7
      || forgotten > 5
      || withoutTrainer > 7;

    if (red) {
      return {
        key: "red",
        colorName: "rød",
        weakening: "større",
        extendedOrWorse,
        standardOrWorse,
        greenDeviationTotal,
      };
    }

    const green = extendedOrWorse <= 2
      && injury <= 2
      && forgotten <= 2
      && withoutTrainer <= 2
      && greenDeviationTotal <= 4;

    if (green) {
      return {
        key: "green",
        colorName: "grøn",
        weakening: "mindre",
        extendedOrWorse,
        standardOrWorse,
        greenDeviationTotal,
      };
    }

    return {
      key: "yellow",
      colorName: "gul",
      weakening: "moderat",
      extendedOrWorse,
      standardOrWorse,
      greenDeviationTotal,
    };
  }

  function kpFactorSeverityText(severity) {
    return `Denne anmærkning er <strong class="virm-kp-factor-severity-word is-${severity.key}">${severity.colorName}</strong> og indikerer en ${severity.weakening} svækkelse af spillerens udvikling.`;
  }

  function kpFactorTooltipHtml(factors) {
    const lines = [];
    const severity = kpFactorSeverity(factors);

    if (Number(factors?.withoutTrainer) > 0) {
      lines.push(`<div class="virm-kp-factor-icon-line"><span class="virm-kp-factor-emoji" aria-hidden="true">👔</span><strong>Trænet uden træner:</strong> ${formatDanishOccurrenceCount(factors.withoutTrainer)}</div>`);
    }

    if (Number(factors?.forgottenTraining) > 0) {
      lines.push(`<div class="virm-kp-factor-icon-line"><span class="virm-kp-factor-emoji" aria-hidden="true">💩</span><strong>Glemt træning:</strong> ${formatDanishDayCount(factors.forgottenTraining)}</div>`);
    }

    const secondaryCount = Number(factors?.secondaryFacilityCount) || 0;
    if (secondaryCount > 0) {
      lines.push(`<div class="virm-kp-factor-icon-line"><span class="virm-kp-factor-emoji" aria-hidden="true">🎓</span><strong>Sekundære træningsfaciliteter:</strong> ${formatDanishOccurrenceCount(secondaryCount)}</div>`);
      const facilityRows = kpFactorFacilityRows(factors);
      if (facilityRows.length) {
        lines.push(
          `<div class="virm-kp-factor-facilities">${
            facilityRows.map(row => `
              <span class="virm-kp-factor-facility-row">
                <span class="virm-kp-factor-facility-swatch" style="background-color:${row.color}" aria-hidden="true"></span>
                <span>${row.name}: ${row.count}</span>
              </span>
            `).join("")
          }</div>`
        );
      }
    }

    if (Number(factors?.trainedWithInjury) > 0) {
      lines.push(
        `<div class="virm-kp-factor-injury-line"><span class="virm-kp-injury-icon" aria-hidden="true"></span><strong>Trænet med skade:</strong> ${formatDanishOccurrenceCount(factors.trainedWithInjury)}</div>`
      );
      lines.push(
        `<span class="virm-kp-factor-note">Skader registreres på baggrund af mistænkeligt lave træningspræstationer sammenlignet med spillerens gennemsnit. Antallet er derfor vejledende.</span>`
      );
    }

    return `
      <span class="virm-kp-factor-tooltip" role="tooltip">
        <span class="virm-kp-factor-heading">${
          (() => {
            const span = Number(factors?.dateSpanDays);
            const totalDays = Number.isFinite(span) && span >= 0
              ? Math.round(span) + 1
              : Math.max(1, Number(factors?.trainingCount) || 1);
            return `Forhold, der ud fra tilgængelige træningsdata har påvirket KP negativt (${formatDanishDayCount(totalDays)})`;
          })()
        }</span>
        ${lines.join("")}
        <span class="virm-kp-factor-severity-note is-${severity.key}">${kpFactorSeverityText(severity)}</span>
      </span>
    `;
  }

  function renderKpFactorInfo(container, summary) {
    if (!container) return false;

    // Bevar mobilens åben/lukket-status på selve KP-feltet. Det er vigtigt,
    // fordi VMAN/VIRM kan re-render en spiller-række efter et tap.
    const priorTarget = container.__virmKpFactorActivationTarget
      || (container.matches?.("[data-virm-legacy-player-kp]") ? container.closest(".virm-player-point") : container);
    const restoreOpen = priorTarget?.dataset?.virmKpInfoOpen === "1";

    if (priorTarget?.__virmKpFactorPointerHandler) {
      priorTarget.removeEventListener("pointerup", priorTarget.__virmKpFactorPointerHandler);
      delete priorTarget.__virmKpFactorPointerHandler;
    }
    if (priorTarget?.__virmKpFactorTouchHandler) {
      priorTarget.removeEventListener("touchend", priorTarget.__virmKpFactorTouchHandler);
      delete priorTarget.__virmKpFactorTouchHandler;
    }
    if (priorTarget?.__virmKpFactorClickHandler) {
      priorTarget.removeEventListener("click", priorTarget.__virmKpFactorClickHandler);
      priorTarget.removeEventListener("keydown", priorTarget.__virmKpFactorKeyHandler);
      delete priorTarget.__virmKpFactorClickHandler;
      delete priorTarget.__virmKpFactorKeyHandler;
    }
    if (priorTarget?.__virmKpFactorOutsideHandler) {
      document.removeEventListener("pointerdown", priorTarget.__virmKpFactorOutsideHandler, true);
      document.removeEventListener("touchstart", priorTarget.__virmKpFactorOutsideHandler, true);
      delete priorTarget.__virmKpFactorOutsideHandler;
    }

    if (priorTarget) {
      priorTarget.classList.remove("virm-kp-factor-hitarea");
      priorTarget.removeAttribute("data-virm-kp-factor-hitarea");
      priorTarget.removeAttribute("aria-expanded");
      priorTarget.removeAttribute("data-virm-kp-mobile-mode");
      if (priorTarget.dataset.virmKpAddedTabindex === "1") {
        priorTarget.removeAttribute("tabindex");
        delete priorTarget.dataset.virmKpAddedTabindex;
      }
      if (priorTarget.dataset.virmKpAddedRole === "1") {
        priorTarget.removeAttribute("role");
        delete priorTarget.dataset.virmKpAddedRole;
      }
    }

    container.querySelector?.(".virm-kp-factor-info")?.remove();

    const factors = summary?.kpFactors;
    if (!factors?.hasNegative) {
      if (priorTarget?.dataset) delete priorTarget.dataset.virmKpInfoOpen;
      return false;
    }

    const severity = kpFactorSeverity(factors);
    const info = document.createElement("span");
    info.className = `virm-kp-factor-info is-${severity.key}`;
    info.dataset.virmKpSeverity = severity.key;
    info.setAttribute("aria-hidden", "true");
    info.innerHTML = `<span class="virm-kp-factor-icon" aria-hidden="true">i</span>${kpFactorTooltipHtml(factors)}`;

    const activationTarget = container.matches?.("[data-virm-legacy-player-kp]")
      ? (container.closest(".virm-player-point") || container)
      : container;
    container.__virmKpFactorActivationTarget = activationTarget;

    activationTarget.classList.add("virm-kp-factor-hitarea");
    activationTarget.setAttribute("data-virm-kp-factor-hitarea", "1");

    const isMobileInteraction = window.matchMedia?.("(hover: none)")?.matches === true;

    if (isMobileInteraction) {
      activationTarget.setAttribute("data-virm-kp-mobile-mode", "1");
      activationTarget.setAttribute("aria-expanded", restoreOpen ? "true" : "false");
      activationTarget.dataset.virmKpInfoOpen = restoreOpen ? "1" : "0";
      if (restoreOpen) info.classList.add("is-open");

      if (!activationTarget.hasAttribute("tabindex")) {
        activationTarget.tabIndex = 0;
        activationTarget.dataset.virmKpAddedTabindex = "1";
      }
      if (!activationTarget.hasAttribute("role") && activationTarget.tagName !== "TD") {
        activationTarget.setAttribute("role", "button");
        activationTarget.dataset.virmKpAddedRole = "1";
      }

      const closeOther = () => {
        for (const other of document.querySelectorAll(".virm-kp-factor-info.is-open")) {
          if (other === info) continue;
          other.classList.remove("is-open");
          const otherTarget = other.closest?.(".virm-kp-factor-hitarea");
          if (otherTarget) {
            otherTarget.setAttribute("aria-expanded", "false");
            otherTarget.dataset.virmKpInfoOpen = "0";
          }
        }
      };

      const setOpen = open => {
        if (open) closeOther();
        info.classList.toggle("is-open", open);
        activationTarget.setAttribute("aria-expanded", open ? "true" : "false");
        activationTarget.dataset.virmKpInfoOpen = open ? "1" : "0";
      };

      const toggle = event => {
        event?.preventDefault?.();
        event?.stopPropagation?.();
        setOpen(activationTarget.dataset.virmKpInfoOpen !== "1");
      };

      let lastPointerToggleAt = 0;
      const pointerHandler = event => {
        if (event.pointerType && event.pointerType !== "touch" && event.pointerType !== "pen") return;
        lastPointerToggleAt = performance.now();
        toggle(event);
      };
      const touchHandler = event => {
        if ("PointerEvent" in window) return;
        lastPointerToggleAt = performance.now();
        toggle(event);
      };
      const clickHandler = event => {
        // iOS kan sende et syntetisk click efter pointerup/touchend. Det click
        // skal kun sluges – ikke toggles endnu en gang.
        event.preventDefault();
        event.stopPropagation();
        if (performance.now() - lastPointerToggleAt < 900) return;
        toggle(event);
      };
      const keyHandler = event => {
        if (event.key === "Enter" || event.key === " ") toggle(event);
        if (event.key === "Escape" && activationTarget.dataset.virmKpInfoOpen === "1") {
          event.preventDefault();
          event.stopPropagation();
          setOpen(false);
        }
      };

      activationTarget.__virmKpFactorPointerHandler = pointerHandler;
      activationTarget.__virmKpFactorTouchHandler = touchHandler;
      activationTarget.__virmKpFactorClickHandler = clickHandler;
      activationTarget.__virmKpFactorKeyHandler = keyHandler;
      activationTarget.addEventListener("pointerup", pointerHandler);
      activationTarget.addEventListener("touchend", touchHandler, { passive: false });
      activationTarget.addEventListener("click", clickHandler);
      activationTarget.addEventListener("keydown", keyHandler);

      const outsideHandler = event => {
        if (activationTarget.dataset.virmKpInfoOpen !== "1") return;
        if (activationTarget.contains(event.target)) return;
        setOpen(false);
      };
      activationTarget.__virmKpFactorOutsideHandler = outsideHandler;
      document.addEventListener("pointerdown", outsideHandler, true);
      document.addEventListener("touchstart", outsideHandler, true);
    } else {
      // Desktop styres udelukkende af CSS-hover. Fjern evt. bevaret mobilstatus.
      delete activationTarget.dataset.virmKpInfoOpen;
    }

    container.appendChild(info);
    return true;
  }


  function renderResult(data, summary) {
    if (!data.row.isConnected) return;
    const cells = valueCells(data.row);
    if (!cells.pp || !cells.kp) return;

    const pp = Number(summary?.pp);
    const age = bestAvailableKpAge(summary?.age, data.marketAge);
    const sum = firstFiniteKpNumber(summary?.sum, data.marketSum);
    const position = data.position || normalizePlayerPosition(summary?.position || "");
    const kp = calculateKp(position, age, sum);

    cells.pp.textContent = Number.isFinite(pp) ? formatOne(pp) : "—";
    cells.pp.title = Number.isFinite(pp)
      ? "PP beregnet som i VIRM Player Search ud fra spillerens seneste træninger."
      : "PP kunne ikke beregnes ud fra spillerens træningsdata.";

    cells.kp.textContent = formatKpDisplay(kp, age, formatOne);
    if (Number.isFinite(kp)) {
      const factor = age > 27 ? kpAgeFactor(position, age) : 1;
      const equivalentSum = age > 27 && Number.isFinite(factor) ? sum / factor : sum;
      cells.kp.title = age > 27
        ? `KP: karrierens gennemsnitlige træningsniveau. Egenskabssummen alderskorrigeres tilbage til 27,0 år (${Number(equivalentSum).toFixed(1)}), XP beregnes lineært fra startniveau 20 og omregnes til PP-skalaen.`
        : `KP: karrierens gennemsnitlige træningsniveau. XP beregnes lineært fra startniveau 20 til den nuværende egenskabssum over ${formatDanishDayCount((age - START_AGE) * DAYS_PER_YEAR, 1)} og omregnes til PP-skalaen.`;
    } else {
      cells.kp.title = age > 40
        ? "KP understøttes foreløbigt til og med 40,0 år."
        : "KP kunne ikke beregnes. Der mangler alder, egenskabssum eller en understøttet position.";
    }

    const kpHasFactorInfo = Number.isFinite(kp) && renderKpFactorInfo(cells.kp, summary);
    if (kpHasFactorInfo) cells.kp.removeAttribute("title");

    if (Number.isFinite(pp)) data.row.dataset.virmMarketPp = String(pp);
    else delete data.row.dataset.virmMarketPp;
    data.row.dataset.virmMarketRatingState = "ready";
    if (ppSortActive) sortTableByPp(data.row.closest("table"));
  }

  function renderScoutKpResult(data, summary) {
    if (!data.row.isConnected) return;

    const ppCell = data.row.querySelector("td.virm-scout-pp");
    const kpCell = data.row.querySelector("td.virm-scout-kp");
    if (!kpCell) return;
    const kpContent = kpCell.querySelector(".virm-scout-kp-content") || kpCell;

    const pp = Number(summary?.pp);
    const age = bestAvailableKpAge(summary?.age, data.marketAge);
    const sum = firstFiniteKpNumber(summary?.sum, data.marketSum);
    const position = data.position || normalizePlayerPosition(summary?.position || "");
    const kp = calculateKp(position, age, sum);

    // Hvis VMEnhancer ikke leverer PP på rapporten, viser VIRM sin egen PP.
    // Vi bruger samme fetch/summary som KP, så det medfører ikke et ekstra spilleropslag.
    if (ppCell && data.virmScoutPpSource === "virm") {
      ppCell.textContent = Number.isFinite(pp) ? formatTwo(pp) : "—";
      ppCell.title = Number.isFinite(pp)
        ? "PP beregnet af VIRM ud fra spillerens seneste tilgængelige træninger."
        : "PP kunne ikke beregnes ud fra spillerens træningsdata.";
    }

    kpContent.textContent = formatKpDisplay(kp, age, formatTwo);
    kpCell.title = Number.isFinite(kp)
      ? "KP viser spillerens gennemsnitlige træningsniveau gennem karrieren på samme skala som PP."
      : isBelowKpMinimumAge(age)
        ? "KP beregnes fra og med alderen 15.5."
        : "KP kunne ikke beregnes. Der mangler alder, egenskabssum eller en understøttet position.";

    const kpHasFactorInfo = Number.isFinite(kp) && renderKpFactorInfo(kpCell, summary);
    if (kpHasFactorInfo) kpCell.removeAttribute("title");

    data.row.dataset.virmMarketRatingState = "ready";
    if (data.virmKpOnly) data.row.dataset.virmScoutKpState = "ready";
  }

  function renderError(data, error) {
    if (!data.row.isConnected) return;
    const cells = valueCells(data.row);
    for (const cell of Object.values(cells)) {
      if (!cell) continue;
      cell.textContent = "—";
      cell.title = error?.message || "Data kunne ikke indlæses.";
    }
    delete data.row.dataset.virmMarketPp;
    data.row.dataset.virmMarketRatingState = "error";

    if (data.virmKpOnly) {
      const scoutKp = data.row.querySelector("td.virm-scout-kp .virm-scout-kp-content")
        || data.row.querySelector("td.virm-scout-kp");
      if (scoutKp) {
        scoutKp.textContent = "—";
        scoutKp.title = error?.message || "KP kunne ikke indlæses.";
      }

      if (data.virmScoutPpSource === "virm") {
        const scoutPp = data.row.querySelector("td.virm-scout-pp");
        if (scoutPp) {
          scoutPp.textContent = "—";
          scoutPp.title = error?.message || "PP kunne ikke indlæses.";
        }
      }

      data.row.dataset.virmScoutKpState = "error";
    }

    if (ppSortActive) sortTableByPp(data.row.closest("table"));
  }

  function enqueue(data) {
    if (!data.id || queued.has(data.id) || data.row.dataset.virmMarketRatingState === "ready") return;
    queued.add(data.id);
    queue.push(data);
    runQueue();
  }

  async function runQueue() {
    if (queueRunning) return;
    queueRunning = true;
    while (queue.length) {
      const data = queue.shift();
      if (!data || !data.row.isConnected) { if (data?.id) queued.delete(data.id); continue; }
      if (rateLimited) { renderError(data, new Error("VMAN har midlertidigt begrænset opslagene.")); queued.delete(data.id); continue; }
      try {
        const summary = await fetchTrainingSummary(data);
        if (data.virmKpOnly) renderScoutKpResult(data, summary);
        else renderResult(data, summary);
      } catch (error) {
        renderError(data, error);
      }
      queued.delete(data.id);
      if (queue.length && !rateLimited) await new Promise(resolve => setTimeout(resolve, REQUEST_GAP_MS));
    }
    queueRunning = false;
  }

  function headerRowForTable(table) {
    const rows = Array.from(table.querySelectorAll("tr"));
    return rows.find(row => {
      const text = normalizeKey(row.textContent);
      return text.includes("spiller") && text.includes("alder") && (text.includes("vurdering") || text.includes("rating"));
    }) || table.querySelector("thead tr") || null;
  }

  function ensureHeader(table) {
    const header = headerRowForTable(table);
    if (!header || header.querySelector(".virm-market-pp")) return;
    const cells = Array.from(header.children);
    let ratingCell = cells.find(cell => ["vurdering", "rating"].includes(normalizeKey(cell.textContent)));
    if (!ratingCell) ratingCell = cells.find(cell => /rating/i.test(String(cell.className || "")));
    if (!ratingCell) return;

    const pp = document.createElement(ratingCell.tagName === "TH" ? "th" : "td");
    pp.className = "virm-market-pp virm-market-added-head";
    pp.textContent = "PP";
    pp.title = "Potentiale point beregnet fra spillerens seneste træninger.";

    const kp = document.createElement(ratingCell.tagName === "TH" ? "th" : "td");
    kp.className = "virm-market-kp virm-market-added-head";
    kp.textContent = "KP";
    kp.title = "Karriere-point: spillerens gennemsnitlige træningsniveau gennem karrieren, vist på samme skala som PP.";

    // Match præcis den skriftfarve VMAN bruger på de eksisterende kolonneoverskrifter.
    const headerColor = window.getComputedStyle(ratingCell).color;
    if (headerColor) {
      pp.style.setProperty("color", headerColor, "important");
      kp.style.setProperty("color", headerColor, "important");
    }

    ratingCell.insertAdjacentElement("afterend", kp);
    ratingCell.insertAdjacentElement("afterend", pp);
  }

  function ensureRow(row) {
    if (!(row instanceof HTMLTableRowElement) || !row.querySelector("td.player")) return;
    if (!row.dataset.virmMarketOrdinal) row.dataset.virmMarketOrdinal = String(++marketRowOrdinal);
    const existing = row.querySelector("td.virm-market-pp");
    if (!existing) {
      const ratingCell = row.querySelector("td.rating");
      if (!ratingCell) return;
      const pp = document.createElement("td");
      pp.className = "virm-market-pp";
      pp.textContent = "…";
      const kp = document.createElement("td");
      kp.className = "virm-market-kp";
      kp.textContent = "…";
      ratingCell.insertAdjacentElement("afterend", kp);
      ratingCell.insertAdjacentElement("afterend", pp);
    }
    const data = marketRowData(row);
    if (!data.id) {
      renderError(data, new Error("Spilleren kunne ikke identificeres."));
      return;
    }
    if (!row.dataset.virmMarketRatingState) row.dataset.virmMarketRatingState = "loading";
    const cached = cachedSummary(data.id);
    if (cached) renderResult(data, cached);
    else enqueue(data);
  }

  function sortTableByPp(table) {
    if (!table || !ppSortActive) return;
    for (const tbody of Array.from(table.tBodies || [])) {
      const rows = Array.from(tbody.rows).filter(row => row.querySelector("td.player"));
      if (rows.length < 2) continue;
      rows.sort((left, right) => {
        const leftPp = Number(left.dataset.virmMarketPp);
        const rightPp = Number(right.dataset.virmMarketPp);
        const leftReady = Number.isFinite(leftPp);
        const rightReady = Number.isFinite(rightPp);
        if (leftReady && rightReady && rightPp !== leftPp) return rightPp - leftPp;
        if (leftReady !== rightReady) return leftReady ? -1 : 1;
        return Number(left.dataset.virmMarketOrdinal || 0) - Number(right.dataset.virmMarketOrdinal || 0);
      });
      for (const row of rows) tbody.appendChild(row);
    }
    updateTopMarketTooltipDirections(table);
  }

  function findMarketSortSelect() {
    let best = null;
    let bestScore = -Infinity;
    for (const select of document.querySelectorAll("select")) {
      const optionKeys = Array.from(select.options || []).map(option => normalizeKey(option.textContent));
      let score = 0;
      if (/sort/i.test(`${select.id || ""} ${select.name || ""} ${select.className || ""}`)) score += 7;
      if (optionKeys.some(key => key === "pris" || key === "price")) score += 2;
      if (optionKeys.some(key => key === "vaerdi" || key === "value")) score += 2;
      if (optionKeys.some(key => key === "vurdering" || key === "rating")) score += 3;
      const nearby = normalizeKey(select.parentElement?.textContent || "");
      if (nearby.includes("sorter efter") || nearby.includes("sort by")) score += 10;
      const label = select.id ? document.querySelector(`label[for="${CSS.escape(select.id)}"]`) : null;
      const labelKey = normalizeKey(label?.textContent || "");
      if (labelKey.includes("sorter efter") || labelKey.includes("sort by")) score += 12;
      if (score > bestScore) { best = select; bestScore = score; }
    }
    return bestScore >= 7 ? best : null;
  }

  function ensurePpSortOption() {
    const select = findMarketSortSelect();
    if (!select) return;
    if (!Array.from(select.options).some(option => option.value === PP_SORT_VALUE)) {
      const option = document.createElement("option");
      option.value = PP_SORT_VALUE;
      option.textContent = "PP";
      select.appendChild(option);
    }
    if (select.dataset.virmPpSortBound === "1") return;
    select.dataset.virmPpSortBound = "1";
    select.addEventListener("change", event => {
      if (select.value !== PP_SORT_VALUE) {
        ppSortActive = false;
        return;
      }
      // PP findes kun i VIRM, så vi sorterer den viste resultatliste lokalt
      // og forhindrer VMAN i at indsende en ukendt sorteringsværdi.
      event.preventDefault();
      event.stopImmediatePropagation();
      ppSortActive = true;
      for (const table of document.querySelectorAll("table.virm-market-rating-table")) sortTableByPp(table);
    }, true);
  }

  function marketHeaderKeys(table) {
    const header = headerRowForTable(table);
    if (!header) return [];
    return Array.from(header.children).map(cell => normalizeKey(cell.textContent));
  }

  function pageLooksLikeFreeTransfer() {
    const pathKey = normalizeKey(path);
    if (pathKey.includes("free") || pathKey.includes("fri")) return true;
    for (const heading of document.querySelectorAll("#content h1, #content h2, #content h3, #content .headline, #content .heading, #content .title")) {
      const key = normalizeKey(heading.textContent);
      if (key.includes("fri transfer") || key.includes("free transfer") || key.includes("free agent")) return true;
    }
    return false;
  }

  function tableLooksLikePlayerMarket(table) {
    if (scoutReportPage) return false;
    if (!table) return false;
    if (!table.querySelector('td.player a[href*="/players/"]')) return false;

    const keys = marketHeaderKeys(table);
    if (!keys.length) return false;
    const has = (...terms) => keys.some(key => terms.includes(key));
    const hasPartial = (...terms) => keys.some(key => terms.some(term => key.includes(term)));

    const core = has("spiller", "player")
      && has("alder", "age")
      && has("vurdering", "rating");

    const marketTail = hasPartial(
      "pris", "price", "bud", "bid", "udlob", "expires", "expiry", "deadline",
      "vaerdi", "value", "transfer"
    );
    return core && marketTail;
  }

  function rememberMarketWidth(table, selector, variableName) {
    const cell = table.querySelector(selector);
    const width = cell?.getBoundingClientRect().width || 0;
    if (width > 0) table.style.setProperty(variableName, `${width}px`);
    return width;
  }

  function rememberOriginalMarketWidths(table) {
    if (table.dataset.virmOriginalMarketWidths === "1") return;
    table.dataset.virmOriginalMarketWidths = "1";

    rememberMarketWidth(table, "td.age", "--virm-market-original-age-width");
    rememberMarketWidth(table, "td.position", "--virm-market-original-position-width");
    rememberMarketWidth(table, "td.country", "--virm-market-original-country-width");
    rememberMarketWidth(table, "td.abilities_total", "--virm-market-original-es-width");
    rememberMarketWidth(table, "td.rating", "--virm-market-original-rating-width");
    const priceWidth = rememberMarketWidth(table, "td.price", "--virm-market-original-price-width");

    const tableWidth = table.getBoundingClientRect().width || 0;
    if (tableWidth > 0 && priceWidth > 0) {
      // PP + KP bruger 10,4 % af tabellens bredde i det normale markedslayout.
      // På Fri transfer tages hele den plads fra Pris.
      const donated = tableWidth * 0.104;
      const freePriceWidth = Math.max(42, priceWidth - donated);
      table.style.setProperty("--virm-market-free-price-width", `${freePriceWidth}px`);
    }
  }

  function naturalKpTooltipHeight(cell) {
    const tooltip = cell?.querySelector?.(".virm-kp-factor-tooltip");
    if (!tooltip) return 0;

    const priorStyle = tooltip.getAttribute("style");
    tooltip.style.setProperty("display", "block", "important");
    tooltip.style.setProperty("visibility", "hidden", "important");
    tooltip.style.setProperty("pointer-events", "none", "important");
    const height = tooltip.getBoundingClientRect().height || 0;

    if (priorStyle === null) tooltip.removeAttribute("style");
    else tooltip.setAttribute("style", priorStyle);

    return height;
  }

  function updateTopMarketTooltipDirections(table) {
    if (!table) return;

    for (const cell of table.querySelectorAll("td.virm-market-kp")) {
      cell.classList.remove("virm-kp-tooltip-open-down");
    }

    const playerRows = Array.from(table.querySelectorAll("tbody tr, tr"))
      .filter(row => row instanceof HTMLTableRowElement && row.querySelector("td.player"));

    // Resultat nr. 2 åbner fortsat nedad.
    playerRows[1]?.querySelector("td.virm-market-kp")?.classList.add("virm-kp-tooltip-open-down");

    // Det øverste resultat åbner kun nedad, hvis boblen er så høj,
    // at den ellers ville ramme toppen af viewporten.
    const topCell = playerRows[0]?.querySelector("td.virm-market-kp");
    if (topCell) {
      const tooltipHeight = naturalKpTooltipHeight(topCell);
      const availableAbove = Math.max(0, topCell.getBoundingClientRect().top - 12);
      if (tooltipHeight > 0 && tooltipHeight + 7 > availableAbove) {
        topCell.classList.add("virm-kp-tooltip-open-down");
      }
    }
  }

  function markTable(table) {
    if (!table || !tableLooksLikePlayerMarket(table)) return;
    if (!table.classList.contains("virm-market-rating-table")) {
      const playerCell = table.querySelector("td.player");
      const normalPlayerWidth = playerCell?.getBoundingClientRect().width || 0;
      if (normalPlayerWidth > 0) {
        table.style.setProperty("--virm-market-player-width", `${normalPlayerWidth}px`);
      }

      rememberOriginalMarketWidths(table);

      const headerKeys = marketHeaderKeys(table);
      const isAuction = headerKeys.some(key => key.includes("bud") || key.includes("bid"))
        && headerKeys.some(key => key.includes("udlob") || key.includes("expire") || key.includes("deadline"));
      if (isAuction) table.classList.add("virm-market-auction-table");

      const hasPrice = Boolean(table.querySelector("td.price"))
        || headerKeys.some(key => key === "pris" || key === "price");
      const hasValue = Boolean(table.querySelector("td.value"))
        || headerKeys.some(key => key === "vaerdi" || key === "value");
      const headerSaysFree = headerKeys.some(key =>
        key.includes("fri transfer") || key.includes("free transfer") || key.includes("free agent")
      );

      // Fri transfer kan genkendes på sidens titel/rute eller på den kompakte
      // markedstabel med Pris men uden den separate Værdi-kolonne.
      if (!isAuction && hasPrice && (pageLooksLikeFreeTransfer() || headerSaysFree || !hasValue)) {
        table.classList.add("virm-market-free-table");
      }
    }

    table.classList.add("virm-market-rating-table");
    ensureHeader(table);
    for (const row of table.querySelectorAll("tr")) ensureRow(row);
    updateTopMarketTooltipDirections(table);
  }

  function playerProfilePosition() {
    const direct = parsePlayerPosition(document);
    if (direct) return direct;

    for (const element of document.querySelectorAll("#content dt, #content dd, #content li, #content p, #content span")) {
      const text = normalizeText(element.textContent);
      if (!text || text.length > 80) continue;
      const parsed = normalizePlayerPosition(text);
      if (parsed) return parsed;
    }
    return "";
  }

  function findAbilitiesHeading() {
    const root = document.querySelector("#content") || document.body;
    if (!root) return null;

    for (const element of root.querySelectorAll("h1,h2,h3,h4,.headline,.heading,.title,strong")) {
      const key = normalizeKey(element.textContent);
      if (key === "egenskaber" || key === "abilities") return element;
    }

    for (const element of root.querySelectorAll("*")) {
      const key = normalizeKey(element.textContent);
      if ((key === "egenskaber" || key === "abilities") && element.children.length <= 2) return element;
    }
    return null;
  }

  function createLegacyPlayerPointsCard() {
    const card = document.createElement("div");
    card.id = "virm-player-career-points";
    card.setAttribute("aria-label", "VIRM spillerpoint");
    card.innerHTML = `
      <div class="virm-player-point">
        <span class="virm-player-point-label">PP</span>
        <strong class="virm-player-point-value" data-virm-legacy-player-pp>…</strong>
      </div>
      <div class="virm-player-point">
        <span class="virm-player-point-label">KP</span>
        <strong class="virm-player-point-value" data-virm-legacy-player-kp>…</strong>
      </div>
    `;
