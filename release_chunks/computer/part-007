  function positionPopup(menu, x, y) {
    // Popup-menuerne ligger inde i Shadow DOM-panelet. Brug lokale koordinater
    // i forhold til selve appen, så Safari mobil ikke placerer dem uden for
    // panelet, når VMAN-siden er zoomet eller har en desktop-lignende viewport.
    menu.classList.add("is-open");
    menu.style.left = "0px";
    menu.style.top = "0px";
    const appRect = refs.app.getBoundingClientRect();
    const rect = menu.getBoundingClientRect();
    const localX = x - appRect.left;
    const localY = y - appRect.top;
    const availableHeight = Math.max(appRect.height, refs.app.scrollHeight || 0);
    const maxX = Math.max(4, appRect.width - rect.width - 6);
    const maxY = Math.max(4, availableHeight - rect.height - 6);
    menu.style.left = `${clamp(localX, 4, maxX)}px`;
    menu.style.top = `${clamp(localY, 4, maxY)}px`;
  }

