        preferredSquadId: squadId,
        candidateMatchIds: [],
        attempts: [],
        result: null,
      };
      arbitraryClubLineupDiagnostics.set(key, diagnostics);

      const fixturesResponse = await fetch(`/clubs/${encodeURIComponent(id)}/fixtures`, {
        credentials: "include",
        cache: "no-store",
        headers: { Accept: "text/html,application/xhtml+xml" },
      });
      if (!fixturesResponse.ok) {
        diagnostics.fixturesStatus = fixturesResponse.status;
        return null;
      }
      const fixturesHtml = await fixturesResponse.text();
      const fixturesDoc = new DOMParser().parseFromString(fixturesHtml, "text/html");

      // Byg en bred, men stadig begrænset kandidatpulje. På andre klubbers
      // kampprogrammer kan en brugbar startopstilling ligge på en anden kamp end
      // den første kommende. 0.1.376 stoppede for tidligt og gav derfor null for
      // de fleste invitationsmodstandere.
      const candidates = [];
      const seen = new Set();
      const addCandidate = (matchId, meta = {}) => {
        const mid = String(matchId || "");
        if (!/^\d+$/.test(mid) || seen.has(mid)) return;
        seen.add(mid);
        candidates.push({ matchId: mid, ...meta });
      };

      // Eksisterende parser først, fordi den har den bedste metadata om modstander
      // og hjemme/ude, når VMAN leverer den normale kommende-kampe-struktur.
      for (const match of scheduleMatchesFromHtml(kind, fixturesHtml)) {
        addCandidate(match.matchId, { parsedMatch: match, priority: 100 });
      }

      let rowOrder = 0;
      for (const row of fixturesDoc.querySelectorAll("tr")) {
        const rowText = normalizeKey(row.textContent || "");
        const explicitYouth = Boolean(row.querySelector('a[href*="/youth_leagues/"]'))
          || /ungdomshold|youth squad|youth team|u-?23/.test(rowText);
        const explicitSenior = /seniorhold|senior squad|senior team/.test(rowText);
        if (kind === "youth" && explicitSenior && !explicitYouth) continue;
        if (kind === "senior" && explicitYouth) continue;

        const links = Array.from(row.querySelectorAll('a[href*="/new_matches/"]'));
        for (const link of links) {
          const href = String(link.getAttribute("href") || "");
          const matchId = href.match(/\/new_matches\/(\d+)/i)?.[1] || "";
          if (!matchId) continue;
          let priority = 40 - rowOrder * 0.01;
          if (/\/tactics(?:[/?#]|$)/i.test(href)) priority += 25;
          if (/\b\d+\s*[-–:]\s*\d+\b/.test(normalizeText(row.textContent || ""))) priority += 15;
          if (/result|spillet|played|finished|slut|afsluttet/.test(rowText)) priority += 10;
          addCandidate(matchId, { priority, rowText: normalizeText(row.textContent || "").slice(0, 500) });
        }
        rowOrder += 1;
      }

      // Links udenfor tabellen som sidste supplement.
      for (const link of fixturesDoc.querySelectorAll('a[href*="/new_matches/"]')) {
        const href = String(link.getAttribute("href") || "");
        const matchId = href.match(/\/new_matches\/(\d+)/i)?.[1] || "";
        addCandidate(matchId, { priority: 10 });
      }

      candidates.sort((a, b) => Number(b.priority || 0) - Number(a.priority || 0));
      diagnostics.candidateMatchIds = candidates.slice(0, 16).map(item => item.matchId);

      // På /new_matches/<id>/tactics viser VMAN de valgte spilleres VT direkte på
      // hver banehalvdel. For andre klubber er dette langt mere robust end at
      // forsøge at udlede lineupen fra spillerlinks, fordi klub-/squad-linket og
      // spillerlisten ikke altid ligger i samme DOM-container.
      const targetClubNames = new Set();
      for (const link of fixturesDoc.querySelectorAll(`a[href*="/clubs/${id}"]`)) {
        const key = normalizeKey(link.textContent || "");
        if (key) targetClubNames.add(key);
      }

      const targetPitchRatingFromDoc = (doc, candidate = null) => {
        const slots = Array.from(doc.querySelectorAll(".match_tactics .pitches > li, .pitches > li"))
          .filter((slot, index, all) => all.indexOf(slot) === index)
          .slice(0, 2);
        if (!slots.length) return null;

        const opponentKey = normalizeKey(candidate?.parsedMatch?.opponent || "");
        const scored = slots.map((slot, index) => {
          const clubHost = Array.from(slot.children || []).find(child => child.classList?.contains("club"))
            || slot.querySelector(".club")
            || null;
          const nameNode = clubHost?.querySelector("a") || clubHost || null;
          const href = String(nameNode?.getAttribute?.("href") || "");
          const linkedClub = href.match(/\/clubs\/(\d+)/i)?.[1] || "";
          const linkedSquad = href.match(/\/squads\/(\d+)/i)?.[1] || "";
          const name = normalizeText(nameNode?.textContent || "");
          const nameKey = normalizeKey(name);

          let score = 0;
          if (linkedClub === id) score += 1000;
          if (squadId && linkedSquad === squadId) score += 1000;
          if (nameKey && targetClubNames.has(nameKey)) score += 700;
          // Kandidater fra klubbens eget kampprogram har metadata om modstanderen.
          // Hvis VMAN kun bruger squad-links, er "den anden banehalvdel" derfor
          // stadig en sikker identifikation af den ønskede klub.
          if (opponentKey && nameKey && nameKey !== opponentKey) score += 250;
          if (opponentKey && nameKey === opponentKey) score -= 250;

          const values = Array.from(slot.querySelectorAll("ol > li > .rating, .pitch > li > .rating, li > .rating"))
            .map(node => Number(normalizeText(node.textContent).replace(",", ".")))
            .filter(value => Number.isFinite(value) && value >= 0 && value <= 100)
            .slice(0, 11);
          if (values.length === 11) score += 120;
          return { slot, index, name, nameKey, linkedClub, linkedSquad, values, score };
        }).sort((a, b) => b.score - a.score);

        const best = scored[0] || null;
        if (!best || best.values.length < 1 || best.values.length > 11 || best.score <= 0) return null;
        const total = best.values.reduce((sum, value) => sum + value, 0);
        return {
          total,
          average: total / 11,
          lineupCount: best.values.length,
          slotName: best.name,
          slotHref: String((best.slot.querySelector(".club a") || best.slot.querySelector(".club"))?.getAttribute?.("href") || ""),
        };
      };

      const targetLineupFromDoc = doc => {
        const teamLinks = Array.from(doc.querySelectorAll('a[href*="/clubs/"],a[href*="/squads/"]'));
        const targetLinks = teamLinks.filter(link => {
          const raw = String(link.getAttribute("href") || "");
          const linkedClub = raw.match(/\/clubs\/(\d+)/i)?.[1] || "";
          const linkedSquad = raw.match(/\/squads\/(\d+)/i)?.[1] || "";
          return linkedClub === id || (squadId && linkedSquad === squadId);
        });
        const scored = [];
        for (const clubLink of targetLinks) {
          let node = clubLink.parentElement;
          for (let depth = 0; node && node !== doc.body && depth < 16; depth += 1, node = node.parentElement) {
            const players = uniquePlayerLinks(node);
            if (!players.length || players.length > 16) continue;
            const marker = normalizeKey(`${node.id || ""} ${node.className || ""}`);
            let score = 180 - Math.abs(players.length - 11) * 22 - depth;
            if (/lineup|formation|tactic|pitch|field|opstilling|start|team|players/.test(marker)) score += 45;
            if (players.length === 11) score += 140;
            scored.push({ players: players.slice(0, 11), score, depth, marker: marker.slice(0, 200) });
          }
        }
        scored.sort((a, b) => b.score - a.score);
        return scored[0] || null;
      };

      // Prøv flere kampe end før. Hver klub behandles sekventielt, så vi undgår
      // en request-storm; spillerprofiler er fortsat dæmpet af den eksisterende
      // PROFILE_CONCURRENCY-kø og genbruges fra cache.
      for (const candidate of candidates.slice(0, 12)) {
        const attempt = { matchId: candidate.matchId, directPlayers: 0, analyzed: false, error: "" };
        diagnostics.attempts.push(attempt);
        try {
          const tacticsResponse = await fetch(`/new_matches/${encodeURIComponent(candidate.matchId)}/tactics`, {
            credentials: "include",
            cache: "no-store",
            headers: { Accept: "text/html,application/xhtml+xml" },
          });
          attempt.status = tacticsResponse.status;
          if (!tacticsResponse.ok) continue;
          const tacticsHtml = await tacticsResponse.text();
          const doc = new DOMParser().parseFromString(tacticsHtml, "text/html");

          // Førstevalg: brug de VT-tal, som VMAN allerede viser direkte på
          // den relevante banehalvdel. Det kræver ingen spillerprofil-opslag.
          const pitchRating = targetPitchRatingFromDoc(doc, candidate);
          attempt.directRatings = pitchRating?.lineupCount || 0;
          attempt.targetSlotName = pitchRating?.slotName || "";
          attempt.targetSlotHref = pitchRating?.slotHref || "";
          if (pitchRating && Number.isFinite(Number(pitchRating.average))) {
            diagnostics.result = {
              matchId: candidate.matchId,
              method: "pitch-ratings",
              average: pitchRating.average,
              lineupCount: pitchRating.lineupCount,
              slotName: pitchRating.slotName,
            };
            return {
              total: pitchRating.total,
              average: pitchRating.average,
              lineupCount: pitchRating.lineupCount,
            };
          }

          // Fallback: find den konkrete klub/squad på optakten og tag de nærmeste
          // op til 11 spillerlinks i dens lineup-container.
          const direct = targetLineupFromDoc(doc);
          attempt.directPlayers = direct?.players?.length || 0;
          if (direct?.players?.length) {
            const result = await lineupResult(direct.players);
            if (result && Number.isFinite(Number(result.average))) {
              diagnostics.result = { matchId: candidate.matchId, method: "target-container", average: result.average, lineupCount: result.lineupCount };
              return result;
            }
          }

          // Fallback til den velafprøvede kamp-parser, hvis vi har metadata fra
          // kampprogrammet. Her svarer "ownKv" til klubben hvis fixtures-side vi
          // netop gennemgår.
          if (candidate.parsedMatch) {
            attempt.analyzed = true;
            const analyzed = await analyzeMatch(candidate.parsedMatch);
            const own = analyzed?.ownKv;
            if (own && Number.isFinite(Number(own.average))) {
              diagnostics.result = { matchId: candidate.matchId, method: "fixture-parser", average: own.average, lineupCount: own.lineupCount };
              return own;
            }
          }
        } catch (error) {
          attempt.error = String(error?.message || error);
        }
      }

      return null;
    })().catch(error => {
      const current = arbitraryClubLineupDiagnostics.get(key) || {};
      current.fatalError = String(error?.stack || error);
      arbitraryClubLineupDiagnostics.set(key, current);
      console.warn("[VIRM Assistant] Startopstillings-KV for klub kunne ikke indlæses", id, error);
      return null;
    });

    arbitraryClubLineupKvCache.set(key, promise);
    return promise;
  }

  const api = {
    CACHE_KEY,
    getCache,
    ensureDaily,
    refreshTeam: teamKind => refreshTeams([teamKind], "manual"),
    refreshAll: () => refreshTeams(["senior", "youth"], "manual"),
    requestTeamRefresh,
    processPendingRefreshes,
    lineupKvForClub,
    getArbitraryClubLineupDiagnostics: arbitraryLineupDiagnosticsSnapshot,
    subscribe,
    formatUpdatedAt,
  };
  window.__VIRM_KV_START11_CACHE_V1__ = api;

  const boot = () => {
    window.setTimeout(async () => {
      try {
        await api.ensureDaily();
        await api.processPendingRefreshes();
      } catch (error) {
