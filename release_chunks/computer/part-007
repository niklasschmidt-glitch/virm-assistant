  function renderScenarioPlayersEditor() {
    const program = activeProgram();
    refs.editor.appendChild(createEditorTitle("Spillere i scenario", closeScenarioPlayersEditor));
    const data = groupPlayerData.get(state.activeGroupId);

    if (!data || data.status === "loading") {
      const loading = document.createElement("div");
      loading.className = "virm-scenario-player-empty";
      loading.textContent = "Henter spillerdata fra gruppen…";
      refs.editor.appendChild(loading);
      return;
    }
