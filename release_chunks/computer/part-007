  async function ensureKvTeamCache() {
    const api = window.__VIRM_KV_START11_CACHE_V1__;
    if (!api?.getCache) return null;
    const cache = await syncKvCache();
    if (!session.kvStart11Enabled) return cache;
    if (session.kvRefreshPromise) return cache;

    session.kvRefreshPromise = (async () => {
      let refreshed = cache;
      try {
        if (api.ensureDaily) {
          refreshed = await api.ensureDaily();
          await syncKvCache(refreshed);
        }
        const team = refreshed?.teams?.[teamKind] || null;
        const cachedMatches = team?.matches && typeof team.matches === 'object' ? team.matches : {};
        const missingCurrentMatches = session.matches.some(match => !cachedMatches[String(match.matchId)]);
        if ((!team || missingCurrentMatches) && api.refreshTeam) {
          refreshed = await api.refreshTeam(teamKind);
          await syncKvCache(refreshed);
        }
        return refreshed;
      } catch (error) {
        console.warn('[VIRM Assistant] Taktikrotationens KV-cache kunne ikke opdateres.', error);
        return refreshed;
      } finally {
        session.kvRefreshPromise = null;
      }
    })();
    return cache;
  }

  function clubIdFromSquadPage(page, squadId, opponentName = '') {
    const id = String(squadId || '');
    if (!page?.doc || !/^\d+$/.test(id)) return '';
    const scripts = Array.from(page.doc.querySelectorAll('script')).map(script => String(script.textContent || '')).join('\n');
    const escaped = id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    for (const pattern of [
      new RegExp(`"id"\\s*:\\s*${escaped}\\b[^{}]{0,900}?"club_id"\\s*:\\s*(\\d+)`, 'i'),
      new RegExp(`"club_id"\\s*:\\s*(\\d+)[^{}]{0,900}?"id"\\s*:\\s*${escaped}\\b`, 'i')
    ]) {
      const match = scripts.match(pattern);
      if (match?.[1]) return match[1];
    }

    const root = page.doc.querySelector('#content') || page.doc.body;
    const links = Array.from(root?.querySelectorAll?.('a[href*="/clubs/"]') || [])
      .filter(link => !link.closest('#header,.navigation,.side,.account,.quick_links'));
    const opponentKey = normalizeText(opponentName).toLocaleLowerCase('da-DK');
    const named = opponentKey
      ? links.find(link => normalizeText(link.textContent).toLocaleLowerCase('da-DK') === opponentKey)
      : null;
    const link = named || links[0] || null;
    return String(link?.getAttribute('href') || '').match(/\/clubs\/(\d+)/i)?.[1] || '';
  }

