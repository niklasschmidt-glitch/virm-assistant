  function exportItem(item) {
    if (item.type === "block") {
      return {
        type: "block",
        name: item.name,
        repetitions: item.repetitions,
        phases: item.phases.map(exportItem),
      };
    }
    return {
      type: "phase",
      days: item.days,
      exercise: item.exercise,
      exercise_type_code: item.exerciseTypeCode,
      intensity: POINTS_TO_INTENSITY[String(item.trainingPoints)] || "Hård",
      training_points: item.trainingPoints,
      distribution: item.distribution ? deepClone(item.distribution) : null,
    };
  }



  function programFileAssistantState(raw, position, scenario) {
    // Træningsprogramfiler indeholder selve det valgte program og Assistentens
    // indstillinger, men ikke op til 100 komplette søgeresultater. De kan fylde
    // over browserens lagergrænse og har deres egen Gem søgning/Indlæs-funktion.
    // Fjern resultaterne før normalisering, så ældre 10–11 MB-filer heller ikke
    // bruger tid og hukommelse på at genopbygge en historik, der skal kasseres.
    const source = raw && typeof raw === "object"
      ? { ...raw, view: "constraints", results: [], selectedResultId: null }
      : raw;
    return normalizeAssistantState(source, position, scenario);
  }

  function exportedProgramPayload(program) {
    return {
      virm_extension_version: VIRM_BUILD_VERSION,
      virm_assistant_version: VIRM_BUILD_VERSION,
      name: program.name,
      position: program.position,
      start_date: program.startDate,
      experience_bonus: {
        enabled: program.settings.experienceBonus,
        ratio: Number(program.settings.experienceRatio).toFixed(2),
        knee: program.settings.gradient,
      },
      scenario: deepClone(program.scenario),
      assistant: programFileAssistantState(program.assistant, program.position, program.scenario),
      program: program.sessions.map(exportItem),
    };
  }

  function downloadJsonFile(filename, payload) {
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    link.style.display = "none";
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function normalizedJsonFilename(value, fallback) {
    const raw = normalizeText(value) || fallback;
    const withoutExtension = raw.replace(/\.json$/i, "");
    const safe = escapeFilename(withoutExtension) || "VIRM_holdtraening";
    return `${safe}.json`;
  }

  async function saveJsonFileAs(suggestedFilename, payload) {
    const json = JSON.stringify(payload, null, 2);

    if (typeof window.showSaveFilePicker === "function") {
      try {
        const handle = await window.showSaveFilePicker({
          suggestedName: suggestedFilename,
          types: [{
            description: "JSON-fil",
            accept: { "application/json": [".json"] },
          }],
        });
        const writable = await handle.createWritable();
        await writable.write(new Blob([json], { type: "application/json" }));
        await writable.close();
        return true;
      } catch (error) {
        if (error && error.name === "AbortError") return false;
        console.warn("VIRM Assistant: Gem som-dialog kunne ikke åbnes.", error);
      }
    }

    const requestedName = window.prompt("Gem holdtræning som:", suggestedFilename);
    if (requestedName === null) return false;
    downloadJsonFile(normalizedJsonFilename(requestedName, suggestedFilename), payload);
    return true;
  }

