  function openContextMenu(x, y) {
    refs.mainMenu.classList.remove("is-open");
    const items = selectedItems();
    const indices = selectedIndices();
    const oneItem = items.length === 1;
    const onePhase = oneItem && items[0].type === "phase";
    const oneBlock = oneItem && items[0].type === "block";
    const canMoveUp = indices.length > 0 && indices[0] > 0;
    const canMoveDown = indices.length > 0 && indices[indices.length - 1] < activeProgram().sessions.length - 1;

    refs.contextMenu.replaceChildren(
      menuItem("Redigér valgte", () => oneBlock ? openBlockEditor(items[0].id) : openPhaseEditor(items[0].id), !oneItem),
      ...(oneBlock ? [menuItem("Opløs blok", dissolveSelectedBlock)] : []),
      ...(isMobileMultiSelectAvailable() ? [menuItem(mobileMultiSelectMode ? "Afslut markering" : "Markér flere", () => {
        mobileMultiSelectMode = !mobileMultiSelectMode;
        renderProgram();
        showToast(mobileMultiSelectMode
          ? "Tryk på flere sessioner eller blokke for at markere dem."
          : "Markering af flere er afsluttet.");
      })] : []),
      menuSeparator(),
      menuItem("Kopiér valgte", copySelectedItems, items.length === 0),
      menuItem("Indsæt efter valgte", pasteAfterSelected, clipboardItems.length === 0),
      menuItem("Duplikér valgte", duplicateSelectedItems, items.length === 0),
      menuSeparator(),
      menuItem("Flyt valgte op", () => moveSelected(-1), !canMoveUp),
      menuItem("Flyt valgte ned", () => moveSelected(1), !canMoveDown),
      menuSeparator(),
      menuItem("Tilføj valgte til blok", makeBlockFromSelected, items.length === 0),
      menuSeparator(),
      menuItem("Slet valgte", () => deleteItemsByIds(items.map((item) => item.id)), items.length === 0),
