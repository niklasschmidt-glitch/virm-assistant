  function assistantResultColumns(customWeights) {
    return [
      { key: "rank", label: "#", className: "rank", value: (_result, rank) => rank },
      ...(customWeights ? [{ key: "weightedRating", label: "bVT", className: "number", value: (result) => result.weightedRating.toFixed(2) }] : []),
      { key: "rating", label: "VT", className: "number", value: (result) => result.rating.toFixed(2) },
