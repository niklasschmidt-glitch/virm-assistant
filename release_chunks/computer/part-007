  function redistributeAssistantWeights(assistant, changedStat, requestedValue) {
    const stats = Object.keys(assistant.weights);
    const values = Object.fromEntries(stats.map((stat) => [stat, Math.max(0, Number(assistant.weights[stat]) || 0)]));
    const oldValue = values[changedStat];
    const newValue = clamp(Number(requestedValue) || 0, 0, 100);
    let delta = newValue - oldValue;
    values[changedStat] = newValue;
    const others = stats.filter((stat) => stat !== changedStat);
    if (delta > 0) {
      let candidates = others.filter((stat) => values[stat] > 0);
      while (delta > 0.0001 && candidates.length) {
        const share = delta / candidates.length;
        let moved = 0;
        for (const stat of candidates) {
          const amount = Math.min(values[stat], share);
          values[stat] -= amount;
          moved += amount;
        }
        if (moved <= 0.0001) break;
        delta -= moved;
        candidates = candidates.filter((stat) => values[stat] > 0.0001);
      }
      if (delta > 0.0001) values[changedStat] -= delta;
    } else if (delta < 0) {
      let remaining = -delta;
      let candidates = others.filter((stat) => values[stat] < 100);
      while (remaining > 0.0001 && candidates.length) {
        const share = remaining / candidates.length;
        let moved = 0;
        for (const stat of candidates) {
          const amount = Math.min(100 - values[stat], share);
          values[stat] += amount;
          moved += amount;
        }
        if (moved <= 0.0001) break;
        remaining -= moved;
        candidates = candidates.filter((stat) => values[stat] < 99.9999);
      }
      if (remaining > 0.0001) values[changedStat] += remaining;
    }
    assistant.weights = normalizedAssistantWeights(activeProgram().scenario ? activeProgram().scenario.position : activeProgram().position, values);
  }

