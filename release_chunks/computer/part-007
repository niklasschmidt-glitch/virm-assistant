  function activateProfile(profileId) {
    if (!state.profiles[profileId] || profileId === state.activeProfileId) return;
    state.activeProfileId = profileId;
    resetProfileWorkspace();
    editorState = { type: "profiles" };
    scheduleSave({ touchActiveGroup: false });
    renderAll();
    requestGroupPlayerData(state.activeGroupId);
  }

  function addProfile() {
    const ordinal = Math.max(0, ...Object.values(state.profiles).map((profile) => Number(profile.ordinal) || 0)) + 1;
    const profile = createProfileRecord(ordinal);
    state.profiles[profile.id] = profile;
    state.activeProfileId = profile.id;
    resetProfileWorkspace();
    editorState = { type: "profiles" };
    scheduleSave();
    renderAll();
  }

  function openProfileEditor() {
    editorState = editorState.type === "profiles" ? { type: "phase-new" } : { type: "profiles" };
    renderEditor();
  }

  function renderProfileEditor() {
    const title = createEditorTitle("Profil", closeEditor);
    const add = document.createElement("button");
    add.type = "button";
    add.className = "virm-profile-add";
    add.textContent = "+";
    add.title = "Tilføj profil";
    add.setAttribute("aria-label", "Tilføj profil");
    add.addEventListener("click", addProfile);
    title.insertBefore(add, title.lastElementChild);
    refs.editor.appendChild(title);

    const list = document.createElement("div");
    list.className = "virm-profile-list";
    Object.values(state.profiles)
      .sort((left, right) => left.ordinal - right.ordinal)
      .forEach((profile) => {
        const row = document.createElement("div");
        row.className = "virm-profile-row";
        row.classList.toggle("is-active", profile.id === state.activeProfileId);
        row.setAttribute("role", "button");
        row.tabIndex = 0;
        const marker = document.createElement("span");
        marker.className = "virm-profile-marker";
        marker.textContent = profile.id === state.activeProfileId ? "●" : "○";
        const input = document.createElement("input");
        input.type = "text";
        input.className = "virm-profile-name";
        input.maxLength = 60;
        input.value = profile.name;
        input.setAttribute("aria-label", `Profilnavn: ${profile.name}`);
        input.addEventListener("click", (event) => event.stopPropagation());
        input.addEventListener("change", () => {
          profile.name = normalizeText(input.value) || `Profil#${profile.ordinal}`;
          input.value = profile.name;
          scheduleSave({ touchActiveGroup: false });
        });
        const choose = () => activateProfile(profile.id);
        row.addEventListener("click", choose);
        row.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            choose();
          }
        });
        row.append(marker, input);
        list.appendChild(row);
      });
    refs.editor.appendChild(list);
  }

  function renderEditor() {
    refs.editor.replaceChildren();
    if (editorState.type === "closed") editorState = { type: "phase-new" };
    refs.assistantResultsBody = null;
    refs.assistantSearchStatus = null;
    refs.assistantSearchProgress = null;
    refs.assistantSearchButton = null;
    refs.assistantImportButton = null;
    refs.assistantClearButton = null;
    refs.assistantExportSelect = null;
    refs.assistantSearchMethod = null;
    refs.assistantSearchTime = null;
    refs.editor.classList.add("is-open");
    refs.editor.classList.toggle("is-block-editor", editorState.type === "block");
    if (editorState.type === "result" && !activeProgram().sessions.length) editorState = { type: "scenario" };
    const resultOpen = editorState.type === "result";
    const scenarioOpen = ["scenario", "scenario-players", "result"].includes(editorState.type);
    refs.editor.classList.toggle("is-scenario-editor", scenarioOpen);
    refs.editor.classList.toggle("is-result-editor", resultOpen);
    refs.editor.classList.toggle("is-assistant-editor", editorState.type.startsWith("assistant-"));
    refs.editor.classList.toggle("is-profile-editor", editorState.type === "profiles");
    refs.app.classList.toggle("is-scenario-mode", scenarioOpen);
    refs.app.classList.toggle("is-assistant-mode", editorState.type.startsWith("assistant-"));
    if (refs.assistantButton) {
      const assistantOpen = editorState.type.startsWith("assistant-");
      refs.assistantButton.setAttribute("aria-pressed", String(assistantOpen));
      refs.assistantButton.title = assistantOpen ? "Luk Assistent" : "Åbn Assistent";
    }
    if (refs.scenarioButton) {
      const hasTrainingInput = activeProgram().sessions.length > 0;
      const buttonLabel = hasTrainingInput
        ? (resultOpen ? "Scenario" : "Resultat")
        : "Scenario";
      refs.scenarioButton.setAttribute("aria-pressed", String(scenarioOpen));
      refs.scenarioButton.textContent = buttonLabel;
      refs.scenarioButton.title = `Åbn ${buttonLabel}`;
    }
    if (editorState.type === "profiles") {
      renderProfileEditor();
    } else if (editorState.type === "scenario") {
      renderScenarioEditor();
    } else if (editorState.type === "scenario-players") {
      renderScenarioPlayersEditor();
    } else if (editorState.type === "result") {
      renderScenarioEditor(true);
    } else if (editorState.type.startsWith("assistant-")) {
      renderAssistantEditor();
    } else if (editorState.type === "block") {
      renderBlockEditor();
    } else {
      renderPhaseEditor();
    }
  }

  function currentEditorDraftKey() {
    const programId = activeProgram().id;
    if (editorState.type === "phase") return `${programId}:phase:${editorState.itemId}`;
    if (editorState.type === "phase-block") return `${programId}:phase-block:${editorState.parentBlockId}:${editorState.phaseId}`;
    if (editorState.type === "phase-new-block") return `${programId}:phase-new-block:${editorState.parentBlockId}`;
