  function assistantReportLines(result) {
    const program = activeProgram();
    const scenario = program.scenario;
    const assistant = assistantStateForProgram(program);
    const usesWeightedRating = assistantHasCustomWeights(assistant, scenario.position);
    const ratingLines = usesWeightedRating
      ? [`bVT: ${result.weightedRating.toFixed(2)}`, `VT: ${result.rating.toFixed(2)}`]
      : [`VT: ${result.rating.toFixed(2)}`];
    const lines = [
      "VIRM Assistant – Assistentrapport",
      "",
      `Metode: ${result.method}`,
      ...ratingLines,
      `Gennemsnit: ${result.average.toFixed(2)}`,
      `Startalder: ${scenario.ageYears} år ${formatDanishDayCount(scenario.ageDays)}`,
      `XP: ${scenario.xp} ved ${scenario.referenceIntensity} intensitet`,
      "",
      "Slutegenskaber",
      ...Object.entries(result.finalStats).map(([stat, value]) => `${stat}: ${Number(value).toFixed(2)}`),
      "",
      "Træningsprogram",
      result.notes,
    ];
    return lines;
  }

  function downloadTextFile(filename, text, type = "text/plain;charset=utf-8") {
    const blob = new Blob([text], { type });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    link.style.display = "none";
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function exportAssistantResult(kind) {
    const result = selectedAssistantResult();
    if (!result) return;
    const baseName = `${escapeFilename(activeProgram().name)}_Assistent`;
    const lines = assistantReportLines(result);
    if (kind === "Rapport som DOC") {
      const escaped = lines.map((line) => line.replace(/\\/g, "\\\\").replace(/[{}]/g, "\\$&")).join("\\par\n");
      downloadTextFile(`${baseName}.doc`, `{\\rtf1\\ansi\\deff0 ${escaped}}`, "application/rtf");
      return;
    }
    if (kind === "Historik som CSV") {
      const rows = [["Egenskab", "Start", "Slut"]];
      for (const stat of POSITION_STATS[activeProgram().scenario.position]) rows.push([stat, activeProgram().scenario.stats[stat], result.finalStats[stat].toFixed(4)]);
      downloadTextFile(`${baseName}.csv`, rows.map((row) => row.map((value) => `"${String(value).replace(/"/g, '""')}"`).join(";")).join("\n"), "text/csv;charset=utf-8");
      return;
    }
    const popup = window.open("", "_blank");
    if (!popup) {
      showToast("Safari blokerede rapportvinduet.");
      return;
    }
    const html = lines.map((line) => `<div>${String(line).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;") || "&nbsp;"}</div>`).join("");
    popup.document.write(`<!doctype html><meta charset="utf-8"><title>Assistentrapport</title><style>body{font:15px -apple-system,sans-serif;margin:32px;line-height:1.45}div:first-child{font-size:22px;font-weight:700;margin-bottom:16px}</style>${html}<script>setTimeout(()=>print(),250)<\/script>`);
    popup.document.close();
  }

  function saveAssistantSearch() {
    const payload = {
      virm_assistant_search: 1,
      position: activeProgram().scenario ? activeProgram().scenario.position : activeProgram().position,
      scenario: deepClone(activeProgram().scenario),
      settings: deepClone(activeProgram().settings),
      assistant: deepClone(assistantStateForProgram()),
    };
    downloadTextFile(`${escapeFilename(activeProgram().name)}_Assistent.json`, JSON.stringify(payload, null, 2), "application/json");
  }

  async function loadAssistantSearchFile(file) {
    if (!file) return;
    try {
      const payload = JSON.parse(await file.text());
      if (!payload || payload.virm_assistant_search !== 1 || !payload.assistant) throw new Error("Filen indeholder ikke en Assistent-søgning.");
      const program = activeProgram();
      if (payload.scenario) program.scenario = normalizeScenario(payload.scenario, program.position);
      if (payload.settings) {
        program.settings.experienceBonus = Boolean(payload.settings.experienceBonus);
        program.settings.experienceRatio = clamp(Number(payload.settings.experienceRatio) || 1.10, 1.01, 1.15);
        program.settings.gradient = ["early", "linear", "late"].includes(payload.settings.gradient) ? payload.settings.gradient : "linear";
      }
      program.assistant = normalizeAssistantState(payload.assistant, program.scenario ? program.scenario.position : program.position, program.scenario);
      program.assistant.view = "simulation";
      editorState = { type: "assistant-simulation" };
      persistAssistantChange();
      renderAll();
      showToast("Assistent-søgningen blev indlæst.");
    } catch (error) {
      window.alert(`Assistent-søgningen kunne ikke indlæses.\n\n${error.message || error}`);
    }
  }

