  function rotationJsonValueAfterAssignment(source, startIndex) {
    const text = String(source || '');
    let start = Number(startIndex) || 0;
    while (start < text.length && /\s/.test(text[start])) start += 1;
    const opening = text[start];
    const closing = opening === '{' ? '}' : opening === '[' ? ']' : '';
    if (!closing) return null;
    let depth = 0;
    let quote = '';
    let escaped = false;
    for (let index = start; index < text.length; index += 1) {
      const character = text[index];
      if (quote) {
        if (escaped) escaped = false;
        else if (character === '\\') escaped = true;
        else if (character === quote) quote = '';
        continue;
      }
      if (character === '"' || character === "'") {
        quote = character;
        continue;
      }
      if (character === opening) depth += 1;
      else if (character === closing && --depth === 0) {
        try {
          return JSON.parse(text.slice(start, index + 1));
        } catch (_) {
          return null;
        }
      }
    }
    return null;
  }

  function rotationPlayersDataFromHtml(html) {
    const raw = String(html || '').replace(/\\\//g, '/');
    for (const match of raw.matchAll(/(?:window\.)?playersData\s*=\s*/gi)) {
      const data = rotationJsonValueAfterAssignment(raw, match.index + match[0].length);
      if (data && typeof data === 'object' && Array.isArray(data.players)) return data;
    }
    return null;
  }

  function rotationClubIdFromPlayersData(data, squadId = '') {
    const target = String(squadId || '');
    for (const squad of Array.isArray(data?.squads) ? data.squads : []) {
      if (target && String(squad?.id ?? '') !== target) continue;
      const clubId = String(squad?.club_id ?? squad?.club?.id ?? '');
      if (/^\d+$/.test(clubId)) return clubId;
    }
    for (const player of Array.isArray(data?.players) ? data.players : []) {
      const playerSquadId = String(player?.squad_id ?? player?.squad?.id ?? '');
      if (target && playerSquadId !== target) continue;
      const clubId = String(player?.squad?.club_id ?? player?.squad?.club?.id ?? '');
      if (/^\d+$/.test(clubId)) return clubId;
    }
    return '';
  }

  function rotationSquadKvFromPlayersData(data, squadId = '') {
    if (!data || !Array.isArray(data.players)) return null;
    const target = String(squadId || '');
    const squadPriority = teamKind === 'youth' ? 2 : 1;
    const fallbackIds = new Set((Array.isArray(data.squads) ? data.squads : [])
      .filter(squad => Number(squad?.priority) === squadPriority && squad?.id != null)
      .map(squad => String(squad.id)));
    let players = data.players.filter(player => {
      const playerSquadId = String(player?.squad_id ?? player?.squad?.id ?? '');
      if (target) return playerSquadId === target;
      return Number(player?.squad?.priority) === squadPriority || fallbackIds.has(playerSquadId);
    });
    if (!players.length && target) {
      players = data.players.filter(player => {
        const playerSquadId = String(player?.squad_id ?? player?.squad?.id ?? '');
        return Number(player?.squad?.priority) === squadPriority || fallbackIds.has(playerSquadId);
      });
    }
    const ratings = players
      .map(player => Number(player?.rating))
      .filter(value => Number.isFinite(value) && value >= 0 && value <= 100)
      .sort((left, right) => right - left);
    if (!ratings.length) return null;
    const selected = ratings.slice(0, Math.min(11, ratings.length));
    const average = selected.reduce((sum, value) => sum + value, 0) / selected.length;
    return average > 0 ? { average, playerCount: selected.length, source: 'squad' } : null;
  }

  async function loadStandardOpponentKv(match) {
    let clubId = String(match?.opponentClubId || '');
    const squadId = String(match?.opponentSquadId || '');
    let result = null;
    if (/^\d+$/.test(squadId)) {
      try {
        const page = await fetchRotationDebugDocument(`/squads/${squadId}`);
        if (page.ok) {
          const data = rotationPlayersDataFromHtml(page.html);
          result = rotationSquadKvFromPlayersData(data, squadId);
          clubId = clubId
            || rotationClubIdFromPlayersData(data, squadId)
            || clubIdFromSquadPage(page, squadId, match?.opponent);
        }
      } catch (_) {}
    }
    if (!result && /^\d+$/.test(clubId)) {
      try {
        const page = await fetchRotationDebugDocument(`/clubs/${clubId}/players`);
        if (page.ok) result = rotationSquadKvFromPlayersData(rotationPlayersDataFromHtml(page.html), squadId);
      } catch (_) {}
    }
    if (!result) return null;
    if (/^\d+$/.test(clubId)) match.opponentClubId = clubId;
    return { ...result, clubId, squadId, updatedAt: Date.now() };
  }

  function validDirectOpponentKv(result) {
    return Boolean(kvModeApi?.isValidStart11?.(result));
  }

  function validStandardOpponentKv(result) {
    const average = Number(result?.average);
    return Number.isFinite(average) && average > 0;
  }

  async function loadSpecialOpponentKvs() {
    const api = window.__VIRM_KV_START11_CACHE_V1__;
    const targets = session.matches.filter(match => {
      const competition = matchCompetitionKey(match);
      return (competition === 'cup' || competition === 'friendly') && opponentKvForMatch(match) === null;
    });
    const summary = {
      attempted: targets.length,
      succeeded: 0,
      cupAttempted: targets.filter(match => matchCompetitionKey(match) === 'cup').length,
      cupSucceeded: 0,
      friendlyAttempted: targets.filter(match => matchCompetitionKey(match) === 'friendly').length,
      friendlySucceeded: 0
    };
    if (!targets.length) return summary;

    const standardShared = new Map();
    const directShared = new Map();
    const succeededMatches = new Set();
    const markSucceeded = match => {
      const matchKey = String(match.matchId || match.selectionId || '');
      if (succeededMatches.has(matchKey)) return;
      succeededMatches.add(matchKey);
      summary.succeeded += 1;
      if (matchCompetitionKey(match) === 'cup') summary.cupSucceeded += 1;
      else summary.friendlySucceeded += 1;
    };
    let cursor = 0;
    const workers = Array.from({ length: Math.min(2, targets.length) }, async () => {
      while (true) {
        const index = cursor++;
        if (index >= targets.length) return;
        const match = targets[index];
        const standardKey = `${match.opponentSquadId || ''}:${match.opponentClubId || ''}:${normalizeText(match.opponent)}:${teamKind}`;
        let standardPromise = standardShared.get(standardKey);
        if (!standardPromise) {
          standardPromise = loadStandardOpponentKv(match);
          standardShared.set(standardKey, standardPromise);
        }
        let standardFound = false;
        try {
          const standard = await standardPromise;
          if (validStandardOpponentKv(standard)) {
            standardFound = true;
            session.standardOpponentKv[String(match.matchId)] = standard;
            markSucceeded(match);
            if (session.panel?.isConnected) renderPreview(session.panel);
          }
        } catch (_) {}

        if (!session.kvStart11Enabled || !api?.lineupKvForClub) continue;
        const clubId = String(match.opponentClubId || '') || await resolveOpponentClubId(match);
        if (!/^\d+$/.test(clubId)) continue;
        const directKey = `${clubId}:${match.opponentSquadId || ''}:${teamKind}`;
        let directPromise = directShared.get(directKey);
        if (!directPromise) {
          directPromise = Promise.resolve().then(() => api.lineupKvForClub(clubId, teamKind, match.opponentSquadId || ''));
          directShared.set(directKey, directPromise);
        }
        const acceptDirect = result => {
          if (!validDirectOpponentKv(result)) return;
          session.directOpponentKv[String(match.matchId)] = result;
          markSucceeded(match);
          if (session.panel?.isConnected) renderPreview(session.panel);
        };
        directPromise.then(acceptDirect).catch(() => {});
        if (!standardFound) {
          const direct = await Promise.race([
            directPromise.catch(() => null),
            new Promise(resolve => window.setTimeout(() => resolve(null), 6000))
          ]);
          acceptDirect(direct);
        }
      }
    });
    await Promise.all(workers);
    if (session.panel?.isConnected) renderPreview(session.panel);
    return summary;
  }

  async function initialize() {
    const root = document.querySelector('#content .side_navigationed > .coming_matches')
      || document.querySelector('.coming_matches');
    if (!root) return false;

    const scanned = scanPage();
    session.tactics = scanned.tactics;
    session.matches = scanned.matches;
    session.stateKey = buildStateKey(session.tactics);
    await loadState();
    session.kvStart11Enabled = kvModeApi?.getEnabled ? await kvModeApi.getEnabled(teamKind) : (await storageGet(KV_START11_ENABLED_KEY)) !== false;

    const panel = createPanel();
    session.panel = panel;
    const heading = root.querySelector('h1');
    const table = scanned.table;
    if (table?.parentNode) table.parentNode.insertBefore(panel, table);
    else if (heading?.parentNode) heading.parentNode.insertBefore(panel, heading.nextSibling);
    else root.prepend(panel);

    if (heading && session.menuWrap) {
      heading.classList.add('virm-assistant-overview-heading-host', 'virm-assistant-coming-heading-host');
      heading.appendChild(session.menuWrap);
    }

    renderTactics(panel);
    session.initialSyncPending = true;
    renderPreview(panel);
    const api = window.__VIRM_KV_START11_CACHE_V1__;
    if (api?.subscribe && !session.kvUnsubscribe) {
      session.kvUnsubscribe = api.subscribe(cache => syncKvCache(cache));
    }
    setStatus('Henter kamphistorik og modstandernes KV…', 'muted');
    ensureKvTeamCache().catch(error => {
      console.warn('[VIRM Assistant] Den indledende KV-synkronisering fejlede.', error);
    });

    let backgroundSettled = false;
    const background = Promise.all([
      syncHistoricalAssignments(),
      loadSpecialOpponentKvs()
    ]).then(([historySync, specialKvSync]) => {
      backgroundSettled = true;
      session.initialSyncPending = false;
      renderPreview(panel);
      const cupStatus = specialKvSync.cupAttempted
        ? ` Cup-KV: ${specialKvSync.cupSucceeded}/${specialKvSync.cupAttempted}.`
        : '';
      const friendlyStatus = specialKvSync.friendlyAttempted
        ? ` Venskab-KV: ${specialKvSync.friendlySucceeded}/${specialKvSync.friendlyAttempted}.`
        : '';
      setStatus(
        session.matches.length
          ? `${session.matches.length} kommende ${session.matches.length === 1 ? 'kamp blev' : 'kampe blev'} fundet.${cupStatus}${friendlyStatus}`
          : 'Der er ingen kommende kampe på siden.',
        'muted'
      );
    }).catch(error => {
      backgroundSettled = true;
      session.initialSyncPending = false;
      renderPreview(panel);
      setStatus(`Modulet er klar. KV-opdateringen fejlede: ${String(error?.message || error)}`, 'error');
    });

    window.setTimeout(() => {
      if (backgroundSettled || !panel.isConnected) return;
      session.initialSyncPending = false;
      renderPreview(panel);
      setStatus('Modulet er klar. KV-opdateringen fortsætter i baggrunden…', 'muted');
    }, 12000);
    background.catch(() => {});

    return true;
  }

  function boot() {
    initialize().catch(error => {
      console.error('[VIRM Assistant] Taktikrotation kunne ikke startes.', error);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
  else boot();
})();


