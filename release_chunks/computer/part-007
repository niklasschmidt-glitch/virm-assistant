      window.addEventListener("resize", schedule, { passive: true });
      window.addEventListener("scroll", schedule, { passive: true });
      window.visualViewport?.addEventListener?.("resize", schedule, { passive: true });
      window.visualViewport?.addEventListener?.("scroll", schedule, { passive: true });
    }
    return layer;
  }

  function positionNextMatchKvBadge(badge) {
    const anchor = badge?.__virmKvAnchor;
    if (!badge || !anchor?.isConnected) {
      if (badge) badge.style.setProperty("display", "none", "important");
      return;
    }
    const rect = anchor.getBoundingClientRect();
    if (!rect.width || !rect.height) {
      badge.style.setProperty("display", "none", "important");
      return;
    }
    const layer = badge.parentElement;
    const layerRect = layer?.getBoundingClientRect?.();
    if (!layerRect) {
      badge.style.setProperty("display", "none", "important");
      return;
    }
    const size = 29;
    // Begge rects er målt i samme koordinatsystem. Differencen er derfor stabil
    // ved både almindelig scroll og Safari pinch-zoom, uden visualViewport-offsets.
    const left = (rect.right - layerRect.left) + 5;
    const top = (rect.top - layerRect.top) + ((rect.height - size) / 2);
    badge.style.setProperty("left", `${left}px`, "important");
    badge.style.setProperty("top", `${top}px`, "important");
    badge.style.setProperty("display", "flex", "important");
  }

  function scheduleNextMatchKvOverlayPosition() {
    if (nextMatchKvPositionFrame) return;
    nextMatchKvPositionFrame = requestAnimationFrame(() => {
      nextMatchKvPositionFrame = 0;
      document.querySelectorAll(".virm-team-overview-next-match-kv").forEach(positionNextMatchKvBadge);
    });
  }

  function createNextMatchKvBadge(value, side, source = "start11") {
    const numeric = Number(value);
    if (!Number.isFinite(numeric) || numeric <= 0) return null;
    const displayed = Math.round(numeric);
    const style = virmOfficialRatingStyleForDisplayedValue(displayed);
    if (!style) return null;

    const badge = document.createElement("span");
    badge.className = `virm-team-overview-next-match-kv virm-team-overview-next-match-kv-${side}`;
    badge.textContent = String(displayed);
    const precise = numeric.toLocaleString("da-DK", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    badge.title = source === "vman"
      ? `VMAN KV: ${precise}`
      : `KV baseret på startopstilling: ${precise}`;
    badge.dataset.virmKvSource = source;
    badge.style.setProperty("box-sizing", "border-box", "important");
    // 0.1.330: Stort KV som layout-neutralt dokument-overlay. Badge og overlay
    // ligger helt uden for VMANs klub-/pitch-flow og ændrer hverken højder eller
    // spillerpositioner; dokumentkoordinaterne gør placeringen zoom-stabil på iOS.
    badge.style.setProperty("position", "absolute", "important");
    badge.style.setProperty("display", "flex", "important");
    badge.style.setProperty("align-items", "center", "important");
    badge.style.setProperty("justify-content", "center", "important");
    badge.style.setProperty("width", "29px", "important");
    badge.style.setProperty("height", "29px", "important");
    badge.style.setProperty("min-width", "29px", "important");
    badge.style.setProperty("min-height", "29px", "important");
    badge.style.setProperty("max-width", "29px", "important");
    badge.style.setProperty("max-height", "29px", "important");
    badge.style.setProperty("margin", "0", "important");
    badge.style.setProperty("padding", "0", "important");
    badge.style.setProperty("border", `2px solid ${style.borderColor}`, "important");
    badge.style.setProperty("border-radius", "50%", "important");
    badge.style.setProperty("background", style.background, "important");
    badge.style.setProperty("background-color", style.background, "important");
    badge.style.setProperty("color", "#fff", "important");
    badge.style.setProperty("font", "400 13px/1 Arial,Helvetica,sans-serif", "important");
    badge.style.setProperty("text-align", "center", "important");
    badge.style.setProperty("text-shadow", `0 -1px 0 ${style.borderColor}`, "important");
    badge.style.setProperty("white-space", "nowrap", "important");
    badge.style.setProperty("pointer-events", "none", "important");
    return badge;
  }

  function removeNextMatchKvBadges() {
    document.querySelectorAll(".virm-team-overview-next-match-kv").forEach(node => node.remove());
    const layer = document.getElementById(NEXT_MATCH_KV_OVERLAY_ID);
    if (layer && !layer.children.length) layer.remove();
  }

  function placeNextMatchKvBadge(nameNode, badge) {
    if (!nameNode || !badge) return false;
    const layer = ensureNextMatchKvOverlay();
    badge.__virmKvAnchor = nameNode;
    layer.appendChild(badge);
    positionNextMatchKvBadge(badge);
    scheduleNextMatchKvOverlayPosition();
    setTimeout(scheduleNextMatchKvOverlayPosition, 100);
    setTimeout(scheduleNextMatchKvOverlayPosition, 500);
    return true;
  }

  async function renderNextMatchKv(team, enabled) {
    const renderToken = ++nextMatchKvRenderToken;
    removeNextMatchKvBadges();

    const area = nextMatchArea();
    if (!area) return;
    const id = nextMatchId(area);
    const matches = Object.values(team?.matches || {});
    const match = (id && team?.matches?.[id]) || matches[0] || null;
    const nodes = nextMatchClubNodes(area, match);
    if (!nodes.ownNode && !nodes.opponentNode) return;

    const ownStart11Valid = enabled && Boolean(kvModeApi?.isValidStart11?.(match?.ownKv));
    const opponentStart11Valid = enabled && Boolean(kvModeApi?.isValidStart11?.(match?.opponentKv));
    let ownAverage = ownStart11Valid ? finiteKv(match?.ownKv?.average) : NaN;
    let opponentAverage = opponentStart11Valid ? finiteKv(match?.opponentKv?.average) : NaN;
    if (!(ownAverage > 0)) ownAverage = NaN;
    if (!(opponentAverage > 0)) opponentAverage = NaN;
    let ownSource = Number.isFinite(ownAverage) ? "start11" : "vman";
    let opponentSource = Number.isFinite(opponentAverage) ? "start11" : "vman";

    // Afmarkeret = VMANs egne værdier, ikke intet ikon. Egen standard-KV findes
    // allerede på Holdoversigten som "Vurdering"; modstanderens standard-KV
    // hentes fra VMANs Kommende kampe-tabel, hvor VMAN selv viser KV.
    if (!Number.isFinite(ownAverage)) {
      ownAverage = nativeTeamOverviewKv();
      ownSource = "vman";
    }
    if (!Number.isFinite(opponentAverage)) {
      opponentAverage = await vmanOpponentKvForMatch(id, match);
      opponentSource = "vman";
    }
    if (renderToken !== nextMatchKvRenderToken) return;

    removeNextMatchKvBadges();
    if (nodes.ownNode?.isConnected && Number.isFinite(ownAverage)) {
      placeNextMatchKvBadge(nodes.ownNode, createNextMatchKvBadge(ownAverage, "own", ownSource));
    }
    if (nodes.opponentNode?.isConnected && Number.isFinite(opponentAverage)) {
      placeNextMatchKvBadge(nodes.opponentNode, createNextMatchKvBadge(opponentAverage, "opponent", opponentSource));
    }
  }

  function rememberOriginalRating(node) {
    if (!node || node.dataset.virmTeamOverviewKvRemembered === "1") return;
    node.dataset.virmTeamOverviewKvRemembered = "1";
    node.dataset.virmTeamOverviewKvOriginalText = node.textContent || "";
    node.dataset.virmTeamOverviewKvOriginalTitle = node.getAttribute("title") || "";
    const visual = ratingVisualNode(node);
    node.__virmTeamOverviewKvVisualNode = visual;
    node.__virmTeamOverviewKvVisualOriginalStyle = visual?.getAttribute("style") ?? null;
  }

  function restoreRating() {
    const node = ratingValueNode();
    if (!node || node.dataset.virmTeamOverviewKvRemembered !== "1") return;
    node.textContent = node.dataset.virmTeamOverviewKvOriginalText || "";
    const title = node.dataset.virmTeamOverviewKvOriginalTitle || "";
    if (title) node.setAttribute("title", title);
    else node.removeAttribute("title");
    const visual = node.__virmTeamOverviewKvVisualNode || ratingVisualNode(node);
    if (visual) {
      const originalStyle = node.__virmTeamOverviewKvVisualOriginalStyle;
      if (originalStyle == null) visual.removeAttribute("style");
      else visual.setAttribute("style", originalStyle);
    }
    node.classList.remove("virm-team-overview-kv-start11-active");
  }

  function controls() {
    const control = document.getElementById(CONTROL_ID);
    return {
      control,
      checkbox: control?.querySelector('input[type="checkbox"]') || null,
      status: control?.querySelector(".virm-team-overview-kv-status") || null,
    };
  }

  function setStatus(message, kind = "") {
    const { status } = controls();
    if (!status) return;
    status.textContent = message;
    status.dataset.kind = kind;
  }

  async function renderFromCache(cache = null) {
    const requestState = await dataRequestState();
    if (requestState.disabled) {
      restoreRating();
      removeNextMatchKvBadges();
      setStatus("");
      return;
    }
    const { checkbox } = controls();
    if (!checkbox) return;
    if (!checkbox.checked) {
      restoreRating();
      await renderNextMatchKv(null, false);
      setStatus("");
      return;
    }
    const current = cache || await api.getCache();
    const team = current.teams?.senior;
    const isRefreshing = Boolean(current.refreshing?.teamKinds?.includes?.("senior"));
    await renderNextMatchKv(team, true);
    if (!team) {
      restoreRating();
      setStatus(isRefreshing ? "Opdaterer…" : "Afventer dagens KV-data…", "muted");
      return;
    }
    if (team.seasonAverage == null || !Number.isFinite(Number(team.seasonAverage))) {
      restoreRating();
      if (isRefreshing) setStatus("Opdaterer…", "muted");
      else if (team.error) setStatus("Seneste opdatering fejlede.", "error");
      else if (team.matchCount && team.failed) setStatus(`${team.succeeded}/${team.matchCount} kampe kunne beregnes.`, "error");
      else setStatus("Ingen kommende kampe at beregne.", "muted");
      return;
    }

    const node = ratingValueNode();
    if (!node) {
      setStatus("Vurdering kunne ikke findes.", "error");
      return;
    }
    rememberOriginalRating(node);
    const average = Number(team.seasonAverage);
    node.textContent = String(Math.round(average));
    applyTeamOverviewRatingColor(node, average, team.ratingPalette || []);
    const precise = average.toLocaleString("da-DK", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    node.title = `Beregn KV baseret på startopstilling: ${precise} · gennemsnit af ${team.matchCount} kommende ${team.matchCount === 1 ? "kamp" : "kampe"}`;
    node.classList.add("virm-team-overview-kv-start11-active");
    if (isRefreshing) {
      setStatus("Opdaterer…", "muted");
    } else {
      const time = api.formatUpdatedAt(team.updatedAt);
      setStatus(time ? `Opdateret ${time}` : "Beregn KV baseret på startopstilling opdateret.", "success");
    }
  }


  function overviewHeading() {
    return exactTextElement(["Holdoversigt", "Team overview"]);
  }

  function overviewHeadingHost() {
    const heading = overviewHeading();
    if (!heading) return null;
    return heading.closest("h1,h2,h3,h4,h5") || heading;
  }

  function switchOverviewTeam() {
    const localeMatch = String(window.location.pathname || "").match(/^\/([a-z]{2})(?=\/)/i);
    const prefix = localeMatch ? `/${localeMatch[1]}` : "";
    const targetUrl = new URL(`${prefix}/youth_squad`, window.location.origin).href;
    if (typeof window.__VIRM_EXTENSION_NAVIGATE__ === "function") {
      window.__VIRM_EXTENSION_NAVIGATE__(targetUrl);
      return;
    }
    window.location.assign(targetUrl);
  }

  function closeOverviewMenu(control) {
    const menu = control?.querySelector(".virm-assistant-overview-popup-menu");
    const button = control?.querySelector(".virm-assistant-overview-menu-button");
    const mainView = control?.querySelector(".virm-assistant-overview-menu-main");
    const requestView = control?.querySelector(".virm-assistant-overview-menu-data-requests");
    menu?.classList.remove("is-open");
    button?.setAttribute("aria-expanded", "false");
    if (mainView) mainView.hidden = false;
    if (requestView) requestView.hidden = true;
  }

  function currentControls() {
    return Array.from(document.querySelectorAll(`[id="${CONTROL_ID}"]`));
  }

  function cleanDuplicateControls() {
    const found = currentControls();
    let current = found.find(control => control.classList.contains("virm-assistant-overview-header-menu")) || null;
    for (const control of found) {
      if (control !== current) control.remove();
    }
    return current;
  }

  async function syncDataRequestMenu(control) {
    if (!control) return;
    const current = await dataRequestState();
    const label = control.querySelector(".virm-assistant-overview-checkbox-item");
    const triggerText = control.querySelector(".virm-assistant-data-request-trigger-text");
    const pageToggle = control.querySelector(".virm-assistant-data-request-page-toggle");
    const globalToggle = control.querySelector(".virm-assistant-data-request-global-toggle");
    const pageCheckbox = control.querySelector(".virm-assistant-data-request-page-checkbox");
    const globalCheckbox = control.querySelector(".virm-assistant-data-request-global-checkbox");
    const globalEnabled = !current.globalDisabled;
    const pageEnabled = globalEnabled && !current.pageDisabled;
    if (label) label.classList.toggle("virm-assistant-hidden-menu-item", current.disabled);
    if (triggerText) triggerText.textContent = "Indstil data request";
    if (pageToggle) pageToggle.title = globalEnabled ? "" : "Aktivér Globalt først";
    if (pageCheckbox) {
      pageCheckbox.checked = pageEnabled;
      pageCheckbox.disabled = !globalEnabled;
    }
    if (globalCheckbox) globalCheckbox.checked = globalEnabled;
  }

  async function applyDataRequestScope(control, scope) {
    if (!dataRequestApi) return;
    const current = await dataRequestState();
    if (scope === "page") {
      if (current.globalDisabled) return;
      await dataRequestApi.setPageDisabled(!current.pageDisabled);
    } else if (scope === "global") {
      await dataRequestApi.setGlobalDisabled(!current.globalDisabled);
      // Globalt er master-indstillingen; genindlæs så hele VIRM-overfladen
      // afspejler den nye effektive tilstand med det samme.
      window.location.reload();
      return;
    } else {
      return;
    }

    const next = await dataRequestState();
    await syncDataRequestMenu(control);
    if (next.disabled) {
      restoreRating();
      removeNextMatchKvBadges();
      setStatus("");
      closeOverviewMenu(control);
      return;
    }

    // Ved genaktivering af "Denne side" genindlæses siden, så alle
    // request-baserede VIRM-moduler starter rent igen.
    window.location.reload();
  }

  async function createControl() {
    if (cleanDuplicateControls()) return true;
    const host = overviewHeadingHost();
    if (!host) return false;
    const enabled = kvModeApi?.getEnabled ? await kvModeApi.getEnabled('senior') : (await storageGet(ENABLED_KEY)) !== false;
    if (cleanDuplicateControls()) return true;

    host.classList.add("virm-assistant-overview-heading-host");

    const control = document.createElement("div");
    control.id = CONTROL_ID;
    control.className = "virm-assistant-overview-header-menu";

    const menuButton = document.createElement("button");
    menuButton.type = "button";
    menuButton.className = "virm-assistant-overview-menu-button";
    menuButton.textContent = "☰";
    menuButton.title = "Hovedmenu";
    menuButton.setAttribute("aria-label", "Hovedmenu");
    menuButton.setAttribute("aria-haspopup", "menu");
    menuButton.setAttribute("aria-expanded", "false");

    const popup = document.createElement("div");
    popup.className = "virm-assistant-overview-popup-menu";
    popup.setAttribute("role", "menu");

    const mainView = document.createElement("div");
    mainView.className = "virm-assistant-overview-menu-main";

    const label = document.createElement("label");
    label.className = "virm-assistant-overview-popup-item virm-assistant-overview-checkbox-item";
    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.checked = enabled;
    const text = document.createElement("span");
    text.textContent = "Beregn KV baseret på startopstilling";
    label.append(checkbox, text);

    const requestTrigger = document.createElement("button");
    requestTrigger.type = "button";
    requestTrigger.className = "virm-assistant-overview-popup-item virm-assistant-overview-submenu-trigger";
    const requestTriggerText = document.createElement("span");
    requestTriggerText.className = "virm-assistant-data-request-trigger-text";
    requestTriggerText.textContent = "Indstil data request";
    const requestArrow = document.createElement("span");
    requestArrow.className = "virm-assistant-overview-submenu-arrow";
    requestArrow.textContent = "›";
    requestTrigger.append(requestTriggerText, requestArrow);
    mainView.append(label, requestTrigger);

    const requestView = document.createElement("div");
    requestView.className = "virm-assistant-overview-menu-data-requests";
    requestView.hidden = true;

    const pageButton = document.createElement("label");
    pageButton.className = "virm-assistant-overview-popup-item virm-assistant-data-request-checkbox-item virm-assistant-data-request-page-toggle";
    const pageCheckbox = document.createElement("input");
    pageCheckbox.type = "checkbox";
    pageCheckbox.className = "virm-assistant-data-request-page-checkbox";
    const pageText = document.createElement("span");
    pageText.textContent = "Denne side";
    pageButton.append(pageCheckbox, pageText);

    const globalButton = document.createElement("label");
    globalButton.className = "virm-assistant-overview-popup-item virm-assistant-data-request-checkbox-item virm-assistant-data-request-global-toggle";
    const globalCheckbox = document.createElement("input");
    globalCheckbox.type = "checkbox";
    globalCheckbox.className = "virm-assistant-data-request-global-checkbox";
    const globalText = document.createElement("span");
    globalText.textContent = "Globalt";
    globalButton.append(globalCheckbox, globalText);

    const backButton = document.createElement("button");
    backButton.type = "button";
    backButton.className = "virm-assistant-overview-popup-item virm-assistant-overview-submenu-back";
    backButton.textContent = "‹";
    backButton.title = "Tilbage";
    backButton.setAttribute("aria-label", "Tilbage");

    requestView.append(pageButton, globalButton, backButton);
    popup.append(mainView, requestView);
    control.append(menuButton, popup);
    host.appendChild(control);
    cleanDuplicateControls();

    menuButton.addEventListener("click", event => {
      event.stopPropagation();
      const open = popup.classList.toggle("is-open");
      menuButton.setAttribute("aria-expanded", open ? "true" : "false");
      if (open) globalThis.__VIRM_REPORTING_V1__?.injectMenu?.(popup);
      if (open) {
        mainView.hidden = false;
        requestView.hidden = true;
        syncDataRequestMenu(control).catch(() => {});
      }
    });
    checkbox.addEventListener("change", async () => {
      if (kvModeApi?.setEnabled) await kvModeApi.setEnabled('senior', checkbox.checked, 'team-overview');
      else await storageSet(ENABLED_KEY, checkbox.checked);
      renderFromCache();
    });
    requestTrigger.addEventListener("click", event => {
      event.stopPropagation();
      mainView.hidden = true;
      requestView.hidden = false;
    });
    pageCheckbox.addEventListener("change", event => {
      event.stopPropagation();
      applyDataRequestScope(control, "page").catch(error => console.warn("[VIRM Assistant] Data request-indstilling fejlede.", error));
    });
    globalCheckbox.addEventListener("change", event => {
      event.stopPropagation();
      applyDataRequestScope(control, "global").catch(error => console.warn("[VIRM Assistant] Data request-indstilling fejlede.", error));
    });
    backButton.addEventListener("click", event => {
      event.stopPropagation();
      mainView.hidden = false;
      requestView.hidden = true;
    });
    document.addEventListener("click", event => {
      if (control.isConnected && !control.contains(event.target)) closeOverviewMenu(control);
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && control.isConnected) closeOverviewMenu(control);
    });
    document.addEventListener("virm:data-requests-changed", () => {
      syncDataRequestMenu(control).catch(() => {});
      renderFromCache().catch(() => {});
    });
    document.addEventListener("virm:kv-mode-changed", event => {
      const detail = event?.detail || {};
      if ((detail.kind || detail.teamKind) !== "senior") return;
      checkbox.checked = Boolean(detail.enabled);
      renderFromCache().catch(() => {});
    });

    await syncDataRequestMenu(control);
    await renderFromCache();
    return true;
  }

  function boot() {
    createControl().then(done => {
      if (done) return;
      const observer = new MutationObserver(() => {
        createControl().then(created => { if (created) observer.disconnect(); });
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(() => observer.disconnect(), 20000);
    });
    api.subscribe(cache => renderFromCache(cache));
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, { once: true });
  else boot();
})();



// 0.1.315: KV-ikoner og VIRM-hamburgermenu på alle optaktsider
// (/new_matches/<id>/tactics), med samme start-11/data-request-logik som Holdoversigt.
(() => {
  "use strict";

  const path = String(window.location.pathname || "").replace(/\/+$/, "") || "/";
  const pathMatch = path.match(/^\/(?:[a-z]{2}\/)?new_matches\/(\d+)\/tactics$/i);
  if (!pathMatch) return;

  const matchId = String(pathMatch[1] || "");
  const api = window.__VIRM_KV_START11_CACHE_V1__ || null;
  if (!api) return;
  const kvModeApi = globalThis.__VIRM_KV_MODE_V1__ || null;
  const dataRequestApi = window.__VIRM_DATA_REQUESTS_V1__ || null;
  const CONTROL_ID = "virm-assistant-match-tactics-menu";
  const BADGE_CLASS = "virm-assistant-match-tactics-kv";
  const ROW_CLASS = "virm-assistant-match-tactics-kv-row";
  const OVERLAY_ID = "virm-assistant-match-tactics-kv-overlay";
  const OWN_STANDARD_CACHE_KEY = "virmAssistantMatchTacticsOwnStandardKvDailyV1";
  let renderToken = 0;
  let ownStandardPromise = null;
  let overlayPositionFrame = 0;

  function normalizeText(value) {
    return String(value == null ? "" : value).replace(/\s+/g, " ").trim();
  }

  function normalizeKey(value) {
    return normalizeText(value).normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("da");
  }

  async function storageGet(key) {
    const result = await chrome.storage.local.get(key);
    return result ? result[key] : undefined;
  }

  async function storageSet(key, value) {
    await chrome.storage.local.set({ [key]: value });
  }

  async function dataRequestState() {
    if (!dataRequestApi?.getState) return { globalDisabled: false, pageDisabled: false, disabled: false };
    return dataRequestApi.getState();
  }

  function teamKind(cache = null) {
    if (cache?.teams?.youth?.matches?.[matchId]) return "youth";
    if (cache?.teams?.senior?.matches?.[matchId]) return "senior";
    if (document.querySelector('a[href^="/youth_squad/tactics/"][href*="match_id"], a[href^="/youth_squad/tactics/"][href$="/edit"]')) return "youth";
    return "senior";
  }

  function enabledKey(kind) {
    return `virmAssistantKvStart11EnabledV3_${kind === "youth" ? "youth" : "senior"}`;
  }

  function heading() {
    return document.querySelector("#content .match_tactics > h1")
      || Array.from(document.querySelectorAll("#content h1")).find(node => /(?:taktik|tactic)/i.test(normalizeText(node.textContent)))
      || null;
  }

  function ownSquadName(kind) {
    const priority = kind === "youth" ? 2 : 1;
    for (const script of document.querySelectorAll("script")) {
      const source = String(script.textContent || "");
      let match = source.match(new RegExp(`"priority"\\s*:\\s*${priority}\\b[^{}]{0,1400}?"name"\\s*:\\s*"((?:\\\\.|[^"\\\\])*)"`, "i"));
      if (!match) match = source.match(new RegExp(`"name"\\s*:\\s*"((?:\\\\.|[^"\\\\])*)"[^{}]{0,1400}?"priority"\\s*:\\s*${priority}\\b`, "i"));
      if (!match?.[1]) continue;
      try { return JSON.parse(`"${match[1]}"`); }
      catch (_) { return match[1].replace(/\\(["\\/bfnrt])/g, "$1"); }
    }
    return "";
  }

  function opponentNameFromHeading() {
    // Brug document.title, ikke H1.textContent. Hamburgermenuen ligger inde i H1,
    // så dens tekst må aldrig kunne blive en del af modstanderens klubnavn.
    const raw = normalizeText(document.title || heading()?.firstChild?.textContent || "");
    return raw
      .replace(/\s*\|\s*Virtual Manager.*$/i, "")
      .replace(/^\s*(?:Taktik\s+imod|Tactic(?:s)?\s+against)\s+/i, "")
      .trim();
  }

  function finiteKv(value) {
    if (value === null || value === undefined || value === "") return NaN;
    const numeric = Number(String(value).replace(",", "."));
    return Number.isFinite(numeric) ? numeric : NaN;
  }

  function ensureKvOverlay() {
    let layer = document.getElementById(OVERLAY_ID);
    if (layer) return layer;
    layer = document.createElement("div");
    layer.id = OVERLAY_ID;
    layer.setAttribute("aria-hidden", "true");
    layer.dataset.virmLayoutNeutralOverlay = "1";
    // 0.1.331: Samme zoom-stabile dokument-overlay som på Holdoversigt.
    // Laget er 0x0 og ligger uden for VMANs kamp-DOM, så 29 px KV kan aldrig
    // ændre klubrække, banehøjde eller spillernes koordinater.
    layer.style.setProperty("position", "absolute", "important");
    layer.style.setProperty("left", "0", "important");
    layer.style.setProperty("top", "0", "important");
    layer.style.setProperty("width", "0", "important");
    layer.style.setProperty("height", "0", "important");
    layer.style.setProperty("margin", "0", "important");
    layer.style.setProperty("padding", "0", "important");
