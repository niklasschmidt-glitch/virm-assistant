  function importedTeamTarget(entry, entryIndex, targets) {
    const requestedVmanGroupId = Number(entry && (entry.vman_group_id ?? entry.vmanGroupId));
    if (Number.isInteger(requestedVmanGroupId) && requestedVmanGroupId > 0) {
      const byVmanId = targets.find((target) => Number(target.vmanGroupId) === requestedVmanGroupId);
      if (byVmanId) return byVmanId;
    }

    const requestedSlot = Number(entry && (entry.group_slot ?? entry.groupSlot));
    if (Number.isInteger(requestedSlot) && requestedSlot >= 1 && requestedSlot <= targets.length) {
      return targets[requestedSlot - 1];
    }

    // Ældre eksportfiler havde ingen stabil VMAN-identitet eller gruppeplads.
    // Her må navnet kun bruges som en bogstavelig etiket-match – aldrig til at
    // udlede en bestemt position eller standardgruppe. Navnet prøves før det
    // gamle interne ID, fordi netop stale ID'er var årsagen til 0.1.431-fejlen.
    const requestedName = normalizeText(entry && (entry.group_name || entry.groupName || entry.name));
    if (requestedName) {
      const lowered = requestedName.toLocaleLowerCase("da");
      const byExactName = targets.find((target) => normalizeText(target.name).toLocaleLowerCase("da") === lowered);
      if (byExactName) return byExactName;
    }

    const requestedId = normalizeText(entry && (entry.group_id || entry.groupId));
    if (requestedId) {
      const byInternalId = targets.find((target) => target.groupId === requestedId);
      if (byInternalId) return byInternalId;
    }

    if (targets[entryIndex]) return targets[entryIndex];
    return null;
  }

  function prepareTeamProgramImport(entry, entryIndex, targets) {
    const rawProgram = entry && entry.program;
    if (!rawProgram || typeof rawProgram !== "object") {
      throw new Error("En af grupperne mangler et træningsprogram.");
    }

    const target = importedTeamTarget(entry, entryIndex, targets);
    if (!target || !target.groupId) {
      const sourceName = normalizeText(entry && (entry.group_name || entry.groupName || entry.name)) || `gruppe ${entryIndex + 1}`;
      throw new Error(`Kunne ikke finde en tilsvarende træningsgruppe til “${sourceName}”.`);
    }

    const groupId = target.groupId;
    const requestedGroupPosition = importedTeamPosition(entry.position || rawProgram.position);
    const existingDefinition = groupDefinition(groupId);
    const position = POSITION_STATS[rawProgram.position]
      ? rawProgram.position
      : (requestedGroupPosition || existingDefinition.position);

    const sessionsSource = Array.isArray(rawProgram.program) ? rawProgram.program : rawProgram.sessions;
    if (!Array.isArray(sessionsSource)) {
      throw new Error(`Gruppen “${target.name || existingDefinition.name}” indeholder ikke et træningsprogram.`);
    }

    const sessions = sessionsSource
      .map((item) => normalizeProgramItem(item, position))
      .filter(Boolean);

    const bonus = rawProgram.experience_bonus || rawProgram.settings || {};
    const importedStartDate = rawProgram.start_date || rawProgram.startDate;
    const scenario = normalizeScenario(rawProgram.scenario, position);

    return {
      groupId,
      groupSlot: target.slot,
      vmanGroupId: target.vmanGroupId,
      // Bevar altid navnet på den aktuelle VMAN-gruppe. Importfilens navn er
      // kun metadata og må ikke omdøbe brugerens træningsgrupper.
      groupName: target.name || existingDefinition.name,
      groupPosition: requestedGroupPosition || existingDefinition.position,
      program: {
        name: normalizeText(rawProgram.name) || `${target.name || existingDefinition.name} 1`,
        position,
        startDate: dateOrdinal(importedStartDate) !== null ? importedStartDate : todayISO(),
        sessions,
        settings: {
          experienceBonus: Boolean(bonus.enabled ?? bonus.experienceBonus),
          experienceRatio: clamp(Number(bonus.ratio || bonus.experienceRatio) || 1.10, 1.01, 1.15),
          gradient: ["linear", "early", "late"].includes(bonus.knee || bonus.gradient)
            ? (bonus.knee || bonus.gradient)
            : "linear",
        },
        scenario,
        assistant: programFileAssistantState(rawProgram.assistant, position, scenario),
      },
    };
  }

  async function importTeamTrainingPayload(raw) {
    if (!raw || typeof raw !== "object" || !Array.isArray(raw.groups) || !raw.groups.length) {
      throw new Error("Filen indeholder ikke en VIRM-holdtræning.");
    }

    const context = vmanTrainingContext();
    let targets = [];
    try {
      targets = await currentTeamTrainingTargets(context, true);
    } catch (error) {
      console.warn("VIRM Assistant: VMANs træningsgrupper kunne ikke hentes til import.", error);
    }

    if (!targets.length) {
      const profile = activeProfile();
      targets = Object.keys(profile.groups || {}).map((groupId, index) => ({
        slot: index + 1,
        vmanGroupId: null,
        name: normalizeText(profile.groups[groupId] && profile.groups[groupId].name) || groupDefinition(groupId).name,
        groupId,
      }));
    }

    if (!targets.length) {
      throw new Error("De aktuelle træningsgrupper kunne ikke identificeres på VMAN-siden.");
    }

    const prepared = raw.groups.map((entry, index) => prepareTeamProgramImport(entry, index, targets));
    const duplicateTargetIds = prepared
      .map((item) => item.groupId)
      .filter((groupId, index, ids) => ids.indexOf(groupId) !== index);
    if (duplicateTargetIds.length) {
      const names = Array.from(new Set(duplicateTargetIds))
        .map((groupId) => targets.find((target) => target.groupId === groupId)?.name || groupDefinition(groupId).name)
        .join(", ");
      throw new Error(`Flere importerede grupper peger på samme træningsgruppe${names ? ` (${names})` : ""}.`);
    }
    const previousActiveGroupId = state.activeGroupId;

    commitChange("Importér holdtræning", () => {
      const importedAt = new Date().toISOString();
      for (const item of prepared) {
        if (!state.groups[item.groupId]) {
          state.groups[item.groupId] = {
            id: item.groupId,
            name: item.groupName,
            position: item.groupPosition,
            activeProgramId: null,
            programIds: [],
          };
        } else {
          state.groups[item.groupId].name = item.groupName;
          state.groups[item.groupId].position = item.groupPosition;
        }
        state.groups[item.groupId].vmanGroupId = item.vmanGroupId;
        state.groups[item.groupId].groupSlot = item.groupSlot;

        const group = ensureGroupState(item.groupId);
        const targetProgram = state.programs[group.activeProgramId];
        targetProgram.name = item.program.name;
        targetProgram.position = item.program.position;
        targetProgram.startDate = item.program.startDate;
        targetProgram.sessions = item.program.sessions;
        targetProgram.settings = item.program.settings;
        targetProgram.scenario = item.program.scenario;
        targetProgram.assistant = item.program.assistant;
        targetProgram.updatedAt = importedAt;
        group.updatedAt = importedAt;
      }

      if (state.groups[previousActiveGroupId]) state.activeGroupId = previousActiveGroupId;
      selectedIds.clear();
      editorState = { type: "phase-new" };
      currentDistribution = {};
      resetDistributionPriorities();
      editorDraft = null;
    }, { keepEditor: true });

    showToast(`Holdtræningen blev importeret (${prepared.length} grupper).`);
  }

  async function importSelectedFile() {
    const file = refs.fileInput.files && refs.fileInput.files[0];
    const importMode = refs.fileInput.dataset.importMode || "program";
    delete refs.fileInput.dataset.importMode;
    refs.fileInput.value = "";
    if (!file) return;
    try {
      const raw = JSON.parse(await file.text());

      if (importMode === "team") {
        importTeamTrainingPayload(raw);
        return;
      }

      const position = positionFromImport(raw.position);
      const sessionsSource = Array.isArray(raw.program) ? raw.program : raw.sessions;
      if (!Array.isArray(sessionsSource)) {
        throw new Error("Filen indeholder ikke et træningsprogram.");
      }
      const sessions = sessionsSource.map((item) => normalizeProgramItem(item, position)).filter(Boolean);
      const targetGroup = GROUP_DEFINITIONS.find((group) => group.position === position) || groupDefinition(state.activeGroupId);
      const group = ensureGroupState(targetGroup.id);
      const imported = createProgram(targetGroup, group.programIds.length + 1);
      imported.name = normalizeText(raw.name) || normalizeText(file.name.replace(/\.json$/i, "")) || imported.name;
      imported.position = position;
      const importedStartDate = raw.start_date || raw.startDate;
      if (dateOrdinal(importedStartDate) !== null) imported.startDate = importedStartDate;
      imported.sessions = sessions;
      const bonus = raw.experience_bonus || raw.settings || {};
      imported.settings.experienceBonus = Boolean(bonus.enabled ?? bonus.experienceBonus);
      imported.settings.experienceRatio = clamp(Number(bonus.ratio || bonus.experienceRatio) || 1.10, 1.01, 1.15);
      imported.settings.gradient = ["linear", "early", "late"].includes(bonus.knee || bonus.gradient)
        ? (bonus.knee || bonus.gradient)
        : "linear";
      imported.scenario = normalizeScenario(raw.scenario, position);
      imported.assistant = programFileAssistantState(raw.assistant, position, imported.scenario);

      if (importMode === "template") {
        commitChange("Indlæs skabelon", () => {
          const program = activeProgram();
          program.name = imported.name;
          program.position = imported.position;
          program.sessions = imported.sessions;
          program.settings = imported.settings;
          program.scenario = imported.scenario;
          program.assistant = imported.assistant;
          selectedIds.clear();
          editorState = { type: "phase-new" };
          currentDistribution = {};
          resetDistributionPriorities();
          editorDraft = null;
        }, { keepEditor: true });
        showToast(`Skabelonen “${imported.name}” blev indlæst.`);
        return;
      }

      commitChange("Importér program", () => {
        state.programs[imported.id] = imported;
        group.programIds.push(imported.id);
        group.activeProgramId = imported.id;
        state.activeGroupId = targetGroup.id;
        selectedIds.clear();
      });
      showToast(`“${imported.name}” blev importeret.`);
    } catch (error) {
      const label = importMode === "team" ? "Holdtræningen" : "Programmet";
      window.alert(`${label} kunne ikke importeres.\n\n${error.message || error}`);
    }
  }

