  function plannerGroupIdForVmanExercise(exercise) {
    const exerciseName = normalizeText(exercise && exercise.name);
    if (!exerciseName) return null;
    const lowered = exerciseName.toLocaleLowerCase("da");

    for (const [groupId, found] of discoveredGroups.entries()) {
      if (normalizeText(found && found.definition && found.definition.name).toLocaleLowerCase("da") === lowered) {
        return groupId;
      }
    }

    const profile = activeProfile();
    const exerciseId = Number(exercise && exercise.id);
    if (Number.isInteger(exerciseId) && exerciseId > 0) {
      const stableMatch = Object.entries(profile.groups || {}).find(([, group]) =>
        Number(group && group.vmanGroupId) === exerciseId
      );
      if (stableMatch) return stableMatch[0];
    }

    const savedMatch = Object.entries(profile.groups || {}).find(([, group]) =>
      normalizeText(group && group.name).toLocaleLowerCase("da") === lowered
    );
    if (savedMatch) return savedMatch[0];

    const definitionMatch = allGroupDefinitions().find((group) =>
      normalizeText(group && group.name).toLocaleLowerCase("da") === lowered
    );
    if (definitionMatch) return definitionMatch.id;

    const groupId = customGroupId(exerciseName);
    if (!dynamicGroupDefinitions.has(groupId)) {
      dynamicGroupDefinitions.set(groupId, {
        id: groupId,
        name: exerciseName,
        position: "Forsvar",
        aliases: [exerciseName],
        dynamic: true,
      });
    }
    return groupId;
  }

  async function currentTeamTrainingTargets(context, force = false) {
    if (!context) return [];
    const exercises = await loadVmanTrainingExercises(context, force);
    return exercises.map((exercise, index) => ({
