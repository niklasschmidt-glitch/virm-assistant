    if (!isLoggedInDocument()) return getCache();
    const cache = await getCache();
    const activeClubId = currentClubId();
    const sameClub = !activeClubId || !cache.clubId || cache.clubId === activeClubId;
    const today = todayKey();

    if (!sameClub || cache.dailyCompletedDate !== today) {
      return refreshTeams(["senior", "youth"], "daily");
    }

    // Ved opstart skal begge kampprogrammer have gyldige dagsdata. Hvis én
    // cache mangler, stammer fra en tidligere dag eller senest fejlede,
    // genberegnes kun det pågældende hold.
    const staleKinds = ["senior", "youth"].filter(teamKind => {
      const team = cache.teams?.[teamKind];
      return !team || team.updatedDate !== today || Boolean(team.error);
    });
    if (!staleKinds.length) return cache;
    return refreshTeams(staleKinds, "startup");
  }

  function subscribe(callback) {
    if (typeof callback !== "function") return () => {};
    const listener = (changes, areaName) => {
