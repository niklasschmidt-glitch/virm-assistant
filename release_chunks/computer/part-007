      if (availability.trainedToday) throw new Error("Holdet har allerede trænet i dag.");
      if (!availability.nativeButton) throw new Error('VMANs knap "Træn nu" kunne ikke findes.');
      if (!availability.available) throw new Error("Holdet kan ikke trænes lige nu.");

      const root = await loadStoredRoot();
      const profile = profileForSquad(root, descriptor.squadId);
      if (!profile) throw new Error("Ingen programmer er sat op for holdet i VIRM Assistant.");
      const loaded = await loadExercises(descriptor.squadId);
      const targets = resolveTargets(profile, loaded.exercises);
      if (!targets.length) throw new Error("Ingen aktive grupper har en programdag, der kan bruges i dag.");

      for (let index = 0; index < targets.length; index += 1) {
        const item = targets[index];
        setControlStatus(control, `Overfører ${item.exercise.name} (${index + 1}/${targets.length})…`);
        await updateExercise(descriptor.squadId, loaded.basePath, item.exercise, item.target);
        item.program.lastApplied = {
          date: todayISO(),
          dayNumber: item.current.dayNumber,
          appliedAt: Date.now(),
        };
      }
      await saveStoredRoot(root);

      if (button) button.textContent = "Starter træning…";
      setControlStatus(control, `✓ Dagens øvelser er overført til ${targets.length} ${targets.length === 1 ? "gruppe" : "grupper"}. Starter træningen…`, "success");
      availability.nativeButton.click();
      trainingStarted = true;
    } catch (error) {
      if (button) button.textContent = "Træn med VIRM Assistant";
      setControlStatus(control, `${error.message || error} Træningen blev ikke startet.`, "error");
    } finally {
      if (!trainingStarted) setControlBusy(control, false);
    }
  }

  function createControl(descriptor) {
    const control = document.createElement("div");
    control.className = CONTROL_CLASS;
    control.dataset.squadKind = descriptor.kind || "";
    if (descriptor.squadId) control.dataset.squadId = String(descriptor.squadId);

    const button = document.createElement("button");
    button.type = "button";
    button.className = "virm-assistant-training-button";
    button.textContent = "Træn med VIRM Assistant";
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      trainWithAssistant(control, descriptor);
    });

    const status = document.createElement("small");
    status.className = "virm-assistant-training-status";
    status.setAttribute("aria-live", "polite");
    status.textContent = "Kontrollerer VIRM Assistant…";
    control.append(button, status);
