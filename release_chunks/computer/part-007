function virmOfficialRatingStyleForDisplayedValue(value) {
  const displayed = Math.round(Number(value));
  if (!Number.isFinite(displayed)) return null;
  const palette = [
    { background: "#4fac39", borderColor: "#38651d" },
    { background: "#b4c30c", borderColor: "#677a00" },
    { background: "#edc50d", borderColor: "#a16920" },
    { background: "#f59000", borderColor: "#a25314" },
    { background: "#cf4120", borderColor: "#743316" },
    { background: "#dc49a7", borderColor: "#742871" },
    { background: "#aa51c4", borderColor: "#6b2779" },
    { background: "#356bc5", borderColor: "#2e3689" },
    { background: "#13a4d3", borderColor: "#00597a" },
    { background: "#5b5b5b", borderColor: "#282828" },
  ];
  const band = Math.min(9, Math.floor(Math.max(0, displayed) / 10));
  return palette[band];
}


(() => {
