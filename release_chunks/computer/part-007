    }
      } else {
        phases.push(item);
      }
    }
    return phases;
  }

  function forecastProgramContext(program) {
    const totalDays = programTotalDays(program);
    const dayIndex = dayIndexForDate(program.startDate, todayISO());

    if (dayIndex === null) {
      return {
        state: "invalid-date",
        totalDays,
        dayIndex,
        waitingDays: 0,
        trainingDays: totalDays,
        calendarDays: totalDays,
        phases: expandedProgramPhases(program),
      };
    }

    // Programmet starter senere end i dag: alle træningsdage er stadig tilbage,
    // men spilleren bliver ældre i ventedagene før første session.
    if (dayIndex < 0) {
      const waitingDays = Math.abs(dayIndex);
      return {
        state: "future",
        totalDays,
        dayIndex,
        waitingDays,
        trainingDays: totalDays,
        calendarDays: waitingDays + totalDays,
        phases: expandedProgramPhases(program).map((phase) => deepClone(phase)),
      };
    }

    // Programmet er allerede afsluttet.
    if (dayIndex >= totalDays) {
      return {
        state: "finished",
        totalDays,
        dayIndex,
        waitingDays: 0,
        trainingDays: 0,
        calendarDays: 0,
        phases: [],
      };
    }

    // Programmet er i gang. Spillerdataene er nutidsdata, så allerede passerede
    // sessioner må ikke simuleres en gang til.
    let skipDays = dayIndex;
    const phases = [];
    for (const original of expandedProgramPhases(program)) {
      const phaseDays = Math.max(1, Number(original.days) || 1);
      if (skipDays >= phaseDays) {
        skipDays -= phaseDays;
        continue;
      }

      const phase = deepClone(original);
      phase.days = phaseDays - skipDays;
      skipDays = 0;
      phases.push(phase);
    }

    const trainingDays = Math.max(0, totalDays - dayIndex);
    return {
      state: "ready",
      totalDays,
      dayIndex,
      waitingDays: 0,
      trainingDays,
      calendarDays: trainingDays,
      phases,
    };
  }

  function absoluteExperienceBonus(age, ratio, gradient) {
    const progress = clamp((age - 15) / 12, 0, 1);
    const shaped = gradient === "early" ? 1 - ((1 - progress) ** 2) : (gradient === "late" ? progress ** 2 : progress);
    return 1 + (Math.max(1, ratio) - 1) * shaped;
  }

  function simulatePlayerWithProgram(player, program, forecastContext = null) {
    const statNames = POSITION_STATS[player.position];
    if (!statNames || !statNames.every((stat) => Number.isFinite(player.stats[stat]))) return null;
    const stats = Object.fromEntries(statNames.map((stat) => [stat, clamp(Math.round(player.stats[stat]), 0, 100)]));
    const progressXp = Object.fromEntries(statNames.map((stat) => [stat, 0]));
    const startAge = Number.isFinite(player.age) ? player.age : 15;
    const settings = program.settings || {};
    const baseBonus = absoluteExperienceBonus(startAge, Number(settings.experienceRatio || 1.10), settings.gradient || "linear");
    const context = forecastContext || forecastProgramContext(program);
    let elapsedDays = Math.max(0, Number(context.waitingDays) || 0);

    function statValue(stat) {
      return stats[stat] >= 100 ? 100 : stats[stat] + progressXp[stat] / XP_TO_NEXT[stats[stat]];
    }

    function addXp(stat, amount) {
      if (stats[stat] >= 100) return;
      progressXp[stat] += amount;
      while (stats[stat] < 100 && progressXp[stat] >= XP_TO_NEXT[stats[stat]]) {
        progressXp[stat] -= XP_TO_NEXT[stats[stat]];
        stats[stat] += 1;
      }
      if (stats[stat] >= 100) progressXp[stat] = 0;
    }

    for (const phase of context.phases || []) {
      const trainedStats = exerciseStatsForPhase(phase, player.position);
      if (!trainedStats) return null;
      for (let phaseDay = 0; phaseDay < phase.days; phaseDay += 1) {
        elapsedDays += 1;
        const currentAge = Math.min(27, startAge + elapsedDays / 30);
        const bonus = settings.experienceBonus && startAge < 27
          ? Math.max(1, absoluteExperienceBonus(currentAge, Number(settings.experienceRatio || 1.10), settings.gradient || "linear") / baseBonus)
          : 1;
        const xpAtReference = Number.isFinite(Number(player.xp)) ? Number(player.xp) : 180;
        const referencePoints = INTENSITIES[player.referenceIntensity] || 23;
        const sessionXp = xpAtReference * bonus * Number(phase.trainingPoints || 23) / referencePoints;
        const currentValues = Object.fromEntries(statNames.map((stat) => [stat, statValue(stat)]));
        const currentAverage = average(Object.values(currentValues));
        for (const stat of trainedStats) {
          let rawXp;
          if (Number(phase.exerciseTypeCode) === 0) {
            rawXp = sessionXp / statNames.length;
          } else {
            const totalPoints = Object.values(phase.distribution || {}).reduce((sum, value) => sum + value, 0);
            if (!totalPoints || !Number.isFinite(phase.distribution && phase.distribution[stat])) return null;
            rawXp = sessionXp * phase.distribution[stat] / totalPoints;
          }
          let penalty = 1;
          if (Number(phase.exerciseTypeCode) !== 0 && currentAverage > 0) {
            const percentAbove = (currentValues[stat] / currentAverage - 1) * 100;
            if (percentAbove > 15) penalty = Math.max(0, 1 - ((percentAbove - 15) / 3) / 100);
          }
          addXp(stat, rawXp * penalty);
        }
      }
    }
    const finalStats = Object.fromEntries(statNames.map((stat) => [stat, statValue(stat)]));
    return {
      rating: calculateRating(finalStats, player.position),
      average: average(Object.values(finalStats)),
      age: startAge + elapsedDays / 30,
      finalStats,
    };
  }


  function scenarioResultForProgram(program) {
    const player = scenarioPlayer(program && program.scenario);
    if (!player || !program.sessions.length) return null;
    const totalDays = programTotalDays(program);
    const simulation = simulatePlayerWithProgram(player, program, {
      state: "full-program",
      totalDays,
      dayIndex: 0,
      waitingDays: 0,
      trainingDays: totalDays,
      calendarDays: totalDays,
      phases: expandedProgramPhases(program).map((phase) => deepClone(phase)),
    });
    if (!simulation || !simulation.finalStats) return null;
    const finalAge = agePartsFromDecimal(simulation.age);
    return {
      source: "result",
      position: player.position,
      ageYears: finalAge.years,
      ageDays: finalAge.days,
      xp: player.xp,
      referenceIntensity: player.referenceIntensity,
      includedPlayerIds: null,
      stats: simulation.finalStats,
    };
  }

  function effectiveAssistantWeights(assistant, position) {
    const visible = normalizedAssistantWeights(position, assistant && assistant.weights);
    if (!assistant || !assistant.promoteStamina || !Object.hasOwn(visible, "Udholdenhed")) return visible;
    const promoted = Math.min(100, visible.Udholdenhed + (STAMINA_PROMOTION_PP[assistant.promoteStaminaLevel] || 5));
    const others = (POSITION_STATS[position] || []).filter((stat) => stat !== "Udholdenhed");
    const otherTotal = others.reduce((sum, stat) => sum + visible[stat], 0);
    const remaining = Math.max(0, 100 - promoted);
    const result = { Udholdenhed: promoted };
    for (const stat of others) result[stat] = otherTotal > 0 ? visible[stat] * remaining / otherTotal : 0;
    return Object.fromEntries((POSITION_STATS[position] || []).map((stat) => [stat, result[stat] || 0]));
  }

  function assistantHasCustomWeights(assistant, position) {
    if (assistant && assistant.promoteStamina) return true;
    const current = normalizedAssistantWeights(position, assistant && assistant.weights);
    const standard = normalizedAssistantWeights(position, POSITION_WEIGHTS[position]);
    return (POSITION_STATS[position] || []).some((stat) => Math.abs(current[stat] - standard[stat]) > 0.01);
  }

  function weightedRating(stats, weights) {
    const entries = Object.entries(weights || {});
    const total = entries.reduce((sum, [, weight]) => sum + Number(weight || 0), 0) || 1;
    return entries.reduce((sum, [stat, weight]) => sum + Number(stats[stat] || 0) * Number(weight || 0), 0) / total;
  }

  function assistantDistribution(position, exercise, weights, totalPoints) {
    if (exercise === "Træningskamp") return null;
    const allowed = Array.from(exerciseMapForPosition(position)[exercise] || []);
    const distribution = Object.fromEntries(allowed.map((stat) => [stat, 2]));
    let remaining = clamp(Math.round(Number(totalPoints) || 23), 20, 24) - allowed.length * 2;
    const ordered = [...allowed].sort((left, right) => (weights[right] || 0) - (weights[left] || 0) || right.localeCompare(left, "da"));
    while (remaining > 0) {
      let changed = false;
      for (const stat of ordered) {
        if (remaining <= 0) break;
        if (distribution[stat] < 10) {
          distribution[stat] += 1;
          remaining -= 1;
          changed = true;
        }
      }
      if (!changed) break;
    }
    return distribution;
  }

  function assistantIntensityPoints(dayNumber, assistant) {
    if (!assistant.allowIntensityBoost) return 23;
    const period = clamp(Math.round(Number(assistant.intensityBoostPeriodDays) || 7), 1, 365);
    const cycleDay = ((Math.max(1, dayNumber) - 1) % period) + 1;
    return assistant.intensityBoostDays.includes(cycleDay) ? 24 : 23;
  }

  function compressAssistantDaily(daily, position, weights) {
    const phases = [];
    for (const day of daily) {
      const previous = phases[phases.length - 1];
      if (previous && previous.exercise === day.exercise && previous.trainingPoints === day.points) {
        previous.days += 1;
      } else {
        const definition = exerciseDefinitionForName(day.exercise, position);
        phases.push({
          id: uid("phase"),
          type: "phase",
          days: 1,
          exercise: day.exercise,
          exerciseTypeCode: definition.code,
          trainingPoints: day.points,
          distribution: assistantDistribution(position, day.exercise, weights, day.points),
        });
      }
    }
    return phases;
  }

  function assistantProgramFromDaily(dailyExercises, position, weights, assistant, prefixDays = 0, scenarioAge = 15) {
    const constrained = [...dailyExercises];
    const totalDays = constrained.length;
    const fixedPrefix = assistant.trainingMatchPreludeEnabled
      ? clamp(Math.round((Number(assistant.trainingMatchUntilAge) - Number(scenarioAge)) * 30), 0, totalDays)
      : 0;
    const effectivePrefix = clamp(Math.max(prefixDays, fixedPrefix), 0, totalDays);
    for (let index = 0; index < effectivePrefix; index += 1) constrained[index] = "Træningskamp";

    if (assistant.rollEnabled && effectivePrefix < totalDays) {
      const length = Math.max(assistant.changeEveryDays, Math.round(assistant.rollBlockDays / assistant.changeEveryDays) * assistant.changeEveryDays);
      const bodyStart = effectivePrefix;
      const pattern = constrained.slice(bodyStart, Math.min(totalDays, bodyStart + length));
      if (pattern.length) {
        for (let index = bodyStart; index < totalDays; index += 1) constrained[index] = pattern[(index - bodyStart) % pattern.length];
      }
    }

    const daily = constrained.map((exercise, index) => ({ exercise, points: 23 }));
    if (assistant.allowIntensityBoost) {
      if (assistant.splitTrainingPasses) {
        for (let index = 0; index < daily.length; index += 1) daily[index].points = assistantIntensityPoints(index + 1, assistant);
      } else {
        const passDays = Math.max(1, assistant.changeEveryDays);
        for (let offset = 0; offset < daily.length; offset += passDays) {
          const end = Math.min(daily.length, offset + passDays);
          const boosted = Array.from({ length: end - offset }, (_, localDay) => assistantIntensityPoints(offset + localDay + 1, assistant)).some((points) => points === 24);
          for (let index = offset; index < end; index += 1) daily[index].points = boosted ? 24 : 23;
        }
      }
    }

    // Fast rul gemmes som en rigtig blok, når intensitetsrytmen ikke gør
    // gentagelserne forskellige. Ellers bevares den tilsvarende fasesekvens.
    if (assistant.rollEnabled && !assistant.allowIntensityBoost && effectivePrefix < totalDays) {
      const result = compressAssistantDaily(daily.slice(0, effectivePrefix), position, weights);
      const length = Math.min(totalDays - effectivePrefix, Math.max(assistant.changeEveryDays, assistant.rollBlockDays));
      const repetitions = Math.floor((totalDays - effectivePrefix) / length);
      if (repetitions > 1) {
        result.push({
          id: uid("block"),
          type: "block",
          name: "Blok 1",
          repetitions,
          phases: compressAssistantDaily(daily.slice(effectivePrefix, effectivePrefix + length), position, weights),
        });
        const used = effectivePrefix + repetitions * length;
        result.push(...compressAssistantDaily(daily.slice(used), position, weights));
        return result;
      }
    }
    return compressAssistantDaily(daily, position, weights);
  }

  function assistantScenarioAge(program) {
    const scenario = program && program.scenario;
    return scenario ? Number(scenario.ageYears || 15) + Number(scenario.ageDays || 0) / 30 : 15;
  }

  function assistantProgramDays(assistant = null) {
    const years = clamp(Math.round(Number(assistant && assistant.trainingPeriodYears) || 10), 1, 25);
    return years * 30;
  }

  function expandSessionsToDailyExercises(sessions, maximum = assistantProgramDays()) {
    const result = [];
    for (const item of sessions || []) {
      const repetitions = item.type === "block" ? item.repetitions : 1;
      const phases = item.type === "block" ? item.phases : [item];
      for (let repetition = 0; repetition < repetitions; repetition += 1) {
        for (const phase of phases) {
          for (let day = 0; day < phase.days && result.length < maximum; day += 1) result.push(phase.exercise);
        }
      }
    }
    return result;
  }

  function assistantExerciseRanking(position, weights) {
    const exercises = Object.keys(exerciseMapForPosition(position));
    return exercises.sort((left, right) => {
      const score = (exercise) => (exerciseMapForPosition(position)[exercise] || []).reduce((sum, stat) => sum + Number(weights[stat] || 0), 0);
      return score(right) - score(left) || left.localeCompare(right, "da");
    });
  }

  function assistantWeightedChoice(values, scores) {
    const weights = values.map((value) => Math.max(0.1, Number(scores[value]) || 0.1));
    const total = weights.reduce((sum, value) => sum + value, 0);
    let cursor = Math.random() * total;
    for (let index = 0; index < values.length; index += 1) {
      cursor -= weights[index];
      if (cursor <= 0) return values[index];
    }
    return values[values.length - 1];
  }

  function assistantExerciseScores(position, weights) {
    return Object.fromEntries(Object.entries(exerciseMapForPosition(position)).map(([exercise, stats]) => [
      exercise,
      stats.reduce((sum, stat) => sum + Number(weights[stat] || 0), 0),
    ]));
  }

  function assistantCandidateDaily({ method, index, assistant, position, weights, seedResult = null, results = [] }) {
    const days = assistantProgramDays(assistant);
    const exercises = Object.keys(exerciseMapForPosition(position));
    const ranking = assistantExerciseRanking(position, weights);
    const scores = assistantExerciseScores(position, weights);
    const changeDays = Math.max(1, assistant.changeEveryDays);
    const blockCount = Math.ceil(days / changeDays);
    const resultSeeds = results.slice(0, 10).map((result) => expandSessionsToDailyExercises(result.program, days));
    const directSeed = seedResult ? expandSessionsToDailyExercises(seedResult.program, days) : null;
    const availableSeeds = [directSeed, ...resultSeeds].filter((value) => value && value.length);
    let workingMethod = method;
    if (method === "Queen Seeker") workingMethod = ["Beam Search", "Genetic Algorithm", "Simulated Annealing", "Monte Carlo", "Hybrid: Beam + Mutation"][index % 5];
    if (method === "TM Threshold") workingMethod = ["Beam Search", "Genetic Algorithm", "Simulated Annealing", "Monte Carlo", "Hybrid: Beam + Mutation"][index % 5];

    if (method === "Omrokering" && directSeed) {
      const chunks = [];
      for (let cursor = 0; cursor < directSeed.length; cursor += changeDays) chunks.push(directSeed.slice(cursor, cursor + changeDays));
      for (let cursor = chunks.length - 1; cursor > 0; cursor -= 1) {
        const target = Math.floor(Math.random() * (cursor + 1));
        [chunks[cursor], chunks[target]] = [chunks[target], chunks[cursor]];
      }
      return { daily: chunks.flat().slice(0, days), label: `Omrokering #${index + 1}`, prefixDays: 0 };
    }

    if (method === "Brute Force") {
      let value = index;
      const choices = [];
      for (let block = 0; block < blockCount; block += 1) {
        choices.push(ranking[value % ranking.length]);
        value = Math.floor(value / ranking.length);
      }
      return { daily: Array.from({ length: days }, (_, day) => choices[Math.floor(day / changeDays)]), label: `Brute Force #${index + 1}`, prefixDays: 0 };
    }

    if (index < exercises.length) {
      const exercise = exercises[index];
      return { daily: Array(days).fill(exercise), label: `Kun ${exercise}`, prefixDays: 0 };
    }

    let daily = availableSeeds.length && ["Genetic Algorithm", "Simulated Annealing", "Hybrid: Beam + Mutation"].includes(workingMethod)
      ? [...availableSeeds[Math.floor(Math.random() * availableSeeds.length)]]
      : [];
    if (!daily.length) {
      const choices = [];
      for (let block = 0; block < blockCount; block += 1) {
        if (workingMethod === "Monte Carlo") choices.push(exercises[Math.floor(Math.random() * exercises.length)]);
        else if (workingMethod === "Beam Search") choices.push(ranking[block % Math.min(5, ranking.length)]);
        else choices.push(assistantWeightedChoice(exercises, scores));
      }
      daily = Array.from({ length: days }, (_, day) => choices[Math.floor(day / changeDays)]);
    }

    if (workingMethod === "Genetic Algorithm" && availableSeeds.length >= 2) {
      const left = availableSeeds[Math.floor(Math.random() * availableSeeds.length)];
      const right = availableSeeds[Math.floor(Math.random() * availableSeeds.length)];
      const split = Math.floor(Math.random() * days);
      daily = [...left.slice(0, split), ...right.slice(split, days)];
    }

    const mutationRate = {
      "Beam Search": 0.025,
      "Genetic Algorithm": 0.06,
      "Simulated Annealing": Math.max(0.015, 0.12 * (1 - Math.min(1, index / 500))),
      "Monte Carlo": 0.15,
      "Hybrid: Beam + Mutation": 0.10,
    }[workingMethod] || 0.05;
    for (let block = 0; block < blockCount; block += 1) {
      if (Math.random() >= mutationRate) continue;
      const exercise = workingMethod === "Monte Carlo"
        ? exercises[Math.floor(Math.random() * exercises.length)]
        : assistantWeightedChoice(exercises, scores);
      for (let day = block * changeDays; day < Math.min(days, (block + 1) * changeDays); day += 1) daily[day] = exercise;
    }

    let prefixDays = 0;
    let label = `${workingMethod} #${index + 1}`;
    if (method === "Queen Seeker") label = `Queen Seeker/${label}`;
    if (method === "TM Threshold") {
      const startAge = assistantScenarioAge(activeProgram());
      const first = Math.max(16 * 30, Math.ceil(startAge * 30));
      const last = Math.min(20 * 30, Math.floor((startAge + clamp(Math.round(Number(assistant.trainingPeriodYears) || 10), 1, 25)) * 30));
      const choices = Math.max(1, last - first + 1);
      const cutoffAgeDays = first + (index % choices);
      prefixDays = clamp(cutoffAgeDays - Math.round(startAge * 30), 0, days);
      const years = Math.floor(cutoffAgeDays / 30);
      const ageDays = cutoffAgeDays % 30;
      label = `TM Threshold ${years}${ageDays ? `,${ageDays}` : ""}/Queen Seeker/${workingMethod}`;
    }
    return { daily: daily.slice(0, days), label, prefixDays };
  }

  function simulateAssistantProgram(scenario, sessions, settings) {
    if (!scenario) return null;
    const position = scenario.position;
    const statNames = POSITION_STATS[position];
    const stats = Object.fromEntries(statNames.map((stat) => [stat, clamp(Math.round(Number(scenario.stats[stat]) || 0), 0, 100)]));
    const progressXp = Object.fromEntries(statNames.map((stat) => [stat, 0]));
    const startAge = Number(scenario.ageYears || 15) + Number(scenario.ageDays || 0) / 30;
    const baseBonus = absoluteExperienceBonus(startAge, Number(settings.experienceRatio || 1.10), settings.gradient || "linear");
    let elapsedDays = 0;
    let maxAverageRatio = 1;

    function statValue(stat) {
      return stats[stat] >= 100 ? 100 : stats[stat] + progressXp[stat] / XP_TO_NEXT[stats[stat]];
    }
    function addXp(stat, amount) {
      if (stats[stat] >= 100) return;
      progressXp[stat] += amount;
      while (stats[stat] < 100 && progressXp[stat] >= XP_TO_NEXT[stats[stat]]) {
        progressXp[stat] -= XP_TO_NEXT[stats[stat]];
        stats[stat] += 1;
      }
      if (stats[stat] >= 100) progressXp[stat] = 0;
    }

    const simulatedProgram = { sessions };
    for (const phase of expandedProgramPhases(simulatedProgram)) {
      const trainedStats = exerciseStatsForPhase(phase, position);
      if (!trainedStats) return null;
      for (let phaseDay = 0; phaseDay < phase.days; phaseDay += 1) {
        elapsedDays += 1;
        const currentValues = Object.fromEntries(statNames.map((stat) => [stat, statValue(stat)]));
        const currentAverage = average(Object.values(currentValues)) || 1;
        maxAverageRatio = Math.max(maxAverageRatio, Math.max(...Object.values(currentValues)) / currentAverage);
        const currentAge = Math.min(27, startAge + elapsedDays / 30);
        const bonus = settings.experienceBonus && startAge < 27
          ? Math.max(1, absoluteExperienceBonus(currentAge, Number(settings.experienceRatio || 1.10), settings.gradient || "linear") / baseBonus)
          : 1;
        const referencePoints = INTENSITIES[scenario.referenceIntensity] || 23;
        const sessionXp = Number(scenario.xp || 180) * bonus * Number(phase.trainingPoints || 23) / referencePoints;
        for (const stat of trainedStats) {
          let rawXp;
          if (Number(phase.exerciseTypeCode) === 0) rawXp = sessionXp / statNames.length;
          else {
            const total = Object.values(phase.distribution || {}).reduce((sum, value) => sum + value, 0);
            rawXp = total > 0 ? sessionXp * Number(phase.distribution[stat] || 0) / total : 0;
          }
          let penalty = 1;
          if (Number(phase.exerciseTypeCode) !== 0) {
            const percentAbove = (currentValues[stat] / currentAverage - 1) * 100;
            if (percentAbove > 15) penalty = Math.max(0, 1 - ((percentAbove - 15) / 3) / 100);
          }
          addXp(stat, rawXp * penalty);
        }
      }
    }
    const finalStats = Object.fromEntries(statNames.map((stat) => [stat, statValue(stat)]));
    const finalAverage = average(Object.values(finalStats)) || 0;
    maxAverageRatio = Math.max(maxAverageRatio, Math.max(...Object.values(finalStats)) / Math.max(0.0001, finalAverage));
    return { finalStats, average: finalAverage, age: startAge + elapsedDays / 30, maxAverageRatio };
  }

  function assistantProgramNote(sessions) {
    return (sessions || []).map((item) => {
      if (item.type === "block") return `${item.repetitions}× (${item.phases.map((phase) => phase.exercise).join(" → ")})`;
      return `${item.days}d ${item.exercise}`;
    }).join(" → ");
  }

  function assistantProgramSignature(sessions) {
    return JSON.stringify((sessions || []).map((item) => item.type === "block"
      ? ["b", item.repetitions, item.phases.map((phase) => [phase.days, phase.exercise, phase.trainingPoints, phase.distribution])]
      : ["p", item.days, item.exercise, item.trainingPoints, item.distribution]));
  }

  function normalizeAssistantResult(raw, position) {
    if (!raw || typeof raw !== "object" || !Array.isArray(raw.program)) return null;
    const program = raw.program.map((item) => normalizeProgramItem(item, position)).filter(Boolean);
    if (!program.length) return null;
    const finalStats = Object.fromEntries((POSITION_STATS[position] || []).map((stat) => [stat, Number(raw.finalStats && raw.finalStats[stat]) || 0]));
    return {
      id: raw.id || uid("assistant-result"),
      score: Number(raw.score) || 0,
      rating: Number(raw.rating) || 0,
      weightedRating: Number(raw.weightedRating) || Number(raw.rating) || 0,
      average: Number(raw.average) || 0,
      method: normalizeText(raw.method) || "Assistent",
      notes: normalizeText(raw.notes) || assistantProgramNote(program),
      program,
      finalStats,
      createdAt: raw.createdAt || new Date().toISOString(),
    };
  }

  function evaluateAssistantCandidate(candidate, assistant, program) {
    const scenario = program.scenario;
    if (!scenario) return null;
    const position = scenario.position;
    const effectiveWeights = effectiveAssistantWeights(assistant, position);
    const sessions = assistantProgramFromDaily(candidate.daily, position, effectiveWeights, assistant, candidate.prefixDays, assistantScenarioAge(program));
    const simulation = simulateAssistantProgram(scenario, sessions, program.settings || {});
    if (!simulation) return null;
    const rating = calculateRating(simulation.finalStats, position);
    const customRating = weightedRating(simulation.finalStats, effectiveWeights);
    const usesWeightedRating = assistantHasCustomWeights(assistant, position);
    let score = usesWeightedRating ? customRating : rating;
    const notes = [];

    if (assistant.groupHighWeightedStats) {
      const entries = Object.entries(effectiveWeights).sort((left, right) => right[1] - left[1]);
      const maximumWeight = entries[0] ? entries[0][1] : 0;
      let group = entries.filter(([, weight]) => weight >= maximumWeight * 0.4 && weight > 0).map(([stat]) => stat);
      if (group.length < 2) group = entries.slice(0, 2).map(([stat]) => stat);
      const values = group.map((stat) => simulation.finalStats[stat]);
      const mean = average(values) || 0;
      const spread = Math.max(...values) - Math.min(...values);
      const deviation = average(values.map((value) => Math.abs(value - mean))) || 0;
      score -= Math.max(0, spread - 8) * 0.55 + deviation * 0.10;
      notes.push(`Gruppe ${Math.min(...values).toFixed(1)}-${Math.max(...values).toFixed(1)}`);
    }

    const toleranceLimit = PENALTY_TOLERANCE_LIMITS[assistant.penaltyTolerance];
    if (toleranceLimit !== null && simulation.maxAverageRatio > toleranceLimit) {
      score -= (simulation.maxAverageRatio - toleranceLimit) * 100 * 4;
      notes.push(`Straftolerance ${assistant.penaltyTolerance}: max ${((simulation.maxAverageRatio - 1) * 100).toFixed(1)}%`);
    }

    return {
      id: uid("assistant-result"),
      score,
      rating,
      weightedRating: customRating,
      average: simulation.average,
      method: candidate.label,
      notes: [assistantProgramNote(sessions), ...notes].join(" | "),
      program: sessions,
      finalStats: simulation.finalStats,
      createdAt: new Date().toISOString(),
    };
  }

  function compareAssistantResults(left, right, usesWeightedRating = false) {
    const primaryKey = usesWeightedRating ? "weightedRating" : "rating";
    const primaryDifference = Math.round(Number(right[primaryKey]) * 100) - Math.round(Number(left[primaryKey]) * 100);
    if (primaryDifference) return primaryDifference;
    const averageDifference = Math.round(Number(right.average) * 100) - Math.round(Number(left.average) * 100);
    if (averageDifference) return averageDifference;
    if (usesWeightedRating) {
      return Math.round(Number(right.rating) * 100) - Math.round(Number(left.rating) * 100);
    }
    return 0;
  }

  function sortAssistantResults(results, usesWeightedRating = false) {
    results.sort((left, right) => compareAssistantResults(left, right, usesWeightedRating));
    return results;
  }

  function mergeAssistantResult(assistant, result, position) {
    if (!result) return;
    const selectedId = assistant.selectedResultId;
    const signature = assistantProgramSignature(result.program);
    const existing = assistant.results.findIndex((item) => assistantProgramSignature(item.program) === signature);
    if (existing >= 0) {
      if (assistant.results[existing].score >= result.score) return;
      if (assistant.results[existing].id === selectedId) assistant.selectedResultId = result.id;
      assistant.results.splice(existing, 1);
    }
    assistant.results.push(result);
    sortAssistantResults(assistant.results, assistantHasCustomWeights(assistant, position));
    assistant.results.splice(100);
    if (!assistant.results.some((item) => item.id === assistant.selectedResultId)) {
      assistant.selectedResultId = assistant.results[0] ? assistant.results[0].id : null;
    }
  }

  function formatAssistantSeconds(seconds) {
    if (!Number.isFinite(seconds)) return "manuel";
    const safe = Math.max(0, Math.round(seconds));
    const hours = Math.floor(safe / 3600);
    const minutes = Math.floor((safe % 3600) / 60);
    const remaining = safe % 60;
    return hours ? `${hours}:${String(minutes).padStart(2, "0")}:${String(remaining).padStart(2, "0")}` : `${minutes}:${String(remaining).padStart(2, "0")}`;
  }

  function yieldAssistantWorkFrame() {
    return new Promise((resolve) => {
      let settled = false;
      let frameId = null;
      let timerId = null;
      const finish = () => {
        if (settled) return;
        settled = true;
        if (frameId !== null && typeof window.cancelAnimationFrame === "function") window.cancelAnimationFrame(frameId);
        if (timerId !== null) window.clearTimeout(timerId);
        resolve();
      };
      if (typeof window.requestAnimationFrame === "function") frameId = window.requestAnimationFrame(finish);
      timerId = window.setTimeout(finish, 32);
    });
  }



  function assistantBestMetric(assistant, position) {
    const usesWeightedRating = assistantHasCustomWeights(assistant, position);
    return {
      key: usesWeightedRating ? "weightedRating" : "rating",
      label: usesWeightedRating ? "bVT" : "VT",
    };
  }

  function updateAssistantSearchUi(run = assistantSearchRun) {
    if (!refs.assistantSearchStatus || !run) return;
    const elapsed = (performance.now() - run.startedAt) / 1000;
    const remaining = Number.isFinite(run.durationSeconds) ? Math.max(0, run.durationSeconds - elapsed) : Number.POSITIVE_INFINITY;
    const assistant = activeProgram().assistant;
    const best = assistant.results[0];
    const metric = assistantBestMetric(assistant, activeProgram().scenario.position);
    refs.assistantSearchStatus.textContent = run.cancelled
      ? "Stopper efter den aktuelle simulering…"
      : `${run.method === "Brute Force" ? "Brute Force" : "Simulerer"}… ${run.evaluated} udfald${Number.isFinite(remaining) ? ` · tilbage ${formatAssistantSeconds(remaining)}` : " · kører til Stop"}${best ? ` · bedste ${metric.label} ${Number(best[metric.key]).toFixed(2)}` : ""}`;
    refs.assistantSearchStatus.dataset.searchState = run.cancelled ? "stopping" : "running";
    refs.assistantSearchStatus.dataset.evaluated = String(run.evaluated);
    if (refs.assistantSearchButton) {
      refs.assistantSearchButton.textContent = "Stop";
      refs.assistantSearchButton.classList.remove("primary");
      refs.assistantSearchButton.classList.add("danger");
      // Hold knappen aktiv, så det click, der følger efter pointerup, kan opsluges.
      refs.assistantSearchButton.disabled = false;
    }
    if (refs.assistantSearchProgress) {
      refs.assistantSearchProgress.value = Number.isFinite(run.durationSeconds)
        ? clamp(elapsed / run.durationSeconds * 100, 0, 100)
        : 0;
    }
    renderAssistantResultsTable();
  }

  function stopAssistantSearch() {
    if (!assistantSearchRun) return;
    assistantSearchRun.cancelled = true;
    updateAssistantSearchUi();
  }

  async function startAssistantSearch(seedResult = null, methodOverride = null) {
    if (assistantSearchRun) {
      stopAssistantSearch();
      return;
    }
    const program = activeProgram();
    if (!program.scenario) {
      showToast("Åbn Scenario og indlæs spillerdata først.");
      return;
    }
    const assistant = program.assistant = normalizeAssistantState(program.assistant, program.scenario.position, program.scenario);
    const method = methodOverride || assistant.searchMethod;
    if (method !== "Omrokering") assistant.lastNonRearrangeMethod = method;
    const returnMethod = method === "Omrokering"
      ? (ASSISTANT_SEARCH_METHODS.includes(assistant.lastNonRearrangeMethod) && assistant.lastNonRearrangeMethod !== "Omrokering"
        ? assistant.lastNonRearrangeMethod
        : "Beam Search")
      : method;
    if (method === "Omrokering" && !seedResult) {
      showToast("Omrokering kræver et eksisterende søgeresultat.");
      return;
    }
    const configuredSeconds = method === "Brute Force" ? Number.POSITIVE_INFINITY : ASSISTANT_SEARCH_TIMES[assistant.searchTime];
    const testSeconds = Number(window.__VIRM_EXTENSION_TEST_SEARCH_SECONDS__);
    const durationSeconds = Number.isFinite(testSeconds) && testSeconds > 0 ? testSeconds : configuredSeconds;
    const run = {
      cancelled: false,
      startedAt: performance.now(),
      durationSeconds,
      evaluated: 0,
      index: 0,
      method,
      baseMethod: method === "Omrokering" ? returnMethod : method,
      hiddenMinuteRearrangement: method !== "Omrokering" && configuredSeconds >= 60 * 60,
      returnMethod,
      seedResult,
      programId: program.id,
    };
    assistantSearchRun = run;
    if (refs.assistantSearchButton) {
      refs.assistantSearchButton.textContent = "Stop";
      refs.assistantSearchButton.classList.remove("primary");
      refs.assistantSearchButton.classList.add("danger");
    }
    if (refs.assistantSearchMethod) refs.assistantSearchMethod.disabled = true;
    if (refs.assistantSearchTime) refs.assistantSearchTime.disabled = true;
    updateAssistantSearchUi(run);

    try {
      while (!run.cancelled && (run.evaluated === 0 || !Number.isFinite(durationSeconds) || (performance.now() - run.startedAt) / 1000 < durationSeconds)) {
        // En rigtig skærmframe giver mobil-Safari mulighed for at behandle tryk på Stop.
        await yieldAssistantWorkFrame();
        if (run.cancelled) break;
        const batchStarted = performance.now();
        while (!run.cancelled && performance.now() - batchStarted < 18) {
          const currentProgram = state.programs[run.programId];
          if (!currentProgram) {
            run.cancelled = true;
            break;
          }
          const currentAssistant = currentProgram.assistant;
          const position = currentProgram.scenario.position;
          const weights = effectiveAssistantWeights(currentAssistant, position);
          const searchMinute = Math.floor((performance.now() - run.startedAt) / 60000);
          const wantsAutomaticRearrangement = run.hiddenMinuteRearrangement && searchMinute % 2 === 1;
          const activeMethod = run.hiddenMinuteRearrangement
            ? (wantsAutomaticRearrangement && currentAssistant.results.length ? "Omrokering" : run.baseMethod)
            : method;
          const activeSeedResult = activeMethod === "Omrokering"
            ? (currentAssistant.results[0] || seedResult)
            : seedResult;
          const candidate = assistantCandidateDaily({
            method: activeMethod,
            index: run.index,
            assistant: currentAssistant,
            position,
            weights,
            seedResult: activeSeedResult,
            results: currentAssistant.results,
          });
          run.index += 1;
          const result = evaluateAssistantCandidate(candidate, currentAssistant, currentProgram);
          mergeAssistantResult(currentAssistant, result, position);
          run.evaluated += 1;
          // Giv Safari en eventrunde efter hvert udfald, så Stop altid reagerer.
          break;
        }
        updateAssistantSearchUi(run);
        scheduleSave();
      }
    } finally {
      if (assistantSearchRun === run) assistantSearchRun = null;
      const finalProgram = state.programs[run.programId] || program;
      const finalAssistant = finalProgram.assistant = normalizeAssistantState(finalProgram.assistant, finalProgram.scenario.position, finalProgram.scenario);
      if (finalAssistant.results.length) {
        if (run.hiddenMinuteRearrangement) {
          finalAssistant.searchMethod = run.method === "Omrokering" ? run.returnMethod : run.method;
          finalAssistant.lastNonRearrangeMethod = run.baseMethod;
        } else if (run.method === "Omrokering") {
          finalAssistant.searchMethod = run.returnMethod;
          finalAssistant.lastNonRearrangeMethod = run.returnMethod;
        } else {
          finalAssistant.lastNonRearrangeMethod = run.method;
          finalAssistant.searchMethod = "Omrokering";
        }
      }
      if (refs.assistantSearchMethod && refs.assistantSearchMethod.isConnected && finalAssistant.results.length) {
        if (!Array.from(refs.assistantSearchMethod.options).some((option) => option.value === "Omrokering")) {
          const option = document.createElement("option");
          option.value = "Omrokering";
          option.textContent = "Omrokering";
          refs.assistantSearchMethod.appendChild(option);
        }
        refs.assistantSearchMethod.value = finalAssistant.searchMethod;
      }
      if (refs.assistantSearchMethod) refs.assistantSearchMethod.disabled = false;
      if (refs.assistantSearchTime) refs.assistantSearchTime.disabled = finalAssistant.searchMethod === "Brute Force";
      if (refs.assistantSearchButton) {
        refs.assistantSearchButton.textContent = finalAssistant.results.length ? "Søg videre" : "Start";
        refs.assistantSearchButton.classList.remove("danger");
        refs.assistantSearchButton.classList.add("primary");
        refs.assistantSearchButton.disabled = false;
      }
      if (refs.assistantSearchStatus) {
        const best = finalAssistant.results[0];
        const metric = assistantBestMetric(finalAssistant, finalProgram.scenario.position);
        refs.assistantSearchStatus.textContent = run.cancelled
          ? `Stoppet. Akkumulerede resultater: ${finalAssistant.results.length}${best ? ` · bedste ${metric.label} ${Number(best[metric.key]).toFixed(2)}` : ""}`
          : `Færdig. Akkumulerede resultater: ${finalAssistant.results.length}${best ? ` · bedste ${metric.label} ${Number(best[metric.key]).toFixed(2)}` : ""}`;
        refs.assistantSearchStatus.dataset.searchState = run.cancelled ? "stopped" : "finished";
        refs.assistantSearchStatus.dataset.evaluated = String(run.evaluated);
      }
      if (refs.assistantSearchProgress && !run.cancelled) refs.assistantSearchProgress.value = 100;
      renderAssistantResultsTable();
      scheduleSave();
    }
  }

  function renderPlayerResultLine() {
    if (!refs.resultLine || !refs.resultText || !stateLoaded) return;
    const program = activeProgram();
    const forecastContext = forecastProgramContext(program);
    const prefix = formatDanishDayCount(forecastContext.calendarDays);
    const scenario = program.scenario;
    const scenarioValue = scenarioPlayer(scenario);
    const data = scenarioValue
      ? { status: "ready", players: [scenarioValue], errors: [], total: 1, scenario: true }
      : groupPlayerData.get(state.activeGroupId);
    refs.resultLine.classList.remove("is-loading", "is-muted");
    refs.resultLine.title = "";
    if (!data || data.status === "loading") {
      refs.resultLine.classList.add("is-loading");
      refs.resultText.textContent = `${prefix} — Henter spillerdata fra spillersiderne…`;
      return;
    }
    if (data.status === "empty") {
      refs.resultLine.classList.add("is-muted");
      refs.resultText.textContent = `${prefix} — Ingen spillere kunne kobles til gruppen.`;
      return;
    }
    if (!data.players.length) {
      refs.resultLine.classList.add("is-muted");
      refs.resultText.textContent = `${prefix} — Spillerdata kunne ikke indlæses.`;
      refs.resultLine.title = (data.errors || []).join("\n");
      return;
    }
    const startRatings = data.players.map((player) => player.rating);
    const startAges = data.players.map((player) => player.age);
    const forecasts = data.players
      .map((player) => simulatePlayerWithProgram(player, program, forecastContext))
      .filter(Boolean);
    const startRating = formatDanishNumber(average(startRatings));
    const startAge = formatVmanAge(average(startAges));
    if (forecasts.length === data.players.length) {
      const endRating = formatDanishNumber(average(forecasts.map((result) => result.rating)));
      const endAge = formatVmanAge(average(forecasts.map((result) => result.age)));
      refs.resultText.textContent = `${prefix} - VT: ${startRating} → ${endRating} - Alder: ${startAge} → ${endAge}`;
    } else {
      refs.resultText.textContent = `${prefix} - VT: ${startRating} → ? - Alder: ${startAge} → ?`;
      refs.resultLine.title = "Prognosen mangler komplette egenskabsdata for en eller flere spillere.";
    }
    const xpText = scenarioValue
      ? `Scenariet anvender ${scenarioValue.xp} XP ved ${scenarioValue.referenceIntensity} intensitet.`
      : "Prognosen anvender 180 XP ved Hård intensitet.";
    const timingText = forecastContext.state === "future"
      ? `Programmet starter om ${formatDanishDayCount(forecastContext.waitingDays)}; slutalderen medregner ventetiden.`
      : forecastContext.state === "ready" && forecastContext.dayIndex > 0
        ? `${forecastContext.dayIndex} allerede passerede programdage springes over; prognosen regnes fra dags dato.`
        : forecastContext.state === "finished"
          ? "Programmet er afsluttet; der er ingen resterende sessioner at simulere."
          : "Prognosen regnes fra dags dato.";
    const details = [data.scenario ? `Aktivt ${scenario.source === "manual" ? "manuelt" : "gruppebaseret"} scenario.` : `${data.players.length}/${data.total || data.players.length} spillere indlæst.`, `${forecasts.length}/${data.players.length} spillere kunne simuleres.`, xpText, timingText];
    if (data.errors && data.errors.length) details.push(...data.errors);
    refs.resultLine.title = details.join("\n");
  }

  function blockSummary(block) {
    const exercises = (block.phases || []).map((phase) => exerciseDisplayName(phase)).join(" → ");
    return `${block.repetitions}× (${exercises})`;
  }

  function renderProgram() {
    const program = activeProgram();
    const group = groupDefinition(state.activeGroupId);
    const stationaryMobile = isStationaryMobileProgramLayout();
    // Træningsprogrammet reserverer altid præcis seks sessionrækker.
    // Flere sessioner scroller internt i stedet for at ændre panelets højde.
    const reservedProgramRows = 6;
    const reservedProgramHeight = reservedProgramRows * 39;
    refs.app.classList.toggle("is-stationary-mobile", stationaryMobile);
    refs.app.classList.add("is-stationary-program");
    refs.app.classList.toggle("has-program-sessions", program.sessions.length > 0);
    refs.app.classList.remove("has-expanded-program");
    refs.clearProgramButton.disabled = !program.sessions.length;
    refs.app.style.setProperty("--virm-program-rows", String(reservedProgramRows));
    if (stationaryMobile) {
      refs.app.style.setProperty("--virm-mobile-program-rows", String(reservedProgramRows));
      // Appens samlede højde skal følge indholdet naturligt. Kun programlisten
      // har en fast/reserveret højde; ellers kunne footeren blive klippet og
      // blinke ind/ud, når viewporten eller VMAN-layoutet ændrede sig.
      refs.app.style.removeProperty("--virm-mobile-app-height");
      refs.app.style.removeProperty("height");
      refs.app.style.removeProperty("min-height");
      refs.app.style.removeProperty("max-height");
      refs.programScroll.style.setProperty("height", `${reservedProgramHeight}px`, "important");
      refs.programScroll.style.setProperty("min-height", `${reservedProgramHeight}px`, "important");
      refs.programScroll.style.setProperty("max-height", `${reservedProgramHeight}px`, "important");
      refs.programScroll.style.setProperty("overflow-x", "hidden", "important");
      refs.programScroll.style.setProperty("overflow-y", "auto", "important");
    } else {
      refs.app.style.removeProperty("--virm-mobile-program-rows");
      refs.app.style.removeProperty("--virm-mobile-app-height");
      refs.app.style.removeProperty("height");
      refs.app.style.removeProperty("min-height");
      refs.app.style.removeProperty("max-height");
      refs.programScroll.style.setProperty("height", `${reservedProgramHeight}px`);
      refs.programScroll.style.setProperty("min-height", `${reservedProgramHeight}px`);
      refs.programScroll.style.setProperty("max-height", `${reservedProgramHeight}px`);
      refs.programScroll.style.setProperty("overflow-x", "hidden");
      refs.programScroll.style.setProperty("overflow-y", "auto");
    }
    refs.programScroll.replaceChildren();
    const validIds = new Set(program.sessions.map((item) => item.id));
    selectedIds = new Set(Array.from(selectedIds).filter((id) => validIds.has(id)));

    if (!program.sessions.length) {
      const empty = document.createElement("div");
      empty.className = "virm-empty-program";
      empty.innerHTML = "<strong>Programmet er tomt</strong><span>Tilføj den første session i editoren nedenfor.</span>";
      refs.programScroll.appendChild(empty);
    } else {
      program.sessions.forEach((item, index) => refs.programScroll.appendChild(createProgramRow(item, index)));
    }

    const totalDays = program.sessions.reduce((sum, item) => sum + itemTotalDays(item), 0);
    const generatedPrefix = `${group.name} `;
    const generatedSuffix = program.name.startsWith(generatedPrefix) ? program.name.slice(generatedPrefix.length) : "";
    const visibleProgramName = /^\d+$/.test(generatedSuffix) ? "" : program.name;
    refs.status.textContent = visibleProgramName ? `${group.name} · ${visibleProgramName}` : group.name;
    refs.totalDays.textContent = formatDanishDayCount(totalDays);
  }

  function createProgramRow(item, index) {
    const row = document.createElement("div");
    row.className = "virm-program-row";
    row.classList.toggle("is-selected", selectedIds.has(item.id));
    row.classList.toggle("is-block", item.type === "block");
    row.dataset.itemId = item.id;
    row.draggable = true;
    row.setAttribute("role", "row");

    const trashCell = document.createElement("div");
    trashCell.className = "virm-program-cell center";
    const trash = document.createElement("button");
    trash.type = "button";
    trash.className = "virm-trash-button";
    trash.innerHTML = TRASH_ICON_MARKUP;
    trash.title = "Slet";
    const itemLabel = item.type === "block" ? item.name : exerciseDisplayName(item);
    trash.setAttribute("aria-label", `Slet ${itemLabel}`);
    trash.addEventListener("click", (event) => {
      event.stopPropagation();
      deleteItemsByIds([item.id]);
    });
    trashCell.appendChild(trash);

    const days = createCell(String(itemTotalDays(item)), true);
    const exercise = createCell(itemLabel, false);
    exercise.title = itemLabel;
    const intensity = createCell(
      item.type === "block" ? "Blok" : (POINTS_TO_INTENSITY[String(item.trainingPoints)] || String(item.trainingPoints)),
      true,
    );
    row.title = item.type === "block" ? blockSummary(item) : distributionSummary(item);
    row.append(trashCell, days, exercise, intensity);

    let longPressTimer = null;
    let longPressPointerId = null;
    let longPressStartX = 0;
    let longPressStartY = 0;
    let suppressTouchContextMenuUntil = 0;

    const cancelLongPress = () => {
      window.clearTimeout(longPressTimer);
      longPressTimer = null;
      longPressPointerId = null;
    };

    const openRowContextMenu = (x, y) => {
      if (!selectedIds.has(item.id)) {
        if (mobileMultiSelectMode && isMobileMultiSelectAvailable()) selectedIds.add(item.id);
        else selectedIds = new Set([item.id]);
        selectionAnchorId = item.id;
        setEditorFromSelectedItem();
        renderProgram();
        renderEditor();
      }
      openContextMenu(x, y);
    };

    row.addEventListener("pointerdown", (event) => {
      const blocked = Boolean(event.target.closest("button, input, select, textarea"));
      row.dataset.dragBlocked = String(blocked);
      if (blocked || event.pointerType !== "touch") return;
      cancelLongPress();
      longPressPointerId = event.pointerId;
      longPressStartX = event.clientX;
      longPressStartY = event.clientY;
      longPressTimer = window.setTimeout(() => {
        longPressTimer = null;
        if (longPressPointerId !== event.pointerId) return;
        suppressTouchContextMenuUntil = Date.now() + 1500;
        suppressProgramClickUntil = Date.now() + 900;
        row.dataset.dragBlocked = "true";
        openRowContextMenu(longPressStartX, longPressStartY);
      }, 1000);
    });
    row.addEventListener("pointermove", (event) => {
      if (event.pointerId !== longPressPointerId) return;
      if (Math.hypot(event.clientX - longPressStartX, event.clientY - longPressStartY) > 12) cancelLongPress();
    });
    for (const eventName of ["pointerup", "pointercancel", "lostpointercapture"]) {
      row.addEventListener(eventName, cancelLongPress);
    }
    row.addEventListener("dragstart", (event) => beginProgramNativeDrag(item.id, index, row, event));
    row.addEventListener("dragend", finishProgramNativeDrag);
    row.addEventListener("click", (event) => {
      if (Date.now() < suppressProgramClickUntil) {
        event.preventDefault();
        event.stopPropagation();
        return;
      }
      selectProgramRow(item.id, index, event);
    });
    row.addEventListener("contextmenu", (event) => {
      event.preventDefault();
      if (longPressPointerId !== null || Date.now() < suppressTouchContextMenuUntil) return;
      openRowContextMenu(event.clientX, event.clientY);
    });
    return row;
  }

  function beginProgramNativeDrag(itemId, index, row, event) {
    clearProgramDragVisuals();
    programDragState = null;
    if (row.dataset.dragBlocked === "true" || !event.dataTransfer) {
      event.preventDefault();
      return;
    }
    const sessions = activeProgram().sessions;
    if (!sessions[index] || sessions[index].id !== itemId) {
      event.preventDefault();
      return;
    }

    if (!selectedIds.has(itemId)) {
      selectedIds = new Set([itemId]);
      selectionAnchorId = itemId;
    }
    setEditorFromSelectedItem();
    const sourceIds = sessions.filter((item) => selectedIds.has(item.id)).map((item) => item.id);
    programDragState = { sourceIds, dropIndex: index, dropped: false };
    suppressProgramClickUntil = Date.now() + 500;
    refs.programScroll.querySelectorAll(".virm-program-row").forEach((candidate) => {
      candidate.classList.toggle("is-selected", selectedIds.has(candidate.dataset.itemId));
      candidate.classList.toggle("is-drag-source", sourceIds.includes(candidate.dataset.itemId));
    });

    event.dataTransfer.effectAllowed = "move";
    event.dataTransfer.setData("text/plain", sourceIds.join(","));
    const preview = createProgramNativeDragPreview(sourceIds);
    if (typeof event.dataTransfer.setDragImage === "function") event.dataTransfer.setDragImage(preview, 12, 12);
    window.setTimeout(() => preview.remove(), 0);
  }

  function createProgramNativeDragPreview(itemIds) {
    const preview = document.createElement("div");
    preview.className = "virm-program-native-drag-preview";
    if (itemIds.length > 1) {
      preview.textContent = `${itemIds.length} sessioner`;
    } else {
      const item = activeProgram().sessions.find((candidate) => candidate.id === itemIds[0]);
      preview.textContent = item?.type === "block"
        ? `${formatDanishDayCount(itemTotalDays(item))} · ${item.name} · Blok`
        : `${formatDanishDayCount(itemTotalDays(item))} · ${item?.exercise || "Session"}`;
    }
    refs.app.appendChild(preview);
    return preview;
  }

  function programDropIndexFromClientY(clientY) {
    const rows = Array.from(refs.programScroll.querySelectorAll(".virm-program-row"));
    if (!rows.length) return 0;
    for (let index = 0; index < rows.length; index += 1) {
      const rect = rows[index].getBoundingClientRect();
      const midpoint = rect.top + rect.height / 2;
      if (clientY < midpoint) return index;
    }
    return rows.length;
  }

  function showProgramDropIndicator(insertAt) {
    const rows = Array.from(refs.programScroll.querySelectorAll(".virm-program-row"));
    rows.forEach((row) => row.classList.remove("is-drop-before", "is-drop-after"));
    if (!rows.length) return;
    if (insertAt >= rows.length) rows[rows.length - 1].classList.add("is-drop-after");
    else rows[Math.max(0, insertAt)].classList.add("is-drop-before");
  }

  function clearProgramDragVisuals() {
    refs.programScroll.querySelectorAll(".virm-program-row").forEach((row) => {
      row.classList.remove("is-drag-source", "is-drop-before", "is-drop-after");
    });
    refs.app.querySelectorAll(".virm-program-drag-ghost, .virm-program-native-drag-preview").forEach((preview) => preview.remove());
  }

  function autoScrollProgramDuringDrag(clientY) {
    const rect = refs.programScroll.getBoundingClientRect();
    if (clientY < rect.top + 18) refs.programScroll.scrollTop -= 28;
    else if (clientY > rect.bottom - 18) refs.programScroll.scrollTop += 28;
  }

  function handleProgramNativeDragOver(event) {
    if (!programDragState) return;
    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = "move";
    autoScrollProgramDuringDrag(event.clientY);
    programDragState.dropIndex = programDropIndexFromClientY(event.clientY);
    showProgramDropIndicator(programDragState.dropIndex);
  }

  function handleProgramNativeDragLeave(event) {
    if (!programDragState || refs.programScroll.contains(event.relatedTarget)) return;
    refs.programScroll.querySelectorAll(".virm-program-row").forEach((row) => {
      row.classList.remove("is-drop-before", "is-drop-after");
    });
  }

  function moveProgramItemsToIndex(itemIds, insertAt) {
    const sessions = activeProgram().sessions;
    const idSet = new Set(itemIds);
    const indexed = sessions.map((item, index) => ({ item, index }));
    const selected = indexed.filter(({ item }) => idSet.has(item.id));
    if (!selected.length) return false;
    const movingItems = selected.map(({ item }) => item);
    const keptItems = indexed.filter(({ item }) => !idSet.has(item.id)).map(({ item }) => item);
    const adjustedInsert = Math.max(0, Math.min(
      insertAt - selected.filter(({ index }) => index < insertAt).length,
      keptItems.length,
    ));
    const reordered = [
      ...keptItems.slice(0, adjustedInsert),
      ...movingItems,
      ...keptItems.slice(adjustedInsert),
    ];
    if (reordered.every((item, index) => item.id === sessions[index]?.id)) return false;

    commitChange("Flyt session", () => {
      activeProgram().sessions = reordered;
      selectedIds = new Set(movingItems.map((item) => item.id));
      selectionAnchorId = movingItems[0]?.id || null;
    }, { keepEditor: true });
    return true;
  }

  function handleProgramNativeDrop(event) {
    if (!programDragState) return;
    event.preventDefault();
    const sourceIds = [...programDragState.sourceIds];
    const dropIndex = programDropIndexFromClientY(event.clientY);
    programDragState.dropped = true;
    const moved = moveProgramItemsToIndex(sourceIds, dropIndex);
    if (!moved) {
      setEditorFromSelectedItem();
      renderProgram();
      renderEditor();
    }
    clearProgramDragVisuals();
    programDragState = null;
    suppressProgramClickUntil = Date.now() + 350;
  }

  function finishProgramNativeDrag() {
    if (!programDragState) {
      clearProgramDragVisuals();
      return;
    }
    const shouldRender = !programDragState.dropped;
    clearProgramDragVisuals();
    programDragState = null;
    suppressProgramClickUntil = Date.now() + 350;
    if (shouldRender) {
      setEditorFromSelectedItem();
      renderProgram();
      renderEditor();
    }
  }

  function cancelProgramNativeDrag() {
    if (!programDragState && !refs.app?.querySelector(".virm-program-drag-ghost, .virm-program-native-drag-preview")) return;
    clearProgramDragVisuals();
    programDragState = null;
    suppressProgramClickUntil = Date.now() + 350;
  }

  function createCell(text, centered) {
    const cell = document.createElement("div");
    cell.className = `virm-program-cell${centered ? " center" : ""}`;
    cell.textContent = text;
    return cell;
