  function distributionSummary(phase) {
    if (Number(phase.exerciseTypeCode) === 0 || !phase.distribution) {
      return "Træningskamp";
    }
    return Object.entries(phase.distribution).map(([stat, points]) => `${stat}: ${points}`).join(", ");
  }

  function selectProgramRow(itemId, index, event) {
    const sessions = activeProgram().sessions;
    if (mobileMultiSelectMode && isMobileMultiSelectAvailable()) {
      if (selectedIds.has(itemId)) selectedIds.delete(itemId);
      else selectedIds.add(itemId);
      selectionAnchorId = itemId;
    } else if (event.shiftKey && selectionAnchorId) {
      const anchorIndex = sessions.findIndex((item) => item.id === selectionAnchorId);
      if (anchorIndex >= 0) {
        const start = Math.min(anchorIndex, index);
        const end = Math.max(anchorIndex, index);
        selectedIds = new Set(sessions.slice(start, end + 1).map((item) => item.id));
      }
    } else if (event.metaKey || event.ctrlKey) {
      if (selectedIds.has(itemId)) selectedIds.delete(itemId);
      else selectedIds.add(itemId);
      selectionAnchorId = itemId;
    } else {
      selectedIds = new Set([itemId]);
      selectionAnchorId = itemId;
    }
    setEditorFromSelectedItem();
    renderProgram();
    renderEditor();
  }

  function setEditorFromSelectedItem() {
    if (selectedIds.size !== 1) return;
    const itemId = selectedIds.values().next().value;
    const item = activeProgram().sessions.find((candidate) => candidate.id === itemId);
    if (!item) {
      editorState = { type: "phase-new" };
      currentDistribution = {};
      resetDistributionPriorities();
      editorDraft = null;
      return;
    }
    if (item.type === "block") {
      editorState = { type: "block", itemId: item.id };
      editorDraft = null;
      return;
    }
    editorState = { type: "phase", itemId: item.id };
    currentDistribution = deepClone(item.distribution || {});
    resetDistributionPriorities();
    editorDraft = null;
  }

  function selectedIndices() {
    return activeProgram().sessions
      .map((item, index) => selectedIds.has(item.id) ? index : -1)
      .filter((index) => index >= 0);
  }

  function selectedItems() {
    const sessions = activeProgram().sessions;
    return selectedIndices().map((index) => sessions[index]);
  }

  function deleteItemsByIds(itemIds) {
    if (!itemIds.length) return;
    const idSet = new Set(itemIds);
    commitChange("Slet session", () => {
      activeProgram().sessions = activeProgram().sessions.filter((item) => !idSet.has(item.id));
