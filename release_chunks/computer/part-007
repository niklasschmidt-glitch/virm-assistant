  function openBlockEditor(itemId) {
    const item = activeProgram().sessions.find((candidate) => candidate.id === itemId);
    if (!item || item.type !== "block") return;
    editorState = { type: "block", itemId };
    editorDraft = null;
    selectedIds = new Set([itemId]);
    renderProgram();
    renderEditor();
  }

  function closeEditor() {
    editorState = { type: "phase-new" };
    currentDistribution = {};
    resetDistributionPriorities();
    editorDraft = null;
    renderEditor();
    renderProgram();
  }

  function resetProfileWorkspace() {
    stopAssistantSearch();
    historyStack = [];
    redoStack = [];
    selectedIds.clear();
    currentDistribution = {};
    resetDistributionPriorities();
    editorDraft = null;
    lastRenderedGroupId = null;
    for (const group of GROUP_DEFINITIONS) ensureGroupState(group.id);
