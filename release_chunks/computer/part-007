      "defense": "Forsvar",
      "midtbane": "Midtbane",
      "midfielder": "Midtbane",
      "midfielders": "Midtbane",
      "midfield": "Midtbane",
      "angreb": "Angreb",
      "forward": "Angreb",
      "forwards": "Angreb",
      "attack": "Angreb",
    };
