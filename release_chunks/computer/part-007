  const TEAM_SQUADS_STORAGE_KEY = "virm-extension-team-squads-v1";

  function rememberedTeamSquads() {
    try {
      const parsed = JSON.parse(localStorage.getItem(TEAM_SQUADS_STORAGE_KEY) || "{}");
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch (_error) {
      return {};
    }
  }

  function rememberTeamSquad(squadId) {
    const id = Number(squadId);
    if (!Number.isInteger(id)) return;
    const clubKey = currentClubId() || "default";
    const stored = rememberedTeamSquads();
    const known = Array.isArray(stored[clubKey]) ? stored[clubKey].map(Number).filter(Number.isInteger) : [];
    stored[clubKey] = [...new Set([...known, id])].slice(-4);
    try {
      localStorage.setItem(TEAM_SQUADS_STORAGE_KEY, JSON.stringify(stored));
    } catch (_error) {
      // Holdskift virker stadig via de links, VMAN viser på siden.
    }
  }

  function rememberedAlternateSquadId(currentSquadId) {
    const clubKey = currentClubId() || "default";
    const known = rememberedTeamSquads()[clubKey];
    if (!Array.isArray(known)) return null;
    const candidate = known.map(Number).find((id) => Number.isInteger(id) && id !== Number(currentSquadId));
    return candidate || null;
  }

  function rememberCurrentSquad() {
    const context = vmanTrainingContext();
    if (context) rememberTeamSquad(context.squadId);
  }

  function teamSquadCandidates(root, currentSquadId) {
    const candidates = [];
    const teamWords = /(?:^|\b)(?:senior(?:hold)?|ungdom(?:shold)?|youth|junior|first\s+team|første\s*hold)(?:\b|$)/i;
    if (!root || typeof root.querySelectorAll !== "function") return candidates;

    for (const anchor of root.querySelectorAll("a[href]")) {
      let url;
      try {
        url = new URL(anchor.getAttribute("href"), window.location.href);
      } catch (_error) {
        continue;
      }
      if (url.origin !== window.location.origin) continue;
      const match = url.pathname.match(/\/squads\/(\d+)(?:\/|$)/i);
      if (!match) continue;
      const squadId = Number(match[1]);
      if (!Number.isInteger(squadId) || squadId === Number(currentSquadId)) continue;

      const label = normalizeText([
        anchor.textContent,
        anchor.getAttribute("aria-label"),
        anchor.getAttribute("title"),
      ].filter(Boolean).join(" "));
      const directTraining = new RegExp(`^/squads/${squadId}/training_exercises/?$`, "i").test(url.pathname);
      const labelledTeam = teamWords.test(label);
      if (!directTraining && !labelledTeam) continue;

      const inNavigation = Boolean(anchor.closest("nav, header, aside, [role='navigation'], .navigation, .navbar, .nav, .sidebar, .menu, .tabs"));
      const score = (directTraining ? 100 : 0) + (labelledTeam ? 60 : 0) + (inNavigation ? 15 : 0);
      candidates.push({ squadId, score });
    }

    return candidates.sort((left, right) => right.score - left.score);
  }

  async function fetchedAlternateSquadId(currentSquadId) {
    const clubId = currentClubId();
    if (!clubId) return null;
    const pageLanguage = window.location.pathname.match(/^\/([a-z]{2})(?:\/|$)/i)?.[1] || "da";
    const paths = [
      `/${pageLanguage}/clubs/${clubId}`,
      `/${pageLanguage}/clubs/${clubId}/players`,
      `/clubs/${clubId}`,
      `/clubs/${clubId}/players`,
    ];
    for (const path of [...new Set(paths)]) {
      try {
        const response = await fetch(new URL(path, window.location.origin).href, { credentials: "include", cache: "no-store" });
        if (!response.ok) continue;
        const parsed = new DOMParser().parseFromString(await response.text(), "text/html");
        const candidate = teamSquadCandidates(parsed, currentSquadId)[0];
        if (candidate) return candidate.squadId;
      } catch (_error) {
        // Prøv næste klubside.
      }
    }
    return null;
  }

  async function alternateTeamTrainingUrl() {
    const context = vmanTrainingContext();
    if (!context) return null;
    const currentSquadId = Number(context.squadId);
    const pageCandidate = teamSquadCandidates(document, currentSquadId)[0]?.squadId || null;
    const fetchedCandidate = pageCandidate ? null : await fetchedAlternateSquadId(currentSquadId);
    const targetSquadId = pageCandidate || fetchedCandidate || rememberedAlternateSquadId(currentSquadId);
    if (!targetSquadId) return null;
    rememberTeamSquad(currentSquadId);
    rememberTeamSquad(targetSquadId);
    return new URL(`/squads/${targetSquadId}/training_exercises`, window.location.origin).href;
  }

  async function switchTeam() {
    const targetUrl = await alternateTeamTrainingUrl();
    if (!targetUrl) {
      window.alert("Det andet hold kunne ikke findes. Åbn senior- eller ungdomsholdets træningsside én gang og prøv igen.");
      return;
    }
    if (typeof window.__VIRM_EXTENSION_NAVIGATE__ === "function") {
      window.__VIRM_EXTENSION_NAVIGATE__(targetUrl);
      return;
    }
    window.location.assign(targetUrl);
  }

  let trainingManualObjectUrl = "";

  function embeddedTrainingManualUrl() {
    if (trainingManualObjectUrl) return trainingManualObjectUrl;
    const base64 = String(globalThis.__VIRM_TRAINING_MANUAL_PDF_BASE64__ || "");
    if (!base64) return "";
    try {
      const binary = window.atob(base64);
      const bytes = new Uint8Array(binary.length);
      for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index);
      trainingManualObjectUrl = URL.createObjectURL(new Blob([bytes], { type: "application/pdf" }));
      return trainingManualObjectUrl;
    } catch (_error) {
      return "";
    }
  }

  function trainingManualUrl() {
    const embeddedUrl = embeddedTrainingManualUrl();
    if (embeddedUrl) return embeddedUrl;
    try {
      return globalThis.chrome?.runtime?.getURL?.("manuals/Traeningsmodul_manual.pdf") || "";
    } catch (_error) {
      return "";
    }
  }

  function openTrainingManual() {
    const url = trainingManualUrl();
    if (!url) {
      window.alert("Manualen kunne ikke åbnes. Genindlæs siden efter opdatering af VIRM Assistant.");
      return;
    }
    const link = document.createElement("a");
    link.href = url;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.setAttribute("aria-label", "Åbn Træningsmodulets manual");
    link.style.display = "none";
    document.body.appendChild(link);
    link.click();
    link.remove();
  }

  function openMainMenu(anchor) {
    refs.contextMenu.classList.remove("is-open");
    refs.templateMenu.classList.remove("is-open");
    const reportingNodes = globalThis.__VIRM_REPORTING_V1__?.menuNodes?.({ shadow: true }) || [];
    const feedbackNode = reportingNodes.length ? reportingNodes[reportingNodes.length - 1] : null;
    refs.mainMenu.replaceChildren(
      menuItem("Skift hold", switchTeam),
      menuItem("Importér holdtræning", () => {
