    const pageCheckbox = current.querySelector(".virm-assistant-data-request-page-checkbox");
    const globalCheckbox = current.querySelector(".virm-assistant-data-request-global-checkbox");
    const globalEnabled = !state.globalDisabled;
    const pageEnabled = globalEnabled && !state.pageDisabled;
    if (label) label.classList.toggle("virm-assistant-hidden-menu-item", state.disabled);
    if (triggerText) triggerText.textContent = "Indstil data request";
    if (pageToggle) pageToggle.title = globalEnabled ? "" : "Aktivér Globalt først";
    if (pageCheckbox) {
      pageCheckbox.checked = pageEnabled;
      pageCheckbox.disabled = !globalEnabled;
    }
    if (globalCheckbox) globalCheckbox.checked = globalEnabled;
  }

  async function applyDataRequestScope(scope) {
    if (!dataRequestApi) return;
    const current = await dataRequestState();
    if (scope === "page") {
      if (current.globalDisabled) return;
      await dataRequestApi.setPageDisabled(!current.pageDisabled);
    } else if (scope === "global") {
      await dataRequestApi.setGlobalDisabled(!current.globalDisabled);
      window.location.reload();
      return;
    } else return;
    const next = await dataRequestState();
    await syncRequestMenu();
    if (next.disabled) {
      removeBadges();
      closeMenu();
      return;
    }
    window.location.reload();
  }

  async function render(cache = null) {
    const token = ++renderToken;
    removeBadges();
    const state = await dataRequestState();
    if (state.disabled) return false;

    const current = cache || await api.getCache();
    const kind = teamKind(current);
    const enabled = kvModeApi?.getEnabled ? await kvModeApi.getEnabled(kind) : (await storageGet(enabledKey(kind))) !== false;
    const team = current.teams?.[kind] || null;
    const match = team?.matches?.[matchId] || null;
    const ownName = ownSquadName(kind);
    const opponentName = normalizeText(match?.opponent || opponentNameFromHeading());

    const nodes = matchPitchClubNodes(ownName, opponentName);
    if (!nodes.ownSlot || !nodes.opponentSlot) return false;

    let ownValue = NaN;
    let opponentValue = NaN;
    let ownSource = "vman";
    let opponentSource = "vman";

    if (enabled) {
      // Optaktsiden viser allerede de faktiske VT-værdier på hver banehalvdel.
      // Brug dem før cache, så KV altid svarer til den startopstilling brugeren ser nu.
      ownValue = lineupKvFromPitchSlot(nodes.ownSlot);
      opponentValue = lineupKvFromPitchSlot(nodes.opponentSlot);
      if (!Number.isFinite(ownValue) && kvModeApi?.isValidStart11?.(match?.ownKv)) ownValue = finiteKv(match?.ownKv?.average);
      if (!Number.isFinite(opponentValue) && kvModeApi?.isValidStart11?.(match?.opponentKv)) opponentValue = finiteKv(match?.opponentKv?.average);
      if (!(ownValue > 0)) ownValue = NaN;
      if (!(opponentValue > 0)) opponentValue = NaN;
      ownSource = Number.isFinite(ownValue) ? "start11" : "vman";
      opponentSource = Number.isFinite(opponentValue) ? "start11" : "vman";
    }

    if (!Number.isFinite(ownValue)) {
      ownValue = await ownVmanKv(kind);
      ownSource = "vman";
    }
    if (!Number.isFinite(opponentValue)) {
      opponentValue = await opponentVmanKv(kind, match);
      opponentSource = "vman";
    }
    if (token !== renderToken) return false;

    removeBadges();
    if (nodes.ownSlot?.clubHost?.isConnected && Number.isFinite(ownValue)) {
      appendAfterClubMarker(nodes.ownSlot, createBadge(ownValue, "own", ownSource));
    }
    if (nodes.opponentSlot?.clubHost?.isConnected && Number.isFinite(opponentValue)) {
      appendAfterClubMarker(nodes.opponentSlot, createBadge(opponentValue, "opponent", opponentSource));
    }
    return Boolean(
      document.querySelector(`.${BADGE_CLASS}-own`) &&
      document.querySelector(`.${BADGE_CLASS}-opponent`)
    );
  }

