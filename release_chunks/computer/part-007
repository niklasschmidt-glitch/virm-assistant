  function copySelectedItems() {
    clipboardItems = deepClone(selectedItems());
    showToast(`${clipboardItems.length} linje${clipboardItems.length === 1 ? "" : "r"} kopieret.`);
  }

  function pasteAfterSelected() {
    if (!clipboardItems.length) return;
    const indices = selectedIndices();
    const insertAt = indices.length ? indices[indices.length - 1] + 1 : activeProgram().sessions.length;
    const copies = deepClone(clipboardItems);
    reassignItemIds(copies);
    commitChange("Indsæt session", () => {
      activeProgram().sessions.splice(insertAt, 0, ...copies);
      selectedIds = new Set(copies.map((item) => item.id));
    }, { keepEditor: true });
  }

  function duplicateSelectedItems() {
    const items = deepClone(selectedItems());
    const indices = selectedIndices();
    if (!items.length || !indices.length) return;
    reassignItemIds(items);
    const insertAt = indices[indices.length - 1] + 1;
    commitChange("Duplikér session", () => {
      activeProgram().sessions.splice(insertAt, 0, ...items);
      selectedIds = new Set(items.map((item) => item.id));
    }, { keepEditor: true });
  }

  function moveSelected(direction) {
    const sessions = activeProgram().sessions;
    const indices = selectedIndices();
    if (!indices.length) return;
    if (direction < 0 && indices[0] === 0) return;
    if (direction > 0 && indices[indices.length - 1] === sessions.length - 1) return;

    commitChange("Flyt session", () => {
      const selectedSet = new Set(indices);
      if (direction < 0) {
        for (const index of indices) {
          if (!selectedSet.has(index - 1)) {
            [sessions[index - 1], sessions[index]] = [sessions[index], sessions[index - 1]];
          }
        }
      } else {
        for (const index of [...indices].reverse()) {
          if (!selectedSet.has(index + 1)) {
            [sessions[index + 1], sessions[index]] = [sessions[index], sessions[index + 1]];
          }
        }
      }
    }, { keepEditor: true });
  }

  function flattenItemToPhases(item) {
    if (item.type === "block") {
      const flattened = [];
      for (let repetition = 0; repetition < item.repetitions; repetition += 1) {
        flattened.push(...deepClone(item.phases));
      }
      return flattened;
    }
    return [deepClone(item)];
  }

  function nextBlockName() {
    const used = new Set(activeProgram().sessions
      .filter((item) => item.type === "block")
      .map((item) => normalizeText(item.name)));
    let number = 1;
    while (used.has(`Blok ${number}`)) number += 1;
    return `Blok ${number}`;
  }

  function makeBlockFromSelected() {
    const indices = selectedIndices();
    if (!indices.length) return;
    const sessions = activeProgram().sessions;
    const phases = [];
    for (const index of indices) {
      phases.push(...flattenItemToPhases(sessions[index]));
    }
    for (const phase of phases) {
      phase.id = uid("phase");
    }
    const block = {
      id: uid("block"),
      type: "block",
      name: nextBlockName(),
      repetitions: 1,
      phases,
    };
    const insertAt = indices[0];
    commitChange("Lav blok", () => {
      const selectedIndexSet = new Set(indices);
      activeProgram().sessions = sessions.filter((_item, index) => !selectedIndexSet.has(index));
      activeProgram().sessions.splice(insertAt, 0, block);
      selectedIds = new Set([block.id]);
      editorState = { type: "block", itemId: block.id };
    }, { keepEditor: true });
  }

  function dissolveSelectedBlock() {
    const items = selectedItems();
    if (items.length !== 1 || items[0].type !== "block") return;
    const block = items[0];
    const index = activeProgram().sessions.findIndex((item) => item.id === block.id);
    const expanded = [];
    for (let repetition = 0; repetition < block.repetitions; repetition += 1) {
      const phases = deepClone(block.phases);
      for (const phase of phases) phase.id = uid("phase");
      expanded.push(...phases);
    }
    commitChange("Opløs blok", () => {
      activeProgram().sessions.splice(index, 1, ...expanded);
      selectedIds = new Set(expanded.map((phase) => phase.id));
    });
  }

  function openNewPhaseEditor(parentBlockId = null) {
    editorState = parentBlockId
      ? { type: "phase-new-block", parentBlockId }
      : { type: "phase-new" };
    currentDistribution = {};
    resetDistributionPriorities();
    editorDraft = null;
    renderEditor();
  }

  function openPhaseEditor(itemId) {
    const item = activeProgram().sessions.find((candidate) => candidate.id === itemId);
    if (!item || item.type !== "phase") return;
    editorState = { type: "phase", itemId };
    currentDistribution = deepClone(item.distribution || {});
    resetDistributionPriorities();
    editorDraft = null;
    selectedIds = new Set([itemId]);
    renderProgram();
    renderEditor();
  }

  function openNestedPhaseEditor(blockId, phaseId) {
    const block = activeProgram().sessions.find((item) => item.id === blockId && item.type === "block");
    const phase = block && block.phases.find((candidate) => candidate.id === phaseId);
    if (!phase) return;
    editorState = { type: "phase-block", parentBlockId: blockId, phaseId };
    currentDistribution = deepClone(phase.distribution || {});
