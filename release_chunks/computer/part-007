    }

    return { tactics, matches, table };
  }

  function buildStateKey(tactics) {
    const signature = tactics.map(tactic => tactic.id).join(',');
    return `${teamKind}:${signature || 'no-tactics'}`;
  }

  function clampInteger(value, min, max, fallback) {
    const number = Math.round(Number(value));
    return Number.isFinite(number) ? Math.max(min, Math.min(max, number)) : fallback;
  }

  function normalizeCutoffs(lowValue, highValue) {
    let low = clampInteger(lowValue, 1, 97, DEFAULT_LOW_CUTOFF);
    let high = clampInteger(highValue, 3, 99, DEFAULT_HIGH_CUTOFF);
    if (high - low < 2) high = Math.min(99, low + 2);
    if (high - low < 2) low = Math.max(1, high - 2);
    return { low, high };
  }

  function freshBandSelections(tactics) {
    const all = tactics.map(tactic => tactic.id);
    return { low: [...all], mid: [...all], high: [...all] };
  }

  function freshCompetitionSelections(tactics) {
    const all = tactics.map(tactic => tactic.id);
    return { cup: [...all], league: [...all], friendly: [...all] };
  }

  function freshNextByBand(tactics) {
    const first = tactics[0]?.id || null;
    return { low: first, mid: first, high: first };
  }

  function freshState(tactics) {
    return {
      schemaVersion: 2,
      teamKind,
      lowCutoff: DEFAULT_LOW_CUTOFF,
      highCutoff: DEFAULT_HIGH_CUTOFF,
      bandTacticIds: freshBandSelections(tactics),
      competitionTacticIds: freshCompetitionSelections(tactics),
      distributionPrinciple: DEFAULT_DISTRIBUTION_PRINCIPLE,
      nextTacticIdByBand: freshNextByBand(tactics),
      nextFallbackTacticId: tactics[0]?.id || null,
      // Round robin har én global cursor for hele kampprogrammet. KV-bånd og
      // kampform filtrerer kun kandidatfeltet; de starter ikke egne sekvenser.
      nextRoundRobinTacticId: tactics[0]?.id || null,
      // Færrest bruger én global round-robin-markør som tie-breaker.
      // KV-båndene afgør kun kandidatfeltet; de må ikke starte hver sin sekvens.
      nextFewestTacticId: tactics[0]?.id || null,
      processed: {},
      updatedAt: Date.now()
    };
  }

  function normalizeState(raw, tactics) {
    const available = new Set(tactics.map(tactic => tactic.id));
    const fallback = freshState(tactics);
    if (!raw || raw.schemaVersion !== 2 || raw.teamKind !== teamKind) return fallback;

    const cutoffs = normalizeCutoffs(raw.lowCutoff, raw.highCutoff);
    const bandTacticIds = {};
    const competitionTacticIds = {};
    const nextTacticIdByBand = {};
    for (const band of BAND_KEYS) {
      const rawIds = Array.isArray(raw.bandTacticIds?.[band]) ? raw.bandTacticIds[band].map(String) : null;
      bandTacticIds[band] = rawIds == null
        ? [...fallback.bandTacticIds[band]]
        : rawIds.filter(id => available.has(id));
      const requestedNext = String(raw.nextTacticIdByBand?.[band] || '');
      nextTacticIdByBand[band] = available.has(requestedNext)
        ? requestedNext
        : tactics[0]?.id || null;
    }
    for (const competition of COMPETITION_KEYS) {
      const rawIds = Array.isArray(raw.competitionTacticIds?.[competition]) ? raw.competitionTacticIds[competition].map(String) : null;
      competitionTacticIds[competition] = rawIds == null
        ? [...fallback.competitionTacticIds[competition]]
        : rawIds.filter(id => available.has(id));
    }

    const processed = {};
    if (raw.processed && typeof raw.processed === 'object') {
      const entries = Object.entries(raw.processed)
        .filter(([selectionId, item]) => selectionId && item && typeof item === 'object')
        .sort((a, b) => Number(a[1].appliedAt || 0) - Number(b[1].appliedAt || 0))
        .slice(-MAX_PROCESSED);
      for (const [selectionId, item] of entries) {
        processed[String(selectionId)] = {
          tacticId: String(item.tacticId || ''),
          tacticLabel: String(item.tacticLabel || ''),
          matchId: String(item.matchId || ''),
          band: BAND_KEYS.includes(item.band) ? item.band : '',
          opponentKv: item.opponentKv === null || item.opponentKv === undefined || item.opponentKv === ''
            ? null
            : Number.isFinite(Number(item.opponentKv)) ? Number(item.opponentKv) : null,
          appliedAt: Number(item.appliedAt || 0),
          source: String(item.source || ''),
          confidence: Number.isFinite(Number(item.confidence)) ? Number(item.confidence) : null
        };
      }
    }

    return {
      schemaVersion: 2,
      teamKind,
      lowCutoff: cutoffs.low,
      highCutoff: cutoffs.high,
      bandTacticIds,
      competitionTacticIds,
      distributionPrinciple: DISTRIBUTION_PRINCIPLES.includes(raw.distributionPrinciple)
        ? raw.distributionPrinciple
        : DEFAULT_DISTRIBUTION_PRINCIPLE,
      nextTacticIdByBand,
      nextFallbackTacticId: available.has(String(raw.nextFallbackTacticId || ''))
        ? String(raw.nextFallbackTacticId)
        : tactics[0]?.id || null,
      nextRoundRobinTacticId: available.has(String(raw.nextRoundRobinTacticId || ''))
        ? String(raw.nextRoundRobinTacticId)
        : tactics[0]?.id || null,
      nextFewestTacticId: available.has(String(raw.nextFewestTacticId || ''))
        ? String(raw.nextFewestTacticId)
        : tactics[0]?.id || null,
      processed,
      updatedAt: Number(raw.updatedAt || Date.now())
    };
  }

  async function loadState() {
    const all = (await storageGet(STORAGE_KEY)) || {};
    session.state = normalizeState(all[session.stateKey], session.tactics);
    await saveState();
  }

  async function saveState() {
    session.state.updatedAt = Date.now();
    const all = (await storageGet(STORAGE_KEY)) || {};
    all[session.stateKey] = session.state;
    await storageSet(STORAGE_KEY, all);
  }

  function selectedTacticsForBand(band) {
    const selected = new Set(session.state?.bandTacticIds?.[band] || []);
    return session.tactics.filter(tactic => selected.has(tactic.id));
  }

  function tacticIsSelectedForCompetition(tacticId, competition) {
    return (session.state?.competitionTacticIds?.[competition] || []).includes(String(tacticId));
  }

  function matchCompetitionKey(match) {
    const type = normalizeText(match?.type).toLocaleLowerCase('da-DK');
    if (/\bcup\b|pokal/.test(type)) return 'cup';
    if (/liga|league/.test(type)) return 'league';
    if (/venskab|friendly/.test(type)) return 'friendly';
    return null;
  }

  function tacticAllowedForCompetition(tactic, match) {
    if (!tactic) return false;
    const competition = matchCompetitionKey(match);
    return !competition || tacticIsSelectedForCompetition(tactic.id, competition);
  }

  function competitionTacticsForMatch(match) {
    return session.tactics.filter(tactic => tacticAllowedForCompetition(tactic, match));
  }

  function preferredTacticsForMatch(match, band) {
    const competitionAllowed = competitionTacticsForMatch(match);
    if (!band) return [];
    return competitionAllowed.filter(tactic => tacticIsSelectedInBand(tactic.id, band));
  }

  function nextStartIndexForScope(scope) {
    if (!session.tactics.length) return 0;
    const nextId = scope === 'fewest'
      ? session.state?.nextFewestTacticId
      : scope === 'round_robin'
        ? session.state?.nextRoundRobinTacticId
        : scope === 'fallback'
          ? session.state?.nextFallbackTacticId
          : session.state?.nextTacticIdByBand?.[scope];
    const index = session.tactics.findIndex(tactic => tactic.id === nextId);
    return index >= 0 ? index : 0;
  }

  function roundRobinChoice(candidates, startIndex = 0) {
    const count = session.tactics.length;
    if (!count || !candidates?.length) return null;
    const allowed = new Set(candidates.map(tactic => tactic.id));
    for (let offset = 0; offset < count; offset += 1) {
      const index = (startIndex + offset) % count;
      const tactic = session.tactics[index];
      if (!allowed.has(tactic.id)) continue;
      return { tactic, index };
    }
    return null;
  }

  function assignedTacticIdForMatch(match) {
    const visibleTacticId = String(match?.select?.value || '');
    if (session.tactics.some(tactic => tactic.id === visibleTacticId)) return visibleTacticId;
    const processedTacticId = String(session.state?.processed?.[match?.selectionId]?.tacticId || '');
    return session.tactics.some(tactic => tactic.id === processedTacticId) ? processedTacticId : '';
  }

  function currentUpcomingAssignmentCounts() {
    const counts = Object.fromEntries(session.tactics.map(tactic => [tactic.id, 0]));
    for (const item of Object.values(session.state?.processed || {})) {
      const tacticId = String(item?.tacticId || '');
      if (Object.prototype.hasOwnProperty.call(counts, tacticId)) counts[tacticId] += 1;
    }
    return counts;
  }

  function clearCurrentProcessedAssignments() {
    const processed = session.state?.processed || {};
    for (const match of session.matches) delete processed[String(match.selectionId)];
  }

  function chooseByPrinciple(candidates, startIndex, counts) {
    if (!candidates?.length) return null;
    if (session.state?.distributionPrinciple !== 'fewest') {
      return roundRobinChoice(candidates, startIndex);
    }
    let minimum = Infinity;
    for (const tactic of candidates) minimum = Math.min(minimum, Number(counts[tactic.id] || 0));
    const tied = candidates.filter(tactic => Number(counts[tactic.id] || 0) === minimum);
    return roundRobinChoice(tied, startIndex);
  }

  function newMatches() {
    const processed = session.state?.processed || {};
    return session.matches.filter(match => !processed[match.selectionId]);
  }

  function opponentKvForMatch(match) {
    const result = session.kvTeam?.matches?.[match.matchId]?.opponentKv;
    const average = Number(result?.average);
    if (session.kvStart11Enabled && kvModeApi?.isValidStart11?.(result)) {
      return average;
    }
    const direct = session.directOpponentKv?.[String(match?.matchId)] || null;
    const directAverage = Number(direct?.average);
    if (session.kvStart11Enabled && kvModeApi?.isValidStart11?.(direct)) {
      return directAverage;
    }
    const standard = session.standardOpponentKv?.[String(match?.matchId)] || null;
    const standardAverage = Number(standard?.average);
    if (Number.isFinite(standardAverage) && standardAverage > 0) return standardAverage;
    const vmanKv = Number(match?.vmanKv);
    return Number.isFinite(vmanKv) && vmanKv > 0 ? vmanKv : null;
  }

  function bandForKv(kv) {
    // Manglende KV skal ikke fortolkes som 0. Number(null) er 0 i JS.
    // KV 0 er ikke en gyldig klub-KV og bliver derfor afvist tidligere.
    if (kv === null || kv === undefined || kv === '') return null;
    const value = Number(kv);
    if (!Number.isFinite(value) || value <= 0) return null;
    if (value < session.state.lowCutoff) return 'low';
    if (value < session.state.highCutoff) return 'mid';
    return 'high';
  }

  function bandLabel(band) {
    if (band === 'low') return 'Lav';
    if (band === 'mid') return 'Mellem';
    return 'Høj';
  }

  function bandRangeText(band) {
    const low = session.state.lowCutoff;
    const high = session.state.highCutoff;
    if (band === 'low') return `< ${low}`;
    if (band === 'mid') return `${low}–${high - 1}`;
    return `≥ ${high}`;
  }

  function planAssignments() {
    const matches = newMatches();
    const cursors = {
      fewest: nextStartIndexForScope('fewest'),
      round_robin: nextStartIndexForScope('round_robin'),
      fallback: nextStartIndexForScope('fallback')
    };
    for (const band of BAND_KEYS) cursors[band] = nextStartIndexForScope(band);
    const counts = currentUpcomingAssignmentCounts();
    const useFewest = session.state?.distributionPrinciple === 'fewest';
    const useRoundRobin = session.state?.distributionPrinciple === 'round_robin';

    const plan = [];
    for (const match of matches) {
      const opponentKv = opponentKvForMatch(match);
      const band = bandForKv(opponentKv);
      const preferred = preferredTacticsForMatch(match, band);
      const competitionAllowed = competitionTacticsForMatch(match);
      const fallback = preferred.length === 0;
      const candidates = fallback ? competitionAllowed : preferred;
      if (!candidates.length) continue;

      const scope = band || 'fallback';
      // Både Round robin og Færrest-tie-breakeren bruger en fælles cursor på
      // tværs af KV-bånd. Bånd/kampform begrænser kun de tilladte kandidater.
      const cursorKey = useFewest ? 'fewest' : useRoundRobin ? 'round_robin' : scope;
      const choice = chooseByPrinciple(candidates, cursors[cursorKey], counts);
      if (!choice) continue;
      const nextIndex = session.tactics.length ? (choice.index + 1) % session.tactics.length : 0;
      const nextTacticId = session.tactics[nextIndex]?.id || null;
      cursors[cursorKey] = nextIndex;
      counts[choice.tactic.id] = Number(counts[choice.tactic.id] || 0) + 1;
      plan.push({ match, tactic: choice.tactic, band, opponentKv, fallback, scope, cursorKey, nextTacticId });
    }
    return plan;
  }

  function unavailableMatches() {
    return newMatches().filter(match => !Number.isFinite(opponentKvForMatch(match)));
  }

  function matchesWithoutAllowedTactic() {
    return newMatches().filter(match => !competitionTacticsForMatch(match).length);
  }

  function setStatus(message, kind = '') {
    session.status = { message, kind };
    const status = document.querySelector(`#${PANEL_ID} .virm-assistant-rotation-status`);
    if (status) {
      status.textContent = message;
      status.dataset.kind = kind;
    }
  }

  function setBusy(busy) {
    session.busy = busy;
    document.querySelectorAll(`#${PANEL_ID} button, #${PANEL_ID} input, #${PANEL_ID} select`).forEach(element => {
      element.disabled = busy;
    });
    document.querySelectorAll(`#${PANEL_ID} [role="slider"]`).forEach(element => {
      element.setAttribute('aria-disabled', busy ? 'true' : 'false');
      element.classList.toggle('is-disabled', busy);
    });
  }

  function matchSummary(match) {
    return [match.dayLabel, match.time, match.opponent].filter(Boolean).join(' · ');
  }

  function cutoffPercent(value) {
    return ((Number(value) - 1) / 98) * 100;
  }

  function updateMultibandVisual(panel) {
    const low = session.state.lowCutoff;
    const high = session.state.highCutoff;
    panel.style.setProperty('--virm-low-cutoff-pct', `${cutoffPercent(low)}%`);
    panel.style.setProperty('--virm-high-cutoff-pct', `${cutoffPercent(high)}%`);

    const lowInput = panel.querySelector('[data-cutoff="low"]');
    const highInput = panel.querySelector('[data-cutoff="high"]');
    if (lowInput && document.activeElement !== lowInput) lowInput.value = String(low);
    if (highInput && document.activeElement !== highInput) highInput.value = String(high);

    for (const kind of ['low', 'high']) {
      const handle = panel.querySelector(`[data-virm-crossover="${kind}"]`);
      if (!handle) continue;
      const value = kind === 'low' ? low : high;
      const minimum = kind === 'low' ? 1 : low + 1;
      const maximum = kind === 'low' ? 98 : 99;
      handle.setAttribute('aria-valuemin', String(minimum));
      handle.setAttribute('aria-valuemax', String(maximum));
      handle.setAttribute('aria-valuenow', String(value));
      handle.setAttribute('aria-valuetext', `${value} KV`);
    }
  }

  function updateBandHeaders(panel) {
    updateMultibandVisual(panel);
    for (const band of BAND_KEYS) {
      const header = panel.querySelector(`[data-virm-matrix-band="${band}"]`);
      if (header) header.title = bandRangeText(band);
    }
  }

  function renderPreview(panel) {
    updateBandHeaders(panel);
    const preview = panel.querySelector('.virm-assistant-rotation-preview');
    const plan = planAssignments();
    const untreated = newMatches();
    const missingKv = unavailableMatches();
    const noTactic = matchesWithoutAllowedTactic();

    preview.replaceChildren();

    const summary = document.createElement('div');
    summary.className = 'virm-assistant-rotation-summary';
    if (!session.matches.length) {
      summary.textContent = 'Der er ingen kommende kampe på siden.';
    } else if (!session.kvTeam) {
      summary.textContent = 'Afventer KV for de kommende kampe…';
    } else if (!untreated.length) {
      summary.textContent = `Alle ${session.matches.length} viste kampe er allerede behandlet.`;
    } else if (noTactic.length) {
      summary.textContent = `${noTactic.length} ${noTactic.length === 1 ? 'kamp kan ikke få' : 'kampe kan ikke få'} taktik på grund af Cup/Liga-valgene.`;
    } else if (missingKv.length) {
      summary.textContent = `${untreated.length} ${untreated.length === 1 ? 'kamp får' : 'kampe får'} taktik. ${missingKv.length} uden KV fordeles efter fordelingsprincippet.`;
    } else {
      summary.textContent = `${untreated.length} ${untreated.length === 1 ? 'kamp tildeles' : 'kampe tildeles'} taktik ud fra modstanderens klubvurdering.`;
    }
    preview.append(summary);

    const list = document.createElement('div');
    list.className = 'virm-assistant-rotation-preview-list';
    for (const assignment of plan) {
      const row = document.createElement('div');
      row.className = 'virm-assistant-rotation-preview-row';
      const matchText = document.createElement('span');
      matchText.textContent = matchSummary(assignment.match);

      const meta = document.createElement('strong');
      meta.className = 'virm-assistant-rotation-preview-meta';
      const kvText = document.createElement('span');
      kvText.className = 'virm-assistant-preview-kv';
      const numericKv = Number(assignment.opponentKv);
      kvText.textContent = assignment.opponentKv !== null
        && assignment.opponentKv !== undefined
        && assignment.opponentKv !== ''
        && Number.isFinite(numericKv)
        && numericKv > 0
        ? `KV ${numericKv.toFixed(1)}`
        : 'KV –';
      const bandText = document.createElement('span');
      bandText.className = 'virm-assistant-preview-band';
      bandText.textContent = assignment.band ? bandLabel(assignment.band) : 'Fallback';
      const arrowText = document.createElement('span');
      arrowText.className = 'virm-assistant-preview-arrow';
      arrowText.textContent = '→';
      const tacticText = document.createElement('span');
      tacticText.className = 'virm-assistant-preview-tactic';
      tacticText.textContent = assignment.tactic.label;
      meta.append(kvText, bandText, arrowText, tacticText);

      row.append(matchText, meta);
      list.append(row);
    }
    preview.append(list);

    const applyButton = panel.querySelector('.virm-assistant-apply-rotation');
    const resetButton = panel.querySelector('.virm-assistant-reset-rotation');
    if (applyButton) applyButton.disabled = session.busy || session.initialSyncPending || !plan.length;
    if (resetButton) resetButton.disabled = session.busy || !BAND_KEYS.some(band => selectedTacticsForBand(band).length);
  }

  async function invalidateRotation(panel, message = 'Fordelingen er ændret. Tryk Udfyld kampprogram for at opdatere kampene.') {
    // Kun de kampe, der aktuelt er synlige, skal kunne omfordeles. Ældre
    // poster bevares som historisk taktikforbrug for “Færrest kampe”.
    clearCurrentProcessedAssignments();
    for (const band of BAND_KEYS) {
      session.state.nextTacticIdByBand[band] = session.tactics[0]?.id || null;
    }
    session.state.nextFallbackTacticId = session.tactics[0]?.id || null;
    session.state.nextRoundRobinTacticId = session.tactics[0]?.id || null;
    session.state.nextFewestTacticId = session.tactics[0]?.id || null;
    await saveState();
    renderPreview(panel);
    setStatus(message, 'muted');
  }

  let cutoffCommitTimer = 0;

  function setCutoffLive(panel, kind, rawValue) {
    const currentLow = session.state.lowCutoff;
    const currentHigh = session.state.highCutoff;
    let low = currentLow;
    let high = currentHigh;

    if (kind === 'low') {
      low = clampInteger(rawValue, 1, 97, currentLow);
      if (high - low < 2) high = Math.min(99, low + 2);
    } else {
      high = clampInteger(rawValue, 3, 99, currentHigh);
      if (high - low < 2) low = Math.max(1, high - 2);
    }

    const changed = low !== currentLow || high !== currentHigh;
    session.state.lowCutoff = low;
    session.state.highCutoff = high;

    const lowInput = panel.querySelector('[data-cutoff="low"]');
    const highInput = panel.querySelector('[data-cutoff="high"]');
    if (lowInput) lowInput.value = String(low);
    if (highInput) highInput.value = String(high);
    updateBandHeaders(panel);
    return changed;
  }

  async function commitCutoffChange(panel) {
    window.clearTimeout(cutoffCommitTimer);
    cutoffCommitTimer = 0;
    try {
      await invalidateRotation(panel);
    } catch (error) {
      setStatus(`Skæringspunkterne kunne ikke gemmes: ${error.message}`, 'error');
    }
  }

  function scheduleCutoffCommit(panel, delayMs = 180) {
    window.clearTimeout(cutoffCommitTimer);
    cutoffCommitTimer = window.setTimeout(() => commitCutoffChange(panel), delayMs);
  }

  function makeCutoffModwheel(panel, kind) {
    const wrap = document.createElement('label');
    wrap.className = `virm-assistant-cutoff-modwheel is-${kind}`;
    wrap.dataset.virmCutoffModwheel = kind;

    const caption = document.createElement('span');
    caption.textContent = kind === 'low' ? 'Lav' : 'Høj';

    const input = document.createElement('input');
    input.type = 'number';
    input.inputMode = 'numeric';
    input.className = 'virm-assistant-rotation-cutoff';
    input.dataset.cutoff = kind;
    input.min = kind === 'low' ? '1' : '2';
    input.max = kind === 'low' ? '98' : '99';
    input.step = '1';
    input.value = String(kind === 'low' ? session.state.lowCutoff : session.state.highCutoff);
    input.setAttribute('aria-label', kind === 'low' ? 'Lav skæringspunkt' : 'Høj skæringspunkt');
    input.title = 'Træk lodret, brug musehjulet eller skriv værdien';

    input.addEventListener('change', () => {
      const changed = setCutoffLive(panel, kind, input.value);
      if (changed) commitCutoffChange(panel);
    });

    input.addEventListener('wheel', event => {
      if (session.busy || input.disabled) return;
      event.preventDefault();
      const direction = event.deltaY < 0 ? 1 : -1;
      if (setCutoffLive(panel, kind, session.state[kind === 'low' ? 'lowCutoff' : 'highCutoff'] + direction)) {
        scheduleCutoffCommit(panel);
      }
    }, { passive: false });

    let drag = null;
    input.addEventListener('pointerdown', event => {
      if (session.busy || input.disabled || (event.button !== undefined && event.button !== 0)) return;
      drag = {
        pointerId: event.pointerId,
        startY: event.clientY,
        startValue: session.state[kind === 'low' ? 'lowCutoff' : 'highCutoff'],
        active: false,
        changed: false
      };
    });
    input.addEventListener('pointermove', event => {
      if (!drag || drag.pointerId !== event.pointerId) return;
      const delta = drag.startY - event.clientY;
      if (!drag.active && Math.abs(delta) < 5) return;
      if (!drag.active) {
        drag.active = true;
        try { input.setPointerCapture?.(event.pointerId); } catch (_) { /* Safari kan afvise capture. */ }
      }
      event.preventDefault();
      const steps = Math.round(delta / 7);
      if (setCutoffLive(panel, kind, drag.startValue + steps)) drag.changed = true;
    });
    const finishDrag = event => {
      if (!drag || (event?.pointerId !== undefined && drag.pointerId !== event.pointerId)) return;
      const shouldCommit = drag.active && drag.changed;
      drag = null;
      if (shouldCommit) commitCutoffChange(panel);
    };
    input.addEventListener('pointerup', finishDrag);
    input.addEventListener('pointercancel', finishDrag);
    input.addEventListener('lostpointercapture', () => {
      if (!drag) return;
      const shouldCommit = drag.active && drag.changed;
      drag = null;
      if (shouldCommit) commitCutoffChange(panel);
    });

    wrap.append(caption, input);
    return wrap;
  }

  function bindCrossoverHandle(handle, panel, kind) {
    const track = panel.querySelector('.virm-assistant-band-track');
    if (!track) return;
    let activePointer = null;
    let changed = false;

    function valueFromPointer(event) {
      const rect = track.getBoundingClientRect();
      if (!rect.width) return;
      const ratio = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
      const value = Math.round(1 + ratio * 98);
      if (setCutoffLive(panel, kind, value)) changed = true;
    }

    handle.addEventListener('pointerdown', event => {
      if (session.busy || (event.button !== undefined && event.button !== 0)) return;
      event.preventDefault();
      activePointer = event.pointerId ?? 'mouse';
      changed = false;
      try { handle.setPointerCapture?.(event.pointerId); } catch (_) { /* Pointer capture er kun en forbedring. */ }
      valueFromPointer(event);
    });
    handle.addEventListener('pointermove', event => {
      if (activePointer === null || activePointer !== (event.pointerId ?? 'mouse')) return;
      event.preventDefault();
      valueFromPointer(event);
    });
    const finish = event => {
      if (activePointer === null) return;
      if (event?.pointerId !== undefined && activePointer !== event.pointerId) return;
      activePointer = null;
      if (changed) commitCutoffChange(panel);
      changed = false;
    };
    handle.addEventListener('pointerup', finish);
    handle.addEventListener('pointercancel', finish);
    handle.addEventListener('lostpointercapture', () => {
      if (activePointer === null) return;
      activePointer = null;
      if (changed) commitCutoffChange(panel);
      changed = false;
    });
    handle.addEventListener('keydown', event => {
      if (session.busy) return;
      const delta = event.key === 'ArrowLeft' || event.key === 'ArrowDown' ? -1
        : event.key === 'ArrowRight' || event.key === 'ArrowUp' ? 1
          : 0;
      if (!delta) return;
      event.preventDefault();
      const current = session.state[kind === 'low' ? 'lowCutoff' : 'highCutoff'];
      if (setCutoffLive(panel, kind, current + delta)) commitCutoffChange(panel);
    });
  }

  function tacticIsSelectedInBand(tacticId, band) {
    return (session.state.bandTacticIds?.[band] || []).includes(String(tacticId));
  }

  function setTacticSelectedInBand(tacticId, band, checked) {
    const current = new Set(session.state.bandTacticIds?.[band] || []);
    if (checked) current.add(String(tacticId));
    else current.delete(String(tacticId));
    session.state.bandTacticIds[band] = session.tactics.map(entry => entry.id).filter(id => current.has(id));
  }

  function setTacticSelectedForCompetition(tacticId, competition, checked) {
    const current = new Set(session.state.competitionTacticIds?.[competition] || []);
    if (checked) current.add(String(tacticId));
    else current.delete(String(tacticId));
    session.state.competitionTacticIds[competition] = session.tactics.map(entry => entry.id).filter(id => current.has(id));
  }

  function syncGlobalTacticCheckbox(row, tacticId) {
    const global = row?.querySelector('[data-virm-tactic-global]');
    if (!global) return;
    const bandSelectedCount = BAND_KEYS.filter(band => tacticIsSelectedInBand(tacticId, band)).length;
    const competitionSelectedCount = COMPETITION_KEYS.filter(competition => tacticIsSelectedForCompetition(tacticId, competition)).length;
    const selectedCount = bandSelectedCount + competitionSelectedCount;
    const totalCount = BAND_KEYS.length + COMPETITION_KEYS.length;
    global.checked = selectedCount === totalCount;
    global.indeterminate = selectedCount > 0 && selectedCount < totalCount;
    global.setAttribute('aria-checked', global.indeterminate ? 'mixed' : global.checked ? 'true' : 'false');
  }

  function renderTactics(panel) {
    const body = panel.querySelector('[data-virm-tactic-matrix-body]');
    if (!body) return;
    body.replaceChildren();

    if (!session.tactics.length) {
      const empty = document.createElement('div');
      empty.className = 'virm-assistant-rotation-empty';
      empty.textContent = 'Der blev ikke fundet nogen navngivne taktikker.';
      body.append(empty);
      return;
    }

    session.tactics.forEach((tactic, index) => {
      const row = document.createElement('div');
      row.className = 'virm-assistant-tactic-matrix-row';
      row.title = tactic.label;

      const global = document.createElement('input');
      global.type = 'checkbox';
      global.dataset.virmTacticGlobal = tactic.id;
      global.setAttribute('aria-label', `${tactic.label} · alle KV-bånd`);
      global.addEventListener('change', async () => {
        const checked = global.checked;
        for (const band of BAND_KEYS) setTacticSelectedInBand(tactic.id, band, checked);
        for (const competition of COMPETITION_KEYS) setTacticSelectedForCompetition(tactic.id, competition, checked);
        for (const checkbox of row.querySelectorAll('[data-virm-tactic-band], [data-virm-tactic-competition]')) checkbox.checked = checked;
        syncGlobalTacticCheckbox(row, tactic.id);
        try {
          await invalidateRotation(panel);
        } catch (error) {
          setStatus(`Valget kunne ikke gemmes: ${error.message}`, 'error');
        }
      });

      const tacticCell = document.createElement('div');
      tacticCell.className = 'virm-assistant-tactic-matrix-name';
      const number = document.createElement('span');
      number.className = 'virm-assistant-tactic-number';
      number.textContent = String(index + 1);
      const name = document.createElement('span');
      name.className = 'virm-assistant-band-tactic-name';
      name.textContent = tactic.label;
      tacticCell.append(number, name);

      row.append(global, tacticCell);

      for (const competition of COMPETITION_KEYS) {
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.dataset.virmTacticCompetition = competition;
        checkbox.checked = tacticIsSelectedForCompetition(tactic.id, competition);
        const competitionLabel = competition === 'cup' ? 'Cup' : competition === 'friendly' ? 'Venskabskamp' : 'Liga';
        checkbox.setAttribute('aria-label', `${tactic.label} · ${competitionLabel}`);
        checkbox.addEventListener('change', async () => {
          setTacticSelectedForCompetition(tactic.id, competition, checkbox.checked);
          syncGlobalTacticCheckbox(row, tactic.id);
          try {
            await invalidateRotation(panel);
          } catch (error) {
            setStatus(`Valget kunne ikke gemmes: ${error.message}`, 'error');
          }
        });
        row.append(checkbox);
      }

      const groupSeparator = document.createElement('span');
      groupSeparator.className = 'virm-assistant-tactic-group-separator';
      groupSeparator.setAttribute('aria-hidden', 'true');
      row.append(groupSeparator);

      for (const band of BAND_KEYS) {
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.dataset.virmTacticBand = band;
        checkbox.checked = tacticIsSelectedInBand(tactic.id, band);
        checkbox.setAttribute('aria-label', `${tactic.label} · ${bandLabel(band)}`);
        checkbox.addEventListener('change', async () => {
          setTacticSelectedInBand(tactic.id, band, checkbox.checked);
          syncGlobalTacticCheckbox(row, tactic.id);
          try {
            await invalidateRotation(panel);
          } catch (error) {
            setStatus(`Valget kunne ikke gemmes: ${error.message}`, 'error');
          }
        });
        row.append(checkbox);
      }

      body.append(row);
      syncGlobalTacticCheckbox(row, tactic.id);
    });
  }

  function updateCustomSelect(match, tactic) {
    const select = match.select;
    select.value = tactic.id;
    Array.from(select.options || []).forEach(option => {
      option.selected = String(option.value) === tactic.id;
    });

    const custom = select.parentElement?.querySelector('.custom_select')
      || select.previousElementSibling?.classList?.contains('custom_select') && select.previousElementSibling;
    if (!custom) return;

    const valueElement = custom.querySelector('.current .value');
    if (valueElement) valueElement.textContent = `${tactic.label} `;
    const chosenIndex = Array.from(select.options || []).findIndex(option => String(option.value) === tactic.id);
    Array.from(custom.querySelectorAll('ol > li')).forEach((item, index) => {
      item.classList.toggle('selected', index === chosenIndex);
    });
  }

  async function responseError(response) {
    let details = '';
    try { details = normalizeText(await response.text()); } catch (_) { details = ''; }
    return details ? `${response.status}: ${details.slice(0, 180)}` : `${response.status} ${response.statusText}`;
  }

  async function saveTactic(match, tactic) {
    const body = new URLSearchParams();
    body.set('_method', 'patch');
    body.set('new_tactic_selection[new_tactic_id]', tactic.id);

    const response = await fetch(`/new_tactic_selections/${encodeURIComponent(match.selectionId)}`, {
      method: 'POST',
      credentials: 'include',
      headers: {
        Accept: 'text/javascript, text/html, application/json, */*;q=0.8',
        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
        'X-CSRF-Token': csrfToken(),
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: body.toString()
    });
    if (!response.ok) throw new Error(await responseError(response));
    updateCustomSelect(match, tactic);
  }

  function delay(milliseconds) {
    return new Promise(resolve => window.setTimeout(resolve, milliseconds));
  }

  async function applyRotation(panel) {
    const plan = planAssignments();
    if (!plan.length) return;

    setBusy(true);
    renderPreview(panel);
    let succeeded = 0;

    try {
      for (let index = 0; index < plan.length; index += 1) {
        const assignment = plan[index];
        setStatus(`Gemmer ${index + 1}/${plan.length}: ${assignment.tactic.label} mod ${assignment.match.opponent}…`);
        await saveTactic(assignment.match, assignment.tactic);
        session.state.processed[assignment.match.selectionId] = {
          tacticId: assignment.tactic.id,
          tacticLabel: assignment.tactic.label,
          matchId: assignment.match.matchId,
          band: assignment.band,
          opponentKv: assignment.opponentKv,
          appliedAt: Date.now(),
          source: 'rotation',
          confidence: 11
        };
        succeeded += 1;

        if (assignment.cursorKey === 'fewest') {
          session.state.nextFewestTacticId = assignment.nextTacticId || session.tactics[0]?.id || null;
        } else if (assignment.cursorKey === 'round_robin') {
          session.state.nextRoundRobinTacticId = assignment.nextTacticId || session.tactics[0]?.id || null;
        } else if (assignment.scope === 'fallback') {
          session.state.nextFallbackTacticId = assignment.nextTacticId || session.tactics[0]?.id || null;
        } else if (BAND_KEYS.includes(assignment.scope)) {
          session.state.nextTacticIdByBand[assignment.scope] = assignment.nextTacticId || session.tactics[0]?.id || null;
        }
        await saveState();
        if (index < plan.length - 1) await delay(SAVE_DELAY_MS);
      }
      setStatus(`✓ Taktikrotationen blev anvendt på ${succeeded} ${succeeded === 1 ? 'kamp' : 'kampe'}.`, 'success');
      if (succeeded > 0) {
        window.__VIRM_KV_START11_CACHE_V1__?.requestTeamRefresh?.(teamKind, 'tactic-rotation', { delayMs: 350 });
      }
    } catch (error) {
      setStatus(`${succeeded} af ${plan.length} kampe blev gemt. Stoppede ved en fejl: ${error.message}`, 'error');
    } finally {
      setBusy(false);
      renderTactics(panel);
      renderPreview(panel);
    }
  }

  async function resetRotation(panel) {
    // Nulstil betyder, at de viste/kommende kampe skal kunne behandles igen.
    // Historiske poster for kampe, der ikke længere står på siden, bevares,
    // så “Færrest kampe” fortsat kender det tidligere taktikforbrug.
    clearCurrentProcessedAssignments();
    for (const band of BAND_KEYS) {
      session.state.nextTacticIdByBand[band] = session.tactics[0]?.id || null;
    }
    session.state.nextFallbackTacticId = session.tactics[0]?.id || null;
    session.state.nextRoundRobinTacticId = session.tactics[0]?.id || null;
    session.state.nextFewestTacticId = session.tactics[0]?.id || null;
    try {
      await saveState();
      renderPreview(panel);
      setStatus('Rotationen starter forfra. Kampprogrammet kan udfyldes igen.', 'success');
    } catch (error) {
      setStatus(`Rotationen kunne ikke nulstilles: ${error.message}`, 'error');
    }
  }

  function rotationMenuItem(label, handler, options = {}) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'virm-assistant-popup-item virm-assistant-overview-popup-item';
    if (options.active) button.classList.add('is-active');
    button.textContent = label;
    button.addEventListener('click', event => {
      event.stopPropagation();
      handler();
    });
    return button;
  }

  function rotationCheckboxItem(label, checked, handler) {
    const item = document.createElement('label');
    item.className = 'virm-assistant-popup-item virm-assistant-overview-popup-item virm-assistant-overview-checkbox-item';
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.checked = Boolean(checked);
    checkbox.dataset.virmKvStart11Toggle = '1';
    const text = document.createElement('span');
    text.textContent = label;
