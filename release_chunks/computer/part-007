  async function initialize() {
    tpTrace("initialize:start", { readyState: document.readyState });
    ensureHost();
    tpTrace("initialize:after-ensureHost", { hostConnected: Boolean(host?.isConnected), pending: Boolean(host?.classList?.contains("virm-extension-pending")) });
    await loadBuiltinPresets();
    tpTrace("initialize:after-loadBuiltinPresets");
    await loadState();
    tpTrace("initialize:after-loadState", { stateLoaded: Boolean(stateLoaded) });
    renderAll();
    tpTrace("initialize:after-renderAll", { appExists: Boolean(shadow?.querySelector?.(".virm-app")) });
    scanTrainingGroups();
    tpTrace("initialize:after-scanTrainingGroups", { discoveredGroupCount: Number(discoveredGroups?.size || 0) });
    rememberCurrentSquad();
    tpTrace("initialize:after-rememberCurrentSquad");
    liveDateKey = todayISO();
    window.setInterval(() => {
      const nextDateKey = todayISO();
      if (nextDateKey === liveDateKey) return;
      liveDateKey = nextDateKey;
      liveExerciseCache = null;
      liveExerciseCacheSquadId = null;
      renderLiveBar();
      renderTransferButton();
    }, 60000);
    function isVirmOwnedMutationNode(node) {
      const element = node && node.nodeType === 1 ? node : node?.parentElement;
      if (!element || typeof element.closest !== "function") return false;
      return Boolean(element.closest(
        "#virm-extension-host, #virm-extension-grass-spacer, .virm-assistant-daily-transfer, .virm-assistant-training-control, #virm-assistant-tactic-rotation"
      ));
    }

    function mutationNeedsGroupScan(mutation) {
      if (isVirmOwnedMutationNode(mutation.target)) return false;
      const changedNodes = [...mutation.addedNodes, ...mutation.removedNodes];
      if (changedNodes.length && changedNodes.every(isVirmOwnedMutationNode)) return false;
      return true;
    }

    pageObserver = new MutationObserver((mutations) => {
      const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";
      const onTrainingPlanner = VIRM_TRAINING_PLANNER_PATH_RE.test(currentPath);

      // VMAN kan udskifte dele af siden uden en klassisk genindlæsning.
      // Hvis vores host bliver fjernet, genskab Training Planner automatisk.
      if (onTrainingPlanner && !document.getElementById("virm-extension-host")) {
        ensureHost();
        renderAll();
        scanTrainingGroups();
        return;
      }

      if (!mutations.some(mutationNeedsGroupScan)) return;
