  function ensureLegacyPlayerPointsCard() {
    let card = document.getElementById("virm-player-career-points");
    if (card) return card;

    const abilitiesHeading = findAbilitiesHeading();
    if (!abilitiesHeading || !abilitiesHeading.parentNode) return null;

    card = createLegacyPlayerPointsCard();
    abilitiesHeading.parentNode.insertBefore(card, abilitiesHeading);
