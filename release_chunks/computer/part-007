  function tacticRotationSupportPage() {
    const currentPath = String(window.location.pathname || "").replace(/\/+$/, "") || "/";
    return /^\/(?:[a-z]{2}\/)?(?:new_matches\/coming|youth_squad\/matches|new_tactics(?:\/|$)|youth_squad\/tactics(?:\/|$)|new_matches\/\d+\/tactics)$/i.test(currentPath);
  }

  async function dataRequestsAllowed() {
    const guard = window.__VIRM_DATA_REQUESTS_V1__;
    if (!guard?.getState) return true;
    const current = await guard.getState();
    if (current.pageDisabled) return false;
    if (!current.globalDisabled) return true;
    // Taktikrotation er eksplicit undtaget fra global deaktivering.
    return tacticRotationSupportPage();
  }

  function emptyCache() {
    return {
      schemaVersion: 1,
      clubId: "",
      dailyAttemptDate: "",
      dailyCompletedDate: "",
      updatedAt: 0,
      refreshing: null,
      playerRatingsDate: "",
      playerRatings: {},
      teams: { senior: null, youth: null },
    };
  }

  function normalizeCache(raw) {
    const base = emptyCache();
    if (!raw || raw.schemaVersion !== 1) return base;
    return {
      schemaVersion: 1,
      clubId: String(raw.clubId || ""),
      dailyAttemptDate: String(raw.dailyAttemptDate || ""),
      dailyCompletedDate: String(raw.dailyCompletedDate || ""),
      updatedAt: Number(raw.updatedAt || 0),
      refreshing: raw.refreshing && typeof raw.refreshing === "object" ? raw.refreshing : null,
      playerRatingsDate: String(raw.playerRatingsDate || ""),
      playerRatings: raw.playerRatings && typeof raw.playerRatings === "object" ? raw.playerRatings : {},
      teams: {
        senior: raw.teams?.senior && typeof raw.teams.senior === "object" ? raw.teams.senior : null,
        youth: raw.teams?.youth && typeof raw.teams.youth === "object" ? raw.teams.youth : null,
      },
    };
  }

  async function getCache() {
    const cache = normalizeCache(await storageGet(CACHE_KEY));
    const activeClubId = currentClubId();
    if (activeClubId && cache.clubId && cache.clubId !== activeClubId) {
      const fresh = emptyCache();
      fresh.clubId = activeClubId;
      return fresh;
    }
    return cache;
  }

  async function saveCache(cache) {
    cache.schemaVersion = 1;
    cache.updatedAt = Date.now();
    await storageSet(CACHE_KEY, cache);
  }

  function isLoggedInDocument() {
    return Boolean(document.querySelector('a[href="/logout"], a[href$="/logout"]'));
  }

  function clubIdFromSource(source) {
    const text = String(source || "");
    return text.match(/window\.current_club_id\s*=\s*(\d+)/i)?.[1] || "";
  }

  function currentClubId() {
    for (const script of document.querySelectorAll("script")) {
      const id = clubIdFromSource(script.textContent);
      if (id) return id;
    }
    const profileLink = Array.from(document.querySelectorAll('a[href^="/clubs/"]'))
      .find(link => /min klubprofil|my club profile/i.test(normalizeText(link.textContent)));
    return String(profileLink?.getAttribute("href") || "").match(/\/clubs\/(\d+)/i)?.[1] || "";
  }

  function readPendingRefreshes() {
    try {
      const raw = JSON.parse(localStorage.getItem(PENDING_REFRESH_KEY) || "{}");
      return raw && typeof raw === "object" ? raw : {};
    } catch (_) {
      return {};
    }
  }

  function writePendingRefreshes(value) {
    try {
      localStorage.setItem(PENDING_REFRESH_KEY, JSON.stringify(value || {}));
    } catch (_) {}
  }

  function requestTeamRefresh(teamKind, reason = "change", options = {}) {
    if (!TEAM_PATHS[teamKind]) return false;
    if (window.__VIRM_DATA_REQUESTS_V1__?.isDisabledSync?.()) return false;
    const pending = readPendingRefreshes();
    pending[teamKind] = {
      teamKind,
      reason: String(reason || "change"),
      requestedAt: Date.now(),
      clearPlayerRatings: Boolean(options?.clearPlayerRatings),
      clubId: currentClubId(),
    };
    writePendingRefreshes(pending);

    if (!options?.deferUntilNextPage) {
      window.setTimeout(() => {
        processPendingRefreshes().catch(error => console.warn("[VIRM Assistant] Automatisk KV start-11-opdatering fejlede.", error));
      }, Math.max(250, Number(options?.delayMs) || 650));
    }
    return true;
  }

  async function processPendingRefreshes() {
    if (!await dataRequestsAllowed()) return getCache();
    if (!isLoggedInDocument()) return getCache();
    if (localRefreshPromise) {
      try { await localRefreshPromise; } catch (_) {}
    }

    const pending = readPendingRefreshes();
    const activeClubId = currentClubId();
    const entries = Object.values(pending).filter(entry => {
      if (!entry || !TEAM_PATHS[entry.teamKind]) return false;
      return !entry.clubId || !activeClubId || String(entry.clubId) === String(activeClubId);
    });
    if (!entries.length) return getCache();

    const teamKinds = [...new Set(entries.map(entry => entry.teamKind))];
    const clearPlayerRatings = entries.some(entry => entry.clearPlayerRatings);
    const snapshot = Object.fromEntries(entries.map(entry => [entry.teamKind, Number(entry.requestedAt || 0)]));
    const reason = entries.map(entry => entry.reason).filter(Boolean).join("+") || "change";

    const cache = await refreshTeams(teamKinds, `auto:${reason}`, { clearPlayerRatings });

    const latest = readPendingRefreshes();
    for (const teamKind of teamKinds) {
      if (Number(latest?.[teamKind]?.requestedAt || 0) <= Number(snapshot[teamKind] || 0)) delete latest[teamKind];
    }
    writePendingRefreshes(latest);
    return cache;
  }

  async function fetchHtml(path) {
    const response = await fetch(path, {
      credentials: "include",
      cache: "no-store",
      headers: { Accept: "text/html,application/xhtml+xml" },
    });
    if (!response.ok) throw new Error(`${path}: HTTP ${response.status}`);
    const html = await response.text();
    if (!/href=["'][^"']*\/logout["']/i.test(html)) {
      const error = new Error("VMAN-sessionen er ikke logget ind.");
      error.code = "NOT_LOGGED_IN";
      throw error;
    }
    return { html, response };
  }


  async function mapWithConcurrency(items, limit, worker) {
    const list = Array.from(items || []);
    if (!list.length) return [];
    const results = new Array(list.length);
    let nextIndex = 0;
    const count = Math.max(1, Math.min(Number(limit) || 1, list.length));
    const runners = Array.from({ length: count }, async () => {
      while (true) {
        const index = nextIndex++;
        if (index >= list.length) return;
        results[index] = await worker(list[index], index);
      }
    });
    await Promise.all(runners);
    return results;
  }

  function drainProfileQueue() {
    while (activeProfileRequests < PROFILE_CONCURRENCY && profileQueue.length) {
      const job = profileQueue.shift();
      activeProfileRequests += 1;
      Promise.resolve()
        .then(job.task)
        .then(job.resolve, job.reject)
        .finally(() => {
          activeProfileRequests -= 1;
          drainProfileQueue();
        });
    }
  }

  function limitedProfileTask(task) {
    return new Promise((resolve, reject) => {
      profileQueue.push({ task, resolve, reject });
      drainProfileQueue();
    });
  }

  function seedPlayerRatingCache(cache) {
    playerRatingCache.clear();
    activePlayerRatingStore = cache?.playerRatings && typeof cache.playerRatings === "object" ? cache.playerRatings : null;
    if (!activePlayerRatingStore || cache.playerRatingsDate !== todayKey()) return;
    for (const [id, entry] of Object.entries(activePlayerRatingStore)) {
      const rating = Number(entry?.rating ?? entry);
      if (Number.isFinite(rating) && rating >= 0 && rating <= 100) playerRatingCache.set(String(id), rating);
    }
  }

  function rememberPlayerRating(id, rating) {
    const numeric = Number(rating);
    if (!activePlayerRatingStore || !id || !Number.isFinite(numeric)) return;
    activePlayerRatingStore[String(id)] = { rating: numeric, updatedAt: Date.now() };
  }

  function scheduleMatchesFromHtml(teamKind, html) {
    const doc = new DOMParser().parseFromString(html, "text/html");
    const table = doc.querySelector(".coming_matches table")
      || Array.from(doc.querySelectorAll("table")).find(candidate => candidate.querySelector('a[href*="/new_matches/"][href*="/tactics"]'));
    if (!table) return [];
    const matches = [];
    let dayLabel = "";
    for (const row of table.querySelectorAll("tbody tr")) {
      if (row.classList.contains("day_headline")) {
        dayLabel = normalizeText(row.textContent);
        continue;
      }
      const optakt = row.querySelector('a[href*="/new_matches/"][href*="/tactics"]');
      const href = String(optakt?.getAttribute("href") || "");
      const matchId = href.match(/\/new_matches\/(\d+)/i)?.[1];
      if (!matchId) continue;
      const opponentLink = row.querySelector('td.opponent a[href*="/squads/"], td.opponent a[href*="/clubs/"], .opponent a[href*="/squads/"], .opponent a[href*="/clubs/"]');
      const opponent = normalizeText(
        row.querySelector(".opponent .club_name")?.textContent
        || opponentLink?.textContent
        || row.querySelector(".opponent")?.textContent
        || ""
      );
      const opponentHref = String(opponentLink?.getAttribute("href") || "");
      const opponentClubId = opponentHref.match(/\/(?:squads|clubs)\/(\d+)/i)?.[1] || "";
      const vmanKvNode = row.querySelector("td.club_rating > div, .club_rating > div");
      const vmanKv = Number(normalizeText(vmanKvNode?.textContent).replace(",", "."));
      const vmanKvStyle = String(vmanKvNode?.getAttribute("style") || "");
      matches.push({
        teamKind,
        matchId,
        href: new URL(href, window.location.origin).href,
        opponent,
        opponentHref,
        opponentClubId,
        venue: normalizeText(row.querySelector(".venue")?.textContent),
        dayLabel,
        time: normalizeText(row.querySelector(".time")?.textContent),
        type: normalizeText(row.querySelector(".type")?.textContent),
        vmanKv: Number.isFinite(vmanKv) && vmanKv > 0 ? vmanKv : null,
        vmanKvStyle,
      });
    }
    return matches;
  }

  function uniquePlayerLinks(root) {
    const result = [];
    const seen = new Set();
    for (const link of root?.querySelectorAll?.('a[href*="/players/"]') || []) {
      const href = String(link.getAttribute("href") || "");
      const id = href.match(/\/players\/(\d+)/i)?.[1];
      if (!id || seen.has(id)) continue;
      seen.add(id);
      result.push({ id, href: new URL(href, window.location.origin).href, link });
    }
    return result;
  }

  function clubLinkForOpponent(doc, match) {
    const teamLinks = Array.from(doc.querySelectorAll('a[href*="/squads/"], a[href*="/clubs/"]'));
    if (match.opponentClubId) {
      const direct = teamLinks.find(link =>
        String(link.getAttribute("href") || "").match(/\/(?:squads|clubs)\/(\d+)/i)?.[1] === match.opponentClubId
      );
      if (direct) return direct;
    }
    const opponentKey = normalizeKey(match.opponent);
    return opponentKey ? teamLinks.find(link => normalizeKey(link.textContent) === opponentKey) || null : null;
  }

  function lineupFromOpponentContainer(doc, match) {
    const clubLink = clubLinkForOpponent(doc, match);
    if (!clubLink) return null;
    const candidates = [];
    let node = clubLink.parentElement;
    for (let depth = 0; node && node !== doc.body && depth < 14; depth += 1, node = node.parentElement) {
      const players = uniquePlayerLinks(node);
      if (!players.length || players.length > 16) continue;
      const marker = normalizeKey(`${node.id || ""} ${node.className || ""}`);
      let score = 100 - Math.abs(players.length - 11) * 15 - depth;
      if (/lineup|formation|tactic|pitch|field|opstilling|start|team/.test(marker)) score += 25;
      if (players.length === 11) score += 80;
      candidates.push({ players, score });
    }
    candidates.sort((a, b) => b.score - a.score);
    return candidates[0]?.players || null;
  }

  function lineupFromSemanticContainers(doc, match) {
    const opponentKey = normalizeKey(match.opponent);
    const candidates = [];
    for (const node of doc.querySelectorAll('[class*="lineup" i], [class*="formation" i], [class*="tactic" i], [class*="pitch" i], [class*="field" i], [id*="lineup" i], [id*="formation" i], [id*="tactic" i]')) {
      if (opponentKey && !normalizeKey(node.textContent).includes(opponentKey)) continue;
      const players = uniquePlayerLinks(node);
      if (!players.length || players.length > 16) continue;
      let score = 100 - Math.abs(players.length - 11) * 15;
      if (players.length === 11) score += 60;
      candidates.push({ players, score });
    }
    candidates.sort((a, b) => b.score - a.score);
    return candidates[0]?.players || null;
  }

  function lineupFromPageOrder(doc, match, side) {
    const all = uniquePlayerLinks(doc);
    if (all.length < 22) return null;
    const first = all.slice(0, 11);
    const second = all.slice(11, 22);
    const venue = normalizeKey(match.venue);
    const opponentFirst = venue.includes("ude") || venue.includes("away");
    const opponentSecond = venue.includes("hjemme") || venue.includes("home");
    if (side === "opponent") {
      if (opponentFirst) return first;
      if (opponentSecond) return second;
    } else {
      if (opponentFirst) return second;
      if (opponentSecond) return first;
    }
    return null;
  }

  function extractLineups(doc, match) {
    const all = uniquePlayerLinks(doc);
    const candidates = [lineupFromOpponentContainer(doc, match), lineupFromSemanticContainers(doc, match), lineupFromPageOrder(doc, match, "opponent")]
      .filter(candidate => Array.isArray(candidate) && candidate.length > 0 && candidate.length <= 11)
      .sort((left, right) => right.length - left.length);
    const opponent = candidates[0] || null;
    let own = null;
    if (opponent) {
      const opponentIds = new Set(opponent.map(player => player.id));
      const complement = all.filter(player => !opponentIds.has(player.id));
      if (complement.length <= 11) own = complement;
    }
    if (own == null) own = lineupFromPageOrder(doc, match, "own");
    return { opponent, own, allCount: all.length };
  }

  function explicitRatingNearPlayer(player) {
    let node = player?.link || null;
    for (let depth = 0; node && depth < 5; depth += 1, node = node.parentElement) {
      if (depth > 0 && uniquePlayerLinks(node).length > 1) break;
      for (const element of node.querySelectorAll?.('[data-rating], [data-player-rating], .rating, .player_rating, .player-rating') || []) {
        const raw = element.getAttribute("data-rating") || element.getAttribute("data-player-rating") || normalizeText(element.textContent);
        const match = String(raw).match(/^\s*(\d{1,3}(?:[.,]\d+)?)\s*$/);
        const value = match ? Number(match[1].replace(",", ".")) : NaN;
        if (Number.isFinite(value) && value >= 0 && value <= 100) return value;
      }
      const text = normalizeText(node.textContent);
      for (const pattern of [
        /\b(?:VT|Vurdering|Vurderingstal|Rating)\s*[:\-]?\s*(\d{1,3}(?:[.,]\d+)?)/i,
        /(\d{1,3}(?:[.,]\d+)?)\s*(?:VT|Vurdering|Vurderingstal|Rating)\b/i,
      ]) {
        const match = text.match(pattern);
        const value = match ? Number(match[1].replace(",", ".")) : NaN;
        if (Number.isFinite(value) && value >= 0 && value <= 100) return value;
      }
    }
    return null;
  }

  function parseProfileRating(html) {
    const doc = new DOMParser().parseFromString(html, "text/html");
    for (const element of doc.querySelectorAll('[data-rating], [data-player-rating], .rating, .player_rating, .player-rating')) {
      const raw = element.getAttribute("data-rating") || element.getAttribute("data-player-rating") || normalizeText(element.textContent);
      const match = String(raw).match(/^\s*(\d{1,3}(?:[.,]\d+)?)\s*$/);
      const value = match ? Number(match[1].replace(",", ".")) : NaN;
      if (Number.isFinite(value) && value >= 0 && value <= 100) return value;
    }
    const text = normalizeText(doc.body?.textContent || html);
    for (const pattern of [
      /\b(?:VT|Vurdering|Vurderingstal|Rating)\s*[:\-]?\s*(\d{1,3}(?:[.,]\d+)?)/i,
      /(\d{1,3}(?:[.,]\d+)?)\s*(?:VT|Vurdering|Vurderingstal|Rating)\b/i,
    ]) {
      const match = text.match(pattern);
      const value = match ? Number(match[1].replace(",", ".")) : NaN;
      if (Number.isFinite(value) && value >= 0 && value <= 100) return value;
    }
    return null;
  }

  async function playerRating(player) {
    if (playerRatingCache.has(player.id)) return playerRatingCache.get(player.id);
    const direct = explicitRatingNearPlayer(player);
    if (Number.isFinite(direct)) {
      playerRatingCache.set(player.id, direct);
      rememberPlayerRating(player.id, direct);
      return direct;
    }
    const promise = limitedProfileTask(async () => {
      const response = await fetch(player.href, { credentials: "include", cache: "no-store" });
      if (!response.ok) throw new Error(`Spiller ${player.id}: HTTP ${response.status}`);
      const html = await response.text();
      const rating = parseProfileRating(html);
      if (!Number.isFinite(rating)) throw new Error(`Spiller ${player.id}: VT kunne ikke aflæses.`);
      return rating;
    });
    // Gem Promise med det samme, så samme spiller aldrig bliver hentet flere
    // gange, selv om flere kampe analyseres parallelt.
    playerRatingCache.set(player.id, promise);
    try {
      const rating = await promise;
      playerRatingCache.set(player.id, rating);
      rememberPlayerRating(player.id, rating);
      return rating;
    } catch (error) {
      playerRatingCache.delete(player.id);
      throw error;
    }
  }

  async function lineupResult(lineup) {
    if (!Array.isArray(lineup) || lineup.length < 1 || lineup.length > 11) return null;
    // Alle spillere kan anmodes på én gang; den fælles PROFILE_CONCURRENCY-
    // kø sørger for, at VMAN aldrig får mere end et begrænset antal samtidige
    // profilopslag.
    const ratings = await Promise.all(lineup.map(playerRating));
    if (ratings.some(value => !Number.isFinite(value))) return null;
    const total = ratings.reduce((sum, value) => sum + value, 0);
    return { total, average: total / 11, lineupCount: lineup.length };
  }

  async function analyzeMatch(match) {
    const response = await fetch(`/new_matches/${encodeURIComponent(match.matchId)}/tactics`, {
      credentials: "include",
      cache: "no-store",
      headers: { Accept: "text/html,application/xhtml+xml" },
    });
    if (!response.ok) throw new Error(`Optakt: HTTP ${response.status}`);
    const html = await response.text();
    const doc = new DOMParser().parseFromString(html, "text/html");
    const lineups = extractLineups(doc, match);
    if (!lineups.opponent && !lineups.own) throw new Error("Startopstillingerne kunne ikke identificeres.");
    const opponent = lineups.opponent ? await lineupResult(lineups.opponent) : null;
    const own = lineups.own ? await lineupResult(lineups.own) : null;
    return {
      matchId: match.matchId,
      opponent: match.opponent,
      opponentClubId: match.opponentClubId,
      opponentHref: match.opponentHref,
      venue: match.venue,
      dayLabel: match.dayLabel,
      time: match.time,
      vmanKv: match.vmanKv,
      vmanKvStyle: match.vmanKvStyle,
      opponentKv: opponent,
      ownKv: own,
      analyzedAt: Date.now(),
    };
  }

  async function buildTeamCache(teamKind) {
    const sourcePath = TEAM_PATHS[teamKind];
    const { html } = await fetchHtml(sourcePath);
    const clubId = clubIdFromSource(html);
    const matches = scheduleMatchesFromHtml(teamKind, html);
    const results = {};
    let failed = 0;
    const analyzed = await mapWithConcurrency(matches, TACTICS_CONCURRENCY, async match => {
      try {
        return await analyzeMatch(match);
      } catch (error) {
        failed += 1;
        return {
          matchId: match.matchId,
          opponent: match.opponent,
          opponentClubId: match.opponentClubId,
          opponentHref: match.opponentHref,
          venue: match.venue,
          dayLabel: match.dayLabel,
          time: match.time,
          vmanKv: match.vmanKv,
          vmanKvStyle: match.vmanKvStyle,
          opponentKv: null,
          ownKv: null,
          error: String(error?.message || error),
          analyzedAt: Date.now(),
        };
      }
    });
    for (const item of analyzed) if (item?.matchId) results[item.matchId] = item;

    const ownValues = Object.values(results).map(item => item.ownKv).filter(Boolean);
    const ownTotal = ownValues.reduce((sum, item) => sum + Number(item.total || 0), 0);
    const seasonAverage = matches.length && ownValues.length === matches.length ? ownTotal / (matches.length * 11) : null;
    const ratingPalette = matches
      .filter(match => Number.isFinite(Number(match.vmanKv)) && match.vmanKvStyle)
      .map(match => ({ value: Number(match.vmanKv), style: match.vmanKvStyle }));
    return {
      teamKind,
      sourcePath,
      clubId,
      ratingPalette,
      updatedDate: todayKey(),
      updatedAt: Date.now(),
      matchCount: matches.length,
      succeeded: matches.length - failed,
      failed,
      seasonAverage,
      seasonTotal: seasonAverage == null ? null : ownTotal,
      matches: results,
    };
  }

  async function acquireLock(teamKinds, reason) {
    const now = Date.now();
    const current = await storageGet(LOCK_KEY);
    if (current && now - Number(current.startedAt || 0) < LOCK_TTL_MS) return null;
    const token = `${now}-${Math.random().toString(36).slice(2)}`;
    const lock = { token, startedAt: now, date: todayKey(), teamKinds: teamKinds.slice(), reason };
    await storageSet(LOCK_KEY, lock);
    await new Promise(resolve => setTimeout(resolve, 40));
    const verify = await storageGet(LOCK_KEY);
    return verify?.token === token ? lock : null;
  }

  async function releaseLock(lock) {
    const current = await storageGet(LOCK_KEY);
    if (current?.token === lock?.token) await chrome.storage.local.remove(LOCK_KEY);
  }

  async function refreshTeams(teamKinds, reason = "manual", options = {}) {
    if (!await dataRequestsAllowed()) return getCache();
    const uniqueKinds = [...new Set(teamKinds)].filter(kind => TEAM_PATHS[kind]);
    if (!uniqueKinds.length) return getCache();
    if (localRefreshPromise) return localRefreshPromise;

    localRefreshPromise = (async () => {
      let lock = await acquireLock(uniqueKinds, reason);
      if (!lock) {
        const started = Date.now();
        while (Date.now() - started < LOCK_TTL_MS + 1500) {
          await new Promise(resolve => setTimeout(resolve, 500));
          const currentLock = await storageGet(LOCK_KEY);
          if (!currentLock || Date.now() - Number(currentLock.startedAt || 0) >= LOCK_TTL_MS) break;
        }
        lock = await acquireLock(uniqueKinds, reason);
        if (!lock) return getCache();
      }

      try {
        let cache = await getCache();
        const activeClubId = currentClubId();
        if (activeClubId && cache.clubId && cache.clubId !== activeClubId) cache = emptyCache();
        if (activeClubId) cache.clubId = activeClubId;
        if (cache.playerRatingsDate !== todayKey() || options?.clearPlayerRatings) {
          cache.playerRatingsDate = todayKey();
          cache.playerRatings = {};
        }
        seedPlayerRatingCache(cache);
        cache.refreshing = { teamKinds: uniqueKinds, reason, startedAt: Date.now() };
        if (reason === "daily") cache.dailyAttemptDate = todayKey();
        await saveCache(cache);

        for (let teamIndex = 0; teamIndex < uniqueKinds.length; teamIndex += 1) {
          const teamKind = uniqueKinds[teamIndex];
          try {
            cache.teams[teamKind] = await buildTeamCache(teamKind);
            if (cache.teams[teamKind]?.clubId) cache.clubId = String(cache.teams[teamKind].clubId);
          } catch (error) {
            cache.teams[teamKind] = {
              teamKind,
              sourcePath: TEAM_PATHS[teamKind],
              updatedDate: todayKey(),
              updatedAt: Date.now(),
              matchCount: 0,
              succeeded: 0,
              failed: 1,
              seasonAverage: null,
              seasonTotal: null,
              matches: {},
              error: String(error?.message || error),
            };
          }
          if (cache.refreshing) cache.refreshing.teamKinds = uniqueKinds.slice(teamIndex + 1);
          await saveCache(cache);
        }
        cache.refreshing = null;
        if (reason === "daily") cache.dailyCompletedDate = todayKey();
        await saveCache(cache);
        return cache;
      } finally {
        activePlayerRatingStore = null;
