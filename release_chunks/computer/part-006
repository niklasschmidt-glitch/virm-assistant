  function bindNumberWheel(input, { minimum, maximum, step, decimals = 0, commit = false }) {
    input.addEventListener("wheel", (event) => {
      if (input.disabled) return;
      event.preventDefault();
      const current = Number(input.value) || minimum;
      const direction = event.deltaY < 0 ? 1 : -1;
      const next = clamp(current + direction * step, minimum, maximum);
      input.value = decimals > 0 ? next.toFixed(decimals) : String(Math.round(next));
      input.dispatchEvent(new Event("input", { bubbles: true }));
      if (commit) {
        input.dispatchEvent(new Event("change", { bubbles: true }));
      }
    }, { passive: false });
  }

