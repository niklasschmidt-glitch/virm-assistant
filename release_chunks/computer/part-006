    blockDays = Math.max(sessionDays, Math.round(blockDays / sessionDays) * sessionDays);
    blockDays = Math.min(maximumBlock, blockDays);
    const periodDays = clamp(Math.round(Number(source.intensityBoostPeriodDays) || defaults.intensityBoostPeriodDays), 1, 365);
    const boostDays = Array.from(new Set((Array.isArray(source.intensityBoostDays) ? source.intensityBoostDays : defaults.intensityBoostDays)
      .map((value) => Math.round(Number(value)))
      .filter((value) => value >= 1 && value <= periodDays)))
      .sort((left, right) => left - right);
    let searchMethod = ASSISTANT_SEARCH_METHODS.includes(source.searchMethod) ? source.searchMethod : defaults.searchMethod;
    let lastNonRearrangeMethod = ASSISTANT_SEARCH_METHODS.includes(source.lastNonRearrangeMethod) && source.lastNonRearrangeMethod !== "Omrokering"
      ? source.lastNonRearrangeMethod
      : defaults.lastNonRearrangeMethod;
    const searchTime = Object.hasOwn(ASSISTANT_SEARCH_TIMES, source.searchTime) ? source.searchTime : defaults.searchTime;
    const promoteStamina = Boolean(source.promoteStamina);
    const weights = normalizedAssistantWeights(position, source.weights);
    const usesWeightedRating = assistantHasCustomWeights({ promoteStamina, weights }, position);
    let resultSortKey = ASSISTANT_RESULT_SORT_KEYS.includes(source.resultSortKey) ? source.resultSortKey : defaults.resultSortKey;
    let resultSortDirection = source.resultSortDirection === "asc" ? "asc" : "desc";
    if (usesWeightedRating && resultSortKey === "rating") {
      resultSortKey = "weightedRating";
      resultSortDirection = "desc";
    } else if (!usesWeightedRating && resultSortKey === "weightedRating") {
      resultSortKey = "rating";
      resultSortDirection = "desc";
    }
    const results = Array.isArray(source.results)
      ? source.results.map((result) => normalizeAssistantResult(result, position)).filter(Boolean).slice(0, 100)
      : [];
    sortAssistantResults(results, usesWeightedRating);
    if (searchMethod === "Omrokering" && !source.lastNonRearrangeMethod && results.length) {
      const selected = results.find((result) => result.id === source.selectedResultId) || results[0];
      const methodLabel = normalizeText(selected && selected.method);
      const inferred = ASSISTANT_SEARCH_METHODS
        .filter((candidate) => candidate !== "Omrokering")
        .find((candidate) => methodLabel.startsWith(normalizeText(candidate)));
      if (inferred) lastNonRearrangeMethod = inferred;
    }
    if (!results.length && searchMethod === "Omrokering") searchMethod = defaults.searchMethod;
    const startAge = scenario
      ? Number(scenario.ageYears || 15) + Number(scenario.ageDays || 0) / 30
      : 15;
    return {
      view: source.view === "simulation" ? "simulation" : "constraints",
      trainingPeriodYears: clamp(Math.round(Number(source.trainingPeriodYears) || defaults.trainingPeriodYears), 1, 25),
      changeEveryDays: sessionDays,
      rollEnabled: Boolean(source.rollEnabled),
      rollBlockDays: blockDays,
      allowIntensityBoost: Boolean(source.allowIntensityBoost),
      intensityBoostPeriodDays: periodDays,
      intensityBoostDays: boostDays,
      splitTrainingPasses: Boolean(source.splitTrainingPasses),
      trainingMatchPreludeEnabled: Boolean(source.trainingMatchPreludeEnabled),
      trainingMatchUntilAge: clamp(Number(source.trainingMatchUntilAge) || defaults.trainingMatchUntilAge, startAge, startAge + 25),
      penaltyTolerance: Object.hasOwn(PENALTY_TOLERANCE_LIMITS, source.penaltyTolerance) ? source.penaltyTolerance : defaults.penaltyTolerance,
      groupHighWeightedStats: source.groupHighWeightedStats !== false,
      promoteStamina,
      promoteStaminaLevel: Object.hasOwn(STAMINA_PROMOTION_PP, source.promoteStaminaLevel) ? source.promoteStaminaLevel : defaults.promoteStaminaLevel,
      weights,
      searchMethod,
      lastNonRearrangeMethod,
      searchTime,
      resultSortKey,
      resultSortDirection,
      results,
      selectedResultId: results.some((result) => result.id === source.selectedResultId) ? source.selectedResultId : (results[0] && results[0].id) || null,
    };
  }

  function createProgram(group, ordinal) {
    return {
      id: uid("program"),
      name: `${group.name} ${ordinal}`,
      position: group.position,
      startDate: todayISO(),
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      settings: {
        experienceBonus: false,
        experienceRatio: 1.10,
        gradient: "linear",
      },
      scenario: null,
      assistant: createAssistantState(group.position),
      sessions: [],
    };
  }

  function applyPresetData(program, presetName) {
    const preset = builtinPresets[presetName];
    if (!preset) return false;
    const position = POSITION_STATS[preset.position] ? preset.position : program.position;
    const bonus = preset.experience_bonus || {};
    program.name = presetName;
    program.position = position;
    program.settings = {
      experienceBonus: Boolean(bonus.enabled),
      experienceRatio: clamp(Number(bonus.ratio) || 1.10, 1.01, 1.15),
      gradient: ["linear", "early", "late"].includes(bonus.knee) ? bonus.knee : "linear",
    };
    program.scenario = null;
    program.assistant = createAssistantState(position);
    program.sessions = (preset.program || [])
      .map((item) => normalizeProgramItem(item, position))
      .filter(Boolean);
    return true;
  }

  function loadBuiltinPreset(presetName) {
    if (!builtinPresets[presetName]) {
      showToast(`${presetName} kunne ikke indlæses.`);
      renderToolbar();
      return;
    }
    commitChange(`Skabelon ${presetName}`, () => {
      applyPresetData(activeProgram(), presetName);
      selectedIds.clear();
      editorState = { type: "phase-new" };
      currentDistribution = {};
      resetDistributionPriorities();
      editorDraft = null;
    }, { keepEditor: true });
    showToast(`${presetName} blev indlæst.`);
  }

  function ensureGroupState(groupId) {
    const definition = groupDefinition(groupId);
    let groupState = state.groups[groupId];
    if (!groupState || !Array.isArray(groupState.programIds)) {
      groupState = {
        id: groupId,
        name: definition.name,
        position: definition.position,
        activeProgramId: null,
        programIds: [],
      };
      state.groups[groupId] = groupState;
    }

    groupState.programIds = groupState.programIds.filter((programId) => Boolean(state.programs[programId]));
    if (!groupState.activeProgramId || !state.programs[groupState.activeProgramId]) {
      groupState.activeProgramId = groupState.programIds[0] || null;
    }

    if (!groupState.activeProgramId) {
      const program = createProgram(definition, 1);
      state.programs[program.id] = program;
      groupState.programIds.push(program.id);
      groupState.activeProgramId = program.id;
    }
    return groupState;
  }

  function activeGroupState() {
    return ensureGroupState(state.activeGroupId || "goalkeepers");
  }

  function activeProgram() {
    const groupState = activeGroupState();
    return state.programs[groupState.activeProgramId];
  }

  function normalizeProfileRecord(raw, fallbackOrdinal = 1) {
    const rawSquadId = Number(raw && raw.squadId);
    const profile = {
      id: normalizeText(raw && raw.id) || uid("profile"),
      name: normalizeText(raw && raw.name) || `Profil#${fallbackOrdinal}`,
      ordinal: Math.max(1, Math.round(Number(raw && raw.ordinal) || fallbackOrdinal)),
      squadId: Number.isInteger(rawSquadId) && rawSquadId > 0 ? rawSquadId : null,
      activeGroupId: GROUP_DEFINITIONS.some((group) => group.id === (raw && raw.activeGroupId))
        || Boolean(raw && raw.groups && raw.groups[raw.activeGroupId])
        ? raw.activeGroupId
        : "goalkeepers",
      groups: raw && raw.groups && typeof raw.groups === "object" ? raw.groups : {},
      programs: raw && raw.programs && typeof raw.programs === "object" ? raw.programs : {},
    };

    for (const program of Object.values(profile.programs)) {
      if (!program || typeof program !== "object") {
        continue;
      }
      program.id = program.id || uid("program");
      program.position = POSITION_STATS[program.position] ? program.position : "Forsvar";
      program.name = normalizeText(program.name) || "Træningsprogram";
      program.startDate = dateOrdinal(program.startDate) === null ? todayISO() : program.startDate;
      program.sessions = Array.isArray(program.sessions)
        ? program.sessions.map((item) => normalizeProgramItem(item, program.position)).filter(Boolean)
        : [];
      program.settings = {
        experienceBonus: Boolean(program.settings && program.settings.experienceBonus),
        experienceRatio: clamp(Number(program.settings && program.settings.experienceRatio) || 1.10, 1.01, 1.15),
        gradient: ["linear", "early", "late"].includes(program.settings && program.settings.gradient)
          ? program.settings.gradient
          : "linear",
      };
      program.scenario = normalizeScenario(program.scenario, program.position);
      program.assistant = normalizeAssistantState(program.assistant, program.position, program.scenario);
    }
    return profile;
  }

  function normalizeLoadedState(raw) {
    if (!raw || typeof raw !== "object") return createEmptyState();
    if (raw.profiles && typeof raw.profiles === "object" && Object.keys(raw.profiles).length) {
      const profiles = {};
      let fallbackOrdinal = 1;
      for (const source of Object.values(raw.profiles)) {
        const profile = normalizeProfileRecord(source, fallbackOrdinal);
        profiles[profile.id] = profile;
        fallbackOrdinal += 1;
      }
      return stateFromProfiles(profiles, raw.activeProfileId);
    }

    // Version 1 havde grupper og programmer direkte i roden. De flyttes
    // tabsfrit ind i standardprofilen ved første indlæsning.
    const migrated = normalizeProfileRecord({
      id: uid("profile"),
      name: "Profil#1",
      ordinal: 1,
      activeGroupId: raw.activeGroupId,
      groups: raw.groups,
      programs: raw.programs,
    }, 1);
    return stateFromProfiles({ [migrated.id]: migrated }, migrated.id);
  }

  function normalizeScenario(raw, fallbackPosition) {
    if (!raw || typeof raw !== "object") return null;
    const position = POSITION_STATS[raw.position] ? raw.position : fallbackPosition;
    const stats = {};
    for (const stat of POSITION_STATS[position] || []) {
      stats[stat] = clamp(Math.round(Number(raw.stats && raw.stats[stat]) || 0), 0, 100);
    }
    return {
      source: raw.source === "manual" ? "manual" : "group",
      position,
      ageYears: clamp(Math.round(Number(raw.ageYears) || 15), 15, 40),
      ageDays: clamp(Math.round(Number(raw.ageDays) || 0), 0, 29),
      xp: clamp(Math.round(Number(raw.xp) || 180), 0, 999),
      referenceIntensity: Object.hasOwn(INTENSITIES, raw.referenceIntensity) ? raw.referenceIntensity : "Hård",
      includedPlayerIds: Array.isArray(raw.includedPlayerIds)
        ? Array.from(new Set(raw.includedPlayerIds.map((value) => String(value || "")).filter(Boolean)))
        : null,
      stats,
    };
  }

  function normalizePhase(raw, position) {
    if (!raw || typeof raw !== "object") {
      return null;
    }
    const definition = exerciseDefinitionForPhase(raw, position);
    const exercise = definition.name;
    const trainingPoints = clamp(
      Number(raw.trainingPoints || raw.training_points || INTENSITIES[raw.intensity] || 23),
      20,
      24,
    );
    const phase = {
      id: raw.id || uid("phase"),
      type: "phase",
      days: Math.max(1, Math.round(Number(raw.days) || 1)),
      exercise,
      exerciseTypeCode: definition.code,
      trainingPoints,
      distribution: null,
    };
    if (definition.code !== 0) {
      phase.distribution = balancedDistribution(
        definition.stats,
        trainingPoints,
        raw.distribution && typeof raw.distribution === "object" ? raw.distribution : null,
      );
    }
    return phase;
  }

  function normalizeProgramItem(raw, positionOverride) {
    if (!raw || typeof raw !== "object") {
      return null;
    }
    const position = POSITION_STATS[positionOverride]
      ? positionOverride
      : (POSITION_STATS[raw.position] ? raw.position : "Forsvar");
    if (raw.type === "block" || Array.isArray(raw.phases)) {
      const phases = (raw.phases || []).map((phase) => normalizePhase(phase, position)).filter(Boolean);
      if (!phases.length) {
        return null;
      }
      return {
        id: raw.id || uid("block"),
        type: "block",
        name: normalizeText(raw.name) || "Blok",
        repetitions: Math.max(1, Math.round(Number(raw.repetitions) || 1)),
        phases,
      };
    }
    return normalizePhase(raw, position);
  }

  function balancedDistribution(stats, target, preferred) {
    const safeStats = Array.from(stats || []);
    if (!safeStats.length) return {};
    if (preferred && safeStats.every((stat) => Number.isFinite(Number(preferred[stat])))) {
      const preserved = Object.fromEntries(safeStats.map((stat) => [stat, clamp(Math.round(Number(preferred[stat])), 2, 10)]));
      const total = Object.values(preserved).reduce((sum, value) => sum + value, 0);
      if (total === target) return preserved;
    }
    const result = Object.fromEntries(safeStats.map((stat) => [stat, 2]));
    distributeRemainingPoints(result, safeStats, target);
    return result;
  }

  function distributeRemainingPoints(distribution, adjustableStats, remainingPoints) {
    if (!adjustableStats.length) return remainingPoints === 0;
    for (const stat of adjustableStats) distribution[stat] = 2;
    let remainingExtra = remainingPoints - (2 * adjustableStats.length);
    if (remainingExtra < 0) return false;
    while (remainingExtra > 0) {
      let changed = false;
      for (const stat of adjustableStats) {
        if (remainingExtra <= 0) break;
        if (distribution[stat] < 10) {
          distribution[stat] += 1;
          remainingExtra -= 1;
          changed = true;
        }
      }
      if (!changed) break;
    }
    return remainingExtra === 0;
  }

  function resetDistributionPriorities() {
    distributionEditOrder = [];
    distributionRequestedValues = {};
  }

  function addDistributionPoints(distribution, stats, points) {
    let remaining = points;
    while (remaining > 0) {
      let changed = false;
      for (const stat of stats) {
        if (remaining <= 0) break;
        if (distribution[stat] < 10) {
          distribution[stat] += 1;
          remaining -= 1;
          changed = true;
        }
      }
      if (!changed) break;
    }
    return remaining;
  }

  function smartAutofillDistribution(target) {
    const stats = Object.keys(currentDistribution);
    if (!stats.length) return;
    const validOrder = distributionEditOrder.filter((stat) => stats.includes(stat));
    distributionEditOrder = validOrder;
    const editedStats = new Set(validOrder);
    const newestFirst = [...validOrder].reverse();
    const uneditedStats = stats.filter((stat) => !editedStats.has(stat));
    const next = Object.fromEntries(stats.map((stat) => [stat, 2]));
    let remaining = target - (2 * stats.length);

    // Senest redigerede egenskab får først sit ønskede antal point.
    for (const stat of newestFirst) {
      const requested = clamp(Math.round(Number(distributionRequestedValues[stat]) || 2), 2, 10);
      const wantedExtra = requested - 2;
      const grantedExtra = Math.min(remaining, wantedExtra);
      next[stat] += grantedExtra;
      remaining -= grantedExtra;
    }

    // Ikke-redigerede egenskaber deler resten ligeligt i visningsrækkefølgen.
    remaining = addDistributionPoints(next, uneditedStats, remaining);

    // Hvis alle lavere prioriteter er fyldt, optager de ældste redigerede valg
    // eventuelle tvungne overskud før de nyere valg.
    remaining = addDistributionPoints(next, validOrder, remaining);

    currentDistribution = next;
  }

  function setManualDistributionValue(stat, requestedValue, target) {
    const stats = Object.keys(currentDistribution);
    if (!stats.includes(stat)) return false;
    const value = clamp(Math.round(requestedValue), 2, 10);
    const wasLatest = distributionEditOrder[distributionEditOrder.length - 1] === stat;
    if (wasLatest && distributionRequestedValues[stat] === value && currentDistribution[stat] === value) return false;
    distributionRequestedValues[stat] = value;
    distributionEditOrder = distributionEditOrder.filter((candidate) => candidate !== stat);
    distributionEditOrder.push(stat);
    smartAutofillDistribution(target);
    return true;
  }

  function distributionValueFromPointer(bar, event) {
    const rect = bar.getBoundingClientRect();
    if (!rect.width || !Number.isFinite(event.clientX)) return null;
    const relativeX = clamp(event.clientX - rect.left, 0, Math.max(0, rect.width - 0.001));
    return clamp(Math.floor(relativeX / (rect.width / 10)) + 1, 1, 10);
  }

  function ensureProfileForCurrentSquad() {
    const context = vmanTrainingContext();
    if (!context) return;
    const squadId = Number(context.squadId);
    if (!Number.isInteger(squadId) || squadId <= 0) return;

    let profile = Object.values(state.profiles || {}).find((candidate) => Number(candidate && candidate.squadId) === squadId);
    if (!profile) {
      const current = activeProfile();
      if (current && !current.squadId) {
        profile = current;
      } else {
        profile = Object.values(state.profiles || {}).find((candidate) => candidate && !candidate.squadId);
      }
    }
    if (!profile) {
      const ordinal = Math.max(0, ...Object.values(state.profiles || {}).map((candidate) => Number(candidate && candidate.ordinal) || 0)) + 1;
      profile = createProfileRecord(ordinal, null, squadId);
      state.profiles[profile.id] = profile;
    } else {
      profile.squadId = squadId;
    }
    state.activeProfileId = profile.id;
  }

  function localStorageStateCandidate() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
    } catch (_error) {
      return null;
    }
  }

  function newestStoredState(primary, fallback) {
    if (!primary || typeof primary !== "object") return fallback;
    if (!fallback || typeof fallback !== "object") return primary;
    const primarySavedAt = Number(primary.__virmSavedAt) || 0;
    const fallbackSavedAt = Number(fallback.__virmSavedAt) || 0;
    return fallbackSavedAt > primarySavedAt ? fallback : primary;
  }

  async function latestStoredStateCandidate() {
    let primary = null;
    try {
      const stored = await chrome.storage.local.get(STORAGE_KEY);
      primary = stored[STORAGE_KEY] || null;
    } catch (_error) {
      primary = null;
    }
    return newestStoredState(primary, localStorageStateCandidate());
  }

  function storedProfileForLocalProfile(storedState, localProfile) {
    if (!storedState || !localProfile) return null;
    if (storedState.profiles && storedState.profiles[localProfile.id]) {
      return storedState.profiles[localProfile.id];
    }
    const squadId = Number(localProfile.squadId);
    if (!Number.isInteger(squadId) || squadId <= 0) return null;
    return Object.values(storedState.profiles || {}).find((profile) => Number(profile && profile.squadId) === squadId) || null;
  }

  function savedTimestampMs(value) {
    if (typeof value === "number" && Number.isFinite(value)) return value;
    const parsed = Date.parse(value || "");
    return Number.isFinite(parsed) ? parsed : 0;
  }

  function programUpdatedAtMs(program) {
    return savedTimestampMs(program && program.updatedAt);
  }

  function groupUpdatedAtMs(profile, groupId) {
    const group = profile && profile.groups && profile.groups[groupId];
    if (!group) return 0;
    let newest = savedTimestampMs(group.updatedAt);
    for (const programId of Array.isArray(group.programIds) ? group.programIds : []) {
      newest = Math.max(newest, programUpdatedAtMs(profile.programs && profile.programs[programId]));
    }
    return newest;
  }

  function touchActiveGroupForSave() {
    const group = activeGroupState();
    const now = new Date().toISOString();
    group.updatedAt = now;
    const program = state.programs[group.activeProgramId];
    if (program) program.updatedAt = now;
  }

  function profileByIdentity(profiles, localProfile) {
    if (!localProfile || !profiles) return null;
    if (profiles[localProfile.id]) return profiles[localProfile.id];
    const squadId = Number(localProfile.squadId);
    if (!Number.isInteger(squadId) || squadId <= 0) return null;
    return Object.values(profiles).find((profile) => Number(profile && profile.squadId) === squadId) || null;
  }

  function mergeProfileForConcurrentSave(storedProfile, localProfile) {
    if (!storedProfile) return deepClone(localProfile);
    if (!localProfile) return deepClone(storedProfile);

    const merged = deepClone(storedProfile);
    merged.groups = merged.groups && typeof merged.groups === "object" ? merged.groups : {};
    merged.programs = merged.programs && typeof merged.programs === "object" ? merged.programs : {};

    // Profilmetadata er ikke programdata. Bevar den lokale profilidentitet/navngivning,
    // men afgør hver træningsgruppe separat, så en gammel fane ikke kan overskrive
    // nyere programmer fra andre grupper.
    merged.name = localProfile.name || merged.name;
    merged.ordinal = localProfile.ordinal || merged.ordinal;
    if (Number(localProfile.squadId) > 0) merged.squadId = Number(localProfile.squadId);
    merged.activeGroupId = localProfile.activeGroupId || merged.activeGroupId;

    const groupIds = new Set([
      ...Object.keys(storedProfile.groups || {}),
      ...Object.keys(localProfile.groups || {}),
    ]);

    for (const groupId of groupIds) {
      const storedGroup = storedProfile.groups && storedProfile.groups[groupId];
      const localGroup = localProfile.groups && localProfile.groups[groupId];
      if (!localGroup) continue;
      if (!storedGroup) {
        merged.groups[groupId] = deepClone(localGroup);
        for (const programId of localGroup.programIds || []) {
          const program = localProfile.programs && localProfile.programs[programId];
          if (program) merged.programs[programId] = deepClone(program);
        }
        continue;
      }

      const storedRevision = groupUpdatedAtMs(storedProfile, groupId);
      const localRevision = groupUpdatedAtMs(localProfile, groupId);
      const localWinsGroup = localRevision > storedRevision;
      const selectedGroup = localWinsGroup ? localGroup : storedGroup;
      merged.groups[groupId] = deepClone(selectedGroup);

      // Programlisten fra den nyeste gruppe er autoritativ (så sletninger ikke
      // genopstår), men hvert program vælges stadig efter sin egen updatedAt.
      for (const programId of selectedGroup.programIds || []) {
        const storedProgram = storedProfile.programs && storedProfile.programs[programId];
        const localProgram = localProfile.programs && localProfile.programs[programId];
        let selectedProgram = storedProgram || localProgram;
        if (localProgram && (!storedProgram || programUpdatedAtMs(localProgram) > programUpdatedAtMs(storedProgram))) {
          selectedProgram = localProgram;
        }
        if (selectedProgram) merged.programs[programId] = deepClone(selectedProgram);
      }
    }

    const referencedProgramIds = new Set();
    for (const group of Object.values(merged.groups || {})) {
      for (const programId of Array.isArray(group && group.programIds) ? group.programIds : []) referencedProgramIds.add(programId);
    }
    for (const programId of Object.keys(merged.programs || {})) {
      if (!referencedProgramIds.has(programId)) delete merged.programs[programId];
    }
    return merged;
  }

  function mergeConcurrentTrainingState(storedRaw, localRaw) {
    if (!storedRaw || typeof storedRaw !== "object") return deepClone(localRaw);
    if (!localRaw || typeof localRaw !== "object") return deepClone(storedRaw);

    const storedState = normalizeLoadedState(storedRaw);
    const localState = normalizeLoadedState(localRaw);
    const mergedProfiles = deepClone(storedState.profiles || {});

    for (const localProfile of Object.values(localState.profiles || {})) {
      const storedProfile = profileByIdentity(mergedProfiles, localProfile);
      if (!storedProfile) {
        mergedProfiles[localProfile.id] = deepClone(localProfile);
        continue;
      }
      const mergedProfile = mergeProfileForConcurrentSave(storedProfile, localProfile);
      mergedProfile.id = storedProfile.id || localProfile.id;
      mergedProfiles[mergedProfile.id] = mergedProfile;
    }

    return {
      version: STATE_VERSION,
      activeProfileId: localState.activeProfileId || storedState.activeProfileId,
      profiles: mergedProfiles,
    };
  }

  async function withTrainingStorageLock(callback) {
    if (navigator.locks && typeof navigator.locks.request === "function") {
      return navigator.locks.request(STORAGE_LOCK_NAME, { mode: "exclusive" }, callback);
    }
    return callback();
  }

  async function refreshGroupFromSharedStorage(groupId) {
    const storedRaw = await latestStoredStateCandidate();
    if (!storedRaw || typeof storedRaw !== "object") return false;

    const storedState = normalizeLoadedState(storedRaw);
    const localProfile = activeProfile();
    const storedProfile = storedProfileForLocalProfile(storedState, localProfile);
    const storedGroup = storedProfile && storedProfile.groups && storedProfile.groups[groupId];
    if (!storedGroup || !Array.isArray(storedGroup.programIds)) return false;

    const localGroup = state.groups[groupId];
    const localProgramIds = Array.isArray(localGroup && localGroup.programIds) ? localGroup.programIds : [];
    const storedProgramIds = storedGroup.programIds.filter((programId) => Boolean(storedProfile.programs && storedProfile.programs[programId]));

    for (const programId of storedProgramIds) {
      const incomingProgram = storedProfile.programs[programId];
      const localProgram = state.programs[programId];
      if (!localProgram || programUpdatedAtMs(incomingProgram) > programUpdatedAtMs(localProgram)) {
        state.programs[programId] = deepClone(incomingProgram);
      }
    }

    const mergedProgramIds = Array.from(new Set([...storedProgramIds, ...localProgramIds]))
      .filter((programId) => Boolean(state.programs[programId]));
    let activeProgramId = localGroup && localGroup.activeProgramId;
    const storedActiveProgramId = storedGroup.activeProgramId;
    if (!activeProgramId || !state.programs[activeProgramId]) {
      activeProgramId = storedActiveProgramId || mergedProgramIds[0] || null;
    } else if (storedActiveProgramId && storedActiveProgramId !== activeProgramId && state.programs[storedActiveProgramId]) {
      const storedActiveUpdatedAt = programUpdatedAtMs(storedProfile.programs[storedActiveProgramId]);
      const localActiveUpdatedAt = programUpdatedAtMs(state.programs[activeProgramId]);
      if (storedActiveUpdatedAt > localActiveUpdatedAt) activeProgramId = storedActiveProgramId;
    }

    state.groups[groupId] = {
      ...(localGroup || {}),
      ...deepClone(storedGroup),
      programIds: mergedProgramIds,
      activeProgramId,
    };
    ensureGroupState(groupId);
    return true;
  }

  async function loadState() {
    let primary = null;
    try {
      const stored = await chrome.storage.local.get(STORAGE_KEY);
      primary = stored[STORAGE_KEY] || null;
    } catch (error) {
      console.warn("VIRM Assistant kunne ikke indlæse Chrome-lageret", error);
    }
    const fallback = localStorageStateCandidate();
    state = normalizeLoadedState(newestStoredState(primary, fallback));
    ensureProfileForCurrentSquad();
    for (const group of GROUP_DEFINITIONS) {
      ensureGroupState(group.id);
    }
    stateLoaded = true;
    scheduleSave({ touchActiveGroup: false });
  }

  function storageStateSnapshot() {
    const value = deepClone(state);
    value.__virmSavedAt = Date.now();
    // Assistentens op til 100 komplette søgeresultater kan fylde flere MB og har
    // deres egen “Gem søgning”-funktion. De skal ikke følge den almindelige
    // program-state, da de ellers kan overskride browserens lagergrænse og
    // forhindre et importeret træningsprogram i at blive gemt.
    for (const profile of Object.values(value.profiles || {})) {
      for (const program of Object.values(profile?.programs || {})) {
        if (!program?.assistant || typeof program.assistant !== "object") continue;
        program.assistant.results = [];
        program.assistant.selectedResultId = null;
      }
    }
    return value;
  }

  async function saveStateNow() {
    if (!stateLoaded) return false;
    window.clearTimeout(saveTimer);
    saveTimer = null;
    const localValue = storageStateSnapshot();

    return withTrainingStorageLock(async () => {
      const latestRaw = await latestStoredStateCandidate();
      const merged = mergeConcurrentTrainingState(latestRaw, localValue);
      const value = deepClone(merged);
      value.__virmSavedAt = Date.now();
      for (const profile of Object.values(value.profiles || {})) {
        for (const program of Object.values(profile?.programs || {})) {
          if (!program?.assistant || typeof program.assistant !== "object") continue;
          program.assistant.results = [];
          program.assistant.selectedResultId = null;
        }
      }

      let mirrored = false;
      try {
        // Spejlet i VMAN-originens localStorage er synkront og deles mellem faner.
        // Under Web Lock fungerer det som den fælles, serielle reference mellem
        // fanerne, så to samtidige gemninger ikke kan vinde over hinanden.
        localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
        mirrored = true;
      } catch (_fallbackError) {
        mirrored = false;
      }
      try {
        await chrome.storage.local.set({ [STORAGE_KEY]: value });
        return true;
      } catch (error) {
        console.warn("VIRM Assistant kunne ikke gemme i Chrome-lageret", error);
        return mirrored;
      }
    });
  }

  function scheduleSave(options = {}) {
    if (!stateLoaded) {
      return;
    }
    if (options.touchActiveGroup !== false) touchActiveGroupForSave();
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      saveTimer = null;
      void saveStateNow();
    }, 120);
  }

  function commitChange(_label, mutator, options = {}) {
    historyStack.push(deepClone(state));
    if (historyStack.length > HISTORY_LIMIT) {
      historyStack.shift();
    }
    redoStack = [];
    mutator();
    const now = new Date().toISOString();
    const program = activeProgram();
    if (program) program.updatedAt = now;
    const group = activeGroupState();
    if (group) group.updatedAt = now;
    liveStatuses.delete(state.activeGroupId);
    window.clearTimeout(transferButtonResetTimer);
    if (refs.transferButton) refs.transferButton.textContent = "Overfør til VMAN";
    scheduleSave({ touchActiveGroup: false });
    if (!options.keepEditor) editorState = { type: "phase-new" };
    if (!options.keepEditor) editorDraft = null;
    renderAll();
  }

  function undo() {
    if (!historyStack.length) {
      return;
    }
    redoStack.push(deepClone(state));
    state = attachActiveProfileAccessors(historyStack.pop());
    selectedIds.clear();
    editorState = { type: "phase-new" };
    editorDraft = null;
    liveStatuses.delete(state.activeGroupId);
    window.clearTimeout(transferButtonResetTimer);
    if (refs.transferButton) refs.transferButton.textContent = "Overfør til VMAN";
    scheduleSave();
    renderAll();
    showToast("Ændringen blev fortrudt.");
  }

  function redo() {
    if (!redoStack.length) {
      return;
    }
    historyStack.push(deepClone(state));
    state = attachActiveProfileAccessors(redoStack.pop());
    selectedIds.clear();
    editorState = { type: "phase-new" };
    editorDraft = null;
    liveStatuses.delete(state.activeGroupId);
    window.clearTimeout(transferButtonResetTimer);
    if (refs.transferButton) refs.transferButton.textContent = "Overfør til VMAN";
    scheduleSave();
    renderAll();
    showToast("Ændringen blev gendannet.");
  }

  function isElementVisible(element) {
    if (!(element instanceof Element)) {
      return false;
    }
    const style = getComputedStyle(element);
    if (style.display === "none" || style.visibility === "hidden") {
      return false;
    }
    const rect = element.getBoundingClientRect();
    return rect.width > 20 && rect.height > 10;
  }

  function exactGroupDefinition(text) {
    const normalized = normalizeText(text).toLocaleLowerCase("da");
    return GROUP_DEFINITIONS.find((group) => group.aliases.some(
      (alias) => alias.toLocaleLowerCase("da") === normalized,
    ));
  }

  function groupHeadingSignature(element) {
    return `${element.tagName}|${Array.from(element.classList || []).sort().join(".")}`;
  }

  function customGroupId(name) {
    const normalized = normalizeText(name).toLocaleLowerCase("da");
    const slug = normalized
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "")
      .slice(0, 36) || "gruppe";
    let hash = 0;
    for (const character of normalized) hash = ((hash * 31) + character.charCodeAt(0)) >>> 0;
    return `custom-${slug}-${hash.toString(36)}`;
  }

  function inferCustomGroupPosition(card) {
    const text = ` ${normalizeText(card && card.textContent)} `;
    if (/\sK\s/.test(text) || /keeper|målmand/i.test(text)) return "Keepere";
    return "Forsvar";
  }

  function dynamicDefinitionForHeading(name, card) {
    const groupId = customGroupId(name);
    const saved = state.groups && state.groups[groupId];
    const group = {
      id: groupId,
      name,
      position: saved && POSITION_STATS[saved.position] ? saved.position : inferCustomGroupPosition(card),
      aliases: [name],
      dynamic: true,
    };
    dynamicGroupDefinitions.set(groupId, group);
    return group;
  }

  function findBestGroupCard(heading) {
    let best = null;
    let bestScore = -Infinity;
    let current = heading;
    for (let depth = 0; current && current !== document.body && depth < 8; depth += 1, current = current.parentElement) {
      const text = normalizeText(current.textContent);
      const rect = current.getBoundingClientRect();
      let score = 0;
      if (/Øvelse|Exercise/i.test(text)) score += 5;
      if (/Træner|Trainer|Coach/i.test(text)) score += 4;
      if (/Intensitet|Intensity/i.test(text)) score += 4;
      if (/\bNavn\b.*\b(?:Alder|Age)\b.*\bPos\.?\b.*\b(?:Vur\.?|Rating)\b/i.test(text)) score += 5;
      const playerMarkers = (current.innerHTML.match(/(?:\/players\/\d+|data-player-id|data-playerid|player[_-]?id)/gi) || []).length;
      score += Math.min(12, playerMarkers * 3);
      const siblingHeadings = Array.from(current.querySelectorAll("*"))
        .filter((element) => groupHeadingSignature(element) === groupHeadingSignature(heading))
        .filter((element) => normalizeText(element.textContent).length <= 48).length;
      if (siblingHeadings > 1) score -= (siblingHeadings - 1) * 15;
      if (rect.width >= 300 && rect.width <= 900) score += 3;
      if (rect.height >= 100 && rect.height <= 550) score += 3;
      score -= depth * 0.1;
      if (score > bestScore) {
        best = current;
        bestScore = score;
      }
    }
    return bestScore >= 8 ? best : null;
  }

  function candidateHeadingElements() {
    // VMAN bruger både links, spans og div-elementer som fanetitler afhængigt
    // af sideversionen. Søg derfor efter den faktiske tekst frem for bestemte
    // HTML-tags. Det gør især spillerfanerne i højre kolonne genkendelige.
    const elements = Array.from(document.body.querySelectorAll("*"));
    const known = elements
      .filter((element) => element.childElementCount <= 4)
      .filter((element) => Boolean(exactGroupDefinition(element.textContent)));
    const signatures = new Set(known.map(groupHeadingSignature));
    return elements.filter((element) => {
      const text = normalizeText(element.textContent);
      if (!text || text.length > 48 || element.childElementCount > 4) return false;
      return Boolean(exactGroupDefinition(text)) || signatures.has(groupHeadingSignature(element));
    });
  }

  function installGroupInteraction(group, card) {
    if (!card || card.dataset.virmTrainingGroup === group.id) {
      return;
    }
    card.dataset.virmTrainingGroup = group.id;
  }

  function scanTrainingGroups() {
    const nextGroups = new Map();
    const usedCards = new Set();
    for (const heading of candidateHeadingElements()) {
      const name = normalizeText(heading.textContent);
      if (!isElementVisible(heading)) {
        continue;
      }
      const card = findBestGroupCard(heading);
      if (!card || usedCards.has(card)) {
        continue;
      }
      const group = exactGroupDefinition(name) || dynamicDefinitionForHeading(name, card);
      if (nextGroups.has(group.id)) continue;
      usedCards.add(card);
      nextGroups.set(group.id, { definition: group, card, heading });
      installGroupInteraction(group, card);
    }
    discoveredGroups = nextGroups;
    const nextLiveGroupSignature = JSON.stringify(Array.from(nextGroups, ([groupId, found]) => [groupId, found.definition.name]));
    const liveGroupsChanged = nextLiveGroupSignature !== liveGroupSignature;
    liveGroupSignature = nextLiveGroupSignature;
    updateActiveGroupOutline();
    positionHost();
    ensureDailyTransferControl();
    renderFallbackGroups();
    requestGroupPlayerData(state.activeGroupId);
    if (liveGroupsChanged) liveExerciseCache = null;
  }

  function playerReferencesForGroup(groupId) {
    const found = discoveredGroups.get(groupId);
    if (!found || !found.card) return [];
    const references = [];
    const seen = new Set();
    const pageLanguage = window.location.pathname.match(/^\/([a-z]{2})(?:\/|$)/i)?.[1] || "da";

    function addReference(playerId, sourceElement = null, candidateUrl = "") {
      const id = String(playerId || "").match(/\d+/)?.[0];
      if (!id || seen.has(id)) return;
      let url = `/${pageLanguage}/players/${id}`;
      const directUrl = String(candidateUrl || "").match(/(?:https?:\/\/[^"'<>\s]+)?\/(?:[a-z]{2}\/)?players\/\d+[^"'<>\s)]*/i)?.[0];
      if (directUrl) url = directUrl;
      seen.add(id);
      references.push({
        id,
        name: normalizeText(sourceElement && sourceElement.textContent).slice(0, 80) || `Spiller ${id}`,
        url: new URL(url, window.location.origin).href,
      });
    }

    for (const element of [found.card, ...found.card.querySelectorAll("*")]) {
      for (const attribute of element.attributes || []) {
        const value = String(attribute.value || "");
        for (const match of value.matchAll(/\/(?:[a-z]{2}\/)?players\/(\d+)/gi)) {
          addReference(match[1], element, value);
        }
        const attributeName = attribute.name.toLocaleLowerCase("en");
        if (/player.*id|id.*player/.test(attributeName)) {
          const idMatch = value.match(/\b(\d+)\b/);
          if (idMatch) addReference(idMatch[1], element);
        }
        if (/player/.test(attributeName)) {
          const embeddedId = value.match(/(?:player[_-]?id|playerId|["']id["'])\s*["':=]+\s*(\d+)/i);
          if (embeddedId) addReference(embeddedId[1], element);
        }
        const elementMarker = `${element.id || ""} ${element.className || ""} ${element.getAttribute("role") || ""}`;
        if (/player|spiller/i.test(elementMarker) && /^(?:id|data-id|data-object-id|data-entity-id)$/.test(attributeName)) {
          const contextualId = value.match(/\b(\d{3,})\b/);
          if (contextualId) addReference(contextualId[1], element);
        }
        if (/player|spiller/i.test(value)) {
          const functionId = value.match(/(?:player|spiller)[^\d]{0,24}(\d{3,})/i);
          if (functionId) addReference(functionId[1], element, value);
        }
      }
    }

    const markup = found.card.innerHTML;
    for (const match of markup.matchAll(/\/(?:[a-z]{2}\/)?players\/(\d+)/gi)) addReference(match[1], found.card, match[0]);
    for (const match of markup.matchAll(/(?:data-player-id|data-playerid|player[_-]?id|playerId)\s*["':=]+\s*(\d+)/gi)) addReference(match[1], found.card);
    for (const match of markup.matchAll(/(?:class|id)=["'][^"']*(?:player|spiller)[^"']*["'][^>]*(?:data-id|data-object-id|data-entity-id)=["']?(\d{3,})/gi)) addReference(match[1], found.card);
    return references;
  }

  function normalizedNameKey(value) {
    return normalizeText(value)
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase("da")
      .replace(/[^a-z0-9æøå]+/g, " ")
      .trim();
  }

  function mergePlayerReferences(...referenceLists) {
    const merged = [];
    const seen = new Set();
    for (const references of referenceLists) {
      for (const reference of references || []) {
        const id = String(reference && reference.id || "").match(/\d+/)?.[0];
        if (!id || seen.has(id)) continue;
        seen.add(id);
        merged.push({ ...reference, id });
      }
    }
    return merged;
  }

  function referenceFromRosterItem(item) {
    if (!item || typeof item !== "object") return null;
    const id = String(item.id ?? item.player_id ?? item.playerId ?? "").match(/\d+/)?.[0];
    const name = normalizeText(item.name ?? item.player_name ?? item.playerName ?? "");
    if (!id || !name) return null;
    const pageLanguage = window.location.pathname.match(/^\/([a-z]{2})(?:\/|$)/i)?.[1] || "da";
    const candidates = [
      item.url, item.href, item.link, item.profile_url, item.profileUrl,
      item.player_url, item.playerUrl, item.profile_link, item.profileLink,
    ];
    const slug = name.normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("en")
      .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    let url = `/${pageLanguage}/players/${id}${slug ? `-${slug}` : ""}`;
    for (const candidate of candidates) {
      const direct = String(candidate || "").match(/(?:https?:\/\/[^"'<>\s]+)?\/(?:[a-z]{2}\/)?players\/\d+[^"'<>\s)]*/i)?.[0];
      if (direct) {
        url = direct;
        break;
      }
    }
    return { id, name, url: new URL(url, window.location.origin).href };
  }

  function jsonValueAfterAssignment(source, offset) {
    let start = offset;
    while (/\s/.test(source[start] || "")) start += 1;
    if (!["{", "["].includes(source[start])) return null;
    const opening = source[start];
    const closing = opening === "{" ? "}" : "]";
    let depth = 0;
    let quote = "";
    let escaped = false;
    for (let index = start; index < source.length; index += 1) {
      const character = source[index];
      if (quote) {
        if (escaped) escaped = false;
        else if (character === "\\") escaped = true;
        else if (character === quote) quote = "";
        continue;
      }
      if (character === '"' || character === "'") {
        quote = character;
        continue;
      }
      if (character === opening) depth += 1;
      else if (character === closing) {
        depth -= 1;
        if (depth === 0) {
          try {
            return JSON.parse(source.slice(start, index + 1));
          } catch (_error) {
            return null;
          }
        }
      }
    }
    return null;
  }

  function rosterPlayersFromSource(source) {
    const players = [];
    const seen = new Set();
    const raw = String(source || "").replace(/\\\//g, "/");
    const assignment = /(?:window\.)?playersData\s*=\s*/gi;
    for (const match of raw.matchAll(assignment)) {
      const data = jsonValueAfterAssignment(raw, match.index + match[0].length);
      const items = data && Array.isArray(data.players) ? data.players : [];
      for (const item of items) {
        const reference = referenceFromRosterItem(item);
        if (!reference || seen.has(reference.id)) continue;
        seen.add(reference.id);
        players.push(reference);
      }
    }
    return players;
  }

  function embeddedRosterPlayers() {
    const references = [];
    for (const script of document.scripts) references.push(...rosterPlayersFromSource(script.textContent));
    for (const element of document.querySelectorAll("[data-players], [data-players-data]")) {
      references.push(...rosterPlayersFromSource(`playersData=${element.getAttribute("data-players") || element.getAttribute("data-players-data") || ""}`));
    }
    return mergePlayerReferences(references);
  }

  function currentClubId() {
    const scores = new Map();
    function add(id, score = 1) {
      if (id) scores.set(id, (scores.get(id) || 0) + score);
    }
    for (const link of document.querySelectorAll('a[href*="/clubs/"]')) {
      const match = String(link.getAttribute("href") || "").match(/\/clubs\/(\d+)/i);
      if (match) add(match[1], link.closest("header, nav") ? 3 : 1);
    }
    for (const element of document.querySelectorAll("[data-club-id], [data-clubid]")) {
      add(String(element.getAttribute("data-club-id") || element.getAttribute("data-clubid") || "").match(/\d+/)?.[0], 2);
    }
    for (const script of document.scripts) {
      for (const match of String(script.textContent || "").matchAll(/(?:club[_-]?id|clubId)["'\s:=]+(\d+)/gi)) add(match[1]);
    }
    return Array.from(scores.entries()).sort((left, right) => right[1] - left[1])[0]?.[0] || "";
  }

  async function fetchedClubRosterPlayers() {
    if (clubRosterPromise) return clubRosterPromise;
    const clubId = currentClubId();
    if (!clubId) return [];
    clubRosterPromise = (async () => {
      const pageLanguage = window.location.pathname.match(/^\/([a-z]{2})(?:\/|$)/i)?.[1] || "da";
      const candidates = [`/${pageLanguage}/clubs/${clubId}/players`, `/da/clubs/${clubId}/players`, `/clubs/${clubId}/players`];
      for (const url of [...new Set(candidates)]) {
        try {
          const response = await fetch(new URL(url, window.location.origin).href, { credentials: "include", cache: "no-store" });
          if (!response.ok) continue;
          const players = rosterPlayersFromSource(await response.text());
          if (players.length) return players;
        } catch (_error) {
          // Prøv næste sprogrute.
        }
      }
      return [];
    })();
    const players = await clubRosterPromise;
    if (!players.length) clubRosterPromise = null;
    return players;
  }

  function groupCardContainsPlayerName(card, playerName) {
    const cardText = normalizedNameKey(card && card.textContent);
    const name = normalizedNameKey(playerName);
    if (name.length < 4) return false;
    if (` ${cardText} `.includes(` ${name} `)) return true;
    return cardText.replace(/\s+/g, "").includes(name.replace(/\s+/g, ""));
  }

  function rosterReferencesForGroup(groupId, roster) {
    const found = discoveredGroups.get(groupId);
    if (!found || !found.card) return [];
    return (roster || []).filter((reference) => groupCardContainsPlayerName(found.card, reference.name));
  }

  function globalLinkReferencesForGroup(groupId) {
    const found = discoveredGroups.get(groupId);
    if (!found || !found.card) return [];
    const references = [];
    for (const link of document.querySelectorAll('a[href*="/players/"]')) {
      const href = String(link.getAttribute("href") || "");
      const id = href.match(/\/players\/(\d+)/i)?.[1];
      const name = normalizeText(link.textContent);
      if (!id || !groupCardContainsPlayerName(found.card, name)) continue;
      references.push({ id, name, url: new URL(href, window.location.origin).href });
    }
    return mergePlayerReferences(references);
  }

  async function resolveGroupPlayerReferences(groupId) {
    const direct = playerReferencesForGroup(groupId);
    const globalLinks = globalLinkReferencesForGroup(groupId);
    const embedded = rosterReferencesForGroup(groupId, embeddedRosterPlayers());
    const fetched = rosterReferencesForGroup(groupId, await fetchedClubRosterPlayers());
    return mergePlayerReferences(direct, globalLinks, embedded, fetched);
  }

  function canonicalStatLabel(label) {
    const normalized = normalizeText(label).toLocaleLowerCase("da");
    for (const [stat, aliases] of Object.entries(STAT_ALIASES)) {
      if (aliases.some((alias) => normalizeText(alias).toLocaleLowerCase("da") === normalized)) return stat;
    }
    return null;
  }

  function parseProfileAge(text) {
    let match = text.match(/\b(?:Alder|Age)\s*[:\-]?\s*(\d{1,2})\b/i);
    if (!match) return null;
    const years = Number(match[1]);
    let remaining = text.match(/(?:Fødselsdag\s*om|Birthday\s*in)\s*(\d{1,2})\s*(?:dage|days)/i);
    if (remaining) return years + (30 - Number(remaining[1])) / 30;
    if (/(?:Fødselsdag\s*i\s*morgen|Birthday\s*tomorrow)/i.test(text)) return years + 29 / 30;
    return years;
  }

  function parseProfilePosition(text, fallback) {
    const patterns = [
      [/Goalkeeper|Keeper|Målmand/i, "Keepere"],
      [/Midfielder|Midtbane/i, "Midtbane"],
      [/Defender|Defence|Defense|Forsvar/i, "Forsvar"],
      [/Forward|Attacker|Striker|Angriber|Angreb/i, "Angreb"],
    ];
    for (const [pattern, position] of patterns) if (pattern.test(text)) return position;
    return fallback;
  }

  function normalizeSpecificPlayerPosition(value) {
    const text = normalizeText(value);
    const upper = text.toUpperCase();
    const codeMatch = upper.match(/(?:^|[^A-ZÆØÅ])(K|FV|FC|FH|MD|MV|MC|MH|MO|AV|AC|AH)(?:$|[^A-ZÆØÅ])/);
    if (codeMatch) return codeMatch[1];

    const key = normalizedNameKey(text);
    if (/\b(goalkeeper|keeper|målmand|maalmand|malmand)\b/.test(key)) return "K";
    if (/\b(forsvar|defender|defence|defense)\b/.test(key)) {
      if (/\b(venstre|left)\b/.test(key)) return "FV";
      if (/\b(højre|hojre|right)\b/.test(key)) return "FH";
      if (/\b(central|center|centre)\b/.test(key)) return "FC";
    }
    if (/\b(midtbane|midfielder|midfield)\b/.test(key)) {
      if (/\b(defensiv|defensive)\b/.test(key)) return "MD";
      if (/\b(venstre|left)\b/.test(key)) return "MV";
      if (/\b(højre|hojre|right)\b/.test(key)) return "MH";
      if (/\b(offensiv|offensive)\b/.test(key)) return "MO";
      if (/\b(central|center|centre)\b/.test(key)) return "MC";
    }
    if (/\b(angreb|attacker|forward|striker)\b/.test(key)) {
      if (/\b(venstre|left)\b/.test(key)) return "AV";
      if (/\b(højre|hojre|right)\b/.test(key)) return "AH";
      if (/\b(central|center|centre)\b/.test(key)) return "AC";
    }
    return "";
  }

  function broadPositionFromSpecific(code) {
    if (code === "K") return "Keepere";
    if (["FV", "FC", "FH"].includes(code)) return "Forsvar";
    if (["MD", "MV", "MC", "MH", "MO"].includes(code)) return "Midtbane";
    if (["AV", "AC", "AH"].includes(code)) return "Angreb";
    return "";
  }

  function parseSpecificProfilePosition(documentNode) {
    if (!documentNode) return "";
    for (const row of documentNode.querySelectorAll("tr")) {
      const cells = Array.from(row.querySelectorAll("th,td"));
      if (cells.length < 2) continue;
      const label = normalizedNameKey(cells[0].textContent);
      if (label === "position" || label === "pos") {
        const parsed = normalizeSpecificPlayerPosition(cells.slice(1).map((cell) => [
          cell.textContent || "",
          cell.getAttribute("title") || "",
          cell.getAttribute("aria-label") || "",
        ].join(" ")).join(" "));
        if (parsed) return parsed;
      }
    }
    for (const element of documentNode.querySelectorAll(
      "td.position, .player_position, .player-position, [data-position], [class*='position']"
    )) {
      const parsed = normalizeSpecificPlayerPosition([
        element.textContent || "",
        element.getAttribute("data-position") || "",
        element.getAttribute("title") || "",
        element.getAttribute("aria-label") || "",
      ].join(" "));
      if (parsed) return parsed;
    }
    return "";
  }

  function parseProfileStats(documentNode, text) {
    const stats = {};
    const containers = documentNode.querySelectorAll("div.stats table[data-player-id] div.content, div.stats div.content");
    for (const content of containers) {
      const labelElement = Array.from(content.children).find((child) => child.classList.contains("label"));
      const valueElement = Array.from(content.children).find((child) => child.classList.contains("value"));
      if (!labelElement || !valueElement) continue;
      const stat = canonicalStatLabel(labelElement.textContent);
      const valueMatch = normalizeText(valueElement.textContent).match(/\b(\d{1,3}(?:[.,]\d+)?)\b/);
      const value = valueMatch ? Number(valueMatch[1].replace(",", ".")) : NaN;
      if (stat && Number.isFinite(value) && value >= 0 && value <= 100) stats[stat] = value;
    }
    if (Object.keys(stats).length >= 6) return stats;
    for (const [stat, aliases] of Object.entries(STAT_ALIASES)) {
      if (Object.hasOwn(stats, stat)) continue;
      for (const alias of aliases) {
        const escaped = alias.replace(/[.*+?^${}()|[\]\\]/g, "\\$&").replace(/\\ /g, "\\s+");
        const match = text.match(new RegExp(`${escaped}\\s*[:\\-]?\\s*(\\d{1,3}(?:[.,]\\d+)?)`, "i"));
        if (!match) continue;
        const value = Number(match[1].replace(",", "."));
        if (value >= 0 && value <= 100) stats[stat] = value;
        break;
      }
    }
    return stats;
  }

  function calculateRating(stats, position) {
    const weights = POSITION_WEIGHTS[position];
    if (!weights || !Object.keys(weights).every((stat) => Number.isFinite(stats[stat]))) return null;
    const totalWeight = Object.values(weights).reduce((sum, value) => sum + value, 0);
    return Object.entries(weights).reduce((sum, [stat, weight]) => sum + stats[stat] * weight, 0) / totalWeight;
  }

  function parsePlayerProfile(html, reference, fallbackPosition) {
    const documentNode = new DOMParser().parseFromString(html, "text/html");
    const text = normalizeText(documentNode.body ? documentNode.body.textContent : html);
    const stats = parseProfileStats(documentNode, text);
    const specificPosition = parseSpecificProfilePosition(documentNode);
    const position = broadPositionFromSpecific(specificPosition) || parseProfilePosition(text, fallbackPosition);
    let rating = null;
    for (const pattern of [
      /(\d+(?:[.,]\d+)?)\s+(?:Rating|VT)\b/i,
      /\b(?:Rating|VT)\s*[:\-]?\s*(\d+(?:[.,]\d+)?)/i,
    ]) {
      const matches = Array.from(text.matchAll(new RegExp(pattern.source, "gi")));
      if (matches.length) {
        rating = Number(matches[matches.length - 1][1].replace(",", "."));
        break;
      }
    }
    if (!Number.isFinite(rating)) rating = calculateRating(stats, position);
    const age = parseProfileAge(text);
    if (!Number.isFinite(age) && !Number.isFinite(rating) && Object.keys(stats).length < 6) {
      throw new Error(`${reference.name}: spillerprofilen indeholdt ikke de forventede data.`);
    }
    return { ...reference, age, rating, stats, position, specificPosition };
  }

  async function fetchPlayerProfile(reference, fallbackPosition) {
    const pageLanguage = window.location.pathname.match(/^\/([a-z]{2})(?:\/|$)/i)?.[1] || "da";
    const candidates = [
      reference.url,
      new URL(`/${pageLanguage}/players/${reference.id}`, window.location.origin).href,
      new URL(`/da/players/${reference.id}`, window.location.origin).href,
      new URL(`/en/players/${reference.id}`, window.location.origin).href,
    ];
    let lastError = null;
    for (const url of [...new Set(candidates)]) {
      try {
        const response = await fetch(url, { credentials: "include", cache: "no-store" });
        if (!response.ok) {
          lastError = new Error(`HTTP ${response.status}`);
          continue;
        }
        return parsePlayerProfile(await response.text(), { ...reference, url }, fallbackPosition);
      } catch (error) {
        lastError = error;
      }
    }
    throw new Error(`${reference.name}: ${lastError && lastError.message || "spillerprofilen kunne ikke hentes"}`);
  }

  async function requestGroupPlayerData(groupId, force = false) {
    const existing = groupPlayerData.get(groupId);
    if (!force && existing && existing.status === "loading") {
      renderPlayerResultLine();
      return;
    }
    const sequence = ++playerLoadSequence;
    groupPlayerData.set(groupId, { status: "loading", signature: "", players: [], errors: [], total: 0, sequence });
    renderPlayerResultLine();
    const references = await resolveGroupPlayerReferences(groupId);
    if (groupPlayerData.get(groupId)?.sequence !== sequence) return;
    const signature = references.map((reference) => reference.id).sort().join(",");
    if (!force && existing && existing.signature === signature && ["ready", "empty"].includes(existing.status)) {
      groupPlayerData.set(groupId, existing);
      renderPlayerResultLine();
      return;
    }
    if (!references.length) {
      groupPlayerData.set(groupId, { status: "empty", signature, players: [], errors: [] });
      renderPlayerResultLine();
      if (["scenario", "scenario-players"].includes(editorState.type) && groupId === state.activeGroupId) renderEditor();
      return;
    }
    groupPlayerData.set(groupId, { status: "loading", signature, players: [], errors: [], total: references.length, sequence });
    renderPlayerResultLine();
    const players = [];
    const errors = [];
    let cursor = 0;
    const workers = Array.from({ length: Math.min(3, references.length) }, async () => {
      while (cursor < references.length) {
        const reference = references[cursor];
        cursor += 1;
        try {
          players.push(await fetchPlayerProfile(reference, groupDefinition(groupId).position));
        } catch (error) {
          errors.push(error.message || String(error));
        }
      }
    });
    await Promise.all(workers);
    if (groupPlayerData.get(groupId)?.sequence !== sequence) return;
    groupPlayerData.set(groupId, { status: "ready", signature, players, errors, total: references.length });
    renderPlayerResultLine();
    if (["scenario", "scenario-players"].includes(editorState.type) && groupId === state.activeGroupId) renderEditor();
  }

  function updateActiveGroupOutline() {
    for (const [groupId, found] of discoveredGroups.entries()) {
