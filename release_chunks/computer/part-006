  function positionHostInCentralFallback() {
    const layout = findCentralTrainingLayout();
    const firstGroup = discoveredGroups.values().next().value;
    if (!layout || !firstGroup) {
      host.classList.add("virm-extension-pending");
      host.classList.remove("virm-extension-central-overlay");
      return false;
    }

    const layoutRect = layout.getBoundingClientRect();
    const firstRect = firstGroup.card.getBoundingClientRect();
    const viewportLeft = firstRect.right + 24;
    const viewportTop = firstRect.bottom + 12;
    const width = layoutRect.right - viewportLeft - 24;
    if (width < 280) {
      host.classList.add("virm-extension-pending");
      host.classList.remove("virm-extension-central-overlay");
      return false;
    }

    if (host.parentElement !== document.body) {
      document.body.appendChild(host);
    }
    host.classList.remove("virm-extension-pending");
    host.classList.add("virm-extension-central-overlay");
    host.style.setProperty("left", `${viewportLeft + window.scrollX}px`, "important");
    host.style.setProperty("top", `${viewportTop + window.scrollY}px`, "important");
    host.style.setProperty("width", `${width}px`, "important");
    setHostHeightFromViewportTop(viewportTop);
    return true;
  }

