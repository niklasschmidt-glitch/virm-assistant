  function findPlayerPanel() {
    const direct = document.querySelector(".training_exercises > .main > .player_list");
    if (direct && direct.isConnected && isElementVisible(direct)) return direct;

    const firstGroup = discoveredGroups.values().next().value;
    const groupRect = firstGroup ? firstGroup.card.getBoundingClientRect() : null;
    let best = null;
    let bestScore = -Infinity;

    for (const element of candidateHeadingElements()) {
      if (!exactGroupDefinition(element.textContent) || !isElementVisible(element)) {
        continue;
      }
      let current = element.parentElement;
      for (let depth = 0; current && current !== document.body && depth < 11; depth += 1, current = current.parentElement) {
        const text = normalizeText(current.textContent);
        const lowerText = text.toLocaleLowerCase("da");
        const rect = current.getBoundingClientRect();
        const represented = GROUP_DEFINITIONS.filter((group) => group.aliases.some(
          (alias) => lowerText.includes(alias.toLocaleLowerCase("da")),
        )).length;
        if (represented < 3 || rect.width < 280 || rect.width > 850 || rect.height < 100) {
          continue;
        }
        let score = represented * 4 - depth * 0.5;
        if (groupRect && rect.left > groupRect.left + groupRect.width * 0.55) score += 8;
        if (rect.height >= 140 && rect.height <= 600) score += 3;
        if (rect.width <= 650) score += 2;
        if (firstGroup && current.contains(firstGroup.card)) score -= 20;
        if (score > bestScore) {
          best = current;
          bestScore = score;
        }
      }
    }
    return bestScore > 10 ? best : null;
  }

  function visualBottomOfPlayerPanel(panel) {
    if (!panel) return 0;
    let bottom = panel.getBoundingClientRect().bottom;
    for (const element of panel.querySelectorAll("*")) {
      const rect = element.getBoundingClientRect();
      if (!rect.width || !rect.height) continue;
      const style = window.getComputedStyle(element);
      if (style.display === "none" || style.visibility === "hidden") continue;
      bottom = Math.max(bottom, rect.bottom);
    }
    return bottom;
  }

  function findCentralTrainingLayout() {
    const direct = document.querySelector(".training_exercises > .main");
    if (direct && direct.isConnected) return direct;

    const cards = Array.from(discoveredGroups.values()).map((found) => found.card);
    if (!cards.length) return null;
    const firstCard = cards[0];
    const firstRect = firstCard.getBoundingClientRect();
    let current = firstCard.parentElement;
    let best = null;
    let bestWidth = Infinity;
    for (let depth = 0; current && current !== document.body && depth < 10; depth += 1, current = current.parentElement) {
      const rect = current.getBoundingClientRect();
      const containedCards = cards.filter((card) => current.contains(card)).length;
      const enoughCards = containedCards >= Math.min(2, cards.length);
      const spansTwoColumns = rect.width >= firstRect.width * 1.45
        && rect.width <= firstRect.width * 3.1
        && rect.right >= firstRect.right + 250;
      if (enoughCards && spansTwoColumns && rect.width < bestWidth) {
        best = current;
        bestWidth = rect.width;
      }
    }
    return best;
  }


  function isGreenBackgroundColor(value) {
    const match = String(value || "").match(/rgba?\((\d+)[, ]+\s*(\d+)[, ]+\s*(\d+)/i);
    if (!match) return false;
    const red = Number(match[1]);
    const green = Number(match[2]);
    const blue = Number(match[3]);
    return green >= red + 12 && green >= blue + 12 && green >= 65;
  }

  function findGrassBackgroundElement() {
    const layout = findCentralTrainingLayout();
    if (!layout) return null;
    const layoutRect = layout.getBoundingClientRect();
    let current = layout;
    let greenFallback = null;
    for (let depth = 0; current && current !== document.body && depth < 12; depth += 1, current = current.parentElement) {
      const rect = current.getBoundingClientRect();
      if (rect.width < layoutRect.width * 0.9) continue;
      const style = window.getComputedStyle(current);
      const image = String(style.backgroundImage || "");
      if (image && image !== "none") return current;
      if (!greenFallback && isGreenBackgroundColor(style.backgroundColor)) greenFallback = current;
    }
    return greenFallback;
  }

  function removeGrassFlowSpacer() {
    if (grassFlowSpacer && grassFlowSpacer.isConnected) grassFlowSpacer.remove();
    grassFlowSpacer = null;
