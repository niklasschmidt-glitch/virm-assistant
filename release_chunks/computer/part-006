  function itemTotalDays(item) {
    if (item.type === "block") {
      const base = (item.phases || []).reduce((sum, phase) => sum + Math.max(1, Number(phase.days) || 1), 0);
      return base * Math.max(1, Number(item.repetitions) || 1);
    }
    return Math.max(1, Number(item.days) || 1);
  }

  function programTotalDays(program) {
    return (program.sessions || []).reduce((sum, item) => sum + itemTotalDays(item), 0);
  }

  function phaseForProgramDay(program, dayIndex) {
    if (!Number.isInteger(dayIndex) || dayIndex < 0) return null;
    let remaining = dayIndex;
    for (const item of program.sessions || []) {
      if (item.type !== "block") {
        const days = Math.max(1, Number(item.days) || 1);
        if (remaining < days) return item;
        remaining -= days;
        continue;
      }
      const phases = item.phases || [];
      const cycleDays = phases.reduce((sum, phase) => sum + Math.max(1, Number(phase.days) || 1), 0);
      if (!cycleDays) return null;
      const repetitions = Math.max(1, Number(item.repetitions) || 1);
      const blockDays = cycleDays * repetitions;
      if (remaining >= blockDays) {
        remaining -= blockDays;
        continue;
      }
      let withinCycle = remaining % cycleDays;
      for (const phase of phases) {
        const days = Math.max(1, Number(phase.days) || 1);
        if (withinCycle < days) return phase;
        withinCycle -= days;
      }
      return null;
    }
    return null;
  }

  function programSessionForDay(program, dayIndex) {
    if (!Number.isInteger(dayIndex) || dayIndex < 0) return null;

    let remaining = dayIndex;
    for (let itemIndex = 0; itemIndex < (program.sessions || []).length; itemIndex += 1) {
      const item = program.sessions[itemIndex];

      if (item.type !== "block") {
        const days = Math.max(1, Number(item.days) || 1);
        if (remaining < days) {
          return {
            item,
            itemIndex,
            phase: item,
            phaseIndex: null,
            repetition: null,
          };
        }
        remaining -= days;
        continue;
      }

      const phases = item.phases || [];
      const cycleDays = phases.reduce(
        (sum, phase) => sum + Math.max(1, Number(phase.days) || 1),
        0,
      );
      if (!cycleDays) return null;

      const repetitions = Math.max(1, Number(item.repetitions) || 1);
      const blockDays = cycleDays * repetitions;
      if (remaining >= blockDays) {
        remaining -= blockDays;
        continue;
      }

      const repetition = Math.floor(remaining / cycleDays);
      let withinCycle = remaining % cycleDays;
      for (let phaseIndex = 0; phaseIndex < phases.length; phaseIndex += 1) {
        const phase = phases[phaseIndex];
        const days = Math.max(1, Number(phase.days) || 1);
        if (withinCycle < days) {
          return {
            item,
            itemIndex,
            phase,
            phaseIndex,
            repetition,
          };
        }
        withinCycle -= days;
      }
      return null;
    }

    return null;
  }

  function showEditorForTodaySession() {
    const program = activeProgram();
    if (!program) return false;

    const current = currentProgramDay(program);
    if (current.state !== "ready") return false;

    const session = programSessionForDay(program, current.dayIndex);
    if (!session || !session.item || !session.phase) return false;

    selectedIds = new Set([session.item.id]);
    selectionAnchorId = session.item.id;
    editorDraft = null;

    if (session.item.type === "block") {
      editorState = {
        type: "phase-block",
        parentBlockId: session.item.id,
        phaseId: session.phase.id,
      };
      currentDistribution = deepClone(session.phase.distribution || {});
    } else {
      editorState = { type: "phase", itemId: session.item.id };
      currentDistribution = deepClone(session.item.distribution || {});
    }

    resetDistributionPriorities();
    renderProgram();
    renderEditor();

    // Sørg også for, at den relevante række er synlig i programlisten.
    if (refs.programScroll) {
      const row = Array.from(refs.programScroll.querySelectorAll(".virm-program-row"))
        .find((candidate) => candidate.dataset.itemId === session.item.id);
      if (row && typeof row.scrollIntoView === "function") {
        row.scrollIntoView({ block: "nearest" });
      }
    }

    return true;
  }

  function currentProgramDay(program) {
    const totalDays = programTotalDays(program);
    if (!totalDays) return { state: "empty", totalDays, dayIndex: null, phase: null };
    const dayIndex = dayIndexForDate(program.startDate, todayISO());
    if (dayIndex === null) return { state: "invalid-date", totalDays, dayIndex, phase: null };
    if (dayIndex < 0) return { state: "future", totalDays, dayIndex, phase: null };
    if (dayIndex >= totalDays) return { state: "finished", totalDays, dayIndex, phase: null };
    return {
      state: "ready",
      totalDays,
      dayIndex,
      dayNumber: dayIndex + 1,
      phase: phaseForProgramDay(program, dayIndex),
    };
  }

  function vmanTrainingContext() {
    const match = window.location.pathname.match(/\/squads\/(\d+)\/training_exercises\/?$/i);
    if (!match) return null;
    return {
      squadId: Number(match[1]),
      basePath: `/squads/${match[1]}/training_exercises`,
    };
  }

  function vmanAuthenticationError(message) {
    const error = new Error(message);
    error.name = "VIRMAuthenticationError";
    error.code = "VMAN_AUTHENTICATION_REQUIRED";
    return error;
  }

  function responseIsVmanLogin(response, parsedDocument = null) {
    let pathname = "";
    try {
      pathname = new URL(response?.url || "", window.location.origin).pathname;
    } catch (_error) {}
    if (/\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?login\/?$/i.test(pathname)) return true;
    if (!parsedDocument) return false;
    return Boolean(parsedDocument.querySelector('form[action*="/login"], input[type="password"][name*="password" i]'));
  }

  async function refreshVmanSession(context) {
    if (vmanSessionRefreshPromise) return vmanSessionRefreshPromise;
    vmanSessionRefreshPromise = (async () => {
      const url = new URL(context.basePath, window.location.origin);
      url.searchParams.set("virm_session_refresh", String(Date.now()));
      const response = await fetch(url.href, {
        method: "GET",
        credentials: "include",
        cache: "no-store",
        redirect: "follow",
        headers: { Accept: "text/html,application/xhtml+xml" },
      });
      const html = await response.text();
      const parsed = new DOMParser().parseFromString(html, "text/html");
      if (response.status === 401 || responseIsVmanLogin(response, parsed)) {
        liveExerciseCache = null;
        throw vmanAuthenticationError("VMAN-sessionen er udløbet. Log ind i en anden fane og prøv igen. Der blev ikke sendt træning til VMAN.");
      }
      if (!response.ok) {
        const status = `${response.status} ${response.statusText || ""}`.trim();
        throw new Error(`VMAN-sessionen kunne ikke kontrolleres (${status}).`);
      }
      const token = parsed.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";
      if (!token) {
        liveExerciseCache = null;
        throw vmanAuthenticationError("VMAN-sessionen kunne ikke fornyes. Der blev ikke sendt træning til VMAN.");
      }
      const currentMeta = document.querySelector('meta[name="csrf-token"]');
      if (currentMeta) currentMeta.setAttribute("content", token);
      liveExerciseCache = null;
      return token;
    })();
    try {
      return await vmanSessionRefreshPromise;
    } finally {
      vmanSessionRefreshPromise = null;
    }
  }

  function scheduleVmanPageRefresh() {
    window.clearTimeout(liveReloadTimer);
    liveReloadTimer = window.setTimeout(() => {
      window.dispatchEvent(new CustomEvent("virm-extension-refresh-requested"));
      if (!window.__VIRM_EXTENSION_DISABLE_LIVE_RELOAD__) window.location.reload();
    }, 650);
  }

  async function vmanResponseError(response) {
    try {
      const data = await response.json();
      const details = typeof data === "string" ? data : Object.values(data || {}).flat().join(" · ");
      if (details) return `${response.status}: ${details}`;
    } catch (_jsonError) {
      try {
        const text = await response.text();
        if (text) return `${response.status}: ${text}`;
      } catch (_textError) {
        // Brug statuslinjen nedenfor.
      }
    }
    return `${response.status} ${response.statusText || ""}`.trim();
  }

  async function loadVmanTrainingExercises(context, force = false) {
    if (!force
      && liveExerciseCache
      && Number(liveExerciseCacheSquadId) === Number(context.squadId)
      && Date.now() - liveExerciseCacheTime < 2500) return liveExerciseCache;
    const response = await fetch(`${context.basePath}.json`, {
      method: "GET",
      credentials: "include",
      headers: {
        Accept: "application/json",
        "X-Requested-With": "XMLHttpRequest",
      },
    });
    if (!response.ok) throw new Error(`Kunne ikke hente VMANs træningsgrupper (${await vmanResponseError(response)}).`);
    const data = await response.json();
    if (!Array.isArray(data && data.training_exercises)) throw new Error("VMAN returnerede ikke den forventede liste over træningsgrupper.");
    liveExerciseCache = data.training_exercises;
    liveExerciseCacheTime = Date.now();
    liveExerciseCacheSquadId = Number(context.squadId);
    return liveExerciseCache;
  }

  function vmanTargetForPhase(program, phase) {
    if (!phase) throw new Error("Programdagen kunne ikke findes.");
    const definition = exerciseDefinitionForPhase(phase, program.position);
    const exerciseTypeCode = definition.code;
    if (!Number.isInteger(exerciseTypeCode)) throw new Error(`Øvelsen “${definition.label}” kan ikke overføres til VMAN.`);
    const intensity = clamp(Number(phase.trainingPoints) - 19, 1, 5);
    if (exerciseTypeCode === 0) {
      return { exerciseTypeCode, intensity, instructions: [] };
    }
    const byAbility = new Map();
    for (const [stat, points] of Object.entries(phase.distribution || {})) {
      const ability = VMAN_ABILITY_CODES[stat];
      if (!ability) throw new Error(`Egenskaben “${stat}” kan ikke overføres til VMAN.`);
      byAbility.set(ability, Number(points) * 5);
    }
    const abilityOrder = VMAN_ABILITY_ORDER[exerciseTypeCode] || [];
    const instructions = abilityOrder.map((ability) => ({ ability, percentage: byAbility.get(ability) }));
    if (!instructions.length || instructions.some((item) => !Number.isFinite(item.percentage))) {
      throw new Error(`Indsatsen for “${definition.label}” er ufuldstændig.`);
    }
    return { exerciseTypeCode, intensity, instructions };
  }

  function vmanExercisePayload(context, exercise, target) {
    return {
      id: Number(exercise.id),
      name: String(exercise.name),
      squad_id: Number(exercise.squad_id || context.squadId),
      employee_id: exercise.employee_id == null ? null : Number(exercise.employee_id),
      exercise_type_code: target.exerciseTypeCode,
      intensity: target.intensity,
      instructions: target.instructions,
    };
  }

  function setLiveStatus(groupId, message, kind = "") {
    liveStatuses.set(groupId, { message, kind });
    if (groupId === state.activeGroupId) renderLiveBar();
  }

  async function applyLiveGroup(groupId) {
    const context = vmanTrainingContext();
    if (!context || !state.groups[groupId]) return false;
    const groupState = ensureGroupState(groupId);
    const program = state.programs[groupState.activeProgramId];
    const current = currentProgramDay(program);
    if (current.state === "empty") {
      setLiveStatus(groupId, "", "muted");
      return false;
    }
    if (current.state === "future") {
      setLiveStatus(groupId, `Programmet starter om ${formatDanishDayCount(Math.abs(current.dayIndex))}`, "muted");
      return false;
    }
    if (current.state === "finished") {
      setLiveStatus(groupId, "Programmet er afsluttet", "muted");
      return false;
    }
    if (current.state !== "ready") {
      setLiveStatus(groupId, "Ugyldig startdato", "error");
      return false;
    }

    try {
      setLiveStatus(groupId, "Kontrollerer VMAN-sessionen…", "loading");
      const currentCsrfToken = await refreshVmanSession(context);
      const exercises = await loadVmanTrainingExercises(context);
      const groupName = normalizeText(discoveredGroups.get(groupId)?.definition.name || groupState.name).toLocaleLowerCase("da");
      const exercise = exercises.find((item) => normalizeText(item.name).toLocaleLowerCase("da") === groupName);
      if (!exercise) throw new Error(`VMAN-gruppen “${groupState.name}” kunne ikke findes.`);
      const target = vmanTargetForPhase(program, current.phase);
      setLiveStatus(groupId, `Overfører dag ${current.dayNumber}/${current.totalDays}…`, "loading");
      const response = await fetch(`${context.basePath}/${exercise.id}`, {
        method: "PUT",
        credentials: "include",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "X-CSRF-Token": currentCsrfToken,
        },
        body: JSON.stringify(vmanExercisePayload(context, exercise, target)),
      });
      if (!response.ok) throw new Error(`${exercise.name}: ${await vmanResponseError(response)}`);
      exercise.exercise_type_code = target.exerciseTypeCode;
      exercise.intensity = target.intensity;
      exercise.instructions = deepClone(target.instructions);
      setLiveStatus(groupId, "");
      return true;
    } catch (error) {
      setLiveStatus(groupId, `Overførselsfejl: ${error.message}`, "error");
      return false;
    }
  }

  function queueGroupTransfer(groupId, { automatic = false, refresh = false } = {}) {
    if (!groupId) return Promise.resolve(false);
    if (!vmanTrainingContext()) {
      setLiveStatus(groupId, "Overførselsfejl: Gruppens Øvelser-side kunne ikke identificeres.", "error");
      return Promise.resolve(false);
    }
    liveTransferPending += 1;
    renderTransferButton();
    let transferred = false;
    const operation = liveSyncQueue
      .catch(() => false)
      .then(() => applyLiveGroup(groupId))
      .then((result) => {
        transferred = result;
        return result;
      })
      .catch((error) => {
        setLiveStatus(groupId, `Overførselsfejl: ${error.message || error}`, "error");
        return false;
      })
      .finally(() => {
        liveTransferPending = Math.max(0, liveTransferPending - 1);
        renderTransferButton();
        if (transferred && groupId === state.activeGroupId && refs.transferButton) {
          window.clearTimeout(transferButtonResetTimer);
          refs.transferButton.textContent = "Overført";
          transferButtonResetTimer = window.setTimeout(() => {
            if (liveTransferPending === 0) refs.transferButton.textContent = "Overfør til VMAN";
          }, automatic ? 700 : 1100);
        }
        if (transferred && refresh) scheduleVmanPageRefresh();
      });
    liveSyncQueue = operation;
    return operation;
  }

  function average(values) {
    const usable = values.filter(Number.isFinite);
    return usable.length ? usable.reduce((sum, value) => sum + value, 0) / usable.length : null;
  }

  function formatDanishNumber(value) {
    return Number.isFinite(value) ? value.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "-";
  }

  function formatVmanAge(age) {
    if (!Number.isFinite(age)) return "-";
    return Math.max(0, age).toLocaleString("da-DK", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  }

  function agePartsFromDecimal(age) {
    const safeAge = Number.isFinite(age) ? clamp(age, 15, 40) : 15;
    let years = Math.floor(safeAge);
    let days = Math.round((safeAge - years) * 30);
    if (days >= 30) {
      years += 1;
      days = 0;
    }
    return { years: clamp(years, 15, 40), days: clamp(days, 0, 29) };
  }

  function scenarioPlayerIdentity(player) {
    return String(player && (player.id || player.url || player.name) || "");
  }

  function scenarioIncludedPlayers(data, scenario = null) {
    const players = data && Array.isArray(data.players) ? data.players.filter(Boolean) : [];
    if (!players.length) return [];
    if (!Array.isArray(scenario && scenario.includedPlayerIds)) return players;
    const requested = new Set(scenario.includedPlayerIds.map((value) => String(value || "")).filter(Boolean));
    const selected = players.filter((player) => requested.has(scenarioPlayerIdentity(player)));
    // A completely stale selection (for example after a squad change) must not
    // leave Scenario without contributors. In that case all current players are used.
    return selected.length ? selected : players;
  }

  function scenarioFromPlayers(data, fallbackPosition, includedPlayerIds = null, previousScenario = null) {
    if (!data || !Array.isArray(data.players) || !data.players.length) return null;
    const allPlayers = data.players.filter(Boolean);
    const requested = Array.isArray(includedPlayerIds)
      ? new Set(includedPlayerIds.map((value) => String(value || "")).filter(Boolean))
      : null;
    let players = requested
      ? allPlayers.filter((player) => requested.has(scenarioPlayerIdentity(player)))
      : allPlayers;
    if (!players.length) players = allPlayers;
    const position = POSITION_STATS[fallbackPosition] ? fallbackPosition : players[0].position;
    const stats = {};
    for (const stat of POSITION_STATS[position] || []) {
      const value = average(players.map((player) => Number(player.stats && player.stats[stat])));
      stats[stat] = clamp(Math.round(Number.isFinite(value) ? value : 2), 0, 100);
    }
    const age = agePartsFromDecimal(average(players.map((player) => player.age)));
    const selectedIds = players.map(scenarioPlayerIdentity).filter(Boolean);
    return {
      source: "group",
      position,
      ageYears: age.years,
      ageDays: age.days,
      xp: previousScenario ? clamp(Math.round(Number(previousScenario.xp) || 180), 0, 999) : 180,
      referenceIntensity: previousScenario && Object.hasOwn(INTENSITIES, previousScenario.referenceIntensity)
        ? previousScenario.referenceIntensity
        : "Hård",
      includedPlayerIds: selectedIds.length === allPlayers.length ? null : selectedIds,
      stats,
    };
  }

  function manualScenario(position = activeProgram().position) {
    return {
      source: "manual",
      position,
      ageYears: 15,
      ageDays: 0,
      xp: 180,
      referenceIntensity: "Hård",
      includedPlayerIds: null,
      stats: Object.fromEntries((POSITION_STATS[position] || []).map((stat) => [stat, 2])),
    };
  }

  function scenarioPlayer(scenario) {
    if (!scenario) return null;
    const stats = Object.fromEntries((POSITION_STATS[scenario.position] || []).map((stat) => [stat, Number(scenario.stats[stat])]));
    return {
      id: "scenario",
      name: "Scenario",
      position: scenario.position,
      age: Number(scenario.ageYears) + Number(scenario.ageDays) / 30,
      xp: Number(scenario.xp),
      referenceIntensity: scenario.referenceIntensity,
      stats,
      rating: calculateRating(stats, scenario.position),
    };
  }

  function expandedProgramPhases(program) {
    const phases = [];
    for (const item of program.sessions) {
      if (item.type === "block") {
        for (let repetition = 0; repetition < item.repetitions; repetition += 1) {
          for (const phase of item.phases) phases.push(phase);
    