  function ensureGrassFlowSpacer(grass, layout) {
    if (!grass || !layout) return null;
    if (grassFlowElement !== grass || !grassFlowSpacer || !grassFlowSpacer.isConnected) {
      removeGrassFlowSpacer();
      const spacer = document.createElement("div");
      spacer.id = "virm-extension-grass-spacer";
      spacer.setAttribute("aria-hidden", "true");
      spacer.style.setProperty("box-sizing", "border-box", "important");
      spacer.style.setProperty("display", "block", "important");
      spacer.style.setProperty("clear", "both", "important");
      spacer.style.setProperty("height", "0px", "important");
      spacer.style.setProperty("min-height", "0", "important");
      spacer.style.setProperty("margin", "0", "important");
      spacer.style.setProperty("padding", "0", "important");
      spacer.style.setProperty("border", "0", "important");
      spacer.style.setProperty("pointer-events", "none", "important");
      spacer.style.setProperty("visibility", "hidden", "important");
      spacer.style.setProperty("width", "100%", "important");
      spacer.style.setProperty("grid-column", "1 / -1", "important");

      // Placér spaceren i samme normale HTML-flow som VMANs træningsområde.
      // Dermed vokser græscontaineren på samme måde som når VMAN selv tilføjer en øvelse.
      if (grass === layout) {
        grass.appendChild(spacer);
      } else {
        let branch = layout;
        while (branch.parentElement && branch.parentElement !== grass) branch = branch.parentElement;
        if (branch.parentElement === grass) grass.insertBefore(spacer, branch.nextSibling);
        else grass.appendChild(spacer);
      }
      grassFlowElement = grass;
      grassFlowSpacer = spacer;
    }
    return grassFlowSpacer;
  }

  function restoreTrainingLayoutAnchor() {
    if (trainingLayoutAnchor && trainingLayoutAnchor.style) {
      if (trainingLayoutOriginalInlineMinHeight) {
        trainingLayoutAnchor.style.setProperty("min-height", trainingLayoutOriginalInlineMinHeight);
      } else {
        trainingLayoutAnchor.style.removeProperty("min-height");
      }
    }
    trainingLayoutAnchor = null;
    trainingLayoutOriginalInlineMinHeight = null;
  }

  function rememberTrainingLayoutAnchor(layout) {
    if (!layout) return;
    if (trainingLayoutAnchor === layout) return;
    restoreTrainingLayoutAnchor();
    trainingLayoutAnchor = layout;
    trainingLayoutOriginalInlineMinHeight = layout.style.getPropertyValue("min-height") || "";
  }

  function extendGrassBackgroundToHost() {
    // VMANs græs ligger på .training_exercises og følger højden på .main.
    // Host-panelet ligger absolut inde i .main, så vi udvider kun .main nok til at omslutte panelets bund.
    if (!host || !host.isConnected) return;
    const layout = host.parentElement && host.parentElement.matches?.(".training_exercises > .main")
      ? host.parentElement
      : findCentralTrainingLayout();
    if (!layout || !layout.isConnected) return;

    rememberTrainingLayoutAnchor(layout);
    if (trainingLayoutOriginalInlineMinHeight) {
      layout.style.setProperty("min-height", trainingLayoutOriginalInlineMinHeight);
    } else {
      layout.style.removeProperty("min-height");
    }

    const layoutRect = layout.getBoundingClientRect();
    const hostRect = host.getBoundingClientRect();
    if (!layoutRect.width || !hostRect.height) return;

    const computed = window.getComputedStyle(layout);
    const contentHeight = Number.parseFloat(computed.height) || 0;
    const nonContentHeight = Math.max(0, layoutRect.height - contentHeight);
    const requiredBorderBoxHeight = Math.max(layoutRect.height, hostRect.bottom - layoutRect.top + 12);
    const requiredContentMinHeight = Math.max(0, requiredBorderBoxHeight - nonContentHeight);
    layout.style.setProperty("min-height", `${Math.ceil(requiredContentMinHeight)}px`, "important");
  }

  function observeHostSizeForGrass() {
    if (hostSizeResizeObserver) hostSizeResizeObserver.disconnect();
    if (!host || typeof ResizeObserver !== "function") return;
    hostSizeResizeObserver = new ResizeObserver(() => {
      if (typeof window.requestAnimationFrame === "function") {
        window.requestAnimationFrame(extendGrassBackgroundToHost);
      } else {
        window.setTimeout(extendGrassBackgroundToHost, 0);
      }
    });
    hostSizeResizeObserver.observe(host);
  }

