      const panelRect = playerPanel.getBoundingClientRect();
      const layoutRect = layout.getBoundingClientRect();
      const visualBottom = visualBottomOfPlayerPanel(playerPanel);
      const gap = 12;
      const viewportTop = visualBottom + gap;

      clearHostCoordinates();
      host.classList.remove("virm-extension-pending");
      host.classList.add("virm-extension-central-overlay", "virm-extension-layout-anchored");
      host.style.setProperty("left", `${panelRect.left - layoutRect.left}px`, "important");
      host.style.setProperty("top", `${visualBottom - layoutRect.top + gap}px`, "important");
      host.style.setProperty("width", `${panelRect.width}px`, "important");
      setHostHeightFromViewportTop(viewportTop);
      extendGrassBackgroundToHost();
    } else if (
      onTrainingExercisesPage
      && host.parentElement
      && host.parentElement.matches?.(".training_exercises > .main")
      && host.classList.contains("virm-extension-layout-anchored")
    ) {
      // VMAN genopbygger kortvarigt dele af DOM'en ved resize og ved tilføj/fjern.
      // Behold sidste korrekte placering i stedet for at skifte til et andet layout.
      host.classList.remove("virm-extension-pending");
    } else if (onTrainingExercisesPage) {
      // På denne side må viewport-breakpoints aldrig flytte VIRM ned i fuld bredde.
      // Vent på VMANs højre kolonne, som page-observer/resize straks finder igen.
      host.classList.add("virm-extension-pending");
      return;
    } else if (isMobileHostLayout()) {
      positionHostMobile();
    } else {
      mobileHostLocked = false;
      observeHostAnchor(playerPanel);
      positionHostInCentralFallback();
    }

    if (typeof window.requestAnimationFrame === "function") {
      window.requestAnimationFrame(extendGrassBackgroundToHost);
    } else {
      window.setTimeout(extendGrassBackgroundToHost, 0);
    }

    const app = shadow && shadow.querySelector(".virm-app");
    if (app && app.classList.contains("is-initializing") && !host.classList.contains("virm-extension-pending")) {
      const reveal = () => app.classList.remove("is-initializing");
      if (typeof window.requestAnimationFrame === "function") window.requestAnimationFrame(reveal);
      else window.setTimeout(reveal, 0);
    }
  }

