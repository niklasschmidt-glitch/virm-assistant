  function positionHost() {
    ensureHost();

    const onTrainingExercisesPage = location.pathname.includes("/training_exercises");
    const playerPanel = findPlayerPanel();
    const layout = findCentralTrainingLayout();

    if (playerPanel && layout) {
      mobileHostLocked = false;
      observeHostAnchor(playerPanel);
      rememberTrainingLayoutAnchor(layout);

      if (host.parentElement !== layout || host !== layout.firstElementChild) {
        layout.insertBefore(host, layout.firstChild);
