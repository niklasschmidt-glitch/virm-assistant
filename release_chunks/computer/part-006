  function bindShellEvents() {
    refs.menuButton.addEventListener("click", (event) => {
      event.stopPropagation();
      const wasOpen = refs.mainMenu.classList.contains("is-open");
      closeMenus();
      if (!wasOpen) openMainMenu(event.currentTarget);
    });
    refs.templateButton.addEventListener("click", (event) => {
      event.stopPropagation();
      const wasOpen = refs.templateMenu.classList.contains("is-open");
      closeMenus();
      if (!wasOpen) openTemplateMenu(event.currentTarget);
    });
    refs.undo.addEventListener("click", undo);
    refs.redo.addEventListener("click", redo);
    refs.assistantButton.addEventListener("click", () => {
      if (editorState.type.startsWith("assistant-")) closeAssistantEditor();
      else openAssistantEditor();
    });
    refs.clearProgramButton.addEventListener("click", clearCurrentProgram);
    refs.experience.addEventListener("change", () => {
      commitChange("Erfaringsbonus", () => {
        activeProgram().settings.experienceBonus = refs.experience.checked;
      }, { keepEditor: true });
    });
    refs.ratio.addEventListener("change", () => {
      const ratio = clamp(Number(refs.ratio.value) || 1.10, 1.01, 1.15);
      commitChange("Erfaringsratio", () => {
        activeProgram().settings.experienceRatio = Math.round(ratio * 100) / 100;
      }, { keepEditor: true });
    });
    bindNumberWheel(refs.ratio, {
      minimum: 1.01,
      maximum: 1.15,
      step: 0.01,
      decimals: 2,
      commit: true,
    });
    for (const button of refs.gradientButtons) {
      button.addEventListener("click", () => {
        commitChange("Gradient", () => {
          activeProgram().settings.gradient = button.dataset.gradient;
        }, { keepEditor: true });
      });
    }
    refs.fileInput.addEventListener("change", importSelectedFile);
    refs.startDate.addEventListener("change", () => {
      if (dateOrdinal(refs.startDate.value) === null) {
        refs.startDate.value = activeProgram().startDate;
        showToast("Vælg en gyldig startdato.");
        return;
      }
      commitChange("Startdato", () => {
        activeProgram().startDate = refs.startDate.value;
      }, { keepEditor: true });
      showEditorForTodaySession();
    });
    refs.liveToday.addEventListener("click", () => {
      const value = todayISO();
      commitChange("Startdato i dag", () => {
        activeProgram().startDate = value;
      }, { keepEditor: true });
      showEditorForTodaySession();
    });
    refs.livePrev.addEventListener("click", () => changeProgramStartDate(-1));
    refs.liveNext.addEventListener("click", () => changeProgramStartDate(1));
    refs.clearLiveButton.addEventListener("click", clearCurrentProgram);
    refs.programScroll.addEventListener("dragover", handleProgramNativeDragOver);
    refs.programScroll.addEventListener("dragleave", handleProgramNativeDragLeave);
    refs.programScroll.addEventListener("drop", handleProgramNativeDrop);
    window.addEventListener("blur", cancelProgramNativeDrag);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) return;
      cancelProgramNativeDrag();
      // En skjult fane må kun flushe, hvis den selv har en ventende ændring.
      // Ellers kan en gammel/stale fane overskrive nyere state fra en anden fane
      // lige før genindlæsning.
      if (saveTimer !== null) void saveStateNow();
    });
    refs.scenarioButton.addEventListener("click", () => {
      const hasTrainingInput = activeProgram().sessions.length > 0;
      if (hasTrainingInput) {
        if (editorState.type === "result") openScenarioEditor();
        else openResultEditor();
      } else if (["scenario", "scenario-players", "result"].includes(editorState.type)) {
        closeScenarioEditor();
      } else {
        openScenarioEditor();
      }
    });
    if (refs.transferButton) {
      refs.transferButton.addEventListener("click", () => {
        queueGroupTransfer(state.activeGroupId, { refresh: true });
      });
    }
    shadow.addEventListener("click", (event) => {
      if (!event.target.closest(".virm-popup-menu")
        && !event.target.closest("#virm-menu-button")
        && !event.target.closest("#virm-template-button")) {
        closeMenus();
      }
    });
    document.addEventListener("click", closeMenus);
    window.addEventListener("resize", () => {
      closeMenus();
      scheduleHostReposition();
    });
    if (window.visualViewport) {
      window.visualViewport.addEventListener("resize", scheduleHostReposition);
    }
    window.addEventListener("scroll", closeMenus, true);
    shadow.addEventListener("keydown", (event) => {
      const modifier = event.metaKey || event.ctrlKey;
      if (modifier && event.key.toLowerCase() === "z") {
        event.preventDefault();
        if (event.shiftKey) {
          redo();
        } else {
          undo();
        }
      }
    });
  }

  function changeProgramStartDate(dayDelta) {
    const value = shiftISODate(activeProgram().startDate, dayDelta);
    commitChange(dayDelta < 0 ? "Startdato én dag tilbage" : "Startdato én dag frem", () => {
      activeProgram().startDate = value;
    }, { keepEditor: true });
    showEditorForTodaySession();
  }

  let groupActivationSequence = 0;

  async function activateGroup(groupId) {
    const known = GROUP_DEFINITIONS.some((group) => group.id === groupId)
      || dynamicGroupDefinitions.has(groupId)
      || Boolean(state.groups[groupId]);
    if (!known) {
      return;
    }

    const activationSequence = ++groupActivationSequence;
    stopAssistantSearch();

    // Hent kun den gruppe, brugeren er på vej ind i, fra den nyeste fælles
    // storage-kopi. Så får en allerede åben fane straks et program, der er
    // importeret/redigeret i en anden fane, uden at hele VMAN-siden reloades.
    // Nyere lokale programændringer bevares via updatedAt-sammenligningen.
    try {
      await refreshGroupFromSharedStorage(groupId);
    } catch (error) {
      console.warn("VIRM Assistant kunne ikke synkronisere træningsgruppen", error);
    }
    if (activationSequence !== groupActivationSequence) return;

    state.activeGroupId = groupId;
    ensureGroupState(groupId);
    selectedIds.clear();
    editorState = { type: "phase-new" };
    // Gruppeskift er navigation, ikke en programændring. En stale fane må ikke
    // skrive hele sin ældre state tilbage blot ved at vælge en anden gruppe.
    updateActiveGroupOutline();
    renderAll();
    requestGroupPlayerData(groupId);
  }

  function createNewProgram(groupId) {
    const definition = groupDefinition(groupId);
    const group = ensureGroupState(groupId);
    commitChange("Nyt program", () => {
      const ordinal = group.programIds.length + 1;
      const program = createProgram(definition, ordinal);
      state.programs[program.id] = program;
      group.programIds.push(program.id);
      group.activeProgramId = program.id;
      state.activeGroupId = groupId;
      selectedIds.clear();
      editorState = { type: "phase-new" };
    }, { keepEditor: true });
    showToast(`Nyt program oprettet til ${definition.name}.`);
  }

  function renameCurrentProgram() {
    const program = activeProgram();
    const proposed = window.prompt("Navn på træningsprogrammet:", program.name);
    if (proposed === null) {
      return;
    }
    const name = normalizeText(proposed);
    if (!name) {
      showToast("Programnavnet må ikke være tomt.");
      return;
    }
    commitChange("Omdøb program", () => {
      program.name = name;
    }, { keepEditor: true });
  }

  function duplicateCurrentProgram() {
    const group = activeGroupState();
    const source = activeProgram();
    commitChange("Duplikér program", () => {
      const copy = deepClone(source);
      copy.id = uid("program");
      copy.name = `${source.name} – kopi`;
      copy.createdAt = new Date().toISOString();
      copy.updatedAt = copy.createdAt;
      reassignItemIds(copy.sessions);
      state.programs[copy.id] = copy;
      group.programIds.push(copy.id);
      group.activeProgramId = copy.id;
      selectedIds.clear();
    }, { keepEditor: true });
    showToast("Programmet blev duplikeret.");
  }

  function reassignItemIds(items) {
    for (const item of items || []) {
      item.id = uid(item.type === "block" ? "block" : "phase");
      if (item.type === "block") {
        for (const phase of item.phases || []) {
          phase.id = uid("phase");
        }
      }
    }
  }

  function clearCurrentProgram() {
    const program = activeProgram();
    const today = todayISO();
    const hasSessions = program.sessions.length > 0;
    const dateNeedsReset = program.startDate !== today;
    if (!hasSessions && !dateNeedsReset) return;
    commitChange("Ryd program", () => {
      program.sessions = [];
      program.startDate = today;
      selectedIds.clear();
    });
    showToast("Træningsprogrammet blev ryddet, og startdatoen blev nulstillet.");
  }

  function deleteCurrentProgram() {
    const group = activeGroupState();
    const program = activeProgram();
    if (group.programIds.length <= 1) {
      showToast("Gruppen skal have mindst ét program.");
      return;
    }
    if (!window.confirm(`Vil du slette “${program.name}”?`)) {
      return;
    }
    commitChange("Slet program", () => {
      group.programIds = group.programIds.filter((programId) => programId !== program.id);
      delete state.programs[program.id];
      group.activeProgramId = group.programIds[0];
      selectedIds.clear();
    });
  }

  function renderAll() {
    if (!stateLoaded || !shadow || !refs.app) {
      return;
    }
    lastRenderedGroupId = state.activeGroupId;
    ensureGroupState(state.activeGroupId);
    renderToolbar();
    renderFallbackGroups();
    renderProgram();
    renderLiveBar();
    renderPlayerResultLine();
    renderEditor();
    renderTransferButton();
    updateActiveGroupOutline();
  }

  function renderToolbar() {
    const program = activeProgram();
    refs.templateLabel.textContent = groupDefinition(state.activeGroupId).name;
    refs.undo.disabled = historyStack.length === 0;
    refs.redo.disabled = redoStack.length === 0;
    refs.experience.checked = Boolean(program.settings.experienceBonus);
    refs.ratio.value = clamp(Number(program.settings.experienceRatio || 1.10), 1.01, 1.15).toFixed(2);
    refs.ratio.disabled = !program.settings.experienceBonus;
    for (const button of refs.gradientButtons) {
      const pressed = button.dataset.gradient === program.settings.gradient;
      button.setAttribute("aria-pressed", String(pressed));
      button.disabled = !program.settings.experienceBonus;
    }
  }

  function renderLiveBar() {
    if (!refs.startDate || !stateLoaded) return;
    const program = activeProgram();
    const current = currentProgramDay(program);
    refs.startDate.value = program.startDate;
    refs.liveDay.className = "virm-live-day";
    if (current.state === "ready") {
      refs.liveDay.textContent = `Dag ${current.dayNumber}/${current.totalDays}`;
    } else if (current.state === "future") {
      const days = Math.abs(current.dayIndex);
      refs.liveDay.textContent = `Om ${formatDanishDayCount(days)}`;
    } else if (current.state === "finished") {
      refs.liveDay.textContent = "Afsluttet";
    } else if (current.state === "empty") {
      refs.liveDay.textContent = "";
    } else {
      refs.liveDay.textContent = "Ugyldig startdato";
    }
    const live = liveStatuses.get(state.activeGroupId);
    refs.liveStatus.dataset.kind = live?.kind || "";
    if (live) {
      refs.liveStatus.textContent = live.message;
    } else if (vmanTrainingContext()) {
      refs.liveStatus.textContent = "";
    } else {
      refs.liveStatus.textContent = "Overførsel kræver gruppens Øvelser-side";
      refs.liveStatus.dataset.kind = "muted";
    }
  }

  function readyProgramsForActiveProfile() {
    const ready = [];
    for (const [groupId, groupState] of Object.entries(state.groups || {})) {
      const program = state.programs && state.programs[groupState && groupState.activeProgramId];
      if (!program || program.active === false) continue;
      const current = currentProgramDay(program);
      if (current.state !== "ready") continue;
      const groupName = normalizeText(
        discoveredGroups.get(groupId)?.definition?.name
        || groupState?.name
        || groupDefinition(groupId).name
      );
      ready.push({ groupId, groupState, groupName, program, current });
    }
    return ready;
  }

  function setDailyTransferStatus(message, kind = "") {
    if (!dailyTransferStatus) return;
    const nextMessage = message || "";
    if (dailyTransferStatus.textContent !== nextMessage) dailyTransferStatus.textContent = nextMessage;
    if (dailyTransferStatus.dataset.kind !== kind) dailyTransferStatus.dataset.kind = kind;
  }

  function setDailyTransferButtonLabel(label) {
    if (!dailyTransferButton) return;
    if (dailyTransferButton.tagName === "INPUT") {
      if (dailyTransferButton.value !== label) dailyTransferButton.value = label;
    } else if (dailyTransferButton.textContent !== label) {
      dailyTransferButton.textContent = label;
    }
  }

  function renderTransferButton() {
    if (!stateLoaded) return;

    if (dailyTransferButton) {
      const readyCount = readyProgramsForActiveProfile().length;
      const unavailable = liveTransferPending > 0 || readyCount === 0;
      dailyTransferButton.disabled = unavailable;
      dailyTransferButton.setAttribute("aria-disabled", unavailable ? "true" : "false");
      if (liveTransferPending > 0) {
        setDailyTransferButtonLabel("Overfører…");
      } else {
        setDailyTransferButtonLabel("Overfør dagens øvelser");
      }
      dailyTransferButton.title = readyCount
        ? `Overfør dagens øvelse til ${readyCount} ${readyCount === 1 ? "gruppe" : "grupper"}.`
        : "Ingen træningsgrupper har en aktiv programdag i dag.";
    }

    if (refs.transferButton) {
      const context = vmanTrainingContext();
      const current = currentProgramDay(activeProgram());
      refs.transferButton.disabled = liveTransferPending > 0;
      if (liveTransferPending > 0) {
        refs.transferButton.textContent = "Overfører…";
      } else if (refs.transferButton.textContent !== "Overført") {
        refs.transferButton.textContent = "Overfør til VMAN";
      }
      if (!context) refs.transferButton.title = "Åbn gruppens Øvelser-side for at overføre til VMAN.";
      else if (current.state !== "ready") refs.transferButton.title = "Programmet har ingen aktiv session i dag.";
      else refs.transferButton.title = "Overfør dagens session til den valgte træningsgruppe i VMAN.";
    }
  }

  function findGameExerciseList() {
    return document.querySelector('#content > .training_exercises .exercises > ul')
      || document.querySelector('#content .training_exercises .exercises > ul')
      || document.querySelector('.training_exercises .exercises > ul');
  }

  function findGameExerciseNewButton() {
    const direct = document.querySelector('.training_exercises a[href*="training_exercises/new"]')
      || document.querySelector('.training_exercises a[href*="/new"]')
      || document.querySelector('.training_exercises .new_exercise a')
      || document.querySelector('.training_exercises .new_exercise button')
      || document.querySelector('.training_exercises .new_exercise input[type="submit"]');
    if (direct) return direct;
    const candidates = Array.from(document.querySelectorAll('.training_exercises a, .training_exercises button, .training_exercises input[type="submit"]'));
    return candidates.find((element) => /ny\s+øvelse/i.test(element.textContent || element.value || '')) || null;
  }

  function resolveDailyTransferInsertion(list) {
    const trigger = findGameExerciseNewButton();
    if (trigger && trigger.parentNode) {
      return { parent: trigger.parentNode, reference: trigger.nextSibling };
    }
    return { parent: list.parentNode, reference: list };
  }

  function placeDailyTransferControl(list) {
    const nativeButton = findGameExerciseNewButton();
    if (nativeButton && nativeButton.parentNode) {
      const parent = nativeButton.parentNode;
      if (dailyTransferControl.parentNode === parent && nativeButton.nextSibling === dailyTransferControl) return true;
      parent.insertBefore(dailyTransferControl, nativeButton.nextSibling);
      return true;
    }
    if (dailyTransferControl.parentNode === list.parentNode && dailyTransferControl.nextSibling === list) return true;
    list.parentNode.insertBefore(dailyTransferControl, list);
    return true;
  }

  function createDailyTransferButton() {
    const nativeButton = findGameExerciseNewButton();
    let button;
    if (nativeButton) {
      button = nativeButton.cloneNode(false);
      button.removeAttribute("id");
      button.removeAttribute("href");
      button.removeAttribute("onclick");
      button.removeAttribute("name");
      if (button.tagName === "INPUT") {
        button.type = "button";
        button.value = "Overfør dagens øvelser";
      } else {
        button.textContent = "Overfør dagens øvelser";
        if (button.tagName !== "BUTTON") button.setAttribute("role", "button");
      }
    } else {
      button = document.createElement("button");
      button.type = "button";
      button.textContent = "Overfør dagens øvelser";
    }
    button.classList.add("virm-assistant-daily-transfer-button");
    return button;
  }

  function ensureDailyTransferControl() {
    const list = findGameExerciseList();
    if (!list || !list.parentNode) return false;
    if (dailyTransferControl && dailyTransferControl.isConnected) {
      placeDailyTransferControl(list);
      renderTransferButton();
      return true;
    }

    dailyTransferControl = document.createElement("span");
    dailyTransferControl.className = "virm-assistant-daily-transfer";
    dailyTransferButton = createDailyTransferButton();
    dailyTransferButton.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (dailyTransferButton.disabled || dailyTransferButton.getAttribute("aria-disabled") === "true") return;
      transferAllReadyGroups({ refresh: true });
    });
    dailyTransferStatus = document.createElement("span");
    dailyTransferStatus.className = "virm-assistant-daily-transfer-status";
    dailyTransferStatus.setAttribute("aria-live", "polite");
    dailyTransferControl.append(dailyTransferButton, dailyTransferStatus);
    placeDailyTransferControl(list);
    renderTransferButton();
    return true;
  }

  async function transferAllReadyGroups({ refresh = false } = {}) {
    const context = vmanTrainingContext();
    if (!context) {
      setDailyTransferStatus("Holdets Øvelser-side kunne ikke identificeres.", "error");
      return false;
    }
    if (liveTransferPending > 0) return false;

    liveTransferPending += 1;
    renderTransferButton();
    setDailyTransferStatus("Kontrollerer træningsgrupperne…", "loading");
    let transferred = 0;
    try {
      const currentCsrfToken = await refreshVmanSession(context);
      const exercises = await loadVmanTrainingExercises(context, true);
      const exerciseByName = new Map(exercises.map((exercise) => [normalizeText(exercise.name).toLocaleLowerCase("da"), exercise]));
      const ready = readyProgramsForActiveProfile();
      if (!ready.length) throw new Error("Ingen træningsgrupper har en aktiv programdag i dag.");

      const targets = ready.map((item) => {
        const exercise = exerciseByName.get(item.groupName.toLocaleLowerCase("da"));
        if (!exercise) throw new Error(`VMAN-gruppen “${item.groupName}” kunne ikke findes.`);
        return { ...item, exercise, target: vmanTargetForPhase(item.program, item.current.phase) };
      });

      for (let index = 0; index < targets.length; index += 1) {
        const item = targets[index];
        setDailyTransferStatus(`Overfører ${item.exercise.name} (${index + 1}/${targets.length})…`, "loading");
        const response = await fetch(`${context.basePath}/${item.exercise.id}`, {
          method: "PUT",
          credentials: "include",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
            "X-Requested-With": "XMLHttpRequest",
            "X-CSRF-Token": currentCsrfToken,
          },
          body: JSON.stringify(vmanExercisePayload(context, item.exercise, item.target)),
        });
        if (!response.ok) throw new Error(`${item.exercise.name}: ${await vmanResponseError(response)}`);
        item.exercise.exercise_type_code = item.target.exerciseTypeCode;
        item.exercise.intensity = item.target.intensity;
        item.exercise.instructions = deepClone(item.target.instructions);
        item.program.lastApplied = {
          date: todayISO(),
          dayNumber: item.current.dayNumber,
          appliedAt: Date.now(),
        };
        liveStatuses.delete(item.groupId);
        transferred += 1;
      }

      scheduleSave();
      setDailyTransferStatus(`✓ ${transferred} ${transferred === 1 ? "gruppe er" : "grupper er"} overført.`, "success");
      if (refresh) scheduleVmanPageRefresh();
      return true;
    } catch (error) {
      setDailyTransferStatus(`${error.message || error}`, "error");
      return false;
    } finally {
      liveTransferPending = Math.max(0, liveTransferPending - 1);
      renderTransferButton();
    }
  }

  function renderFallbackGroups() {
    if (!refs.fallbackGroups) {
      return;
    }
    refs.fallbackGroups.classList.toggle("is-visible", discoveredGroups.size < 2);
    refs.fallbackGroups.replaceChildren();
    if (discoveredGroups.size >= 2) {
