  function isMobileHostLayout() {
    // Placeringen skal fortsat følge VMANs faktiske layout-viewport.
    // På iPhone kan VMAN bruge en bred desktop-lignende viewport; i den situation
    // skal panelet blive i den normale VMAN-kolonne og ikke flyttes til fuld bredde.
    return Boolean(window.matchMedia && window.matchMedia("(max-width: 920px)").matches);
  }

  function isStationaryMobileProgramLayout() {
    const visualWidth = Number(window.visualViewport?.width || 0);
    const screenWidth = Number(window.screen?.width || 0);
    const layoutWidth = Number(window.innerWidth || 0);
    const touchDevice = Number(navigator.maxTouchPoints || 0) > 0;
    const mobileUserAgent = /iPhone|iPad|iPod|Android|Mobile/i.test(String(navigator.userAgent || ""));
    // Række-reservationen skal derimod virke på fysisk mobil, også når VMAN
    // rapporterer en desktop-lignende layout-viewport.
    return Boolean(
      (touchDevice && mobileUserAgent)
      || (visualWidth > 0 && visualWidth <= 920)
      || (screenWidth > 0 && screenWidth <= 920)
      || isMobileHostLayout()
      || (layoutWidth > 0 && layoutWidth <= 920)
    );
  }



  function isMobileMultiSelectAvailable() {
    const touchPoints = Number(navigator.maxTouchPoints || 0);
